            $user = User::where('id',$request->user_id)->first();
            if (!$user->firebase_token) {
                return response()->json(['ok' => false, 'message' => 'User has no firebase_token'], 422);
            }       
            
            $resp = $this->fcm->sendToToken(
                $user->firebase_token,
                $request->title,
                $request->body,
                $request->data ?? [],
                $request->image ?? null
            );
            // Clean invalid tokens
