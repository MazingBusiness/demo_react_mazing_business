    /**
     * Update Email
     *
     * @param Request $request
     * @return array
     */
    public function updateEmail(Request $request): array
    {
        try {
            $userId = auth()->id();
            $user = User::find($userId);

            if (!$user) {
                return ['res' => false, 'msg' => __('User not found.'), 'data' => null];
            }

            $request->validate([
                'email' => 'required|email|max:255|unique:users,email,' . $userId,
            ]);

            $user->email = trim($request->input('email'));
            $user->save();

            return [
                'res' => true,
                'msg' => __('Email updated successfully.'),
                'data' => $user->fresh(),
            ];
        } catch (Exception $e) {
            return [
                'res' => false,
                'msg' => $e->getMessage(),
                'data' => $e->getCode(),
            ];
        }
    }


    /**
     * Update default address for the authenticated user.
     *
     * @param Request $request
     * @return array
     */
    public function updateSetDefaultAddress(Request $request): array
    {
        try {
            $request->validate([
                'address_id' => 'required|integer',
            ]);

            $userId = auth()->id();
            $address = Address::where('id', $request->input('address_id'))
                ->where('user_id', $userId)
                ->first();

            if (!$address) {
                return ['res' => false, 'msg' => __('Address not found.'), 'data' => null];
            }

            DB::transaction(function () use ($userId, $address) {
                Address::where('user_id', $userId)->update(['set_default' => 0]);
                $address->set_default = 1;
                $address->save();
            });

            return [
                'res' => true,
                'msg' => __('Default address updated successfully.'),
                'data' => $address->fresh(),
            ];
        } catch (Exception $e) {
            return [
                'res' => false,
                'msg' => $e->getMessage(),
                'data' => $e->getCode(),
            ];
        }
    }

    /**
     * Update an address belonging to the authenticated user.
     *
     * @param Request $request
     * @return array
     */
    public function updateAddress(Request $request): array
    {
        try {
            $validated = $request->validate([
                'address_id' => 'required|integer',
                'aadhar_card' => 'nullable|string|max:20',
                'company_name' => 'required|string|max:255',
                'address' => 'required|string|max:500',
                'address_2' => 'nullable|string|max:500',
                'postal_code' => 'required|string|max:20',
                'city' => 'required|string|max:255',
                'state_id' => 'required|integer|exists:states,id',
                'phone' => 'required|string|max:30',
            ]);

            $address = Address::where('id', $validated['address_id'])
                ->where('user_id', auth()->id())
                ->first();

            if (!$address) {
                return ['res' => false, 'msg' => __('Address not found.'), 'data' => null];
            }

            $address->company_name = trim($validated['company_name']);
            $address->aadhar_card = isset($validated['aadhar_card'])
                ? trim($validated['aadhar_card'])
                : null;
            $address->address = trim($validated['address']);
            $address->address_2 = isset($validated['address_2']) ? trim($validated['address_2']) : null;
            $address->postal_code = trim($validated['postal_code']);
            $address->city = trim($validated['city']);
            $address->state_id = $validated['state_id'];
            $address->phone = trim($validated['phone']);
            $address->country_id = 101;
            $address->save();

            $address->load('stateDetails:id,name');
            $address->setAttribute('state', optional($address->stateDetails)->name);
            $address->unsetRelation('stateDetails');

            return [
                'res' => true,
                'msg' => __('Address updated successfully.'),
                'data' => $address,
            ];
        } catch (Exception $e) {
            return [
                'res' => false,
                'msg' => $e->getMessage(),
                'data' => $e->getCode(),
            ];
        }
    }





