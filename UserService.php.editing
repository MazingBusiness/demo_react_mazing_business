    /**

     * Manager Client List

     *

     * @param $request

     * @return array

     */

    public function managerClientList($request): array

    {

        $user = auth()->user();

        try {

            if($user->user_type == "staff"){

                $user = auth()->user();

                // $userList = User::with('userAddress','warehouse','manager')->where('manager_id', $user->id)->orderBy('id','ASC')->paginate(15);

                $userList = User::with('userAddress', 'warehouse', 'manager');

                // Apply the condition for manager_id only if the user's ID is not 180, 25606, or 169

                if (!in_array($user->id, [180, 25606, 169])) {

                    $userList->where('manager_id', $user->id);

                } else {

                    // If the user is 180, 25606, or 169, filter by user_type as 'customer'

                    $userList->where('user_type', 'customer');

                }



                // Order by id and paginate the results

                $userList = $userList->orderBy('id', 'ASC')->paginate(15);

                $response = ['res' => true, 'msg' => "Successfully get data.", 'data' => $userList];

            }else{

                $response = ['res' => false, 'msg' => "Loged User's type is not manager"];

            }            

        } catch (Exception $e) {

            $errorCode = $e->getCode();

            if ($errorCode == 23000) {

                $errorMessage = __("direct link already exists");

            } else {

                $errorMessage = $e->getMessage();

            }

            $response = ['res' => false, 'msg' => $errorMessage, 'data' => $errorCode];

        }

        return $response;

    }



    /**

     * Manager Client Search

     *

     * @param $request

     * @return array

     */

    public function managerClientSearch($request): array

    {

        $user = auth()->user();

        try {

            if($user->user_type == "staff"){

                $user = auth()->user();

                $userList = User::with('userAddress','warehouse','manager');                

                if (!empty($request['search_text'])) {

                    $userList->where(function ($query) use ($request) {

                        $query->where('name', 'like', '%'.$request['search_text'].'%')

                            ->orWhere('company_name', 'like', '%'.$request['search_text'].'%')

                            ->orWhere('party_code', 'like', '%'.$request['search_text'].'%')

                            ->orWhere('phone', 'like', '%'.$request['search_text'].'%');

                    });

                }

                $filter = $request['filter'];

                if (!empty($request['filter'])) {

                    if ($filter) {

                        $userList->when($filter === 'approved', fn($q) => $q->where('banned', '0'))

                            ->when($filter === 'un_approved', fn($q) => $q->where('banned', '1'));

                    }

                }



                if (!empty($request['warehouse'])) {

                    $userList->where('warehouse_id', $request['warehouse']);

                }



                if (!empty($request['manager_id'])) {

                    $userList->where('manager_id', $request['manager_id']);

                }



                // if ($request->filled('city')) {

                //     $userList->whereHas('address_by_party_code', fn($q) => $q->where('city', $request->input('city')));

                // }



                // if ($request->filled('discount')) {

                //     $userList->where('discount', $request->input('discount'));

                // }



                if (!in_array($user->id, [180, 25606, 169])) {

                    $userList->where('manager_id', $user->id);

                } else {

                    // If the user is 180, 25606, or 169, filter by user_type as 'customer'

                    $userList->where('user_type', 'customer');

                }

                $userList = $userList->orderBy('id', 'ASC')->paginate(15);               

                $response = ['res' => true, 'msg' => "Successfully get data.", 'data' => $userList];

            }else{

                $response = ['res' => false, 'msg' => "Loged User's type is not manager"];

            }

            

        } catch (Exception $e) {

            $errorCode = $e->getCode();

            if ($errorCode == 23000) {

                $errorMessage = __("direct link already exists");

            } else {

                $errorMessage = $e->getMessage();

            }

            $response = ['res' => false, 'msg' => $errorMessage, 'data' => $errorCode];

        }

        return $response;

    }



    /**

     * Manager Client List

     *

     * @param $request

     * @return array

     */

    public function managerClientStatement($request): array

    {

        $user = auth()->user();

        try {

            if($user->user_type == "staff"){

                // Allowed user IDs

                $allowedUserIds = [1, 180, 169, 25606];

                $loggedInUserId = $user->id;

                

                // Sorting options

                $sortBy = $request->input('sort_by');

                $sortOrder = $request->input('sort_order', 'asc');

                $validSortColumns = ['credit_days', 'credit_limit', 'city', 'due_amount_numeric', 'overdue_amount_numeric'];

        

                // Base Query for Customers**

                $baseQuery = User::join('addresses', function ($join) {

                        $join->on(DB::raw("LEFT(users.party_code, 11)"), '=', DB::raw("LEFT(addresses.acc_code, 11)"));

                    })

                    ->leftJoin('users as managers', 'users.manager_id', '=', 'managers.id')

                    ->leftJoin('warehouses', 'users.warehouse_id', '=', 'warehouses.id')

                    ->where('users.user_type', 'customer');

        

                // Total Customers Count (before filtering due/overdue amounts)**

                $totalCustomerCount = (clone $baseQuery)->count();

        

                //  *Filtering customers who have due or overdue amounts**

                $customersQuery = (clone $baseQuery)

                    ->where(function ($query) {

                        $query->whereRaw('CAST(NULLIF(addresses.due_amount, "") AS DECIMAL(10,2)) > 0')

                              ->orWhereRaw('CAST(NULLIF(addresses.overdue_amount, "") AS DECIMAL(10,2)) > 0');

                    });

        

                // *Total Customers With Due or Overdue**

                $totalCustomersWithDueOrOverdue = (clone $customersQuery)->count();

        

                // **Apply Filters**

                if ($request->has('search') && !empty($request->search)) {

                    $searchTerm = $request->search;

                    $customersQuery->where(function ($query) use ($searchTerm) {

                        $query->where('users.party_code', 'LIKE', '%' . $searchTerm . '%')

                            ->orWhere('users.name', 'LIKE', '%' . $searchTerm . '%')

                            ->orWhere('addresses.company_name', 'LIKE', '%' . $searchTerm . '%')

                            ->orWhere('addresses.city', 'LIKE', '%' . $searchTerm . '%');

                    });

                }

        

                if (!in_array($loggedInUserId, $allowedUserIds)) {

                    $customersQuery->where('users.manager_id', $loggedInUserId);

                }

        

                if ($request->has('manager_id') && !empty($request->manager_id)) {

                    $customersQuery->where('users.manager_id', $request->manager_id);

                }

        

                if ($request->has('warehouse_id') && !empty($request->warehouse_id)) {

                    $customersQuery->where('users.warehouse_id', $request->warehouse_id);

                }

        

                // **Apply City Filter**

                if ($request->has('city_id') && !empty($request->city_id)) {

                    $customersQuery->where('addresses.city', 'LIKE', '%' . $request->city_id . '%');

                }

        

                if ($request->has('duefilter') && !empty($request->duefilter)) {

                    if ($request->duefilter === 'due') {

                        $customersQuery->whereRaw('CAST(NULLIF(addresses.due_amount, "") AS DECIMAL(10,2)) > 0');

                    } elseif ($request->duefilter === 'overdue') {

                        $customersQuery->whereRaw('CAST(NULLIF(addresses.overdue_amount, "") AS DECIMAL(10,2)) > 0');

                    }

                }

        

                // **Apply Sorting**

                if ($sortBy && in_array($sortBy, $validSortColumns)) {

                    if ($sortBy == 'city') {

                        $customersQuery->orderByRaw("LOWER(addresses.city) $sortOrder");

                    } else {

                        $customersQuery->orderBy($sortBy, $sortOrder);

                    }

                } else {

                    // Default Sorting

                    $customersQuery->orderBy('warehouses.name', 'asc')

                        ->orderBy('managers.name', 'asc')

                        ->orderByRaw('LOWER(addresses.city) ASC');

                }

                // **Calculate Total Due and Overdue Amount**

                if ($request->hasAny(['search', 'manager_id', 'warehouse_id', 'city_id', 'duefilter'])) {

                    // If filters are applied, recalculate total amounts based on filters

                    $filteredTotalQuery = clone $customersQuery;

                    $totalDueAmount = $filteredTotalQuery

                        ->whereRaw('CAST(NULLIF(addresses.due_amount, "") AS DECIMAL(10,2)) > 0')

                        ->sum(DB::raw('CAST(NULLIF(addresses.due_amount, "") AS DECIMAL(10,2))'));

        

                    $totalOverdueAmount = $filteredTotalQuery

                        ->whereRaw('CAST(NULLIF(addresses.overdue_amount, "") AS DECIMAL(10,2)) > 0')

                        ->sum(DB::raw('CAST(NULLIF(addresses.overdue_amount, "") AS DECIMAL(10,2))'));

                } else {

                    // If no filters are applied, fetch the total from the base query

                    $totalDueAmount = (clone $baseQuery)

                        ->whereRaw('CAST(NULLIF(addresses.due_amount, "") AS DECIMAL(10,2)) > 0')

                        ->sum(DB::raw('CAST(NULLIF(addresses.due_amount, "") AS DECIMAL(10,2))'));

        

                    $totalOverdueAmount = (clone $baseQuery)

                        ->whereRaw('CAST(NULLIF(addresses.overdue_amount, "") AS DECIMAL(10,2)) > 0')

                        ->sum(DB::raw('CAST(NULLIF(addresses.overdue_amount, "") AS DECIMAL(10,2))'));

                }

        

                // **Fetch Paginated Data**

                $customers = "";

                $customers = $customersQuery

                    ->select(

                        'users.id', 'users.phone', 'users.manager_id', 'users.credit_days', 'users.credit_limit',

                        'addresses.company_name', 'addresses.acc_code', 'addresses.city',

                        DB::raw('CAST(NULLIF(addresses.due_amount, "") AS DECIMAL(10,2)) as due_amount_numeric'),

                        DB::raw('CAST(NULLIF(addresses.overdue_amount, "") AS DECIMAL(10,2)) as overdue_amount_numeric'),

                        'managers.name as manager_name',

                        'warehouses.name as warehouse_name'

                    )

                    ->paginate(15);

                echo "<pre>"; print_r($customers); die;

                $response = ['res' => true, 'msg' => "Successfully get data.", 'data' => $customers];

            }else{

                $response = ['res' => false, 'msg' => "Loged User's type is not manager"];

            }            

        } catch (Exception $e) {

            $errorCode = $e->getCode();

            if ($errorCode == 23000) {

                $errorMessage = __("direct link already exists");

            } else {

                $errorMessage = $e->getMessage();

            }

            $response = ['res' => false, 'msg' => $errorMessage, 'data' => $errorCode];

        }

        return $response;

    }



    /**

     * Get Cities By Manager Statement.

     *

     * @param $request

     * @return array

     */

    public function getCitiesByManagerStatement($request): array

    {

        $user = auth()->user();

        try {

            $managerId = $request->manager_id;

            // Fetch distinct cities

            // $cities = Address::join('users', 'addresses.user_id', '=', 'users.id')

            //     ->where('users.manager_id', $request->manager_id)

            //     ->whereNotNull('addresses.city') // Ensure city is not null

            //     ->where('addresses.city', '!=', '') // Ensure city is not an empty string

            //     ->where('addresses.due_amount', '>', 0)

            //     ->distinct()

            //     ->pluck('addresses.city');



            $users = User::with(['addresses' => function ($query) {

                $query->whereNotNull('city')

                    ->where('city', '!=', '')

                    ->where('due_amount', '>', 0);

            }])

            ->where('manager_id', $request->manager_id)

            ->get();

            $cities = $users->flatMap(function ($user) {

                return $user->addresses->pluck('city');

            })->unique()->values();



            $response = ['res' => true, 'msg' => "Successfully get data.", 'data' => $cities];            

        } catch (Exception $e) {

            $errorCode = $e->getCode();

            if ($errorCode == 23000) {

                $errorMessage = __("direct link already exists");

            } else {

                $errorMessage = $e->getMessage();

            }

            $response = ['res' => false, 'msg' => $errorMessage, 'data' => $errorCode];

        }

        return $response;

    }



    public function getManagerList(Request $request)

    {

        // Convert comma-separated warehouse IDs to an array

        // $warehouseIds = explode(',', $request->warehouse_id);



        // Fetch managers based on the selected warehouse(s)

        // $managers = User::join('staff', 'users.id', '=', 'staff.user_id')

        //     ->where('staff.role_id', 5)

        //     ->select('users.*')

        //     ->get();



        $managers = User::whereHas('staffDetails', function ($query) {

            $query->where('role_id', 5);

        })->with('staffDetails')->get();



        return response()->json($managers); // Return managers as JSON response

    }



    /**

     * Manager Client Search

     *

     * @param $request

     * @return array

     */

    public function getManagerDetails($request): array

    {

        $user = auth()->user();

        try {

            if($user->user_type != "staff"){

                $user = auth()->user();

                $userList = User::where('id', $user->manager_id)->first();

                $response = ['res' => true, 'msg' => "Successfully get data.", 'data' => $userList];

            }else{

                $response = ['res' => false, 'msg' => "Loged User's type is not manager"];

            }

            

        } catch (Exception $e) {

            $errorCode = $e->getCode();

            if ($errorCode == 23000) {

                $errorMessage = __("direct link already exists");

            } else {

                $errorMessage = $e->getMessage();

            }

            $response = ['res' => false, 'msg' => $errorMessage, 'data' => $errorCode];

        }

        return $response;

    }



