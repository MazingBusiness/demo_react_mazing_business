        $this->redirectUri = $settings->redirect_uri;

        $this->orgId = $settings->organization_id;

        $this->fcm = $fcm;
    }



    /**

     * Vefiry GST

     *

     * @param array $requestData

     * @return array

     */

    public function verifyGstForRegistration(array $requestData) : array

    {

        try{

            // Send request to GST verification API

            $response = Http::withHeaders([

                'Content-Type' => 'application/json',

            ])->post('https://appyflow.in/api/verifyGST', [

                'key_secret' => env('GST_API_KEY'),

                'gstNo' => $requestData['gst_number'],

            ]);



            // Check if the response has errors

            if ($response->failed() || isset($response['error'])) {

                $response =[

                    'res' => false,

                    'msg' => $response['message'] ?? 'Invalid GST'

                ];

                return $response;

            }



            // Extract relevant GST details

            $gst_data = json_decode($response->body(), true);

            // Check GST existence in your database

            $gstExists = User::where('gstin', $requestData['gst_number'])->exists();

            if ($gstExists) {

                $response =[

                    'res' => false,

                    'msg' => 'GSTIN already exists in the system.'

                ];

                return $response;

            }

            $taxpayerInfo = $gst_data['taxpayerInfo'];

            $address = $gst_data['taxpayerInfo']['pradr']['addr'];

            $cmp_address = $address['bnm']. ', '.$address['st'] . ', ' .$address['loc'];

            $cmp_address2 = $address['bno'] . ', ' .$address['dst'];



            // Prepare the data for frontend

            $response =[
                'res' => true,

                'msg' => 'Valid',

                'gst_number' => $requestData['gst_number'],

                'gst_data' => $gst_data ?? null,

                'name' => $gst_data['taxpayerInfo']['lgnm'] ?? null,

                'address' => $cmp_address,

                'address2' => $cmp_address2,

                'postal_code' => $taxpayerInfo['pradr']['addr']['pncd'] ?? null,

                'state' => $taxpayerInfo['pradr']['addr']['stcd'] ?? null,

                'city' => $taxpayerInfo['pradr']['addr']['dst'] ?? null,

            ];

            // $response = ['res' => true, 'msg' => 'Valid', 'data' => 'Valid GST'];

        } catch (Exception $e) {

            $errorCode = $e->getCode();

            if ($errorCode == 23000) {

                $errorMessage = __("direct link already exists");

            } else {

                $errorMessage = $e->getMessage();//"something went wrong, please try again";

            }

            $response = ['res' => false, 'msg' => $errorMessage, 'data' => $errorCode];

        }

        return $response;

    }



    /**

     * Vefiry Phone

     *

     * @param array $requestData

     * @return array

     */ 

    public function verifyPhoneForRegistration(array $requestData) : array

    {

        try{            

            // Check Phone existence in your database

            $phoneExists = User::where('phone', 'LIKE', '%' . $requestData['phone'] . '%')->first();

            if ($phoneExists) {

                $response =[

                    'res' => false,

                    'msg' => 'Phone number already exists in the system.'

                ];

            }else{

                $response =[

                    'res' => true,

                    'msg' => 'Phone number didn\'t exists in system.'

                ];

            }

            return $response;

            

        } catch (Exception $e) {

            $errorCode = $e->getCode();

            if ($errorCode == 23000) {

                $errorMessage = __("direct link already exists");

            } else {

                $errorMessage = $e->getMessage();//"something went wrong, please try again";

            }

            $response = ['res' => false, 'msg' => $errorMessage, 'data' => $errorCode];

        }

        return $response;

    }



    /**

     * Save a new User

     *

     * @param array $requestData

     * @return array

     */

    public function signUp(array $requestData):array

    {

        try{

            $requestData['phone']='+91' . $requestData['phone'];

			$requestData['user_type']='customer';

            $user = $requestData;

            $pincode = Pincode::where('pincode', $requestData['postal_code'])->first();             

            if (!$pincode) {

                $state = State::find($requestData['state']); 

                if (!$state) {

                    return $response = ['res' => false, 'msg' => 'State not found', 'data' => ''];

                }               

                $city = City::firstOrCreate(

                    ['name' => $requestData['city']],

                    ['state_id' => $state->id, 'cost' => 0.00, 'status' => 1]

                );            

                // Create a new pincode entry

                $pincode = Pincode::create([

                    'pincode' => $requestData['postal_code'],

                    'city' => $city->name,

                    'state' => $state->name,

                ]);

            } else {

                $state = State::where('name', $pincode->state)->first();

            }        

            $warehouse = Warehouse::whereRaw('FIND_IN_SET(?, service_states)', [$state->id])->first();        

            if($warehouse->id == 3 OR $warehouse->id == 5){

                $warehouse->id = 6;

            }        



            $lastcustomer = User::where('user_type', 'customer')->where('warehouse_id', $warehouse->id)->orderBy('created_at', 'desc')->orderBy('id', 'desc')->first();

            if ($lastcustomer) {

                $party_code = 'OPEL0' . $warehouse->id . str_pad(((int) substr($lastcustomer->party_code, -5) + 1), 5, '0', STR_PAD_LEFT);

            } else {

                $party_code = 'OPEL0' . $warehouse->id . '00001';

            }

            $user['country'] = 'India';

            $user['state'] = $state->name;

            $user['party_code'] = $party_code;

            $user['virtual_account_number'] = $party_code;

            $user['warehouse_id'] = $warehouse->id;

            $user['ledgergroup'] = str_replace(' ','_',$user['name']).$user['party_code'];

            $user['virtual_account_number'] = $user['party_code'];

            $user['user_type'] = 'customer';

            $user['banned'] = true;

            // $user['gst_data'] = $user['gst_data'];

            $user['email_verified_at'] = date("Y-m-d H:i:s");

            $user['banned'] ='1';

            $user['unapproved'] ='0';

            // Create user

            $user = $this->createUser($user);



            // Transport data insert

            $data = [

                'user_id' => $user->id,

                'party_code' => $user->party_code,

                'assigned_warehouse' => $warehouse->name,

                'city' => $user['city'],

                'warehouse_id' => '1',

                'warehouse_name' => 'Kolkata',

                'preference' => '0',

                'rewards_percentage' => ''

            ];

            RewardUser::create($data);



            $data = [

                'user_id' => $user->id,

                'party_code' => $user->party_code,

                'assigned_warehouse' => $warehouse->name,

                'city' => $user['city'],

                'warehouse_id' => '2',

                'warehouse_name' => 'Delhi',

                'preference' => '0',

                'rewards_percentage' => ''

            ];

            RewardUser::create($data);

            $data = [

                'user_id' => $user->id,

                'party_code' => $user->party_code,

                'assigned_warehouse' => $warehouse->name,

                'city' => $user['city'],

                'warehouse_id' => '3',

                'warehouse_name' => 'Chennai',

                'preference' => '0',

                'rewards_percentage' => ''

            ];

            RewardUser::create($data);



            $data = [

                'user_id' => $user->id,

                'party_code' => $user->party_code,

                'assigned_warehouse' => $warehouse->name,

                'city' => $user['city'],

                'warehouse_id' => '5',

                'warehouse_name' => 'Pune',

                'preference' => '0',

                'rewards_percentage' => ''

            ];

            RewardUser::create($data);



            $data = [

                'user_id' => $user->id,

                'party_code' => $user->party_code,

                'assigned_warehouse' => $warehouse->name,

                'city' => $user['city'],

                'warehouse_id' => '6',

                'warehouse_name' => 'Mumbai',

                'preference' => '0',

                'rewards_percentage' => ''

            ];

            RewardUser::create($data);



            //whatsapp processing start

            $to = $user->phone;

            $company_name=$user->company_name;



            // $to = +919804722029;

            // $company_name='DS';

            $messageContent = "Your account has been successfully created. Please wait for approval from the manager, which will be completed within 24 hours.";



            $userTemplateData = [

                'name' => 'utility_user_signup_temp', // Replace with your template name

                'language' => 'en_US', // Replace with your desired language code

                'components' => [

                    [

                        'type' => 'body',

                        'parameters' => [

                            [

                                'type' => 'text',

                                'text' => $company_name

                            ],

                            [

                                'type' => 'text',

                                'text' => $messageContent

                            ]

                        ],

                    ],

                ],

            ];



            $this->WhatsAppService=new WhatsAppService();

            $response = $this->WhatsAppService->sendTemplateMessage($to, $userTemplateData);



            // //whatsapp message to manager

            $getManagerDetails = $this->getManagerDetailsByWarehouseId('6');

            

            // $getManagerDetails = $this->getManagerDetailsByUserPhone($user->warehouse_id);

            $to = $getManagerDetails[0]['phone'];

            $company_name=$user->company_name;

            $user_phone=$user->phone;

            // $to = '+919804722029';

            // $company_name='DS';

            // $user_phone='+919804722029';

            $managerTemplateData = [

                'name' => 'utility_head_manager_approval_template', // Replace with your template name

                'language' => 'en_US', // Replace with your desired language code

                'components' => [

                    [

                        'type' => 'body',

                        'parameters' => [

                            [

                                'type' => 'text',

                                'text' => $company_name

                            ],

                            [

                                'type' => 'text',

                                'text' => $user_phone

                            ]

                        ],

                    ]

                    

                ],

            ];

            $this->WhatsAppService=new WhatsAppService();

            $response = $this->WhatsAppService->sendTemplateMessage($to, $managerTemplateData);

            // //whatsapp processing end 



            $response = ['res' => true, 'msg' => 'Success', 'data' => $user];

        } catch (Exception $e) {

            $errorCode = $e->getCode();

            if ($errorCode == 23000) {

                $errorMessage = __("direct link already exists");

            } else {

                $errorMessage = $e->getMessage();//"something went wrong, please try again";

            }

            $response = ['res' => false, 'msg' => $errorMessage, 'data' => $errorCode];

        }

        return $response;

    }

    

