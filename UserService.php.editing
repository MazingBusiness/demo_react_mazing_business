    public function managerClientAdd(array $requestData): array
    {
        try {
            $requestData['phone'] = '+91' . $requestData['phone'];
            $requestData['user_type'] = 'customer';
            $requestData['manager_id'] = auth()->user()->id;

            $pincode = Pincode::where('pincode', $requestData['postal_code'])->first();

            if (!$pincode) {
                $state = State::find($requestData['state']);

                if (!$state) {
                    return [
                        'res' => false,
                        'msg' => 'State not found',
                        'data' => '',
                    ];
                }

                $city = City::firstOrCreate(
                    ['name' => $requestData['city']],
                    [
                        'state_id' => $state->id,
                        'cost' => 0.00,
                        'status' => 1,
                    ]
                );

                $pincode = Pincode::create([
                    'pincode' => $requestData['postal_code'],
                    'city' => $city->name,
                    'state' => $state->name,
                ]);
            } else {
                $state = State::where('name', $pincode->state)->first();

                if (!$state) {
                    return [
                        'res' => false,
                        'msg' => 'State not found for this pincode',
                        'data' => '',
                    ];
                }
            }

            $warehouse = Warehouse::find(auth()->user()->warehouse_id);

            if (!$warehouse) {
                return [
                    'res' => false,
                    'msg' => 'Warehouse not found',
                    'data' => '',
                ];
            }

            if (in_array($warehouse->id, [3, 5])) {
                $warehouse = Warehouse::find(6);

                if (!$warehouse) {
                    return [
                        'res' => false,
                        'msg' => 'Mapped warehouse not found',
                        'data' => '',
                    ];
                }
            }

            $lastcustomer = User::where('user_type', 'customer')
                ->where('warehouse_id', $warehouse->id)
                ->orderBy('created_at', 'desc')
                ->orderBy('id', 'desc')
                ->first();

            if ($lastcustomer) {
                $party_code = 'OPEL0' . $warehouse->id . str_pad(
                    ((int) substr($lastcustomer->party_code, -5) + 1),
                    5,
                    '0',
                    STR_PAD_LEFT
                );
            } else {
                $party_code = 'OPEL0' . $warehouse->id . '00001';
            }

            $user = $requestData;

            $user['country'] = 'India';
            $user['state'] = $state->name;
            $user['party_code'] = $party_code;
            $user['virtual_account_number'] = $party_code;
            $user['warehouse_id'] = $warehouse->id;
            $user['ledgergroup'] = str_replace(' ', '_', $user['name']) . $party_code;
            $user['user_type'] = 'customer';
            $user['email_verified_at'] = date("Y-m-d H:i:s");
            $user['banned'] = '0';
            $user['unapproved'] = '0';
            $user['manager_id'] = auth()->user()->id;

            $user = $this->createUser($user);

            $rewardWarehouses = [
                ['warehouse_id' => '1', 'warehouse_name' => 'Kolkata'],
                ['warehouse_id' => '2', 'warehouse_name' => 'Delhi'],
                ['warehouse_id' => '3', 'warehouse_name' => 'Chennai'],
                ['warehouse_id' => '5', 'warehouse_name' => 'Pune'],
                ['warehouse_id' => '6', 'warehouse_name' => 'Mumbai'],
            ];

            foreach ($rewardWarehouses as $rewardWarehouse) {
                RewardUser::create([
                    'user_id' => $user->id,
                    'party_code' => $user->party_code,
                    'assigned_warehouse' => $warehouse->name,
                    'city' => $user->city,
                    'warehouse_id' => $rewardWarehouse['warehouse_id'],
                    'warehouse_name' => $rewardWarehouse['warehouse_name'],
                    'preference' => '0',
                    'rewards_percentage' => '',
                ]);
            }

            // WhatsApp message to user
            $to = $user->phone;
            $company_name = $user->company_name;

            // $messageContent = "Your account has been successfully created. Please wait for approval from the manager, which will be completed within 24 hours.";

            $userTemplateData = [
                  'name' => 'utility_registration_template', 
                  'language' => 'en_US', 
                  'components' => [
                      [
                          'type' => 'body',
                          'parameters' => [
                              ['type' => 'text','text' => $company_name],
                              ['type' => 'text','text' => str_replace("+91", "", $to)],
                              ['type' => 'text','text' => $user->verification_code]
                          ],
                      ]
                  ],
              ];

            $this->WhatsAppService = new WhatsAppService();
            $this->WhatsAppService->sendTemplateMessage($to, $userTemplateData);

            // WhatsApp message to manager
            $getManagerDetails = $this->getManagerDetailsByWarehouseId($warehouse->id);

            if (!empty($getManagerDetails) && isset($getManagerDetails[0]['phone'])) {
                $to = $getManagerDetails[0]['phone'];
                $company_name = $user->company_name;
                $user_phone = $user->phone;

                $managerTemplateData = [
                  'name' => 'sub_manager_notification', 
                  'language' => 'en_US', 
                  'components' => [
                      [
                          'type' => 'body',
                          'parameters' => [
                              ['type' => 'text','text' => $getManagerDetails->name],
                              ['type' => 'text','text' => $company_name],
                              ['type' => 'text','text' => $user_phone],
                              ['type' => 'text','text' => $user->gstin],
                              ['type' => 'text','text' => $user->state],
                              ['type' => 'text','text' => $user->city]
                          ],
                      ]
                  ],
              ];

                $this->WhatsAppService = new WhatsAppService();
                $this->WhatsAppService->sendTemplateMessage($to, $managerTemplateData);
            }

            return [
                'res' => true,
                'msg' => 'Success',
                'data' => $user,
            ];

        } catch (Exception $e) {
            $errorCode = $e->getCode();

            if ($errorCode == 23000) {
                $errorMessage = __("direct link already exists");
            } else {
                $errorMessage = $e->getMessage();
            }

            return [
                'res' => false,
                'msg' => $errorMessage,
                'data' => $errorCode,
            ];
        }
    }

    public function getManagerDetailsByWarehouseId($warehouse_id): array

    {

        $getUserDetails = User::select('name', 'phone', 'email', 'user_type', 'warehouse_id')

          ->where('warehouse_id', $warehouse_id)

          ->where('user_type', 'staff')

          ->whereIn('id', [180, 25606, 169])->get()->toArray();

        return $getUserDetails;

    }



    /**

     * Login In a user

     *

     * @param array $requestData

     * @return array

     */

    public function login(array $requestData): array

    {

        try{

            $user = null;
            $password = (string) ($requestData['password'] ?? '');

            if (!empty($requestData['phone'])) {

               $user = User::where('phone', $requestData['phone'])->first();

            }

            if ($user === null && !empty($requestData['email'])) {

                $user = User::where('email', $requestData['email'])->first();

            }

            if ($user === null) {

                return ['res' => false, 'msg' => 'Wrong information!', 'data' => ''];

            }

            if ((int) $user->banned === 1) {

                return ['res' => false, 'msg' => 'Your account has been disabled.', 'data' => ''];

            }

            if ((int) $user->unapproved === 1) {

                return ['res' => false, 'msg' => 'Your registration is under review. Please wait for manager approval.', 'data' => '500'];

            }

            $passwordMatches = $password !== ''
                && !empty($user->password)
                && Hash::check($password, $user->password);

            $verificationCodeMatches = $password !== ''
                && !empty($user->verification_code)
                && hash_equals((string) $user->verification_code, $password);

            $loginOtpMatches = $password !== ''
                && !empty($user->login_otp)
                && hash_equals((string) $user->login_otp, $password);

            if (!$passwordMatches && !$verificationCodeMatches && !$loginOtpMatches) {

                $response = [

                    'res' => false,

                    'msg' => 'Wrong information!', 

                    'data' => ''

                ];

            }else{

                // Generate a Passport token

                $token = $user->createToken('mazingBusiness')->accessToken;

                $user->firebase_token = $requestData['firebase_token'] ?? '';

                $response = [

                    'id' => $user->id,

                    'first_name' => $user->name,

                    'user_type' => $user->user_type,

                    'party_code' => $user->party_code,

                    'phone' => $user->phone,

                    'authorisation' => [

                        'token' => $token,

                        'type' => 'bearer',

                    ]

                ];  

            }            

        } catch (Exception $e) {

            $errorCode = $e->getCode();

            if ($errorCode == 23000) {

                $errorMessage = __("direct link already exists");

            } else {

                $errorMessage = $e->getMessage();

            }

            $response = ['res' => false, 'msg' => $errorMessage, 'data' => $errorCode];

        }

        return $response;

    }

    /**

     * Login In a user

     *

     * @param array $requestData

     * @return array

     */

    public function loginFromAdmin($requestData): array
    {
        try{
            $user = NULL ;
            if(isset($requestData->user_id)){
                $user_id = base64_decode($requestData->user_id, true);
                $user = User::where('id', $user_id)->where('banned', '0')->first(); 
            }            
            
            if (!$user || ($user->banned == '1' && $user->unapproved == '1') ) {
                $response = [
                    'res' => false,
                    'msg' => 'Wrong information!', 
                    'data' => ''
                ];
            }else{
                // Generate a Passport token
                $token = $user->createToken('mazingBusiness')->accessToken;
                $user->firebase_token = $requestData['firebase_token'] ?? '';
                $response = [
                    'id' => $user->id,
                    'first_name' => $user->name,
                    'user_type' => $user->user_type,
                    'party_code' => $user->party_code,
                    'phone' => $user->phone,
                    'authorisation' => [
                        'token' => $token,
                        'type' => 'bearer',
                    ]
                ];  
            }  
        } catch (Exception $e) {
            $errorCode = $e->getCode();
            if ($errorCode == 23000) {
                $errorMessage = __("direct link already exists");
            } else {
                $errorMessage = $e->getMessage();
            }
            $response = ['res' => false, 'msg' => $errorMessage, 'data' => $errorCode];
        }
        return $response;
    }


