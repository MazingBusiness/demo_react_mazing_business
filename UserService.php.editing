    // Bulk send via queue
    public function sendPopupMessage(Request $request)
    {
        try{
            $userId = (string) $request->user_id; // or however you get it
            $getPopupMessage = PushNotification::select(['id', 'title', 'body', 'image', 'type', 'action', 'item_id', 'show_on_screen'])->where('pop_up_message','1')->where('status','0')->whereRaw('FIND_IN_SET(?, REPLACE(user_id, " ", ""))', [$userId])->where('date_time', '<=', now())->where('to_date', '>=', now())->get();
            $response = ['res' => true, 'data' => $getPopupMessage];
        }catch (Exception $e) {
            $errorCode = $e->getCode();
            $errorMessage = $e->getMessage();//"something went wrong, please try again";
            $response = ['res' => false, 'msg' => $errorMessage, 'data' => $errorCode];
        }
        return $response;
    }


    public function getAllPendingOrder(Request $request)
    {
        try{
            $user = auth()->user();

            $query = SubOrderDetail::selectRaw('*, approved_quantity - (IFNULL(pre_closed, 0) + IFNULL(reallocated, 0) + IFNULL(challan_qty, 0)) as pending_qty')
                ->with([
                    'sub_order_record.user',
                    'product_data',
                    'parentSubOrder:id,id',
                    'btrSubOrder:id,id,order_id,product_id,sub_order_id,type'
                ])
                ->where('pre_closed_status', '0')
                ->where(function ($q) {
                    $q->whereColumn('challan_qty', '<', 'approved_quantity')
                    ->orWhereNull('challan_qty');
                })
                ->whereRaw('approved_quantity - (IFNULL(pre_closed, 0) + IFNULL(reallocated, 0) + IFNULL(challan_qty, 0)) > 0')
                ->whereHas('sub_order_record', function ($q) use ($user) {
                    $q->where('order_no', '!=', '')
                    ->where('user_id', $user->id);
                });

            $total = (clone $query)->count();          // ✅ total records
            $response = ['res' => true, 'total_pending_order_count' => $total];
        }catch (Exception $e) {
            $errorCode = $e->getCode();
            $errorMessage = $e->getMessage();//"something went wrong, please try again";
            $response = ['res' => false, 'msg' => $errorMessage, 'data' => $errorCode];
        }
        return $response;
    }

    /**

     * Crrent Year Order

     *

     * @param $request

     * @return array

     */

    public function currentYearOrder($request): array
    {
        $user = auth()->user();
        try {
            $getData = Order::where('user_id', $user->id)->whereYear('created_at', Carbon::now()->year)->orderBy('id', 'ASC')->get();
            foreach ($getData as $key => $value) {
                $value->approved = false;
                $value->bill_amount = "";
                $value->order_details = "";
                // ✅ Fetch related suborders
                $subOrders = SubOrder::where('order_id', $value->id)->where('type', 'sub_order')->get();
                $subOrderIds = $subOrders->pluck('id');
                // ✅ Fetch challans & challan details
                $challans = Challan::whereIn('sub_order_id', $subOrderIds)->get();
                $challanIds = $challans->pluck('id');
                $invoiceDetails = InvoiceOrderDetail::whereIn('challan_id', $challanIds)->get();
                $challanDetails = ChallanDetail::whereIn('challan_id', $challanIds)->get();
                // ✅ Set delivery status
                if ($invoiceDetails->count() > 0) {
                    $value->delivery_status = 'Completed';
                } elseif ($challanDetails->count() > 0) {
                    $value->delivery_status = 'Dispatched';
                } elseif ($subOrders->count() > 0) {
                    $value->delivery_status = 'Approved';
                } else {
                    $value->delivery_status = 'Pending';
                }
            }
            $response = ['res' => true, 'msg' => ("Successfully get data."), 'data' => $getData];
        } catch (Exception $e) {
            $errorCode = $e->getCode();
            if ($errorCode == 23000) {
                $errorMessage = __("direct link already exists");
            } else {
                $errorMessage = $e->getMessage();
            }
            $response = ['res' => false, 'msg' => $errorMessage, 'data' => $errorCode];
        }
        return $response;
    }

    public function getDataFromReact($request): array
    {
        try {
            $handoff = (string) $request->query('handoff', '');

            if ($handoff === '') {
                return ['res' => false, 'msg' => 'Missing handoff token.', 'data' => 422];
            }

            // expecting "b64.sig"
            [$b64, $sig] = array_pad(explode('.', $handoff, 2), 2, '');
            if ($b64 === '' || $sig === '') {
                return ['res' => false, 'msg' => 'Invalid handoff format.', 'data' => 400];
            }

            $secret = (string) config('app.react_handoff_secret');
            if ($secret === '') {
                return ['res' => false, 'msg' => 'Missing REACT_HANDOFF_SECRET in API .env', 'data' => 500];
            }

            $expected = hash_hmac('sha256', $b64, $secret);

            if (!hash_equals($expected, $sig)) {
                return ['res' => false, 'msg' => 'Invalid handoff signature.', 'data' => 401];
            }

            // decode payload
            $json = $this->b64url_decode($b64);
            $payload = json_decode($json, true);

            if (!is_array($payload)) {
                return ['res' => false, 'msg' => 'Invalid payload json.', 'data' => 400];
            }

            // expiry check
            $expiresAt = (int) ($payload['expires_at'] ?? 0);
            if ($expiresAt && time() > $expiresAt) {
                return ['res' => false, 'msg' => 'Handoff expired.', 'data' => 401];
            }

            $userId  = (int) ($payload['user_id'] ?? 0);
            $staffId = (int) ($payload['staff_id'] ?? 0);

            if (!$userId || !$staffId) {
                return ['res' => false, 'msg' => 'Missing user_id/staff_id in payload.', 'data' => 400];
            }

            // if you want token, create it here (optional)
            $token = null; // set if using Sanctum etc.

            return [
                'res'  => true,
                'msg'  => 'OK',
                'data' => [
                    'user_id'  => $userId,
                    'staff_id' => $staffId,
                    'nonce'    => $payload['nonce'] ?? (string) Str::uuid(),
                    'token'    => $token,
                ],
            ];
        } catch (\Throwable $e) {
            return [
                'res'  => false,
                'msg'  => 'Failed to parse handoff.',
                'data' => $e->getMessage(),
            ];
        }
    }

    public function mCoinStatement(Request $request)
    {
        try {
            $user = auth()->user();
            $fromDate = $request->filled('from_date') ? date('Y-m-d', strtotime($request->from_date)) : null;
            $toDate   = $request->filled('to_date') ? date('Y-m-d', strtotime($request->to_date)) : null;

            if ($fromDate && $toDate && $fromDate > $toDate) {
                return response()->json([
                    'res'  => false,
                    'msg'  => 'From date cannot be greater than To date.',
                    'data' => [],
                ]);
            }

            $query = MCoin::query()
                ->where('user_id', $user->id);
                // ->where('user_id', '24194');
            if ($fromDate) {
                $query->whereDate('created_at', '>=', $fromDate);
            }

            if ($toDate) {
                $query->whereDate('created_at', '<=', $toDate);
            }

            $getMCoin = $query
                ->orderByRaw("
                    CASE
                        WHEN type = 'invoice_creation' THEN invoice_date
                        WHEN type IN ('early_payment', 'overdue') THEN bill_date
                        WHEN type = 'gift' THEN DATE(created_at)
                        ELSE DATE(created_at)
                    END ASC
                ")
                ->orderBy('id', 'ASC')
                ->get()
                ->map(function ($row) {
                    if ($row->type === 'credit_note') {
                        $row->type = 'redeem';
                    }

                    return $row;
                });

            $response = [
                'res'        => true,
                'party_code' => $user->party_code ?? null,
                'data'       => $getMCoin,
            ];
            return $response;
        } catch (\Exception $e) {
            return response()->json([
                'res'  => false,
                'msg'  => $e->getMessage(),
                'data' => $e->getCode(),
            ]);
        }
    }

    public function managerMCoinStatement(Request $request)
    {
        try {
            $user = auth()->user();
            $fromDate = $request->filled('from_date') ? date('Y-m-d', strtotime($request->from_date)) : null;
            $toDate   = $request->filled('to_date') ? date('Y-m-d', strtotime($request->to_date)) : null;

            if ($fromDate && $toDate && $fromDate > $toDate) {
                return response()->json([
                    'res'  => false,
                    'msg'  => 'From date cannot be greater than To date.',
                    'data' => [],
                ]);
            }

            $query = ManagerMCoin::query()
                ->with('user:id,name,party_code')
                ->where('manager_id', $user->id);

            if ($fromDate) {
                $query->whereDate('created_at', '>=', $fromDate);
            }

            if ($toDate) {
                $query->whereDate('created_at', '<=', $toDate);
            }

            $getMCoin = $query
                ->orderBy('created_at', 'ASC')
                ->get()
                ->map(function ($item) {
                    $item->customer_name = $item->user_id && $item->user
                        ? $item->user->name
                        : null;

                    $item->customer_party_code = $item->user_id && $item->user
                        ? $item->user->party_code
                        : null;

                    unset($item->user); // optional: remove nested user object from API response

                    return $item;
                });

            $response = [
                'res'  => true,
                'data' => $getMCoin,
            ];
            return $response;
        } catch (\Exception $e) {
            return response()->json([
                'res'  => false,
                'msg'  => $e->getMessage(),
                'data' => $e->getCode(),
            ]);
        }
    }

    public function createZohoServiceCreditNote($invoiceId)
    {
        // services
        $orgId = $this->orgId;
        $headers = $this->getAuthHeaders();
        $url = "https://www.zohoapis.in/books/v3/creditnotes?organization_id={$orgId}";

        $invoice = PurchaseInvoice::with(['purchaseInvoiceDetails', 'address'])->findOrFail($invoiceId);
        $address = $invoice->address;
        // echo "<pre>";
        // print_r($address->toArray());
        // die();

        if (!$address || !$address->zoho_customer_id ) {
            return response()->json(['error' => 'Customer Zoho ID or GSTIN missing.'], 422);
        }

        $detail = $invoice->purchaseInvoiceDetails->first(); // One line item only
        if (!$detail) {
            return response()->json(['error' => 'Service entry detail missing.'], 422);
        }

        $taxPercent = number_format((float) $detail->tax, 2, '.', '');

        // Tax lookup
        if ($detail->igst > 0) {
            $zohoTax = ZohoTax::where('tax_percentage', $taxPercent)
                ->where('tax_specific_type', 'igst')
                ->first();
        } else {
            $zohoTax = ZohoTax::where('tax_percentage', $taxPercent)
                ->where('tax_specification', 'intra')
                ->first();
        }

        if (!$zohoTax || !$zohoTax->tax_id) {
            return response()->json(['error' => 'Zoho tax_id not found for service item.']);
        }

        $warehouse = Warehouse::find($invoice->warehouse_id);
        if (!$warehouse || !$warehouse->zoho_branch_id) {
            return response()->json(['error' => 'Zoho Branch ID not found for warehouse.']);
        }

        $state = State::find($address->state_id);
        if (!$state || !$state->state_code) {
            return response()->json(['error' => 'State code missing.']);
        }

        // ✅ Construct line item for service
        $taxAmount = $detail->price * ($zohoTax->tax_percentage / 100);
        $priceWithTax = $detail->price + $taxAmount;

        $lineItems = [[
            "description" => $detail->part_no,
            "rate" => number_format($priceWithTax, 2, '.', ''),
            "quantity"    => (int) $detail->qty,
            "hsn_or_sac"  => $detail->hsncode,
            "product_type"=> "service",
            "tax_id"      => $zohoTax->tax_id,
        ]];

        $body = [
            "customer_id" => $address->zoho_customer_id,
            'date' => $invoice->created_at->toDateString(),
            "line_items" => $lineItems,
            "location_id" => $warehouse->zoho_branch_id,
            "creditnote_number" => $invoice->credit_note_number,
            "gst_treatment" => $address->gstin ? "business_gst" : "business_none",
            "is_reverse_charge_applied" => false,
            "invoice_type" => "service",
            "reference_invoice_type" => $address->gstin ? "registered" : "b2c_others",
            // "gst_no" => $address->gstin,
            "place_of_supply" => $state->state_code,
            "reference_number" => $invoice->seller_invoice_no,
            "notes" => "Credit Note for Service Entry: " . $invoice->purchase_no,
            "is_inclusive_tax" => true
        ];

        // echo "<pre>";
        // print_r($body);
        // die();

        // ✅ Conditionally add GSTIN
        if ($address->gstin) {
            $body["gst_no"] = $address->gstin;
        }

        $response = Http::withHeaders(array_merge($headers, [
            'Content-Type' => 'application/json'
        ]))->post($url, $body);

        if ($response->successful()) {
            $responseData = $response->json();
            if (isset($responseData['creditnote']['creditnote_id'])) {
                $invoice->update(['zoho_creditnote_id' => $responseData['creditnote']['creditnote_id']]);
                return response()->json(['message' => 'Zoho Service Credit Note Created', 'data' => $responseData]);
            }
        }
        return response()->json([
            'error' => 'Zoho Credit Note creation failed',
            'details' => $response->json()
        ], 500);
    }

    private function b64url_decode(string $data): string
    {
        $remainder = strlen($data) % 4;
        if ($remainder) {
            $data .= str_repeat('=', 4 - $remainder);
        }
        return base64_decode(strtr($data, '-_', '+/')) ?: '';
    }
    
