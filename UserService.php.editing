	 /**

     * Reset Password

     *

     * @param array $requestData

     * @return array

     */

     public function resetPassword(array $requestData): array

    {

        $lang = $requestData['lang'] ?? 'de';

        app()->setLocale($lang);



        try {

            $token = $requestData['id'];

            $user = User::where('token', $token)->first();



            if ($user !== null) {

                $user->password = Hash::make($requestData['new_password']);

                $user->password_text = $requestData['new_password'];

                $user->token = null;

                $user->save();



                $sendData=array();

                $sendData['go']="update_user";

                $sendData['username']=str_replace('@',"_",$user->email);

                $sendData['password']=$requestData['new_password'];

                $returnData = $this->updateUserToCddbDatabase($sendData);



                $response = ['res' => true, 'msg' => __("Successfully updated your password"), 'data' => ''];

            } else {

                $response = ['res' => false, 'msg' => __("Didn't get user!"), 'data' => ''];

            }

        } catch (Exception $e) {

            $errorCode = $e->getCode();

            if ($errorCode == 23000) {

                $errorMessage = __("direct link already exists");

            } else {

                $errorMessage = $e->getMessage();

            }

            $response = ['res' => false, 'msg' => $errorMessage, 'data' => $errorCode];

        }



        return $response;

    }





    /**

     * Get User Details

     *

     * @return array

     */

    public function getUserDetails(): array

    {

        $user = auth()->user();

        $userDetails = User::with('get_addresses.stateDetails:id,name')
            ->where('id', $user->id)
            ->first();

        $userDetails->get_addresses->each(function ($address) {
            $address->setAttribute('state', optional($address->stateDetails)->name);
            $address->unsetRelation('stateDetails');
        });

        return ['res' => true, 'msg' => "", 'data' => $userDetails,];

    }

    /**
     * Update the authenticated user's basic profile information.
     *
     * @param Request $request
     * @return array
     */
    public function updateBasicInfo(Request $request): array
    {
        try {
            $request->validate([
                'name' => 'nullable|string|max:255',
                'company_name' => 'nullable|string|max:255',
                'aadhar_card' => 'nullable|string|max:20',
                'phone' => 'nullable|string|max:20',
                'gstin' => 'nullable|string|max:20',
                'photo' => 'nullable|image|mimes:jpg,jpeg,png,webp|max:5120',
            ]);

            $userId = auth()->id();
            $user = User::find($userId);

            if (!$user) {
                return ['res' => false, 'msg' => 'User not found.', 'data' => null];
            }

            $fields = [
                'name',
                'company_name',
                'aadhar_card',
                'phone',
                'gstin',
            ];

            foreach ($fields as $field) {
                if ($request->filled($field)) {
                    $user->{$field} = trim($request->input($field));
                }
            }

            $previousPhotoPath = null;

            if ($request->hasFile('photo')) {
                $destinationPath = public_path('user_profile_pic');

                if (!File::isDirectory($destinationPath)) {
                    File::makeDirectory($destinationPath, 0755, true);
                }

                $photo = $request->file('photo');
                $extension = strtolower($photo->getClientOriginalExtension());
                $fileName = 'user_' . $userId . '_' . time() . '_' . Str::random(8) . '.' . $extension;
                $photo->move($destinationPath, $fileName);

                if (!empty($user->avatar_original)) {
                    $previousPhotoName = basename(
                        str_replace('\\', '/', parse_url($user->avatar_original, PHP_URL_PATH) ?: $user->avatar_original)
                    );

                    if ($previousPhotoName !== '' && $previousPhotoName !== $fileName) {
                        $previousPhotoPath = $destinationPath . DIRECTORY_SEPARATOR . $previousPhotoName;
                    }
                }

                $user->avatar_original = url('public/user_profile_pic/' . $fileName);
            }

            $user->save();

            if ($previousPhotoPath && File::isFile($previousPhotoPath)) {
                File::delete($previousPhotoPath);
            }

            return [
                'res' => true,
                'msg' => 'Basic information updated successfully.',
                'data' => $user->fresh(),
            ];
        } catch (Exception $e) {
            return [
                'res' => false,
                'msg' => $e->getMessage(),
                'data' => $e->getCode(),
            ];
        }
    }



    /**

     * Delete Account

     *

     * @param $request

     * @return array

     */

    public function deleteAccount($request): array
    {

        $user = auth()->user();

        try {

            $user = User::where('id', $user->id)->first();



            if ($user !== null) {

                $userData = array();

                $userData['active'] = '0';

                User::where('id',$user->id)->update($userData);

                $response = ['res' => true, 'msg' => __("Successfully deleted account."), 'data' => ''];

            } else {

                $response = ['res' => false, 'msg' => __("Didn't get user!"), 'data' => ''];

            }

        } catch (Exception $e) {

            $errorCode = $e->getCode();

            if ($errorCode == 23000) {

                $errorMessage = __("direct link already exists");

            } else {

                $errorMessage = $e->getMessage();

            }

            $response = ['res' => false, 'msg' => $errorMessage, 'data' => $errorCode];

        }



        return $response;

    }



    /**

     * Create a new User

     *

     * @param array $userData

     * @return User

     */

    public function createUser(array $userData): User

    {

        //create User

        $user = new User();

        $user->fill($userData);

        $user->save();

        if($user->gstin != ""){

            $gstDataArray = json_decode($user->gst_data, true);          

            $gstDataArray = $gstDataArray['taxpayerInfo'];

            // print_r($gstDataArray); die;

            if(isset($gstDataArray['adadr']) AND count($gstDataArray['adadr']) > 0){

                $count = 10;

                foreach($gstDataArray['adadr'] as $key=>$value){

                    $party_code =$user->party_code.$count;

                    $address = $value['addr'];

                    $pincode = Pincode::where('pincode', $address['pncd'])->first();

                    $state = State::where('name', $pincode->state)->first();

                    $city = City::where('name', $pincode->city)->first();

                    if(!isset($city->id)){

                        $city = City::create([

                        'name' => $pincode->city,

                        'state_id' => $state->id

                        ]);

                    }else{

                        $city = $city->id;

                    }

                    

                    $cmp_address = $address['bnm']. ', '.$address['st'] . ', ' .$address['loc'];

                    $cmp_address2 = $address['bno'] . ', ' .$address['dst'];

                    Address::create([

                        'user_id'=>$user->id,

                        'acc_code'=>$party_code,

                        'company_name'=> $gstDataArray['tradeNam'],

                        'address' => trim($cmp_address,' ,'),

                        'address_2' => trim($cmp_address2,' ,'),

                        'gstin'=> $gstDataArray['gstin'],

                        'country_id' => '101',

                        'state_id'=>$state->id,

                        'city_id'=> $city,

                        'city'=>$address['dst'],

                        'longitude'=> $address['lt'],

                        'latitude'=> $address['lg'],

                        'postal_code'=> $address['pncd'],

                        'phone'=> $user->phone,

                        'set_default'=> 0

                    ]);

                    $count++;

                }

            }

            $pincode = Pincode::where('pincode', $gstDataArray['pradr']['addr']['pncd'])->first();

            $city = City::where('name', $pincode->city)->first();

            if(!isset($city->id)){

                $city= 0;

            }else{

                $city = $city->id;

            }

            $state = State::where('name', $pincode->state)->first();

            $cmp_address = $gstDataArray['pradr']['addr']['bnm']. ', '.$gstDataArray['pradr']['addr']['st'] . ', ' .$gstDataArray['pradr']['addr']['loc'];

            $cmp_address2 = $gstDataArray['pradr']['addr']['bno'] . ', ' .$gstDataArray['pradr']['addr']['dst'];

            $address = Address::create([

                'user_id'=>$user->id,

                'acc_code'=>$user->party_code,

                'company_name'=> $gstDataArray['tradeNam'],

                'address' => trim($cmp_address,' ,'),

                'address_2' => trim($cmp_address2,' ,'),

                'gstin'=> $gstDataArray['gstin'],

                'country_id' => '101',

                'state_id'=>$state->id,

                'city_id'=> $city,

                'city'=>$gstDataArray['pradr']['addr']['dst'],

                'longitude'=> $gstDataArray['pradr']['addr']['lt'],

                'latitude'=> $gstDataArray['pradr']['addr']['lg'],

                'postal_code'=> $gstDataArray['pradr']['addr']['pncd'],

                'phone'=> $user->phone,

                'set_default'=> 1

            ]);

        }else{

            $pincode = Pincode::where('pincode', $user->postal_code)->first();

            $state = State::where('name', $pincode->state)->first();

            $city = City::where('name', $pincode->city)->first();

            if(!isset($city->id)){

                $city = City::create([

                'name'                   => $pincode->city,

                'state_id'           => $state->id

                ]);

            }else{

                $city = $city->id;

            }

            

            $cmp_address = $user->address;

            $address = Address::create([

                'user_id'=>$user->id,

                'acc_code'=>$user->party_code,

                'company_name'=> $user->company_name,

                'address' => $user->address,

                'address_2' => $user->address2,

                'country_id' => '101',

                'state_id'=>$state->id,

                'city_id'=> $city,

                'city'=> $user->city,

                'longitude'=> null,

                'latitude'=> null,

                'postal_code'=> $user->postal_code,

                'phone'=> $user->phone,

                'set_default'=> 1

            ]);

        }

        return $user;

    }



    /**

     * My Order

     *

     * @param $request

     * @return array

     */

    public function myOrder($request): array

    {

        $user = auth()->user();

        try {

            $getData = Order::where('user_id', $user->id)->orderBy('id','DESC')

            ->paginate(15);

            

            foreach ($getData as $key => $value) {

                $value->approved = false;

                $value->bill_amount = "";

                $value->order_details = "";

    

                // ✅ Fetch related suborders

                $subOrders = SubOrder::where('order_id', $value->id)

                    ->where('type', 'sub_order')->get();

    

                $subOrderIds = $subOrders->pluck('id');

    

                // ✅ Fetch challans & challan details

                $challans = Challan::whereIn('sub_order_id', $subOrderIds)->get();

                $challanIds = $challans->pluck('id');

    

                $invoiceDetails = InvoiceOrderDetail::whereIn('challan_id', $challanIds)->get();

                $challanDetails = ChallanDetail::whereIn('challan_id', $challanIds)->get();

    

                // ✅ Set delivery status

                if ($invoiceDetails->count() > 0) {

                    $value->delivery_status = 'Completed';

                } elseif ($challanDetails->count() > 0) {

                    $value->delivery_status = 'Dispatched';

                } elseif ($subOrders->count() > 0) {

                    $value->delivery_status = 'Approved';

                } else {

                    $value->delivery_status = 'Pending';

                }

            }

            

            $response = ['res' => true, 'msg' => ("Successfully get data."), 'data' => $getData];

        } catch (Exception $e) {

            $errorCode = $e->getCode();

            if ($errorCode == 23000) {

                $errorMessage = __("direct link already exists");

            } else {

                $errorMessage = $e->getMessage();

            }

            $response = ['res' => false, 'msg' => $errorMessage, 'data' => $errorCode];

        }



        return $response;

    }

