            //         $user->update(['firebase_token' => null]);
            //     }
            // }
            $response = ['ok' => empty($resp['error']), 'fcm' => $resp];
         } catch (Exception $e) {
            $errorCode = $e->getCode();
            $errorMessage = $e->getMessage();//"something went wrong, please try again";
            $response = ['res' => false, 'msg' => $errorMessage, 'data' => $errorCode];
        }
        return $response;
        
    }

