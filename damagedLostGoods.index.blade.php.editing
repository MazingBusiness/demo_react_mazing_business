<script>
    document.addEventListener('DOMContentLoaded', function () {
        const stockUrl = @json(route('products.getProductStockByWarehouse'));

        function loadWarehouseStock(productSelector, warehouseSelector, quantitySelector, messageSelector) {
            const productId = $(productSelector).val();
            const warehouseId = $(warehouseSelector).val();
            const $quantity = $(quantitySelector);
            const $message = $(messageSelector);

            $quantity.removeAttr('max').get(0).setCustomValidity('');
            $message.text('');

            if (!productId || !warehouseId) {
                return;
            }

            $message.text(@json(translate('Loading available stock...')));

            $.get(stockUrl, { product_id: productId, warehouse_id: warehouseId })
                .done(function (response) {
                    const stock = Math.max(0, Number(response.stock_quantity || 0));
                    $quantity.attr('max', stock);
                    $message.text(@json(translate('Available stock')) + ': ' + stock);

                    if (Number($quantity.val() || 0) > stock) {
                        $quantity.get(0).setCustomValidity(
                            @json(translate('Quantity cannot be greater than available stock.'))
                        );
                    }
                })
                .fail(function () {
                    $message.text(@json(translate('Unable to load available stock.')));
                });
        }

        function validateQuantity(quantitySelector) {
            const input = $(quantitySelector).get(0);
            const quantity = Number(input.value || 0);
            const max = Number(input.max);
            input.setCustomValidity(input.max !== '' && quantity > max
                ? @json(translate('Quantity cannot be greater than available stock.'))
                : '');
        }

        $('#add_product_id, #add_warehouse_id').on('change', function () {
            loadWarehouseStock('#add_product_id', '#add_warehouse_id', '#add_quantity', '#add_available_stock');
        });
        $('#edit_product_id, #edit_warehouse_id').on('change', function () {
            loadWarehouseStock('#edit_product_id', '#edit_warehouse_id', '#edit_quantity', '#edit_available_stock');
        });
        $('#add_quantity').on('input', function () { validateQuantity('#add_quantity'); });
        $('#edit_quantity').on('input', function () { validateQuantity('#edit_quantity'); });

        $('.edit-damaged-lost').on('click', function () {
            const productId = $(this).data('product-id');
            const type = $(this).data('type');
            const warehouseId = $(this).data('warehouse-id');

            $('#edit_original_product_id').val(productId);
            $('#edit_original_type').val(type);
            $('#edit_original_warehouse_id').val(warehouseId);
            $('#edit_product_id').val(productId).selectpicker('refresh');
            $('#edit_type').val(type).selectpicker('refresh');
            $('#edit_warehouse_id').val(warehouseId).selectpicker('refresh');
            $('#edit_quantity').val($(this).data('quantity'));
            $('#editDamagedLostGoodsModal').modal('show');
            loadWarehouseStock('#edit_product_id', '#edit_warehouse_id', '#edit_quantity', '#edit_available_stock');
        });

        $('.delete-damaged-lost-form').on('submit', function (event) {
            if (!window.confirm(@json(translate('Are you sure you want to delete this record?')))) {
                event.preventDefault();
            }
        });

        @if($errors->any() && old('action') === 'update')
            $('#edit_original_product_id').val(@json(old('original_product_id')));
            $('#edit_original_type').val(@json(old('original_type')));
            $('#edit_original_warehouse_id').val(@json(old('original_warehouse_id')));
            $('#edit_product_id').val(@json(old('product_id'))).selectpicker('refresh');
            $('#edit_type').val(@json(old('type'))).selectpicker('refresh');
            $('#edit_warehouse_id').val(@json(old('warehouse_id'))).selectpicker('refresh');
            $('#edit_quantity').val(@json(old('quantity')));
            $('#editDamagedLostGoodsModal').modal('show');
            loadWarehouseStock('#edit_product_id', '#edit_warehouse_id', '#edit_quantity', '#edit_available_stock');
        @endif

        loadWarehouseStock('#add_product_id', '#add_warehouse_id', '#add_quantity', '#add_available_stock');
    });
</script>
@endsection
