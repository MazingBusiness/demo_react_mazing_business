    public function updateQuantity($request) : array
    {
        try{
            $user = auth()->user();
            $getCartData = Cart::where('id', $request->id)->where('is_manager_41', '0')->first();

            $product = Product::find($getCartData->product_id);
            if($product->is_reward_product == "1" AND $request->quantity > 0){
                $qty    = 1;
            }else{
                $qty    = (int) $request->quantity;
            }
            
            $userId = (int) $user->id;
            $useAliasProductLogic = ((string) $userId === '24185');
            $price = $this->cartUnitPriceForQuantityAndUser($product, $qty, $userId);
            $bulkDiscountQty = (int) ($product->piece_by_carton ?? 0);
            $staffUserTitle = strtolower(trim((string) ($request->staffUserTitle ?? $request->staff_user_title ?? '')));
            // Threshold logic
            $target       = (float) env('SPECIAL_DISCOUNT_AMOUNT', 5000);     // e.g. ₹5,000
            $spPercentage = (float) env('SPECIAL_DISCOUNT_PERCENTAGE', 3);    // kept if you use it later
            $subtotal = $price * $qty;
            // $increasePriceText = ($subtotal < $target)
            //     ? "Make product's total value ₹{$target} or more and get normal price."
            //     : "";
            if ($useAliasProductLogic) {
                $product = $this->applyAliasProductPriceForCart($product, $userId);
                $product = product_min_qty_alias_price($product, $userId);
            } else {
                $product = product_min_qty($product, $userId);
            }
            $increasePriceText = ($bulkDiscountQty > 0 && $qty < $bulkDiscountQty)
            ? "ALERT : Price increase due to quantity {$qty} pices. For bulk discount price buy {$bulkDiscountQty} or more."
            : "";
            // echo $increasePriceText; die;
            if($getCartData != NULL AND $request->quantity > 0){
                $cartItem = Cart::findOrFail($request->id);
                $quantity = $qty;
                $product = Product::find($cartItem->product_id);
                $price = $this->cartUnitPriceForQuantityAndUser($product, $quantity, $userId);
                if ($staffUserTitle === 'manager') {
                    $cartPrice = $this->normalizePrice($cartItem->price ?? 0);
                    $minOrderSuperPrice = (float) env('MIN_ORDER_SUPER_PRICE', 25000);

                    if ($cartPrice > 0 && ($cartPrice * $quantity) >= $minOrderSuperPrice) {
                        $price = $cartPrice;
                    }
                }

                if ($cartItem['id'] == $request->id) {
                    // If offer already applied  
                    if($cartItem['applied_offer_id'] != "" OR $cartItem['applied_offer_id'] != NULL){
                        $currentDate = now();
                        $appliedOffer = Offer::with('offerProducts')
                            ->where('status', 1)
                            ->whereDate('offer_validity_start', '<=', $currentDate)
                            ->whereDate('offer_validity_end', '>=', $currentDate)
                            ->where('id', $cartItem['applied_offer_id'])->first();
                        // If offer is valid then.
                        if ($appliedOffer !== NULL){                        
                            $offerProducts = $appliedOffer->offerProducts;
                            foreach($offerProducts as $opKey=>$opValue){
                                // If valid offer
                                if($appliedOffer->offer_type == 2){
                                    
                                    $cartItems = Cart::where(function ($query) {
                                        $query->where('user_id', auth()->user()->id)
                                            ->orWhere('customer_id', auth()->user()->id);
                                    })
                                    ->where('applied_offer_id', $cartItem['applied_offer_id'])
                                    ->get(['product_id', 'quantity', 'price'])
                                    ->groupBy('product_id');
                    
                                    // Prepare product IDs and quantities from the cart
                                    $cartProductIds = $cartItems->keys()->toArray();                                
                                    // Sum quantities for each product
                                    $cartQuantities = $cartItems->mapWithKeys(function ($items, $productId) {
                                        return [$productId => $items->sum('quantity')];
                                    })->toArray();

                                    // Prepare prices for each product (assuming all prices for a given product are the same)
                                    $cartItemPrice = $cartItems->mapWithKeys(function ($items, $productId) {
                                        return [$productId => $items->first()->price * $items->sum('quantity')]; // Use the price of the first item in the group
                                    })->toArray();

                                    // echo "<pre>";print_r($cartItemPrice);die;

                                    $c_offer_price_calculate = 0 ;
                                    foreach($cartQuantities as $cqKey=>$cqValue){
                                        $c_product = Product::find($cqKey);
                                        $c_price = $this->cartUnitPriceForQuantityAndUser($c_product, (int) $cqValue, $userId);
                                        if((int) $cqKey === (int) $cartItem->product_id){
                                            $c_offer_price_calculate += $c_price * $quantity;
                                        }else{
                                            $c_offer_price_calculate += $c_price * $cqValue;
                                        }                                    
                                    }
                                    // echo '@'.$appliedOffer->offer_value.'----'.$c_offer_price_calculate;
                                    if(!empty($cartItems)){
                                        if($appliedOffer->offer_value > $c_offer_price_calculate){
                                            $this->removeOfferFromTable($cartItem['applied_offer_id']);                                    
                                            $cartItem->applied_offer_id = null;
                                            $cartItem->price = $price;
                                            $cartItem['quantity'] = $qty;
                                            $cartItem->save(); 
                                        }else{
                                            $cartItem['quantity'] = $qty;
                                            $cartItem->price = $price;
                                            $cartItem->save();
                                        }
                                    }else{
                                        $cartItem->price = $c_price;
                                        $cartItem['quantity'] = $qty;
                                        $cartItem->save();
                                    }
                                    
                                }else{
                                    
                                    if($quantity < $opValue->min_qty AND $opValue->product_id == $product->id){ 
                                        $this->removeOfferFromTable($cartItem['applied_offer_id']);
                                        $cartItem['quantity'] = $qty;
                                        $cartItem->applied_offer_id = null;
                                        $cartItem->price = $price;
                                        $cartItem->save();                                
                                    }else{
                                        $cartItem['quantity'] = $qty;
                                        // $cartItem->applied_offer_id = null;
                                        // if($opValue->discount_type == 'percent'){
                                        //     $price = $price * ((100 - $opValue->offer_discount_percent) / 100);
                                        // }else{
                                        //     $price = $opValue->offer_price;
                                        // }
                                        $cartItem->price = $price;
                                        $cartItem->save(); 
                                    } 
                                }                                
                            }
                            $cartProduct = Cart::where(function ($query) use ($opValue) {
                                $query->where('user_id', auth()->user()->id)
                                    ->orWhere('customer_id', auth()->user()->id);
                            })->where('applied_offer_id', $cartItem['applied_offer_id'])->where('complementary_item', '1')->delete();
                        }else{
                            // Offer Didn't get or not valid then remove the offer from all products if already have.
                            $offerProducts = $appliedOffer->offerProducts;            
                            foreach($offerProducts as $opKey=>$opValue){
                                $cartProduct = Cart::where(function ($query) use ($opValue) {
                                    $query->where('user_id', auth()->user()->id)
                                        ->orWhere('customer_id', auth()->user()->id);
                                })->where('product_id', $opValue->product_id)->first();
                                
                                // $product = Product::where('id',$opValue->product_id)->first();
                                // $price = $product->mrp * ((100 - $user->discount) / 100);
                                $cartProduct->quantity = $qty;
                                $cartProduct->applied_offer_id = null;
                                $cartProduct->price = $price;
                                $cartProduct->save();
                            }
                            $cartProduct = Cart::where(function ($query) use ($opValue) {
                                $query->where('user_id', auth()->user()->id)
                                    ->orWhere('customer_id', auth()->user()->id);
                            })->where('applied_offer_id', $cartItem['applied_offer_id'])->where('complementary_item', '1')->delete();
                        }              
                    }else{
                        // echo "hello2"; die;
                        $cartItem['quantity'] = $qty;
                        $cartItem['price'] = $price;
                        $cartItem->save();
                    }
                }
                // $getCartData->quantity = $qty;
                // $getCartData->save();
                $response =['res' => true, 'increasePriceText' => $increasePriceText,'msg' => 'Successfully Update'];
            }else if($getCartData != NULL AND $request->quantity <= 0){
                $currentDate = date('Y-m-d');
                if($getCartData->applied_offer_id != "" OR $getCartData->applied_offer_id != NULL){
                    $cartItem = Cart::findOrFail($request->id);
                    $appliedOffer = Offer::with('offerProducts')
                            ->where('status', 1)
                            ->whereDate('offer_validity_start', '<=', $currentDate)
                            ->whereDate('offer_validity_end', '>=', $currentDate)
                            ->where('id', $cartItem['applied_offer_id'])->first();
                    
                    // Offer Didn't get or not valid then remove the offer from all products if already have.
                    $offerProducts = $appliedOffer->offerProducts;            
                    foreach($offerProducts as $opKey=>$opValue){
                        $cartProduct = Cart::where(function ($query) use ($opValue) {
                            $query->where('user_id', auth()->user()->id)
                                ->orWhere('customer_id', auth()->user()->id);
                        })->where('product_id', $opValue->product_id)->first();
                        $product = Product::find($cartProduct->product_id);
                        $price = $this->cartUnitPriceForQuantityAndUser($product, (int) $cartProduct->quantity, $userId);
                        
                        // $product = Product::where('id',$opValue->product_id)->first();
                        // $price = $product->mrp * ((100 - $user->discount) / 100);
                        // $cartProduct->quantity = $qty;
                        $cartProduct->applied_offer_id = null;
                        $cartProduct->price = $price;
                        $cartProduct->save();
                    }
                    $cartProduct = Cart::where(function ($query) use ($opValue) {
                        $query->where('user_id', auth()->user()->id)
                            ->orWhere('customer_id', auth()->user()->id);
                    })->where('applied_offer_id', $cartItem['applied_offer_id'])->where('complementary_item', '1')->delete();
                }
                $getCartData->delete();
                $response =['res' => true, 'increasePriceText' => $increasePriceText,'msg' => 'Successfully Deleted' ];
            }else{
                $response =['res' => false, 'msg' => 'Something went wrong.' ];
            }
        } catch (Exception $e) {
            $errorCode = $e->getCode();
            if ($errorCode == 23000) {
                $errorMessage = __("direct link already exists");
            } else {
                $errorMessage = $e->getMessage();//"something went wrong, please try again";
            }
            $response = ['res' => false, 'msg' => $errorMessage, 'data' => $errorCode];
        }
        
        return $response;
    }

    /**
     * Update Cart price
     *
     * @param array $request
     * @return array
     */
    public function updatePrice($request): array
    {
        try {
            $cart = Cart::with('product')->where('id', $request->id)
                ->where('is_manager_41', '0')
                ->first();

            if (!$cart) {
                return ['res' => false, 'msg' => 'Cart item not found.'];
            }

            if ($cart->applied_offer_id !== null) {
                $currentDate = now()->toDateString();
                
                $offer = Offer::with('offerProducts')
                    ->where('status', 1)
                    ->whereDate('offer_validity_start', '<=', $currentDate)
                    ->whereDate('offer_validity_end', '>=', $currentDate)
                    ->where('id', $cart->applied_offer_id)
                    ->first();

                if ($offer) {
                    $matchedOfferProduct = $offer->offerProducts
                        ->where('product_id', $cart->product_id)
                        ->first();
                    
                    if ($matchedOfferProduct && $request->price < $matchedOfferProduct->offer_price) {
                        $cart->applied_offer_id = null;
                    }
                }
            }
            
            if($cart->product->is_reward_product == "1"){
                $cart->price = "1.00";
            }else{
                $cart->price = $request->price;
            }
            $cart->save();

            return ['res' => true, 'msg' => 'Price had updated.'];
        } catch (\Throwable $e) {
            return ['res' => false, 'msg' => $e->getMessage(), 'data' => $e->getCode()];
        }
    }

    public function updateCartItemPriceWithSuperPrice($request): array
    {
        try {
            $user = auth()->user();
            $cart = Cart::with('product')
                ->where('id', $request->id)
                ->where('is_manager_41', '0')
                ->where(function ($query) use ($user) {
                    $query->where('user_id', $user->id)
                        ->orWhere('customer_id', $user->id);
                })
                ->first();

            if (!$cart) {
                return ['res' => false, 'msg' => 'Cart item not found.'];
            }

            $product = $cart->product ?: Product::find($cart->product_id);
            if (!$product) {
                return ['res' => false, 'msg' => 'Product not found.'];
            }

            if ((string) ($product->is_reward_product ?? '0') === '1') {
                return ['res' => false, 'msg' => 'Reward product price is not editable.'];
            }

            $requestedPrice = $this->normalizePrice($request->price ?? 0);
            if ($requestedPrice <= 0) {
                return ['res' => false, 'msg' => 'Enter valid price.'];
            }

            if (($product->super_price ?? null) === null || trim((string) $product->super_price) === '') {
                return ['res' => false, 'msg' => 'Super price is not available. Price is not editable.'];
            }

            $superPrice = $this->normalizePrice($product->super_price);
            if ($superPrice <= 0) {
                return ['res' => false, 'msg' => 'Super price is not available. Price is not editable.'];
            }

            $userId = (int) $user->id;
            $normalPrice = $this->cartUnitPriceForQuantityAndUser($product, 1, $userId);
            $normalPrice = $this->normalizePrice($normalPrice);

            if ($normalPrice <= 0) {
                return ['res' => false, 'msg' => 'Normal discount price is not available.'];
            }

            if ($requestedPrice < $superPrice) {
                return [
                    'res' => false,
                    'msg' => 'Price should not be less than super price.',
                    'normal_price' => $this->price_two_decimel($normalPrice),
                    'super_price' => $this->price_two_decimel($superPrice),
                ];
            }

            $quantity = (int) ($cart->quantity ?? 1);
            $quantity = $quantity > 0 ? $quantity : 1;
            $minimumOrderValue = (float) env('MIN_ORDER_SUPER_PRICE', 25000);
            $suggestedQty = 0;
            $conditionApplied = false;

            if ($requestedPrice < $normalPrice) {
                $suggestedQty = (int) ceil($minimumOrderValue / $requestedPrice);
                $suggestedQty = max(1, $suggestedQty);

                if ($quantity < $suggestedQty) {
                    $quantity = $suggestedQty;
                    $conditionApplied = true;
                }
            }

            if ($cart->applied_offer_id !== null) {
                $appliedOfferId = $cart->applied_offer_id;
                $cart->applied_offer_id = null;
                $cart->offer_rewards = null;
                Cart::where('applied_offer_id', $appliedOfferId)
                    ->where('complementary_item', '1')
                    ->where('is_manager_41', '0')
                    ->where(function ($query) use ($user) {
                        $query->where('user_id', $user->id)
                            ->orWhere('customer_id', $user->id);
                    })
                    ->delete();
            }

            $cart->price = $this->price_two_decimel($requestedPrice);
            $cart->quantity = $quantity;

            if (Schema::hasColumn('carts', 'editable_price')) {
                $cart->editable_price = $this->price_two_decimel($requestedPrice);
            }

            $cart->save();

            $msg = 'Price had updated.';
            if ($conditionApplied) {
                $msg .= " Minimum Order Value: ₹" . number_format($minimumOrderValue, 0) . " applied. Quantity updated to {$quantity}.";
            } elseif ($requestedPrice >= $normalPrice) {
                $msg .= ' Price is greater than or equal to normal discount price, minimum order value condition was not applied.';
            }

            return [
                'res' => true,
                'msg' => $msg,
                'price' => $this->price_two_decimel($requestedPrice),
                'quantity' => $quantity,
                'suggested_qty' => $suggestedQty,
                'minimum_order_value' => $minimumOrderValue,
                'normal_price' => $this->price_two_decimel($normalPrice),
                'super_price' => $this->price_two_decimel($superPrice),
                'condition_applied' => $conditionApplied,
            ];
        } catch (\Throwable $e) {
            return ['res' => false, 'msg' => $e->getMessage(), 'data' => $e->getCode()];
        }
    }



    public function updateSaveForLater($request): array
    {
        $getCartData = CartSaveForLater::where('id', $request->id)->delete();
        $response =['res' => true,'msg' => 'Successfully Deleted' ];
        return $response;
    }

    /**
     * Delete All No Credit Item
     *
     * @param array $request
     * @return array
     */
    public function deleteAllNoCreditItem($request) : array
    {
        try{
            $user = auth()->user();
            $getCartData = Cart::where('cash_and_carry_item', '1')->where('is_manager_41', '0')
                ->where(function ($query) use ($user) {
                    $query->where('user_id', auth()->user()->id)
                          ->orWhere('customer_id', auth()->user()->id);
                })->delete();
            $response =['res' => true,'msg' => 'Successfully Deleted' ];
        } catch (Exception $e) {
            $errorCode = $e->getCode();
            if ($errorCode == 23000) {
                $errorMessage = __("direct link already exists");
            } else {
                $errorMessage = $e->getMessage();//"something went wrong, please try again";
            }
            $response = ['res' => false, 'msg' => $errorMessage, 'data' => $errorCode];
        }        
        return $response;
    }

     /**
     * Save For Later
     *
     * @param array $request
     * @return array
     */
    public function saveForLater(Request $request) : array {
        try {
            $user = auth()->user();
            $userId = auth()->user()->id;
            $cart_id = $request->has('cart_id')? $request->cart_id : '';
            $array_cart_id = explode(',',$cart_id);
            
            foreach($array_cart_id as $key=>$cart_id){
                $cartItem = Cart::with('product')->where('id', $cart_id)->where('is_manager_41', '0')->first();  
                // echo "<pre>"; print_r($cartItem); die; 
                if($cartItem->product->is_reward_product == "1"){
                    continue;
                }       
                $cartSaveForLaterData = CartSaveForLater::where(function($query) use ($userId, $cartItem) {
                    $query->where('user_id', $userId)
                        ->where('product_id', $cartItem->product_id);
                })->orWhere('customer_id', $userId)->get();
                
                if ($cartSaveForLaterData->isEmpty()) {
                    $cartItem->group_id = $cartItem->product->group_id;
                    $cartItem->category_id = $cartItem->product->category_id;
                    $cartItem->brand_id = $cartItem->product->brand_id;
                    CartSaveForLater::create($cartItem->toArray());
                }            
                $cartItem->delete();
            }            

            $cartItems = Cart::where('user_id', auth()->user()->id)->orWhere('customer_id',auth()->user()->id)->where('is_manager_41', '0')->get();
           
            $cartSaveForLater = CartSaveForLater::with('product')->where('user_id', auth()->user()->id)->orWhere('customer_id',auth()->user()->id)->get();
            // Transform each cart item
            $cartSaveForLater->transform(function ($cartSaveForLater) {
                if ($cartSaveForLater->product && $cartSaveForLater->product->photos) {
                    $photoIds = explode(',', $cartSaveForLater->product->photos);
                    $cartSaveForLater->product->images = Upload::whereIn('id', $photoIds)
                        ->select('id', 'file_name')
                        ->get()
                        ->map(function ($image) {
                            $image->file_name = 'https://mazingbusiness.com/public/' . $image->file_name;
                            return $image;
                        });
                } else {
                    $cartSaveForLater->product->images = collect(); // Empty collection if no images found
                }
                
                return $cartSaveForLater;
            });

            $cartSaveForLaterCategory = CartSaveForLater::with('category') // Eager load the related category
            ->where('user_id', auth()->user()->id)
            ->orWhere('customer_id', auth()->user()->id)
            ->selectRaw('category_id, COUNT(*) as product_count') // Select category_id and the product count
            ->groupBy('category_id')
            ->get()
            ->map(function ($item) {
                return [
                    'category_id' => $item->category->id,
                    'category_name' => $item->category->name, // Assuming 'name' is the category's name column
                    'product_count' => $item->product_count,
                ];
            });

            // $overdueAmount = $request->overdueAmount;
            // $dueAmount = $request->dueAmount;
            // $cash_and_carry_item_flag_for_later = CartSaveForLater::where('cash_and_carry_item', '1')->where('user_id', auth()->user()->id)->orWhere('customer_id',auth()->user()->id)->count();

            $response = ['res' => true, 'msg' => 'Successfully save item for letter.', 'cart_item' => $cartItems, 'save-for-later' => $cartSaveForLater, 'save-for-later-category' => $cartSaveForLaterCategory ]; 

        } catch (Exception $e) {
            $errorCode = $e->getCode();
            if ($errorCode == 23000) {
                $errorMessage = __("direct link already exists");
            } else {
                $errorMessage = $e->getMessage();//"something went wrong, please try again";
            }
            $response = ['res' => false, 'msg' => $errorMessage, 'data' => $errorCode];
        }
        return $response;
    }

    /**
     * Move To Cart
     *
     * @param array $request
     * @return array
     */
    public function moveToCart(Request $request) : array {
        try {
            $user = auth()->user();
            $user_id = auth()->user()->id;        
            $cart_id = $request->has('id')? $request->id : '';

            $array_cart_id = explode(',',$cart_id);
            
            foreach($array_cart_id as $key=>$id){
                $cartItem = CartSaveForLater::where('id', $id)->first();
                $cartItemData = $cartItem->toArray();
                
                unset($cartItemData['group_id']);
                unset($cartItemData['category_id']);
                unset($cartItemData['brand_id']);

                $product = Product::find($cartItemData['product_id']);
                $qty    = (int) $cartItemData['quantity'];
                $userId = (int) $user_id;
                // Unit price for this qty (your helper should return a numeric)
                $price = $this->cartUnitPriceForQuantityAndUser($product, $qty, $userId);
                // Threshold logic
                $target       = (float) env('SPECIAL_DISCOUNT_AMOUNT', 5000);     // e.g. ₹5,000
                $spPercentage = (float) env('SPECIAL_DISCOUNT_PERCENTAGE', 3);    // kept if you use it later
                $subtotal = $price * $qty;
                $product = product_min_qty($product, $userId);

                $cartItemData['price'] = $price;
                
                Cart::create($cartItemData);        
                
                $cartItem->delete();
            }


            $cartItems = Cart::where('user_id', $user_id)->orWhere('customer_id',$user_id)->where('is_manager_41', '0')->get();
           
            $cartSaveForLater = CartSaveForLater::where('user_id', $user_id)->orWhere('customer_id',$user_id)->get();
            $cartSaveForLaterCategory = CartSaveForLater::with('category') // Eager load the related category
            ->where('user_id', $user_id)
            ->orWhere('customer_id', $user_id)
            ->selectRaw('category_id, COUNT(*) as product_count') // Select category_id and the product count
            ->groupBy('category_id')
            ->get()
            ->map(function ($item) {
                return [
                    'category_id' => $item->category->id,
                    'category_name' => $item->category->name, // Assuming 'name' is the category's name column
                    'product_count' => $item->product_count,
                ];
            });

            // $overdueAmount = $request->overdueAmount;
            // $dueAmount = $request->dueAmount;
            // $cash_and_carry_item_flag_for_later = CartSaveForLater::where('cash_and_carry_item', '1')->where('user_id', $user_id)->orWhere('customer_id',$user_id)->count();
            $response = ['res' => true, 'msg' => 'Successfully move to cart.', 'cart_item' => $cartItems, 'save-for-later' => $cartSaveForLater, 'save-for-later-category' => $cartSaveForLaterCategory ];

        } catch (\Exception $e) {
            $errorCode = $e->getCode();
            if ($errorCode == 23000) {
                $errorMessage = __("direct link already exists");
            } else {
                $errorMessage = $e->getMessage();//"something went wrong, please try again";
            }
            $response = ['res' => false, 'msg' => $errorMessage, 'data' => $errorCode];
        }
        return $response;
    }

    /**
     * Save All No Credit Item for later
     *
     * @param array $request
     * @return array
     */
    public function saveAllNoCreditItemForLater(Request $request) : array {
        try {
            $user = auth()->user();
            $user_id = auth()->user()->id;       
            
            $cartItem = Cart::with('product')->where('cash_and_carry_item', '1')->where('is_manager_41', '0')->where('user_id', $user_id)->orWhere('customer_id',$user_id)->get();

            // echo "<pre>";print_r($cartItem);die();
            if(!$cartItem->isEmpty()){
                foreach($cartItem as $cKey=>$cValue){
                    $cartSaveForLaterData = CartSaveForLater::where(function($query) use ($user_id, $cValue) {
                        $query->where('user_id', $user_id)
                              ->where('product_id', $cValue->product_id);
                    })->orWhere('customer_id', $user_id)->get();
                   
                    if ($cartSaveForLaterData->isEmpty()) {
                        $cValue->group_id = $cValue->product->group_id;
                        $cValue->category_id = $cValue->product->category_id;
                        $cValue->brand_id = $cValue->product->brand_id;
                        CartSaveForLater::create($cValue->toArray());
                    }
                    Cart::where('id',$cValue->id)->delete();
                }
            }

            $cartItems = Cart::where('user_id', $user_id)->where('is_manager_41', '0')->orWhere('customer_id',$user_id)->get();           
            $cartSaveForLater = CartSaveForLater::where('user_id', $user_id)->orWhere('customer_id',$user_id)->get();
            $cartSaveForLaterCategory = CartSaveForLater::with('category') // Eager load the related category
            ->where('user_id', $user_id)
            ->orWhere('customer_id', $user_id)
            ->selectRaw('category_id, COUNT(*) as product_count') // Select category_id and the product count
            ->groupBy('category_id')
            ->get()
            ->map(function ($item) {
                return [
                    'category_id' => $item->category->id,
                    'category_name' => $item->category->name, // Assuming 'name' is the category's name column
                    'product_count' => $item->product_count,
                ];
            });            
            $response = ['res' => true, 'msg' => 'Successfully move to save for leter.', 'cart_item' => $cartItems, 'save-for-later' => $cartSaveForLater, 'save-for-later-category' => $cartSaveForLaterCategory ];

        } catch (\Exception $e) {
            $errorCode = $e->getCode();
            if ($errorCode == 23000) {
                $errorMessage = __("direct link already exists");
            } else {
                $errorMessage = $e->getMessage();//"something went wrong, please try again";
            }
            $response = ['res' => false, 'msg' => $errorMessage, 'data' => $errorCode];
        }
        return $response;

    }

