    /**
     * Apply M Coin
     *
     * @param array $request
     * @return array
     */
    public function applyMCoin(Request $request): array
    {
        try {
            $request->validate([
                'applied_m_coins' => 'required|numeric|min:1',
            ]);

            $userId = auth()->user()->id;
            $partyCode = auth()->user()->party_code;
            $requestedCoins = (float) $request->applied_m_coins;

            $getDrMCoinSum = (float) MCoin::where('user_id', $userId)
                ->where('dr_or_cr', 'dr')
                ->sum('coins');

            $getCrMCoinSum = (float) MCoin::where('user_id', $userId)
                ->where('dr_or_cr', 'cr')
                ->sum('coins');

            $mCoinBalance = $getCrMCoinSum - $getDrMCoinSum;
            $getAppliedCoins = AppliedMCoin::where('user_id', $userId)->first();

            if ($mCoinBalance < config('app.m_coin_redeem_point')) {
                return ['res' => false, 'msg' => "You didn't have enough coins to redeem."];
            }

            if ($requestedCoins > $mCoinBalance) {
                return ['res' => false, 'msg' => "Your entered coins is greater than you have."];
            }

            if (!$getAppliedCoins) {
                AppliedMCoin::create([
                    'user_id'    => $userId,
                    'party_code' => $partyCode,
                    'coins'      => $requestedCoins,
                ]);

                return ['res' => true, 'msg' => 'Your coins had applied.'];
            }

            $alreadyApplied = (float) $getAppliedCoins->coins;
            $tempMCoin = $alreadyApplied + $requestedCoins;

            if ($tempMCoin <= $mCoinBalance) {
                $getAppliedCoins->coins = $tempMCoin;
                $getAppliedCoins->save();

                return ['res' => true, 'msg' => 'Your coins had applied.'];
            }

            return ['res' => false, 'msg' => 'You do not have enough coins.'];

        } catch (\Throwable $e) {
            return ['res' => false, 'msg' => $e->getMessage()];
        }
    }

