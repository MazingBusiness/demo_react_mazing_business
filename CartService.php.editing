            // ], [], $config);

            // ------------ M Coin ----------------
            $appliedMCoin = AppliedMCoin::where('user_id', auth()->user()->id)->first();

            if ($appliedMCoin) {

                $mCoinRecord = new MCoin;
                $mCoinRecord->user_id = $appliedMCoin->user_id;
                $mCoinRecord->party_code = $appliedMCoin->party_code;
                $mCoinRecord->type = 'credit_note';
                $mCoinRecord->coins = $appliedMCoin->coins;
                $mCoinRecord->dr_or_cr = 'dr';
                $mCoinRecord->save();

                /*
                |--------------------------------------------------------------------------
                | Insert Service Note To Zoho
                |--------------------------------------------------------------------------
                */
                $serviceNoteRequest = new \Illuminate\Http\Request([
                    'user_id'      => auth()->user()->id,
                    'address_id'   => $address_id,
                    'm_coin_value' => $appliedMCoin->coins,
                    'code'         => $code,
                ]);

                $serviceNoteResponse = $this->insertServiceNoteToZoho($serviceNoteRequest);

                /*
