    private function price_two_decimel($price){
        $truncated = floor($price * 100) / 100;
        return number_format($truncated, 2, '.', '');
    }

    private function cartUnitPriceForQuantity($product, int $quantity)
    {
        $bulkDiscountQty = (int) ($product->piece_by_carton ?? 0);

        if ($bulkDiscountQty > 0 && $quantity >= $bulkDiscountQty) {
            $price = home_bulk_discounted_price($product, false)['price'] ?? 0;
        } else {
            $price = home_discounted_price($product, false)['price'] ?? 0;
        }

        return (float) str_replace(',', '', (string) $price);
    }

    private function cartUnitPriceForQuantityAndUser($product, int $quantity, int $userId): float
    {
        if ((string) $userId !== '24185') {
            return $this->cartUnitPriceForQuantity($product, $quantity);
        }

        $product = $this->applyAliasProductPriceForCart($product, $userId);
        $user = User::find($userId);
        $discount = 20;

        if ($user && is_numeric($user->discount) && (float) $user->discount != 0) {
            $discount = (float) $user->discount;
        }

        $price = $this->normalizePrice($product->mrp ?? 0) * ((100 - $discount) / 100);
        $bulkDiscountQty = (int) ($product->piece_by_carton ?? 0);

        if ($bulkDiscountQty > 0 && $quantity >= $bulkDiscountQty) {
            $price = $price - (($price * 2) / 100);
        }

        return (float) $this->price_two_decimel($price);
    }

    private function normalizePrice($value): float
    {
        $price = preg_replace('/[^\d.]/', '', (string) $value);
        return is_numeric($price) ? (float) $price : 0;
    }

    private function specialPriceMessage($product): string
    {
        $superPrice = $this->normalizePrice($product->super_price ?? 0);
        if ($superPrice <= 0) {
            return "";
        }

        $minOrderSuperPrice = (float) env('MIN_ORDER_SUPER_PRICE', 25000);
        $minimumQuantity = (int) ceil($minOrderSuperPrice / $superPrice);
        $minimumQuantity = max(1, $minimumQuantity);

        return "Special price cannot be less than ₹ " . $this->price_two_decimel($superPrice) . ". Minimum quantity will be " . $minimumQuantity . " or more.";
    }

    private function applyAliasProductPriceForCart($product, int $userId)
    {
        if ((string) $userId !== '24185' || !$product || (string) ($product->is_reward_product ?? '0') === '1') {
            return $product;
        }

        $aliasPrimaryPartNo = trim((string) ($product->alias_primary_part_no ?? ''));
        $aliasMasterPartNo = $aliasPrimaryPartNo !== '' ? $aliasPrimaryPartNo : $product->part_no;

        if ($aliasMasterPartNo === '') {
            return $product;
        }

        $aliasProducts = Product::where('is_reward_product', '0')
            ->whereRaw("TRIM(products.mrp) REGEXP '[0-9]'")
            ->where(function ($q) use ($aliasMasterPartNo) {
                $q->where('products.part_no', $aliasMasterPartNo)
                    ->orWhere('products.alias_primary_part_no', $aliasMasterPartNo);
            })
            ->orderByRaw("CASE WHEN products.part_no = ? THEN 0 ELSE 1 END", [$aliasMasterPartNo])
            ->orderBy('products.id', 'ASC')
            ->get();

        if ($aliasProducts->isEmpty()) {
            return $product;
        }

        $aliasPartNos = $aliasProducts->pluck('part_no')->filter()->unique()->values();
        $apiStockPartNos = ProductsApi::whereIn('part_no', $aliasPartNos)
            ->where('closing_stock', '>', '0')
            ->distinct()
            ->pluck('part_no')
            ->flip();

        $apiStockAliasProducts = $aliasProducts->filter(function ($aliasProduct) use ($apiStockPartNos) {
            return $apiStockPartNos->has($aliasProduct->part_no);
        });

        $sellerStockAliasProducts = $aliasProducts->filter(function ($aliasProduct) {
            return (int) $aliasProduct->seller_stock === 1;
        });

        $priceSourceProducts = $apiStockAliasProducts->isNotEmpty()
            ? $apiStockAliasProducts
            : $sellerStockAliasProducts;

        $aliasMinProduct = $priceSourceProducts
            ->filter(function ($aliasProduct) {
                return $this->normalizePrice($aliasProduct->mrp) > 0;
            })
            ->sortBy(function ($aliasProduct) {
                return $this->normalizePrice($aliasProduct->mrp);
            })
            ->first();

        if ($aliasMinProduct) {
            $product->mrp = $aliasMinProduct->mrp;
            $product->current_stock = 1;
        }

        return $product;
    }

    /**
     * Get Cart
     *
     * @param array $request
     * @return array
     */
    public function cart($request) : array
    {
        try{
            $user = auth()->user();        
            $applied_offer_id = null; // Default value
            $offer_rewards = null;
            $earnMCoin = 0;
            $cartItems = Cart::with('product', 'product.category')
                ->where(function ($query) use ($user) {
                    $query->where('user_id', auth()->user()->id)
                        ->orWhere('customer_id', auth()->user()->id);
                })
                ->where('is_manager_41', '0')
                ->orderByRaw("CASE WHEN applied_offer_id IS NOT NULL AND applied_offer_id <> '' THEN 0 ELSE 1 END")
                ->orderBy('id', 'DESC')
                ->get();

            $getRewardProductFromCart = Cart::with('product')
                ->whereHas('product', function ($q) {
                    $q->where('is_reward_product', "1");
                })
                ->get();
            $totalRedeemMCoin = $getRewardProductFromCart->sum(function ($cart) {
                return (float) ($cart->product->redeem_m_coin ?? 0);
            });
            $getDrMCoinSum = MCoin::where('user_id', auth()->user()->id)->where('dr_or_cr', 'dr')->sum('coins');
            $getCrMCoinSum = MCoin::where('user_id', auth()->user()->id)->where('dr_or_cr', 'cr')->sum('coins');
            $availableMCoinBalance = ($getCrMCoinSum - $getDrMCoinSum) - $totalRedeemMCoin;
            
            
            // Transform each cart item
            $cartItems->transform(function ($cartItem) use (&$earnMCoin) {
                if ($cartItem->product AND $cartItem->product->is_reward_product != "1") {
                    $cartItem->product->special_price_message = $this->specialPriceMessage($cartItem->product);

                    // Images
                    if ($cartItem->product->photos) {
                        $photoIds = explode(',', $cartItem->product->photos);

                        $cartItem->product->images = Upload::whereIn('id', $photoIds)
                            ->select('id', 'file_name')
                            ->get()
                            ->map(function ($image) {
                                $image->file_name = 'https://mazingbusiness.com/public/' . $image->file_name;
                                return $image;
                            });

                        $cartItem->product->fast_delivery_tag = ProductsApi::where('part_no', $cartItem->product->part_no)
                            ->where('closing_stock', '>', 0)
                            ->distinct()
                            ->exists() ? 1 : 0;
                    } else {
                        $cartItem->product->images = collect();
                        $cartItem->product->fast_delivery_tag = 0;
                    }

                    // M Coin calculation
                    $lineAmount = ceil($cartItem->price) * $cartItem->quantity;
                    if ($cartItem->product->current_stock === 1) {
                        $itemMCoin = $cartItem->product->c_instock_m_coin * $lineAmount;
                    } else {
                        $itemMCoin = $cartItem->product->c_m_coin * $lineAmount;
                    }
                    $cartItem->earn_m_coin = $itemMCoin; // optional per-item value
                    $earnMCoin += ceil($itemMCoin);
                }

                return $cartItem;
            });
            $cartSaveForLater = CartSaveForLater::with('product','product.category')->where('user_id', auth()->user()->id)->orWhere('customer_id',auth()->user()->id)->get();
            // Transform each cart item
            $cartSaveForLater->transform(function ($cartSaveForLater) {
                if ($cartSaveForLater->product) {
                    $cartSaveForLater->product->special_price_message = $this->specialPriceMessage($cartSaveForLater->product);
                }

                if ($cartSaveForLater->product && $cartSaveForLater->product->photos) {
                    $photoIds = explode(',', $cartSaveForLater->product->photos);
                    $cartSaveForLater->product->images = Upload::whereIn('id', $photoIds)
                        ->select('id', 'file_name')
                        ->get()
                        ->map(function ($image) {
                            $image->file_name = 'https://mazingbusiness.com/public/' . $image->file_name;
                            return $image;
                        });
                } else {
                    $cartSaveForLater->product->images = collect(); // Empty collection if no images found
                }                
                return $cartSaveForLater;
            });
            $cartSaveForLaterCategory = CartSaveForLater::with('category') ->where('user_id', auth()->user()->id) ->orWhere('customer_id', auth()->user()->id) ->selectRaw('category_id, COUNT(*) as product_count') ->groupBy('category_id')  ->get()
            ->map(function ($item) {
                return [
                    'category_id' => $item->category->id,
                    'category_name' => $item->category->name,
                    'product_count' => $item->product_count,
                ];
            });
            
            // Get Payble amount.
            $calculatePayableAmount = $this->calculatePayableAmount('database');
            // echo "<pre>"; print_r($calculatePayableAmount); die;
            $payableAmount = (float)number_format($calculatePayableAmount['payable_amount'],2,'.','');
            $cashAndCarryItemSubtotal = $calculatePayableAmount['cash_and_carry_item_subtotal'];
            $overdueAmount = $calculatePayableAmount['over_due_amount'];
            $normalItemSubtotal = $calculatePayableAmount['normal_item_subtotal'];

            $validOffersTemp = $this->checkValidOffer();            
            $validOffers = $validOffersTemp['offers'] ?? [];
            $achiveOfferArray = $validOffersTemp['achiveOfferArray'] ?? [];
            
            foreach($cartItems as $key => $value){
                if($value['applied_offer_id'] != NULL OR $value['applied_offer_id']!= ""){
                    $applied_offer_id = $value['applied_offer_id'];
                }
                $offer_rewards = ($offer_rewards == 0) ? $value['offer_rewards'] : $offer_rewards;
                $value['price'] = $this->price_two_decimel(ceil_price($value['price']));
            }
            $getOfferDetails="";
            if($applied_offer_id != null){
                $getOfferDetails = Offer::where('id',$applied_offer_id)->first();
            }
            


            // -------------------------------- Conveince Fee ------------------------------
            $conveince_fee = 0;
            $conveince_fee_percentage = 0;
            // if($normalItemSubtotal <= 10000){
            //     $conveince_fee = ($normalItemSubtotal * 10)/100;
            //     $conveince_fee_percentage = 10;
            // }elseif($normalItemSubtotal >= 10000 AND $normalItemSubtotal <= 20000){
            //     $conveince_fee = ($normalItemSubtotal * 7)/100;
            //     $conveince_fee_percentage = 7;
            // }elseif($normalItemSubtotal >= 20000 AND $normalItemSubtotal <= 30000){
            //     $conveince_fee = ($normalItemSubtotal * 5)/100;
            //     $conveince_fee_percentage = 5;
            // }
            
            if($normalItemSubtotal <= 20000){
                $conveince_fee = ($normalItemSubtotal * 5)/100;
                $conveince_fee_percentage = 5;
            }

            $getAppliedCoins = AppliedMCoin::where('user_id', auth()->user()->id)->first();
            $appliedMCoinBalanceInInr = 0;
            $coins = 0;
            if($getAppliedCoins){
                $availableMCoinBalance = (float)$availableMCoinBalance - (float)$getAppliedCoins->coins;
                $appliedMCoinBalanceInInr = number_format((float)$getAppliedCoins->coins / (float)config('app.m_coin_redeem_point'),2);
                $coins = $getAppliedCoins->coins;
            }

            $response =['res' => true, 'cart_item' => $cartItems, 'applied_offer_id' => $applied_offer_id, 'offerDetails' => $getOfferDetails, 'offer_rewards' => $offer_rewards, 'valid_offers' => $validOffers, 'achive_offer_array' => $achiveOfferArray, 'payable_amount' => $payableAmount, 'no_credit_item_total_amount' => $cashAndCarryItemSubtotal, 'other_item_total_amount' => price_less_than_50($normalItemSubtotal,false),'conveince_fee' => price_less_than_50($conveince_fee,false),'conveince_fee_percentage' => $conveince_fee_percentage, 'over_due_amount' => $overdueAmount, 'save_for_later' => $cartSaveForLater, 'save_for_later_category' => $cartSaveForLaterCategory, 'availableMCoinBalance' => ceil($availableMCoinBalance),'appliedCoins' => $coins, 'appliedMCoinBalanceInInr' => $appliedMCoinBalanceInInr, 'earnMCoin' => ceil($earnMCoin), 'm_coin_redeem_point' => config('app.m_coin_redeem_point')];


        } catch (Exception $e) {
            $errorCode = $e->getCode();
            if ($errorCode == 23000) {
                $errorMessage = __("direct link already exists");
            } else {
                $errorMessage = $e->getMessage();//"something went wrong, please try again";
            }
            $response = ['res' => false, 'msg' => $errorMessage, 'data' => $errorCode];
        }
        return $response;
    }

    /**
     * Add To Cart
     *
     * @param array $request
     * @return array
     */
    public function addToCart(array $request) : array
    {
        try{
            $user = auth()->user();
            $userId = auth()->user()->id;
            // $discount = $user->discount==""?0:$user->discount;
            $discount = (!is_numeric($user->discount) || $user->discount === '' || $user->discount === null) ? 22 : $user->discount; // Ths is request for Amir Sir on 20-05-2025
            if ((string) $userId === '24185' && (!is_numeric($user->discount) || (float) $user->discount == 0)) {
                $discount = 20;
            }
            $data = array();
            $product = Product::where('id',$request['product_id'])->with('stocks')->first();
            $product = $this->applyAliasProductPriceForCart($product, (int) $userId);
            $price = '0.00';

            $getDrMCoinSum = MCoin::where('user_id', auth()->user()->id)->where('dr_or_cr', 'dr')->sum('coins');
            $getCrMCoinSum = MCoin::where('user_id', auth()->user()->id)->where('dr_or_cr', 'cr')->sum('coins');
            $getRewardProductFromCart = Cart::with('product')
                ->whereHas('product', function ($q) {
                    $q->where('is_reward_product', "1");
                })
                ->get();
            $totalRedeemMCoin = $getRewardProductFromCart->sum(function ($cart) {
                return (float) ($cart->product->redeem_m_coin ?? 0);
            });

            $availableMCoinBalance = ($getCrMCoinSum - $getDrMCoinSum) - $totalRedeemMCoin;

            if($product->is_reward_product == "1" AND $product->redeem_m_coin > $availableMCoinBalance){
                $response =['res' => false,'msg' => 'You do not have sufficient mCoins.'];
            }else{
                $data['user_id'] = auth()->user()->id;
                $data['owner_id']   = auth()->user()->id;
                $data['product_id'] = $product->id;
                $data['owner_id']   = $product->user_id;
                $data['variation']   = $product->slug;
                if($product->is_reward_product == "1"){
                    $price = "1.00";
                }elseif($request['type'] == "piece"){
                    $price = $product->mrp * ((100 - $discount) / 100);
                    // $price        = (float) (home_discounted_price($product, false, $userId)['price']);
                    $updatedPrice = ((string) $userId === '24185')
                        ? (float) $price
                        : (float) product_price_with_qty_condition($product, $userId, $request['quantity']);
                    // Threshold logic
                    $target       = (float) env('SPECIAL_DISCOUNT_AMOUNT', 5000);     // e.g. ₹5,000
                    $spPercentage = (float) env('SPECIAL_DISCOUNT_PERCENTAGE', 3);    // kept if you use it later
                    $subtotal = $price * $request['quantity'];
                    // $increasePriceText = ($subtotal < $target)
                    //     ? "Make product's total value ₹{$target} or more and get normal price."
                    //     : "";
                    $product = product_min_qty($product, $userId);
                    if($subtotal < $target){
                        $price = $updatedPrice;
                    }
                }elseif($request['type'] == "bulk"){
                    $price = $product->mrp * ((100 - $discount) / 100);
                    $price = $this->price_two_decimel($price - (($price * 2) / 100));
                }
                // echo "<pre>"; print_r($data); die;
                $data['price']= $this->price_two_decimel($price);
                $data['quantity']= $request['quantity'];
                $data['tax']= 0;
                $data['shipping_cost']= 0;
                $data['product_referral_code'] = null;
                // $data['cash_on_delivery']= $product->cash_on_delivery;
                $data['cash_and_carry_item']= (string)$product->cash_and_carry_item;
                // $data['digital']= $product->digital;
                
                // echo "<pre>"; print_r($data); die;
                $getCartData = Cart::where('product_id', $product->id)
                ->where(function ($query) use ($user) {
                    $query->where('user_id', auth()->user()->id)
                        ->orWhere('customer_id', auth()->user()->id);
                })->where('is_manager_41', '0')->first();

                if($getCartData !== NULL){
                    $getCartData->price = $price;
                    $getCartData->quantity = $request['quantity'];
                    $getCartData->save();
                }else{
                    Cart::create($data);
                }           
                $response =['res' => true,'msg' => 'Successfully Added in cart'];
            }           
        } catch (Exception $e) {
            $errorCode = $e->getCode();
            if ($errorCode == 23000) {
                $errorMessage = __("direct link already exists");
            } else {
                $errorMessage = $e->getMessage();//"something went wrong, please try again";
            }
            $response = ['res' => false, 'msg' => $errorMessage, 'data' => $errorCode];
        }
        return $response;
    }

