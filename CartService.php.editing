    public function applyOffer($request){
        try{
            $user = auth()->user();
            $offer_id = $request->offer_id;
            $currentDate = now();
            $userDiscount = $this->normalizePrice($user->discount ?? 0);
            $discount = ($userDiscount > 0 && $userDiscount <= 100)
                ? $userDiscount
                : 20;
            $offers = Offer::with('offerProducts','offerComplementoryProducts.offerComplementoryProductDetails')
                    ->where('status', 1)
                    ->whereDate('offer_validity_start', '<=', $currentDate)
                    ->whereDate('offer_validity_end', '>=', $currentDate)
                    ->where('id', $offer_id)->first();
            
            if($offers == NULL){
                $response = ['res' => false, 'msg' => '* Offer is no loanger valid now.'];                
            }else{
                // Check offer had applied previously or not for single offer applied at a time.
                $appliedOffer = Cart::where('user_id', auth()->user()->id) ->orWhere('customer_id', auth()->user()->id)->where('is_manager_41', '0')->where('applied_offer_id', '!=', NULL )->get();
                if (!$appliedOffer->isEmpty()){
                    foreach($appliedOffer as $aoKey=>$aoValue){
                        $cartProduct = Cart::where('id',$aoValue->id)->first();
                        if($aoValue->complementary_item == 1){
                            $cartProduct->delete();
                        }else{                
                            $cartProduct->applied_offer_id = null;
                            // $cartProduct->price = $price;
                            $cartProduct->save();
                        }                    
                    }
                }
                // Offer Products discount options
                $offerProducts = $offers->offerProducts;
                $rewards = 0;
                // print_r($offerProducts);die;
                // echo "<pre>"; print_r($offerProducts); die;
                if (!$offerProducts->isEmpty()) {
                    foreach ($offerProducts as $opKey => $opValue) {
                        // Fetch the cart product for the current user or customer
                        $user_id = auth()->user()->id;
                        $cartProduct = Cart::where(function ($query) use ($opValue,$user_id) {
                            $query->where('user_id', $user_id)
                                ->orWhere('customer_id', $user_id);
                        })->where('product_id', $opValue->product_id)->where('is_manager_41', '0')->first();
                        // print($user); die;
                        // Fetch product details
                        $product = Product::find($opValue->product_id); // Use find for simplicity
                        
                        if (!$product) {
                            continue; // Skip if product doesn't exist
                        }

                        // Calculate the base price with user-specific discount
                        $price = $this->normalizePrice($product->mrp ?? 0)
                            * ((100 - $discount) / 100);

                        if ($offers->offer_type == 2) { // Type 2 offer logic
                            if ($offers->value_type == 'percent') {
                                $rewards = (
                                    $this->normalizePrice($offers->offer_value ?? 0)
                                    * $this->normalizePrice($offers->discount_percent ?? 0)
                                ) / 100;
                            } else {
                                $rewards = $this->normalizePrice($offers->discount_percent ?? 0);
                            }
                        } else { // Other offer types
                            if ($opValue->discount_type == 'percent') {
                                $offerDiscount = $this->normalizePrice(
                                    $opValue->offer_discount_percent ?? 0
                                );
                                $price = $price * ((100 - $offerDiscount) / 100);
                            } else {
                                $offerPrice = $this->normalizePrice($opValue->offer_price ?? 0);
                                if($offerPrice > 0){
                                    $price = $offerPrice;
                                }                                
                            }
                        }
                        // Update cart product if it exists
                        if ($cartProduct != null) {
                            if ($offers->offer_type == 2) {
                                if($cartProduct->quantity >= $product->piece_by_carton ){
                                    $price = home_bulk_discounted_price($product,false)['price'];
                                }else{
                                    $price = home_discounted_price($product,false)['price'];
                                }
                            }
                            if($opValue->min_qty > $cartProduct->quantity){
                                $cartProduct->quantity = $opValue->min_qty;
                            }
                            $cartProduct->applied_offer_id = $offers->id;
                            $cartProduct->offer_rewards = $rewards;
                            $cartProduct->price = $price;
                            $cartProduct->save();
                        }else{
                            $req = new Request([
                                'offer_id' => $offers->offer_id,
                            ]);
                            $this->addOfferProductsToCart($req);
                        }
                    }
                    
                } else { // Handle cases when no specific offer products are provided
                    if ($offers->value_type == 'percent') {
                        $rewards = (
                            $this->normalizePrice($offers->offer_value ?? 0)
                            * $this->normalizePrice($offers->discount_percent ?? 0)
                        ) / 100;
                    } else {
                        $rewards = $this->normalizePrice($offers->discount_percent ?? 0);
                    }
                    Cart::where('user_id', auth()->user()->id)->orWhere('customer_id', auth()->user()->id)->where('is_manager_41', '0')->update(
                        [
                            'applied_offer_id'      => $offers->id,
                            'offer_rewards' => $rewards,
                        ]
                    );
                }
                // Offer Complementory Products
                $offerComplementoryProducts = $offers->offerComplementoryProducts;
                if($offerComplementoryProducts != NULL){
                    foreach($offerComplementoryProducts as $ocpKey=>$ocpValue){
                        $data = array();
                        $data['user_id'] = auth()->user()->id;
                        $data['owner_id']   = auth()->user()->id;
                        $data['product_id'] = $ocpValue->offerComplementoryProductDetails->id;
                        $data['owner_id']   = $ocpValue->offerComplementoryProductDetails->user_id;
                        $data['variation']   = $ocpValue->offerComplementoryProductDetails->slug;
                        $data['price']= '1';
                        $data['quantity']= $ocpValue->free_product_qty;
                        $data['tax']= 0;
                        $data['shipping_cost']= 0;
                        $data['product_referral_code'] = null;
                        $data['complementary_item'] = '1';
                        $data['applied_offer_id'] = $offers->id;
                        Cart::create($data);
                    }
                }
            }
            $response = ['res' => true, 'msg' => $offers->offer_name.' offer applied.'];
            // print_r($response); die;
        } catch (\Exception $e) {
            $errorCode = $e->getCode();
            if ($errorCode == 23000) {
                $errorMessage = __("direct link already exists");
            } else {
                $errorMessage = $e->getMessage();//"something went wrong, please try again";
            }
            $response = ['res' => false, 'msg' => $errorMessage, 'data' => $errorCode];
        }
        return $response;
    }

    public function removeOffer($request){
        try{
            $user = auth()->user();
            $offers = $this->removeOfferFromTable($request->offer_id);
            if(!isset($offers->offer_name)){
                $response = $offers;
            }else{
                $response = ['res' => true, 'msg' => $offers->offer_name.' offer removed.'];
            }
            
        } catch (\Exception $e) {
            $errorCode = $e->getCode();
            if ($errorCode == 23000) {
                $errorMessage = __("direct link already exists");
            } else {
                $errorMessage = $e->getMessage();//"something went wrong, please try again";
            }
            $response = ['res' => false, 'msg' => $errorMessage, 'data' => $errorCode];
        }        
        return $response;
    }

    public function removeOfferFromTable($offer_id){
        $user = auth()->user();
        $currentDate = now();
        $offers = Offer::with('offerProducts')
                ->where('status', 1)
                ->whereDate('offer_validity_start', '<=', $currentDate)
                ->whereDate('offer_validity_end', '>=', $currentDate)
                ->where('offer_id', $offer_id)->first();
        if($offers == NULL){
            $offers = Offer::with('offerProducts')
                ->where('status', 1)
                ->whereDate('offer_validity_start', '<=', $currentDate)
                ->whereDate('offer_validity_end', '>=', $currentDate)
                ->where('id', $offer_id)->first();
        }
        
        
        if($offers == NULL){
            // echo "remove".$offers->id; die;
            $cartProduct = Cart::where(function ($query) use($user) {
                $query->where('user_id', auth()->user()->id)
                      ->orWhere('customer_id', auth()->user()->id);
            })->where('applied_offer_id', $offer_id)->where('is_manager_41', '0')->get();
            
            if(!$cartProduct->isEmpty()){
                foreach($cartProduct as $cpKey=>$cpValue){
                    $updateCart = Cart::where('id',$cpValue->id)->first();
                    $product = Product::where('id',$cpValue->product_id)->first();
                    // $price = $product->mrp * ((100 - $user->discount) / 100);
                    if($cpValue->quantity >= $product->piece_by_carton ){
                        $price = home_bulk_discounted_price($product,false)['price'];
                    }else{
                        $price = home_discounted_price($product,false)['price'];
                    }
                    $updateCart->applied_offer_id = null;
                    $updateCart->offer_rewards = null;
                    $updateCart->price = $price;
                    $updateCart->save();
                }
                $cartProduct = Cart::where('applied_offer_id', $offer_id)
                ->where('complementary_item', '1')
                ->where('is_manager_41', '0')
                ->where(function ($query) {
                    $query->where('user_id', Auth::id())
                        ->orWhere('customer_id', Auth::id());
                })
                ->delete();
            }
            return $response = ['res' => true, 'msg' => '* Offer is no loanger valid now.'];
        }else{
            $offerProducts = $offers->offerProducts;
            if (!$offerProducts->isEmpty()) {
                foreach($offerProducts as $opKey=>$opValue){
                    $cartProduct = Cart::where(function ($query) use ($opValue,$user) {
                        $query->where('user_id', auth()->user()->id)
                            ->orWhere('customer_id', auth()->user()->id);
                    })->where('product_id', $opValue->product_id)->where('is_manager_41', '0')->first();
                    
                    $product = Product::where('id',$opValue->product_id)->first();
                    // $price = $product->mrp * ((100 - $user->discount) / 100);
                    if($cartProduct != NULL){
                        if($cartProduct->quantity >= $product->piece_by_carton ){
                            $price = home_bulk_discounted_price($product,false)['price'];
                        }else{
                            $price = home_discounted_price($product,false)['price'];
                        }
                        $cartProduct->applied_offer_id = null;
                        $cartProduct->price = $price;
                        $cartProduct->offer_rewards = null;
                        $cartProduct->save();
                    }                
                }
                $cartProduct = Cart::where('applied_offer_id', $offers->id)
                ->where('complementary_item', '1')
                ->where('is_manager_41', '0')
                ->where(function ($query) {
                    $query->where('user_id', Auth::id())
                        ->orWhere('customer_id', Auth::id());
                })
                ->delete();
            }else{
                if ($offers->value_type === 'percent') {
                    $rewards = ($offers->offer_value * ($offers->discount_percent)) / 100;
                } else {
                    $rewards = $offers->discount_percent;
                }

                $cartProduct = Cart::where('applied_offer_id', $offers->id)
                ->where('complementary_item', '1')
                ->where('is_manager_41', '0')
                ->where(function ($query) {
                    $query->where('user_id', Auth::id())
                        ->orWhere('customer_id', Auth::id());
                })
                ->delete();
                Cart::where('user_id', auth()->user()->id)->orWhere('customer_id', auth()->user()->id)->where('is_manager_41', '0')->update(
                    [
                        'applied_offer_id' => NULL,
                        'offer_rewards' => NULL,
                    ]
                );
            }    
            return $offers;
        }
    }

    public function addOfferProductsToCart(Request $request) {
        try{
            $user = auth()->user();
            $offer_id = $request->offer_id;
            $offerData=Offer::where('offer_id',$offer_id)->first();
            // Brands filter
            if (!empty($request['product_id'])) {
                $product_id_array = explode(',',$request->product_id);
            }else{
                $product_id_array = OfferProduct::where('offer_id',$offer_id)->pluck('product_id');
            }

            $currentDate = now();
            foreach($product_id_array as $pKey => $pValue){
                $product = Product::find($pValue);
                $carts   = array();
                $data    = array();
                $user_id         = auth()->user()->id;
                $data['user_id'] = $user_id;
                $carts = Cart::where(function ($query) use ($user_id) {
                    $query->where('user_id', $user_id)
                        ->orWhere('customer_id', $user_id);
                })->where('product_id', $pValue)->where('is_manager_41', '0')->get();

                $data['product_id'] = $product->id;
                $data['owner_id']   = $product->user_id;

                $str     = '';
                $tax     = $ctax     = $price     = $carton_price     = 0;
                $wmarkup = 0;

                $str = $product->slug;
                $data['variation'] = $str;

                $product_stock = $product->stocks->where('variant', $str)->where('is_manager_41', '0');
                
                //$price=calculate_discounted_price($product->mrp,false)['net_selling_price'];
                
                $userDiscount = $this->normalizePrice($user->discount ?? 0);
                $discount = ($userDiscount > 0 && $userDiscount <= 100)
                    ? $userDiscount
                    : 20;
                
                $price = $this->normalizePrice($product->mrp ?? 0)
                    * ((100 - $discount) / 100);
                $data['quantity']  = $request['quantity'];
                $data['price']     = price_less_than_50($price,false);
                $data['tax']       = $tax;
                $data['shipping_cost']         = 0;
                $data['product_referral_code'] = null;
                if ($product->cash_and_carry_item == 1) {
                    $data['cash_and_carry_item'] = '1';   // or '1' if you want string
                } else {
                    $data['cash_and_carry_item'] = '0';   // or '' if you really want empty string
                }
                $data['cash_and_carry_item'] = (string)$product->cash_and_carry_item;
                
                // Get Offer Qty
                $getOfferDetails = Offer::with(['offerProducts' => function ($q) use ($pValue) {
                        $q->where('product_id', $pValue);
                    }])
                    ->where('status', 1)
                    ->whereDate('offer_validity_start', '<=', $currentDate)
                    ->whereDate('offer_validity_end', '>=', $currentDate)
                    ->where('id', $offerData->id ?? null)
                    ->first();

                $minQty = optional(optional($getOfferDetails)->offerProducts->first())->min_qty;
                $data['quantity'] = (is_numeric($minQty) && $minQty > 0) ? (int)$minQty : 1;
                
                if ($carts && count($carts) <= 0) {
                    Cart::create($data);
                }elseif($carts[0]->quantity < $getOfferDetails->offerProducts[0]->min_qty){
                    Cart::where('id',$carts[0]->id)->where('is_manager_41', '0')->update(['quantity'=> $getOfferDetails->offerProducts[0]->min_qty]);
                }
            }
            // echo $offerData->id; die;
            // pass $offerData->id to applyOffer by merging into the Request
            $request->merge(['offer_id' => $offerData->id]);
            $result = $this->applyOffer($request);
            
            $carts   = Cart::where('user_id', auth()->user()->id)->orWhere('customer_id',auth()->user()->id)->where('is_manager_41', '0')->get();
            $response = ['res' => true, 'msg' => 'Successfully Added Product', 'data' => $carts];
        } catch (\Exception $e) {
            $errorCode = $e->getCode();
            if ($errorCode == 23000) {
                $errorMessage = __("direct link already exists");
            } else {
                $errorMessage = $e->getMessage();//"something went wrong, please try again";
            }
            $response = ['res' => false, 'msg' => $errorMessage, 'data' => $errorCode];
        }        
        return $response;        
    }
    
    public function abandonedCartList(Request $request)
{
    try {
        $searchDate = $request->searchDate;

        $searchManagers = !empty($request->searchManager)
            ? explode(',', $request->searchManager)
            : [];

        $searchCompanyName = !empty($request->searchCompanyName)
            ? explode(',', $request->searchCompanyName)
            : [];

        $searchByText = $request->searchByText;

        $currentUserId = auth()->user()->id;

        // Only these users can see all managers/customers
        $isSuperManager = in_array($currentUserId, [180, 169, 25606, 1]);

        /*
        |--------------------------------------------------------------------------
        | Base Query Filter
        |--------------------------------------------------------------------------
        | Super manager: all users
        | Normal manager: only users whose manager_id = logged in manager id
        */
        $userScope = function ($query) use (
            $isSuperManager,
            $currentUserId,
            $searchManagers,
            $searchCompanyName,
            $searchByText
        ) {
            if (!$isSuperManager) {
                $query->where('manager_id', $currentUserId);
            }

            // Super manager can filter by manager
            if ($isSuperManager && !empty($searchManagers)) {
                $query->whereIn('manager_id', $searchManagers);
            }

            if (!empty($searchCompanyName)) {
                $query->whereIn('company_name', $searchCompanyName);
            }

            if (!empty($searchByText)) {
                $term = '%' . $searchByText . '%';

                $query->where(function ($q) use ($term) {
                    $q->where('company_name', 'LIKE', $term)
                        ->orWhere('party_code', 'LIKE', $term);
                });
            }
        };

        /*
        |--------------------------------------------------------------------------
        | Total Cart Value
        |--------------------------------------------------------------------------
        */
        $allUsersWithCarts = User::query()
            ->where($userScope)
            ->whereHas('carts', function ($q) use ($searchDate) {
                $q->where('is_manager_41', 0);

                if (!empty($searchDate)) {
                    $q->whereDate('created_at', $searchDate);
                }
            })
            ->with(['carts' => function ($q) use ($searchDate) {
                $q->where('is_manager_41', 0);

                if (!empty($searchDate)) {
                    $q->whereDate('created_at', $searchDate);
                }
            }])
            ->get();

        $totalCartValue = $allUsersWithCarts->flatMap->carts->sum(function ($cart) {
            return (float) $cart->price * (float) $cart->quantity;
        });

        /*
        |--------------------------------------------------------------------------
        | Paginated Abandoned Cart List
        |--------------------------------------------------------------------------
        */
        $abandonedCart = User::query()
            ->where($userScope)
            ->whereHas('carts', function ($query) use ($searchDate) {
                $query->where('is_manager_41', 0);

                if (!empty($searchDate)) {
                    $query->whereDate('created_at', $searchDate);
                }
            })
            ->with([
                'carts' => function ($query) use ($searchDate) {
                    $query->where('is_manager_41', 0);

                    if (!empty($searchDate)) {
                        $query->whereDate('created_at', $searchDate);
                    }

                    $query->orderBy('created_at', 'desc')
                        ->with('product');
                }
            ])
            ->withMax(['carts' => function ($query) use ($searchDate) {
                $query->where('is_manager_41', 0);

                if (!empty($searchDate)) {
                    $query->whereDate('created_at', $searchDate);
                }
            }], 'created_at')
            ->orderByDesc('carts_max_created_at')
            ->paginate(15);

        $response = [
            'res' => true,
            'msg' => 'Successfully Get List',
            'totalCartValue' => $totalCartValue,
            'data' => $abandonedCart,
        ];

    } catch (\Exception $e) {
        $errorCode = $e->getCode();

        if ($errorCode == 23000) {
            $errorMessage = __("direct link already exists");
        } else {
            $errorMessage = $e->getMessage();
        }

        $response = [
            'res' => false,
            'msg' => $errorMessage,
            'data' => $errorCode,
        ];
    }

    return $response;
}
    
