                    $mCoinRecord->save();
                }

                /*
                |--------------------------------------------------------------------------
                | Reduce Payable Amount
                |--------------------------------------------------------------------------
                */
                $payableAmount = $payableAmount - number_format(
                    (float) $appliedMCoin->coins / (float) config('app.m_coin_redeem_point'),
                    2
                );

                $appliedMCoin->delete();
            }

            // Payment section 
            // if(auth()->user()->id == '24185'){
            //     $payableAmount = 1;
            // }
            $response = $this->iciciPaymentQrCodeGenerater($payableAmount,$order->code);
            $responseData = json_decode($response->getContent(), true);
            $qrCodeUrl = $responseData['qrCodeUrl'];
            $qrmerchantTranId = $responseData['merchantTranId'];
            
            // --------------- When need it will correct and open . this generate payment page url form website -----------------------
            // $fileName = "";
            // $button_variable_encode_part = "";
            // $payment_url = "";
            // if($qrCodeUrl != ""){
            //     $payment_url=$this->generatePaymentUrl($order->code, "payable_amount");
            //     // Extract the part after 'pay-amount/'
            //     $fileName = substr($payment_url, strpos($payment_url, "pay-amount/") + strlen("pay-amount/"));
            //     $button_variable_encode_part=$fileName;
            // }
            // echo $payment_url; print_r($responseData); die;
            // --------------------------------------------------------------------------------------------------------------------------


            // the below tab code need to implement.
            $first_order=$combined_order->orders->first();
            $user = User::where('id',  $first_order->user_id)->first();
                    
            $manager_phone_number = User::where('id', $user->manager_id)->pluck('phone')->first();   
            $to =[json_decode($first_order->shipping_address)->phone,"+919709555576",$manager_phone_number,'+919930791952','+919730377752','+91989475372'];
            // $to =[""];
            $client_address = Address::where('id', $first_order->address_id)->first();
            $company_name = $client_address->company_name;//json_decode($first_order->shipping_address)->company_name;
            $order_id = $first_order->code;
            $date = date('d-m-Y H:i A', $first_order->date);

            $conveince_fee = 0;
            $total_amount = $first_order->grand_total;
            if($first_order->conveince_fee_percentage != null){
              $total_amount += $conveince_fee = ($first_order->grand_total * $first_order->conveince_fee_percentage)/100;
            }

            $file_url=$this->invoice_file_path($first_order->id);
            $order_data = Order::with('orderDetails.product')->where('id',$first_order->id)->first();
            $order_address = Address::where('id', $order->address_id)->first();
            //Whatsapp code Start
            $file_name="Order-".$order_id;
            $templateData = [
                'name' => 'utility_order_template',
                'language' => 'en_US', 
                'components' => [
                    [
                    'type' => 'header',
                        'parameters' => [
