<?php

namespace Modules\User\Entities;

use Illuminate\Database\Eloquent\Model;

class Address extends Model {
  protected $fillable = ['user_id', 'company_name', 'acc_code', 'gstin', 'address', 'address_2', 'city_id', 'city', 'state_id', 'country_id', 'postal_code', 'phone', 'set_default','due_amount','dueDrOrCr','overdue_amount','overdueDrOrCr','statement_data','avg_payment_days'];

  public function user() {
    return $this->belongsTo(User::class,'user_id','id');
  }

  public function country() {
    return $this->belongsTo(Country::class);
  }

  public function state() {
    return $this->belongsTo(State::class);
  }

  public function stateDetails() {
    return $this->belongsTo(State::class, 'state_id', 'id');
  }

  public function city() {
    return $this->belongsTo(City::class,'city_id');
  }
}
