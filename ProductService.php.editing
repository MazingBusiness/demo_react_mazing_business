    public function offerProducts($request){
        try{
            $currentDate = now();
            // Step 1: Fetch offers with pagination
            $offers = Offer::with('offerProducts.productDetails')
            ->where('status', 1)
            ->whereDate('offer_validity_start', '<=', $currentDate)
            ->whereDate('offer_validity_end', '>=', $currentDate)
            ->paginate(10); // Paginate with 10 items per page

            $offerCollection = $offers->getCollection();

            $normalizeIds = function ($value) {
                if (empty($value)) {
                    return [];
                }

                if (is_array($value)) {
                    return array_values(array_filter($value));
                }

                $value = trim((string) $value);

                if ($value === '') {
                    return [];
                }

                $decoded = json_decode($value, true);
                if (json_last_error() === JSON_ERROR_NONE && is_array($decoded)) {
                    return array_values(array_filter($decoded));
                }

                return array_values(array_filter(explode(',', $value)));
            };

            $offerLookup = $offerCollection->keyBy('id');

            $bannerIds = $offerCollection
                ->pluck('offer_banner')
                ->filter(function ($bannerId) {
                    return trim((string) $bannerId) !== '' && ctype_digit(trim((string) $bannerId));
                })
                ->map(function ($bannerId) {
                    return (int) $bannerId;
                })
                ->unique()
                ->values();

            $bannerImages = Upload::whereIn('id', $bannerIds)
                ->select('id', 'file_name')
                ->get()
                ->mapWithKeys(function ($image) {
                    return [$image->id => 'https://mazingbusiness.com/public/' . $image->file_name];
                });

            $categoryIds = $offerCollection
                ->flatMap(function ($offer) use ($normalizeIds) {
                    return $normalizeIds($offer->category_id ?? []);
                })
                ->filter()
                ->unique()
                ->values();

            $brandIds = $offerCollection
                ->flatMap(function ($offer) use ($normalizeIds) {
                    return $normalizeIds($offer->brand_id ?? []);
                })
                ->filter()
                ->unique()
                ->values();

            $categories = Category::whereIn('id', $categoryIds)->get()->keyBy('id');
            $brands = Brand::whereIn('id', $brandIds)->get()->keyBy('id');

            // Step 2: Flatten the offerProducts collection for each offer
            $offerProducts = $offers->getCollection()->flatMap->offerProducts;

            // Step 3: Transform data (process images)
            $offerProducts->transform(function ($product) use ($offerLookup, $bannerImages, $categories, $brands, $normalizeIds) {
                $offer = $offerLookup->get($product->offer_id ?? null);

                $bannerId = $offer ? trim((string) ($offer->offer_banner ?? '')) : '';
                $product->banner_image = $bannerId !== '' && ctype_digit($bannerId)
                    ? ($bannerImages->get((int) $bannerId) ?? null)
                    : null;

                $offerCategoryIds = $offer ? $normalizeIds($offer->category_id ?? []) : [];
                $product->category_details = collect($offerCategoryIds)
                    ->map(function ($categoryId) use ($categories) {
                        return $categories->get($categoryId);
                    })
                    ->filter()
                    ->values();

                $offerBrandIds = $offer ? $normalizeIds($offer->brand_id ?? []) : [];
                $product->brand_details = collect($offerBrandIds)
                    ->map(function ($brandId) use ($brands) {
                        return $brands->get($brandId);
                    })
                    ->filter()
                    ->values();

                // Process images (if multiple image IDs exist)
                $photoIds = explode(',', $product->productDetails->photos ?? '');
                if (!empty(array_filter($photoIds))) {
                    $product->productDetails->images = Upload::whereIn('id', $photoIds)
                        ->select('id', 'file_name')
                        ->get()
                        ->map(function ($image) {
                            $image->file_name = 'https://mazingbusiness.com/public/' . $image->file_name;
                            return $image;
                        });
                } else {
                    $product->productDetails->images = collect(); // Return an empty collection if no images exist
                }
                return $product;
            });

            // Step 4: Replace the paginated collection with the transformed data
            $offers->setCollection($offerProducts);
            $response =['res' => true, 'offers_product' => $offers];
        } catch (Exception $e) {
            $errorCode = $e->getCode();
            if ($errorCode == 23000) {
                $errorMessage = __("direct link already exists");
            } else {
                $errorMessage = $e->getMessage();//"something went wrong, please try again";
            }
            $response = ['res' => false, 'msg' => $errorMessage, 'data' => $errorCode];
        }
        return $response;
    }
    /**
     * Get Products with Filter.
     *
     * @param $request
     * @return array
     */
    public function products($request)
    {
        try {

            // Clone the query before pagination to get min and max MRP correctly
            $min_mrp = Product::where('current_stock', '>', '0')
            ->where('is_reward_product', '0')
            ->whereRaw('mrp REGEXP "^[0-9]+$"') // Ensures only numeric values are considered
            ->selectRaw('MIN(CAST(mrp AS UNSIGNED)) as min_mrp');
            // Categories group filter
            if (!empty($request['cat_groups'])) {
                $selected_cat_groups = explode(',', $request['cat_groups']);
                $min_mrp = $min_mrp->whereIn('group_id', $selected_cat_groups);
            }
            // Categories filter
            if (!empty($request['categories'])) {
                $selected_categories = explode(',', $request['categories']);
                $min_mrp = $min_mrp->whereIn('category_id', $selected_categories);
            }
            // Brands filter
            if (!empty($request['brands'])) {
                $selected_brands = explode(',', $request['brands']);
                $min_mrp = $min_mrp->whereIn('brand_id', $selected_brands);
            }
            // Search filter
            if (!empty($request['search_text'])) {
                $min_mrp->where('name','like', '%'.$request['search_text'].'%')
                        ->orWhere('part_no','like', '%'.$request['search_text'].'%');
            }
            $min_mrp = $min_mrp->value('min_mrp');

            $max_mrp = Product::where('current_stock', '>', '0')
            ->where('is_reward_product', '0')
            ->whereRaw('mrp REGEXP "^[0-9]+$"') // Ensures only numeric values are considered
            ->selectRaw('MAX(CAST(mrp AS UNSIGNED)) as max_mrp');
            // Categories group filter
            if (!empty($request['cat_groups'])) {
                $selected_cat_groups = explode(',', $request['cat_groups']);
                $max_mrp = $max_mrp->whereIn('group_id', $selected_cat_groups);
            }
            // Categories filter
            if (!empty($request['categories'])) {
                $selected_categories = explode(',', $request['categories']);
                $max_mrp = $max_mrp->whereIn('category_id', $selected_categories);
            }
            // Brands filter
            if (!empty($request['brands'])) {
                $selected_brands = explode(',', $request['brands']);
                $max_mrp = $max_mrp->whereIn('brand_id', $selected_brands);
            }
            // Search filter
            if (!empty($request['search_text'])) {
                $max_mrp->where('name','like', '%'.$request['search_text'].'%')
                        ->orWhere('part_no','like', '%'.$request['search_text'].'%');
            }
            $max_mrp = $max_mrp->value('max_mrp');

            $getData = Product::with(['categoryGroup:id,name', 'category:id,name', 'thumb_img:id,file_name', 'reviews:id,product_id,rating,comment'])
                ->select('id', 'part_no', 'thumbnail_img', 'photos', 'billing_name', 'name', 'slug', 'mrp', 'cash_and_carry_item', 'group_id', 'category_id', 'is_warranty', 'warranty_duration', 'c_m_coin', 'c_instock_m_coin', 'm_m_coin', 'm_instock_m_coin')
                ->where('is_reward_product', '0')
                ->where('current_stock', '>', '0');
            // Categories group filter
            if (!empty($request['cat_groups'])) {
                $selected_cat_groups = explode(',', $request['cat_groups']);
                $getData = $getData->whereIn('group_id', $selected_cat_groups);
            }
            // Categories filter
            if (!empty($request['categories'])) {
                $selected_categories = explode(',', $request['categories']);
                $getData = $getData->whereIn('category_id', $selected_categories);
            }
            // Brands filter
            if (!empty($request['brands'])) {
                $selected_brands = explode(',', $request['brands']);
                $getData = $getData->whereIn('brand_id', $selected_brands);
            }
            // Brands filter
            // if (!empty($request['search_text'])) {
            //     $getData->where('name','like', '%'.$request['search_text'].'%')
            //             ->orWhere('part_no','like', '%'.$request['search_text'].'%');
            // }

            // Apply price range filter
            if (!empty($request['min_price']) && !empty($request['max_price'])) {
                $getData = $getData->whereRaw("CAST(mrp AS UNSIGNED) BETWEEN ? AND ?", [$request['min_price'], $request['max_price']]);
            }

            if (!empty($request['location_id'])) {
                $getData = $getData->whereHas('productWarehouses', function ($query) use ($request) {
                    $query->where('warehouse_id', $request['location_id'])
                          ->where('qty', '>', 0); // Ensure stock is available
                });
            }

            // Filter by Inhouse Product
            if (!empty($request['inhouse_product'])) {
                if ($request['inhouse_product'] == 1) {
                    $getData = $getData->whereHas('productsApi');
                } else {
                    $getData = $getData->doesntHave('productsApi');
                }
            }

            $getData = $getData->orderByRaw("FIELD(group_id, 8, 1) DESC, group_id ASC")
                    ->orderByRaw("category_id ASC") // Sort by category_id after group_id
                    ->orderByRaw("CASE WHEN name LIKE '%opel%' THEN 0 ELSE 1 END")
                    ->orderByRaw("CASE  WHEN products.name LIKE '%opel%' THEN 0 WHEN products.part_no COLLATE utf8mb3_general_ci IN (SELECT part_no COLLATE utf8mb3_general_ci FROM products_api ) THEN 1 ELSE 2 END")
                    ->orderByRaw("CAST(products.mrp AS UNSIGNED) ASC");
                    
            if (!empty($request['search_text'])) {
                $searchText = $request['search_text'];
                $getData = $getData->where(function ($query) use ($searchText) {
                    $query->where('name', 'like', "%{$searchText}%")
                        ->orWhere('part_no', 'like', "%{$searchText}%");
                });
            }
            // Paginate the results
            $getData = $getData->paginate(15);

            $getData->getCollection()->transform(function ($product) use ($request) {
                // Process thumb_img
                if ($product->thumb_img && $product->thumb_img->file_name) {
                    $product->thumb_img->file_name = 'https://mazingbusiness.com/public/' . $product->thumb_img->file_name;
                }

                // Process images
                $photoIds = explode(',', $product->photos);
                $product->images = Upload::whereIn('id', $photoIds)
                    ->select('id', 'file_name')
                    ->get()
                    ->map(function ($image) {
                        $image->file_name = 'https://mazingbusiness.com/public/' . $image->file_name;
                        return $image;
                    });

                // Process stocks with warehouse data
                $product->stocks = ProductWarehouse::with('warehouse:id,name') // Load only id and name for warehouse
                    ->where('product_id', $product->id) // Use the current product's id
                    ->where('is_manager_41', '0')
                    ->select('warehouse_id', 'qty') // Select only necessary fields
                    ->get()
                    ->map(function ($stock) {
                        return [
                            'warehouse_id' => $stock->warehouse_id,
                            'warehouse_name' => $stock->warehouse ? $stock->warehouse->name : null,
                            'qty' => $stock->qty,
                        ];
                });

                $product->inhouse_product = ProductsApi::where('part_no', $product->part_no)->where('closing_stock','>', '0')->distinct()->exists() ? 1 : 0;

                // Apply discount if user_id is provided
                if (isset($request['user_id']) && $request['user_id'] != "") {
                    $userData = User::find($request['user_id']);
                    $discount = 20;

                    if ($userData && isset($userData->discount) && $userData->discount != 0) {
                        $discount = $userData->discount;
                    }

                    $price = $product->mrp * ((100 - $discount) / 100);
                    $product->discount_price = $this->price_two_decimel($price);
                    $product->bulk_discount_price = $this->price_two_decimel($product->discount_price - (($product->discount_price * 2) / 100));
                    $price = $price * 131.6 / 100;
                    $product->product_price = $this->price_two_decimel($price);

                    $getWishlist = Wishlist::where('user_id', $request['user_id'])->where('product_id', $product->id)->first();
                    if($getWishlist != NULL){
                        $product->wish_list_flag = 1;
                    }else{
                        $product->wish_list_flag = 0;
                    }

                }
                return $product;
            });
            if (isset($request['user_id']) && $request['user_id'] != "") {
                $getData = $this->addOfferTag($getData,$request['user_id']);
            }
            if (isset($request['user_id']) && $request['user_id'] != "") {
                $userData = User::find($request['user_id']);
                $discount = 20;
                if ($userData && isset($userData->discount) && $userData->discount != 0) {
                    $discount = $userData->discount;
                }
            }

            return ['res' => true, 'msg' => "",'data' => $getData ];
        }catch (\Exception $e) {
            // Log any other exceptions
            \Log::error('An error occurred: ' . $e->getMessage());
            return response()->json([
                'res' => false,
                'msg' => 'An unexpected error occurred.' . $e->getMessage(),
            ], 500);
        }
    }
    
    /**
     * Get min and max price.
     *
     * @param $request
     * @return array
     */
    public function getMinAndMaxPrice($request)
    {
        try {
            // Clone the query before pagination to get min and max MRP correctly
            $min_mrp = Product::where('current_stock', '>', '0')
            ->where('is_reward_product', '0')
            ->whereRaw('mrp REGEXP "^[0-9]+$"') // Ensures only numeric values are considered
            ->selectRaw('MIN(CAST(mrp AS UNSIGNED)) as min_mrp');
            // Categories group filter
            if (!empty($request['cat_groups'])) {
                $selected_cat_groups = explode(',', $request['cat_groups']);
                $min_mrp = $min_mrp->whereIn('group_id', $selected_cat_groups);
            }
            // Categories filter
            if (!empty($request['categories'])) {
                $selected_categories = explode(',', $request['categories']);
                $min_mrp = $min_mrp->whereIn('category_id', $selected_categories);
            }
            // Brands filter
            if (!empty($request['brands'])) {
                $selected_brands = explode(',', $request['brands']);
                $min_mrp = $min_mrp->whereIn('brand_id', $selected_brands);
            }
            // Search filter
            if (!empty($request['search_text'])) {
                $min_mrp->where('name','like', '%'.$request['search_text'].'%')
                        ->orWhere('part_no','like', '%'.$request['search_text'].'%');
            }
            $min_mrp = $min_mrp->value('min_mrp');

            $max_mrp = Product::where('current_stock', '>', '0')->where('is_reward_product', '0')
            ->whereRaw('mrp REGEXP "^[0-9]+$"') // Ensures only numeric values are considered
            ->selectRaw('MAX(CAST(mrp AS UNSIGNED)) as max_mrp');
            // Categories group filter
            if (!empty($request['cat_groups'])) {
                $selected_cat_groups = explode(',', $request['cat_groups']);
                $max_mrp = $max_mrp->whereIn('group_id', $selected_cat_groups);
            }
            // Categories filter
            if (!empty($request['categories'])) {
                $selected_categories = explode(',', $request['categories']);
                $max_mrp = $max_mrp->whereIn('category_id', $selected_categories);
            }
            // Brands filter
            if (!empty($request['brands'])) {
                $selected_brands = explode(',', $request['brands']);
                $max_mrp = $max_mrp->whereIn('brand_id', $selected_brands);
            }
            // Search filter
            if (!empty($request['search_text'])) {
                $max_mrp->where('name','like', '%'.$request['search_text'].'%')
                        ->orWhere('part_no','like', '%'.$request['search_text'].'%');
            }
            $max_mrp = $max_mrp->value('max_mrp');

            return ['res' => true, 'min_mrp' => $min_mrp, 'max_mrp' => $max_mrp ];
        }catch (\Exception $e) {
            // Log any other exceptions
            \Log::error('An error occurred: ' . $e->getMessage());
            return response()->json([
                'res' => false,
                'msg' => 'An unexpected error occurred.' . $e->getMessage(),
            ], 500);
        }
    }



    /**
     * Quick Offer Details.
     *
     * @param $request
     * @return array
     */
    public function offerDetails($request){
        try{
            $currentDate = now();
            $offer = Offer::with('offerProducts')
                ->with('offerProducts')
                ->where('status', 1)
                ->whereDate('offer_validity_start', '<=', $currentDate)
                ->whereDate('offer_validity_end', '>=', $currentDate)
                ->where('offer_id', $request->offer_id)->first();
            $response =['res' => true, 'offers_product' => $offer];
        } catch (Exception $e) {
            $errorCode = $e->getCode();
            if ($errorCode == 23000) {
                $errorMessage = __("direct link already exists");
            } else {
                $errorMessage = $e->getMessage();//"something went wrong, please try again";
            }
            $response = ['res' => false, 'msg' => $errorMessage, 'data' => $errorCode];
        }
        return $response;
    }

    /**
     * Quick Offer Details.
     *
     * @param $request
     * @return array
     */
    public function addToWishList($request){
        try {
            $user = auth()->user();
            $getWishlist = Wishlist::where('user_id', $user->id)->where('product_id', $request->product_id)->first();
            if ($getWishlist == NULL) {
                $data = array();
                $data = [
                    'user_id' => $user->id,
                    'product_id' => $request->product_id
                ];                
                Wishlist::create($data);                
                $response = ['res' => true, 'msg' => 'Successfully added to wishlist'];
            }else{
              $response = ['res' => true, 'msg' => 'Product is already in the wishlist'];
            }
        } catch (Exception $e) {
            $errorCode = $e->getCode();            
            if ($errorCode == 23000) {
                $errorMessage = __("Product is already in the wishlist");
            } else {
                $errorMessage = $e->getMessage();
            }
            $response = ['res' => false, 'msg' => $errorMessage, 'data' => $errorCode];
        }
        return $response;
    }

    /**
     * Quick Offer Details.
     *
     * @param $request
     * @return array
     */
    public function addReview($request)
    {
        try {
            $user = Auth::guard('api')->user() ?? Auth::user();

            if (!$user) {
                return [
                    'res' => false,
                    'msg' => 'Unauthenticated.',
                    'data' => null,
                ];
            }

            $validator = Validator::make(
                $request->all(),
                [
                    'product_id' => 'required|integer|exists:products,id',
                    'rating' => 'required|integer|between:1,5',
                    'comment' => 'required|string|max:1000',
                ],
                [
                    'product_id.required' => 'Product id is required.',
                    'product_id.integer' => 'Product id must be a valid integer.',
                    'product_id.exists' => 'The selected product does not exist.',
                    'rating.required' => 'Rating is required.',
                    'rating.integer' => 'Rating must be a valid integer.',
                    'rating.between' => 'Rating must be between 1 and 5.',
                    'comment.required' => 'Comment is required.',
                    'comment.string' => 'Comment must be valid text.',
                    'comment.max' => 'Comment may not be greater than 1000 characters.',
                ]
            );

            if ($validator->fails()) {
                return [
                    'res' => false,
                    'msg' => $validator->errors()->first(),
                    'data' => null,
                ];
            }

            $validated = $validator->validated();

            $review = Review::create([
                'product_id' => (int) $validated['product_id'],
                'user_id' => (int) $user->id,
                'rating' => (int) $validated['rating'],
                'comment' => trim($validated['comment']),
            ]);

            return [
                'res' => true,
                'msg' => 'Successfully added review',
                'data' => $review,
            ];
        } catch (\Exception $e) {
            \Log::error('AddReview error: ' . $e->getMessage(), [
                'trace' => $e->getTraceAsString(),
            ]);

            return [
                'res' => false,
                'msg' => 'An unexpected error occurred. ' . $e->getMessage(),
                'data' => null,
            ];
        }
    }

    /**
     * Quick Offer Details.
     *
     * @param $request
     * @return array
     */
    public function removeFromWishList($request){
        try {
            $user = auth()->user();
            $getWishlist = Wishlist::where('user_id', $user->id)->where('product_id', $request->product_id)->first();
            if ($getWishlist != NULL) {
                $getWishlist->delete();
                $response = ['res' => true, 'msg' => 'Product removed from wishlist'];
            }else{
              $response = ['res' => true, 'msg' => 'Product didn\'t get in the wishlist'];
            }
        } catch (Exception $e) {
            $errorCode = $e->getCode();            
            if ($errorCode == 23000) {
                $errorMessage = __("Product is already in the wishlist");
            } else {
                $errorMessage = $e->getMessage();
            }
            $response = ['res' => false, 'msg' => $errorMessage, 'data' => $errorCode];
        }
        return $response;
    }

    /**
     * Quick Offer Details.
     *
     * @param $request
     * @return array
     */
    public function wishListProduct($request)
    {
        try {
            $user = auth()->user();
            $getWishlist = Wishlist::where('user_id', $user->id)
                ->whereIn('product_id', Product::select('id')
                    ->where('is_reward_product', '0'))
                ->paginate(15);
            $newCollection = $getWishlist->getCollection()
                ->map(function ($wishlistRow) use ($user) {
                    $productData = Product::with('thumb_img')
                        ->where('id', $wishlistRow->product_id)
                        ->where('is_reward_product', '0')
                        ->first();
                    if (!$productData) return null;
                    if ($productData->thumb_img && $productData->thumb_img->file_name) {
                        $productData->thumb_img->file_name = 'https://mazingbusiness.com/public/' . $productData->thumb_img->file_name;
                    }
                    $photoIds = array_filter(explode(',', (string) $productData->photos));
                    $productData->images = Upload::whereIn('id', $photoIds)
                        ->select('id', 'file_name')
                        ->get()
                        ->map(function ($image) {
                            $image->file_name = 'https://mazingbusiness.com/public/' . $image->file_name;
                            return $image;
                        });
                    $productData->stocks = ProductWarehouse::with('warehouse:id,name')
                        ->where('product_id', $productData->id)
                        ->where('is_manager_41', '0')
                        ->select('warehouse_id', 'qty')
                        ->get()
                        ->map(function ($stock) {
                            return [
                                'warehouse_id'   => $stock->warehouse_id,
                                'warehouse_name' => optional($stock->warehouse)->name,
                                'qty'            => $stock->qty,
                            ];
                        });

                    $inhouse = ProductsApi::where('part_no', $productData->part_no)
                        ->where('closing_stock', '>', 0)
                        ->exists() ? 1 : 0;

                    $productData->fast_delivery_flag = $inhouse;
                    $productData->inhouse_product = $inhouse;
                    $productData->fast_delivery_tag = $inhouse;

                    $discount = (!empty($user->discount) && $user->discount != 0) ? (float) $user->discount : 0;

                    $price = (float) $productData->mrp * ((100 - $discount) / 100);
                    $productData->discount_price = $this->price_two_decimel($price);
                    $productData->bulk_discount_price = $this->price_two_decimel(
                        $productData->discount_price - (($productData->discount_price * 2) / 100)
                    );
                    $price = $price * 131.6 / 100;
                    $productData->product_price = $this->price_two_decimel($price);
                    return $productData;
                })->filter()->values();

            // ✅ IMPORTANT: paginator me new collection set karo
            $getWishlist->setCollection($newCollection);
            $response = ['res' => true, 'data' => $getWishlist];
        } catch (\Exception $e) {
            $errorCode = $e->getCode();
            $errorMessage = ($errorCode == 23000) ? __("Product is already in the wishlist") : $e->getMessage();
            $response = ['res' => false, 'msg' => $errorMessage, 'data' => $errorCode];
        }
        return $response;
    }

    private function addOfferTag($products, $user_id){
        // $user = auth()->user();
        $userDetails = User::with(['get_addresses' => function ($query) {
            $query->where('set_default', 1);
        }])->where('id', $user_id)->first();
        if(!$userDetails || !isset($userDetails->get_addresses[0]->state_id)){
            $userDetails = User::with('get_addresses')->where('id', $user_id)->orderBy('id','ASC')->first();
        }
        $state_id = optional(optional($userDetails)->get_addresses->first())->state_id ?? 0;
        $manager_id = optional($userDetails)->manager_id;
        $currentDate = Carbon::now(); // Get the current date and time

        $productCollection = method_exists($products, 'getCollection')
            ? $products->getCollection()
            : collect($products);

        $productIds = $productCollection->pluck('id')->filter()->unique()->values();

        if ($productIds->isEmpty()) {
            return $products;
        }

        $offersByProductId = collect();

        $offers = Offer::with('offerProducts')
            ->where('status', 1) // Check for offer status
            ->where(function ($query) use ($manager_id) {
                $query->where('manager_id', $manager_id)
                    ->orWhereNull('manager_id');
            })
            ->where(function ($query) use ($state_id) {
                $query->where('state_id', $state_id)
                    ->orWhereNull('state_id');
            })
            ->whereDate('offer_validity_start', '<=', $currentDate) // Start date condition
            ->whereDate('offer_validity_end', '>=', $currentDate) // End date condition
            ->whereHas('offerProducts', function ($query) use ($productIds) {
                $query->whereIn('product_id', $productIds);
            })->get();

        foreach ($offers as $offer) {
            foreach ($offer->offerProducts as $offerProduct) {
                if ($productIds->contains($offerProduct->product_id)) {
                    $offersByProductId->put(
                        $offerProduct->product_id,
                        $offersByProductId->get($offerProduct->product_id, collect())->push($offer)
                    );
                }
            }
        }

        foreach($productCollection as $cKey=>$cValue){
            $productOffers = $offersByProductId->get($cValue->id, collect());
            $cValue->offer = $productOffers->isNotEmpty() ? $productOffers->values() : "";
        }
        return $products;
    }

    /**
     * Get Products with Filter.
     *
     * @param $request
     * @return array
     */
    public function managerProducts($request)
    {
        try {

            // Clone the query before pagination to get min and max MRP correctly
            $min_mrp = Product::where('current_stock', '>', '0')->where('is_reward_product', '0')
            ->whereRaw('mrp REGEXP "^[0-9]+$"') // Ensures only numeric values are considered
            ->selectRaw('MIN(CAST(mrp AS UNSIGNED)) as min_mrp');
            // Categories group filter
            if (!empty($request['cat_groups'])) {
                $selected_cat_groups = explode(',', $request['cat_groups']);
                $min_mrp = $min_mrp->whereIn('group_id', $selected_cat_groups);
            }
            // Categories filter
            if (!empty($request['categories'])) {
                $selected_categories = explode(',', $request['categories']);
                $min_mrp = $min_mrp->whereIn('category_id', $selected_categories);
            }
            // Brands filter
            if (!empty($request['brands'])) {
                $selected_brands = explode(',', $request['brands']);
                $min_mrp = $min_mrp->whereIn('brand_id', $selected_brands);
            }
            // Search filter
            if (!empty($request['search_text'])) {
                $min_mrp->where('name','like', '%'.$request['search_text'].'%')
                        ->orWhere('part_no','like', '%'.$request['search_text'].'%');
            }
            $min_mrp = $min_mrp->value('min_mrp');

            $max_mrp = Product::where('current_stock', '>', '0')->where('is_reward_product', '0')
            ->whereRaw('mrp REGEXP "^[0-9]+$"') // Ensures only numeric values are considered
            ->selectRaw('MAX(CAST(mrp AS UNSIGNED)) as max_mrp');
            // Categories group filter
            if (!empty($request['cat_groups'])) {
                $selected_cat_groups = explode(',', $request['cat_groups']);
                $max_mrp = $max_mrp->whereIn('group_id', $selected_cat_groups);
            }
            // Categories filter
            if (!empty($request['categories'])) {
                $selected_categories = explode(',', $request['categories']);
                $max_mrp = $max_mrp->whereIn('category_id', $selected_categories);
            }
            // Brands filter
            if (!empty($request['brands'])) {
                $selected_brands = explode(',', $request['brands']);
                $max_mrp = $max_mrp->whereIn('brand_id', $selected_brands);
            }
            // Search filter
            if (!empty($request['search_text'])) {
                $max_mrp->where('name','like', '%'.$request['search_text'].'%')
                        ->orWhere('part_no','like', '%'.$request['search_text'].'%');
            }
            $max_mrp = $max_mrp->value('max_mrp');

            $getData = Product::with(['categoryGroup:id,name', 'category:id,name', 'thumb_img:id,file_name', 'reviews:id,product_id,rating,comment'])
                ->select('id', 'part_no', 'thumbnail_img', 'photos', 'billing_name', 'name', 'slug', 'mrp', 'cash_and_carry_item', 'group_id', 'category_id', 'published','approved','featured','seller_id')->where('is_reward_product', '0');
                // ->where('current_stock', '>', '0');
            // Categories group filter
            if (!empty($request['cat_groups'])) {
                $selected_cat_groups = explode(',', $request['cat_groups']);
                $getData = $getData->whereIn('group_id', $selected_cat_groups);
            }
            // Categories filter
            if (!empty($request['categories'])) {
                $selected_categories = explode(',', $request['categories']);
                $getData = $getData->whereIn('category_id', $selected_categories);
            }
            // Brands filter
            if (!empty($request['brands'])) {
                $selected_brands = explode(',', $request['brands']);
                $getData = $getData->whereIn('brand_id', $selected_brands);
            }
            // Seller filter
            if (!empty($request['seller'])) {
                $selected_sellers = explode(',', $request['seller']);
                $getData = $getData->whereIn('seller_id', $selected_sellers);
            }

            // Apply price range filter
            if (!empty($request['min_price']) && !empty($request['max_price'])) {
                $getData = $getData->whereRaw("CAST(mrp AS UNSIGNED) BETWEEN ? AND ?", [$request['min_price'], $request['max_price']]);
            }

            if (!empty($request['location_id'])) {
                $getData = $getData->whereHas('productWarehouses', function ($query) use ($request) {
                    $query->where('warehouse_id', $request['location_id'])
                          ->where('qty', '>', 0); // Ensure stock is available
                });
            }

            // Filter by Inhouse Product
            if (!empty($request['inhouse_product'])) {
                if ($request['inhouse_product'] == 1) {
                    $getData = $getData->whereHas('productsApi');
                } else {
                    $getData = $getData->doesntHave('productsApi');
                }
            }

            $getData = $getData->orderByRaw("FIELD(group_id, 8, 1) DESC, group_id ASC")
                    ->orderByRaw("category_id ASC") // Sort by category_id after group_id
                    ->orderByRaw("CASE WHEN name LIKE '%opel%' THEN 0 ELSE 1 END")
                    ->orderByRaw("CASE  WHEN products.name LIKE '%opel%' THEN 0 WHEN products.part_no COLLATE utf8mb3_general_ci IN (SELECT part_no COLLATE utf8mb3_general_ci FROM products_api ) THEN 1 ELSE 2 END")
                    ->orderByRaw("CAST(products.mrp AS UNSIGNED) ASC");
                    
            if (!empty($request['search_text'])) {
                $searchText = $request['search_text'];
                $getData = $getData->where(function ($query) use ($searchText) {
                    $query->where('name', 'like', "%{$searchText}%")
                        ->orWhere('part_no', 'like', "%{$searchText}%");
                });
            }
            // Paginate the results
            $getData = $getData->paginate(15);

            $getData->getCollection()->transform(function ($product) use ($request) {
                // Process thumb_img
                if ($product->thumb_img && $product->thumb_img->file_name) {
                    $product->thumb_img->file_name = 'https://mazingbusiness.com/public/' . $product->thumb_img->file_name;
                }

                // Process images
                $photoIds = explode(',', $product->photos);
                $product->images = Upload::whereIn('id', $photoIds)
                    ->select('id', 'file_name')
                    ->get()
                    ->map(function ($image) {
                        $image->file_name = 'https://mazingbusiness.com/public/' . $image->file_name;
                        return $image;
                    });

                // Process stocks with warehouse data
                $product->stocks = ProductWarehouse::with('warehouse:id,name') // Load only id and name for warehouse
                    ->where('product_id', $product->id) // Use the current product's id
                    ->where('is_manager_41', '0')
                    ->select('warehouse_id', 'qty') // Select only necessary fields
                    ->get()
                    ->map(function ($stock) {
                        return [
                            'warehouse_id' => $stock->warehouse_id,
                            'warehouse_name' => $stock->warehouse ? $stock->warehouse->name : null,
                            'qty' => $stock->qty,
                        ];
                });

                $product->inhouse_product = ProductsApi::where('part_no', $product->part_no)->where('closing_stock','>', '0')->distinct()->exists() ? 1 : 0;

                // Apply discount if user_id is provided
                if (isset($request['user_id']) && $request['user_id'] != "") {
                    $userData = User::find($request['user_id']);
                    $discount = 20;

                    if ($userData && isset($userData->discount) && $userData->discount != 0) {
                        $discount = $userData->discount;
                    }

                    $price = $product->mrp * ((100 - $discount) / 100);
                    $product->discount_price = $this->price_two_decimel($price);
                    $product->bulk_discount_price = $this->price_two_decimel($product->discount_price - (($product->discount_price * 2) / 100));
                    $price = $price * 131.6 / 100;
                    $product->product_price = $this->price_two_decimel($price);

                    $getWishlist = Wishlist::where('user_id', $request['user_id'])->where('product_id', $product->id)->first();
                    if($getWishlist != NULL){
                        $product->wish_list_flag = 1;
                    }else{
                        $product->wish_list_flag = 0;
                    }

                }
                return $product;
            });
            if (isset($request['user_id']) && $request['user_id'] != "") {
                $getData = $this->addOfferTag($getData,$request['user_id']);
            }
            if (isset($request['user_id']) && $request['user_id'] != "") {
                $userData = User::find($request['user_id']);
                $discount = 20;
                if ($userData && isset($userData->discount) && $userData->discount != 0) {
                    $discount = $userData->discount;
                }
            }

            return ['res' => true, 'msg' => "",'data' => $getData ];
        }catch (\Exception $e) {
            // Log any other exceptions
            \Log::error('An error occurred: ' . $e->getMessage());
            return response()->json([
                'res' => false,
                'msg' => 'An unexpected error occurred.' . $e->getMessage(),
            ], 500);
        }
    }

