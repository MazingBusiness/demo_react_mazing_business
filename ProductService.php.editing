    public function productDetails($request)
    {
        try {
            $product_id = $request['product_id'] ?? '';
            $slug       = $request['slug'] ?? '';

            $attributeVariations = [];
            $selectedValues      = "";
            $getVarientProduct   = "";

            $product = null;

            if (!empty($product_id)) {
                $product = Product::where('id', $product_id)->first();
            } elseif (!empty($slug)) {
                $product = Product::where('slug', $slug)->first();
            }

            if (!$product) {
                return [
                    'res' => false,
                    'msg' => 'Product not found.',
                ];
            }

            $productId = (int) $product->id;

            $makePublicUrl = function ($path) {
                if (!$path) {
                    return $path;
                }

                if (preg_match('/^https?:\/\//i', $path)) {
                    return $path;
                }

                return 'https://mazingbusiness.com/public/' . ltrim($path, '/');
            };

            $userData = null;
            $discount = 20;
            $userId = $request['user_id'] ?? Auth::guard('api')->id() ?? Auth::id();
            $useAliasProductLogic = true;

            if (!empty($userId)) {
                $userData = User::find((int) $userId);

                if ($userData && is_numeric($userData->discount) && (float) $userData->discount > 0) {
                    $discount = (float) $userData->discount;
                }

                if (!$userData) {
                    \Log::warning('Recently viewed product was not saved because the user was not found.', [
                        'user_id' => $userId,
                        'product_id' => $productId,
                    ]);
                }
            }

            if ($userData) {
                try {
                    DB::transaction(function () use ($userId, $productId) {
                        $recentlyViewedProducts = UserRecentlyViewedProduct::where('user_id', (int) $userId)
                            ->orderByDesc('created_at')
                            ->orderByDesc('id')
                            ->lockForUpdate()
                            ->get(['id', 'product_id']);

                        if ($recentlyViewedProducts->contains('product_id', $productId)) {
                            return;
                        }

                        $oldRecordIds = $recentlyViewedProducts
                            ->slice(9)
                            ->pluck('id');

                        if ($oldRecordIds->isNotEmpty()) {
                            UserRecentlyViewedProduct::whereIn('id', $oldRecordIds)->delete();
                        }
                        
                        UserRecentlyViewedProduct::create([
                            'user_id' => (int) $userId,
                            'product_id' => $productId,
                        ]);
                    });
                } catch (\Exception $e) {
                    \Log::warning('Unable to save recently viewed product.', [
                        'user_id' => $userId,
                        'product_id' => $productId,
                        'error' => $e->getMessage(),
                    ]);
                }
            }

            $decorateProductForQuickOrder = function ($product) use ($userId) {
                $inhouse = ProductsApi::where('part_no', $product->part_no)
                    ->where('closing_stock', '>', '0')
                    ->distinct()
                    ->exists() ? 1 : 0;

                $product->original_mrp = (float) preg_replace('/[^\d.]/', '', (string) $product->mrp);
                $product->fast_delivery_flag = $inhouse;
                $product->inhouse_product = $inhouse;
                $product->fast_delivery_tag = $inhouse;

                if (!empty($userId)) {
                    $getWishlist = Wishlist::where('user_id', $userId)
                        ->where('product_id', $product->id)
                        ->first();

                    $product->wish_list_flag = $getWishlist ? 1 : 0;
                }

                return $product;
            };

            $applyDiscount = function ($product) use ($discount, $useAliasProductLogic) {
                $rawMrp = (float) preg_replace('/[^\d.]/', '', (string) $product->mrp);

                $price = $rawMrp * ((100 - $discount) / 100);

                $product->discount = $discount;
                $product->original_mrp = $rawMrp;
                $product->discount_price = $this->price_two_decimel($price);
                $product->bulk_discount_price = $this->price_two_decimel($price - (($price * 2) / 100));

                if (!$useAliasProductLogic) {
                    $finalPrice = $price * 131.6 / 100;
                    $product->product_price = $this->price_two_decimel($finalPrice);
                    $product->mrp = price_less_than_50(convert_price($finalPrice), false);
                }

                return $product;
            };

            $mainProduct = Product::with([
                    'categoryGroup:id,name',
                    'category:id,name',
                    'thumb_img:id,file_name',
                    'reviews' => function ($query) {
                        $query->select(
                                'id',
                                'product_id',
                                'rating',
                                'user_id',
                                'comment'
                            )
                            ->orderByDesc('id');
                    },
                    'reviews.user:id,company_name'
                ])
                ->where('id', $productId)
                ->first();

            if (!$mainProduct) {
                return [
                    'res' => false,
                    'msg' => 'Product not found.',
                ];
            }

            $mainProduct->reviews->each(function ($review) {
                $review->setAttribute(
                    'company_name',
                    optional($review->user)->company_name
                );
                $review->unsetRelation('user');
            });

            /*
            |--------------------------------------------------------------------------
            | Apply Alias Price Logic
            |--------------------------------------------------------------------------
            */
            if ($useAliasProductLogic) {
                $mainProduct = $this->applyAliasProductPriceForCart($mainProduct, (int) $userId);
            }

            if ($mainProduct->thumb_img && $mainProduct->thumb_img->file_name) {
                $mainProduct->thumb_img->file_name = $makePublicUrl($mainProduct->thumb_img->file_name);
            }

            $photoIds = array_filter(explode(',', (string) $mainProduct->photos));

            $mainProduct->images = Upload::whereIn('id', $photoIds)
                ->select('id', 'file_name')
                ->get()
                ->map(function ($image) use ($makePublicUrl) {
                    $image->file_name = $makePublicUrl($image->file_name);
                    return $image;
                });

            $mainProduct->stocks = ProductWarehouse::with('warehouse:id,name')
                ->where('product_id', $productId)
                ->where('is_manager_41', '0')
                ->select('warehouse_id', 'qty')
                ->get()
                ->map(function ($stock) {
                    return [
                        'warehouse_id'   => $stock->warehouse_id,
                        'warehouse_name' => optional($stock->warehouse)->name,
                        'qty'            => $stock->qty,
                    ];
                });

            $getData = collect([$mainProduct]);

            if ($userData) {
                $getData = $getData->map(function ($p) use ($applyDiscount) {
                    return $applyDiscount($p);
                });
            }

            if (
                $getData->isNotEmpty() &&
                (int) $getData->first()->variant_product === 1 &&
                !empty($getData->first()->variation_parent_part_no)
            ) {
                $parentPartNo = $getData->first()->variation_parent_part_no;

                $getVarientProduct = Product::with([
                        'categoryGroup:id,name',
                        'category:id,name',
                        'thumb_img:id,file_name',
                        'reviews:id,product_id,user_id,rating,comment'
                    ])
                    ->where('id', '!=', $productId)
                    ->where('variant_product', '1')
                    ->where('variation_parent_part_no', $parentPartNo)
                    ->where('current_stock', '1')
                    ->where('is_reward_product', '0')
                    ->get()
                    ->map(function ($vp) use ($makePublicUrl, $useAliasProductLogic, $userId, $decorateProductForQuickOrder) {
                        if ($useAliasProductLogic) {
                            $vp = $this->applyAliasProductPriceForCart($vp, (int) $userId);
                        }

                        if ($vp->thumb_img && $vp->thumb_img->file_name) {
                            $vp->thumb_img->file_name = $makePublicUrl($vp->thumb_img->file_name);
                        }

                        $photoIds = array_filter(explode(',', (string) $vp->photos));

                        $vp->images = Upload::whereIn('id', $photoIds)
                            ->select('id', 'file_name')
                            ->get()
                            ->map(function ($image) use ($makePublicUrl) {
                                $image->file_name = $makePublicUrl($image->file_name);
                                return $image;
                            });

                        $vp->stocks = ProductWarehouse::with('warehouse:id,name')
                            ->where('product_id', (int) $vp->id)
                            ->where('is_manager_41', '0')
                            ->select('warehouse_id', 'qty')
                            ->get()
                            ->map(function ($stock) {
                                return [
                                    'warehouse_id'   => $stock->warehouse_id,
                                    'warehouse_name' => optional($stock->warehouse)->name,
                                    'qty'            => $stock->qty,
                                ];
                            });

                        return $decorateProductForQuickOrder($vp);
                    });

                if ($userData) {
                    $getVarientProduct = $getVarientProduct->map(function ($p) use ($applyDiscount) {
                        return $applyDiscount($p);
                    });
                }

                $parentProducts = Product::where('variation_parent_part_no', $parentPartNo)
                    ->where('is_reward_product', '0')
                    ->where('current_stock', '1')
                    ->pluck('variations')
                    ->toArray();

                $allVariationIds = collect($parentProducts)
                    ->flatMap(function ($variations) {
                        $arr = json_decode($variations, true);
                        return is_array($arr) ? $arr : [];
                    })
                    ->unique()
                    ->values()
                    ->toArray();

                $attributeValues = AttributeValue::whereIn('id', $allVariationIds)->get();

                $attributeVariations = Attribute::whereIn('id', $attributeValues->pluck('attribute_id')->unique()->values())
                    ->where('is_variation', 1)
                    ->get()
                    ->map(function ($attribute) use ($attributeValues) {
                        return [
                            'attribute_id'   => $attribute->id,
                            'attribute_name' => $attribute->name,
                            'values'         => $attributeValues
                                ->where('attribute_id', $attribute->id)
                                ->pluck('value', 'id'),
                        ];
                    });

                $selectedValueIds = json_decode($getData->first()->variations, true);
                $selectedValueIds = is_array($selectedValueIds) ? $selectedValueIds : [];

                $selectedValues = $attributeValues
                    ->whereIn('id', $selectedValueIds)
                    ->pluck('id', 'attribute_id');
            }

            $attributes = [];

            $attributeIds = json_decode($getData->first()->attributes ?? '[]', true);
            $attributeIds = is_array($attributeIds) ? $attributeIds : [];

            if (!empty($attributeIds)) {
                $attributes = AttributeValue::with('attribute')
                    ->whereIn('id', $attributeIds)
                    ->get()
                    ->map(function ($attributeValue) {
                        return [
                            'attribute_name'  => $attributeValue->attribute->name ?? null,
                            'attribute_value' => $attributeValue->value,
                        ];
                    });
            }

            if (!empty($userId)) {
                if ($useAliasProductLogic) {
                    product_min_qty_alias_price($getData->first(), $userId);
                } else {
                    product_min_qty($getData->first(), $userId);
                }
                $getData = $this->addOfferTag($getData, $userId);
            }

            $inhouse = ProductsApi::where('part_no', $product->part_no)
                ->where('closing_stock', '>', '0')
                ->distinct()
                ->exists() ? 1 : 0;

            $getData = $getData->map(function ($p) use ($inhouse, $useAliasProductLogic) {
                $p->inhouse_product = $inhouse;
                $p->fast_delivery_tag = $inhouse;

                if ($useAliasProductLogic && (int) ($p->current_stock ?? 0) === 1) {
                    $p->inhouse_product = 1;
                    $p->fast_delivery_tag = 1;
                }

                return $p;
            });

            return [
                'res'                  => true,
                'msg'                  => "",
                'data'                 => $getData,
                'selected_values'      => $selectedValues,
                'product_variations'   => $attributeVariations,
                'all_varient_products' => $getVarientProduct,
                'attributes'           => $attributes
            ];

        } catch (\Exception $e) {
            \Log::error('ProductDetails error: ' . $e->getMessage(), ['trace' => $e->getTraceAsString()]);

            return [
                'res' => false,
                'msg' => 'An unexpected error occurred. ' . $e->getMessage(),
            ];
        }
    }

    public function recentlyViewedProducts($request)
    {
        try {
            $user = Auth::guard('api')->user() ?? Auth::user();

            if (!$user) {
                return [
                    'res' => false,
                    'msg' => 'Unauthenticated.',
                    'data' => [],
                    'count' => 0,
                ];
            }

            $discount = is_numeric($user->discount) && (float) $user->discount > 0
                ? (float) $user->discount
                : 20;

            $makePublicUrl = function ($path) {
                if (!$path) {
                    return $path;
                }

                if (preg_match('/^https?:\/\//i', $path)) {
                    return $path;
                }

                return 'https://mazingbusiness.com/public/' . ltrim($path, '/');
            };

            $recentlyViewedProducts = UserRecentlyViewedProduct::with([
                    'productDetails.categoryGroup:id,name',
                    'productDetails.category:id,name',
                    'productDetails.thumb_img:id,file_name',
                    'productDetails.reviews:id,product_id,user_id,rating,comment',
                ])
                ->where('user_id', (int) $user->id)
                ->orderByDesc('created_at')
                ->orderByDesc('id')
                ->limit(10)
                ->get();

            $products = $recentlyViewedProducts
                ->map(function ($recentlyViewed) use ($user, $makePublicUrl, $discount) {
                    $product = $recentlyViewed->productDetails;

                    if (!$product) {
                        return null;
                    }

                    $product = $this->applyAliasProductPriceForCart(
                        $product,
                        (int) $user->id
                    );

                    $rawMrp = (float) preg_replace(
                        '/[^\d.]/',
                        '',
                        (string) $product->mrp
                    );
                    $discountPrice = $rawMrp * ((100 - $discount) / 100);
                    $bulkDiscountPrice = $discountPrice - (($discountPrice * 2) / 100);

                    $product->discount = $discount;
                    $product->original_mrp = $rawMrp;
                    $product->discount_price = $this->price_two_decimel($discountPrice);
                    $product->bulk_discount_price = $this->price_two_decimel($bulkDiscountPrice);

                    if ($product->thumb_img && $product->thumb_img->file_name) {
                        $product->thumb_img->file_name = $makePublicUrl(
                            $product->thumb_img->file_name
                        );
                    }

                    $photoIds = array_filter(explode(',', (string) $product->photos));
                    $product->images = Upload::whereIn('id', $photoIds)
                        ->select('id', 'file_name')
                        ->get()
                        ->map(function ($image) use ($makePublicUrl) {
                            $image->file_name = $makePublicUrl($image->file_name);
                            return $image;
                        });

                    $product->wish_list_flag = Wishlist::where('user_id', (int) $user->id)
                        ->where('product_id', $product->id)
                        ->exists() ? 1 : 0;

                    $inhouse = ProductsApi::where('part_no', $product->part_no)
                        ->where('closing_stock', '>', '0')
                        ->exists() ? 1 : 0;

                    $product->inhouse_product = $inhouse;
                    $product->fast_delivery_tag = $inhouse;
                    $product->recently_viewed_at = $recentlyViewed->created_at;

                    product_min_qty_alias_price($product, (int) $user->id);

                    return $product;
                })
                ->filter()
                ->values();

            return [
                'res' => true,
                'msg' => '',
                'data' => $products,
                'count' => $products->count(),
            ];
        } catch (\Exception $e) {
            \Log::error('RecentlyViewedProducts error: ' . $e->getMessage(), [
                'trace' => $e->getTraceAsString(),
            ]);

            return [
                'res' => false,
                'msg' => 'An unexpected error occurred. ' . $e->getMessage(),
                'data' => [],
                'count' => 0,
            ];
        }
    }

    public function mostOrderCategoryProducts($request)
    {
        try {
            $user = Auth::guard('api')->user() ?? Auth::user();

            if (!$user) {
                return [
                    'res' => false,
                    'msg' => 'Unauthenticated.',
                    'data' => [],
                    'count' => 0,
                ];
            }

            $categoryId = (int) ($request['category_id'] ?? 0);

            if ($categoryId <= 0) {
                return [
                    'res' => false,
                    'msg' => 'Category id is required.',
                    'data' => [],
                    'count' => 0,
                ];
            }

            if (!Category::whereKey($categoryId)->exists()) {
                return [
                    'res' => false,
                    'msg' => 'Category not found.',
                    'data' => [],
                    'count' => 0,
                ];
            }

            $discount = is_numeric($user->discount) && (float) $user->discount > 0
                ? (float) $user->discount
                : 20;

            $makePublicUrl = function ($path) {
                if (!$path) {
                    return $path;
                }

                if (preg_match('/^https?:\/\//i', $path)) {
                    return $path;
                }

                return 'https://mazingbusiness.com/public/' . ltrim($path, '/');
            };

            /*
             * Find the 20 most-ordered products in the requested category first.
             * The resulting product list is sorted by price below.
             */
            $mostOrderedProducts = OrderDetail::query()
                ->join('products', 'products.id', '=', 'order_details.product_id')
                ->join('categories', 'categories.id', '=', 'products.category_id')
                ->where('categories.id', $categoryId)
                ->where('products.current_stock', 1)
                ->whereNotNull('order_details.product_id')
                ->select('order_details.product_id')
                ->selectRaw(
                    'SUM(COALESCE(order_details.quantity, 0)) as total_ordered_quantity'
                )
                ->groupBy('order_details.product_id')
                ->orderByDesc('total_ordered_quantity')
                ->limit(20)
                ->get();

            if ($mostOrderedProducts->isEmpty()) {
                return [
                    'res' => true,
                    'msg' => '',
                    'data' => [],
                    'count' => 0,
                ];
            }

            $orderedQuantities = $mostOrderedProducts->pluck(
                'total_ordered_quantity',
                'product_id'
            );

            $products = Product::with([
                    'categoryGroup:id,name',
                    'category:id,name',
                    'thumb_img:id,file_name',
                    'reviews:id,product_id,user_id,rating,comment',
                ])
                ->where('category_id', $categoryId)
                ->whereIn('id', $mostOrderedProducts->pluck('product_id'))
                ->get()
                ->map(function ($product) use (
                    $user,
                    $makePublicUrl,
                    $discount,
                    $orderedQuantities
                ) {
                    $product = $this->applyAliasProductPriceForCart(
                        $product,
                        (int) $user->id
                    );

                    $rawMrp = (float) preg_replace(
                        '/[^\d.]/',
                        '',
                        (string) $product->mrp
                    );
                    $discountPrice = $rawMrp * ((100 - $discount) / 100);
                    $bulkDiscountPrice = $discountPrice - (($discountPrice * 2) / 100);

                    $product->discount = $discount;
                    $product->original_mrp = $rawMrp;
                    $product->discount_price = $this->price_two_decimel($discountPrice);
                    $product->bulk_discount_price = $this->price_two_decimel($bulkDiscountPrice);

                    if ($product->thumb_img && $product->thumb_img->file_name) {
                        $product->thumb_img->file_name = $makePublicUrl(
                            $product->thumb_img->file_name
                        );
                    }

                    $photoIds = array_filter(explode(',', (string) $product->photos));
                    $product->images = Upload::whereIn('id', $photoIds)
                        ->select('id', 'file_name')
                        ->get()
                        ->map(function ($image) use ($makePublicUrl) {
                            $image->file_name = $makePublicUrl($image->file_name);
                            return $image;
                        });

                    $product->wish_list_flag = Wishlist::where(
                            'user_id',
                            (int) $user->id
                        )
                        ->where('product_id', $product->id)
                        ->exists() ? 1 : 0;

                    $inhouse = ProductsApi::where('part_no', $product->part_no)
                        ->where('closing_stock', '>', '0')
                        ->exists() ? 1 : 0;

                    $product->inhouse_product = $inhouse;
                    $product->fast_delivery_tag = $inhouse;
                    $product->total_ordered_quantity = (int) (
                        $orderedQuantities->get($product->id) ?? 0
                    );

                    product_min_qty_alias_price($product, (int) $user->id);

                    return $product;
                })
                ->sortBy(function ($product) {
                    return (float) preg_replace(
                        '/[^\d.]/',
                        '',
                        (string) $product->mrp
                    );
                })
                ->values();

            return [
                'res' => true,
                'msg' => '',
                'data' => $products,
                'count' => $products->count(),
            ];
        } catch (\Exception $e) {
            \Log::error('MostOrderCategoryProducts error: ' . $e->getMessage(), [
                'trace' => $e->getTraceAsString(),
            ]);

            return [
                'res' => false,
                'msg' => 'An unexpected error occurred. ' . $e->getMessage(),
                'data' => [],
                'count' => 0,
            ];
        }
    }

