    /**
     * Update Product Qty
     *
     * @param $request
     * @return array
     */
    public function updateProductQty($request){
        try {
            $user = auth()->user();
            $product = Product::find($request->product_id);
            $qty    = (int) $request->quantity;
            $userId = (int) $user->id;
            $useAliasProductLogic = true;
            // Unit price for this qty (your helper should return a numeric)

            if ($useAliasProductLogic) {
                $product = $this->applyAliasProductPriceForCart($product, $userId);

                $discount = 20;
                $userData = User::where('id', $userId)->first();
                if ($userData && is_numeric($userData->discount) && (float) $userData->discount != 0) {
                    $discount = (float) $userData->discount;
                }

                $price = $this->normalizePrice($product->mrp ?? 0) * ((100 - $discount) / 100);
                $price = (float) ceil_price($price);
                $updatedPrice = $price;
            } else {
                $price        = (float) (home_discounted_price($product, false, $userId)['price']);
                $updatedPrice = (float) product_price_with_qty_condition($product, $userId, $qty);
            }
            // Threshold logic
            $target       = (float) env('SPECIAL_DISCOUNT_AMOUNT', 5000);     // e.g. ₹5,000
            $spPercentage = (float) env('SPECIAL_DISCOUNT_PERCENTAGE', 3);    // kept if you use it later
            $subtotal = $price * $qty;
            // $increasePriceText = ($subtotal < $target)
            //     ? "Make product's total value ₹{$target} or more and get normal price."
            //     : "";
            if ($useAliasProductLogic) {
                $product = product_min_qty_alias_price($product, $userId);
            } else {
                $product = product_min_qty($product, $userId);
            }
            $increasePriceText = ($subtotal < $target)
            ? "ALERT : Price increase due to quantity {$qty} pices. For regular price buy {$product->min_qty} or more."
            : "";
            if($subtotal < $target){
                $price = $updatedPrice;
            }

            $response =['res' => true, 'increasePriceText' => $increasePriceText, 'discount_price' => price_less_than_50($price,false), 'sub_total' => price_less_than_50($price*$qty,false)];
        } catch (Exception $e) {
            $errorCode = $e->getCode();            
            $errorMessage = $e->getMessage();
            $response = ['res' => false, 'msg' => $errorMessage, 'data' => $errorCode];
        }
        return $response;
    }

