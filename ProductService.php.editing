    public function genericProducts($request)
    {
        try {
            $productId = (int) ($request['product_id'] ?? 0);

            if ($productId <= 0) {
                return [
                    'res' => false,
                    'msg' => 'Product id is required.',
                    'generic_masters' => [],
                ];
            }

            $makePublicUrl = function ($path) {
                if (!$path) return $path;
                if (preg_match('/^https?:\/\//i', $path)) return $path;
                return 'https://mazingbusiness.com/public/' . ltrim($path, '/');
            };

            $normalizePrice = function ($value) {
                $price = preg_replace('/[^\d.]/', '', (string) $value);
                return is_numeric($price) ? (float) $price : 0;
            };

            $userData = null;
            $discount = 20;
            $userId = $request['user_id'] ?? null;
            $useAliasProductLogic = true;

            if (!empty($userId)) {
                $userData = User::where('id', $userId)->first();

                if ($userData && is_numeric($userData->discount) && (float) $userData->discount > 0) {
                    $discount = (float) $userData->discount;
                }
            }

            $applyDiscount = function ($product) use ($discount, $normalizePrice, $useAliasProductLogic) {
                $rawMrp = $normalizePrice($product->mrp);
                $discountPrice = $rawMrp * ((100 - $discount) / 100);
                $bulkDiscountPrice = $discountPrice - (($discountPrice * 2) / 100);

                $product->discount = $discount;
                $product->original_mrp = $rawMrp;
                $product->discount_price = $this->price_two_decimel($discountPrice);
                $product->bulk_discount_price = $this->price_two_decimel($bulkDiscountPrice);

                if (!$useAliasProductLogic) {
                    $product->product_price = $this->price_two_decimel($discountPrice * 131.6 / 100);
                    $product->mrp = price_less_than_50(convert_price($rawMrp), false);
                }

                return $product;
            };

            $genericMasterIds = DB::table('generic_master_products')
                ->where('product_id', $productId)
                ->pluck('generic_master_id')
                ->unique()
                ->values();

            if ($genericMasterIds->isEmpty()) {
                return [
                    'res' => false,
                    'msg' => 'Generic products not found.',
                    'generic_masters' => [],
                ];
            }

            $genericMasters = GenericMaster::select('id', 'name', 'priority')
                ->whereIn('id', $genericMasterIds)
                ->where('status', 1)
                ->orderBy('priority', 'ASC')
                ->orderBy('id', 'ASC')
                ->get();

            if ($genericMasters->isEmpty()) {
                return [
                    'res' => false,
                    'msg' => 'Generic products not found.',
                    'generic_masters' => [],
                ];
            }

            $genericMasterIds = $genericMasters->pluck('id')->values();

            $genericLinks = GenericMasterLink::select('id', 'generic_master_id', 'name', 'priority')
                ->whereIn('generic_master_id', $genericMasterIds)
                ->where('status', 1)
                ->orderBy('priority', 'ASC')
                ->orderBy('id', 'ASC')
                ->get();

            if ($genericLinks->isEmpty()) {
                return [
                    'res' => false,
                    'msg' => 'Generic products not found.',
                    'generic_masters' => [],
                ];
            }

            $genericLinkIds = $genericLinks->pluck('id')->values();

            $linkProductRows = DB::table('generic_master_link_products')
                ->select('generic_master_id', 'generic_master_link_id', 'product_id')
                ->whereIn('generic_master_id', $genericMasterIds)
                ->whereIn('generic_master_link_id', $genericLinkIds)
                ->get();

            $genericProductIds = $linkProductRows->pluck('product_id')->unique()->values();

            if ($genericProductIds->isEmpty()) {
                return [
                    'res' => false,
                    'msg' => 'Generic products not found.',
                    'generic_masters' => [],
                ];
            }

            $genericProductsQuery = Product::with('thumb_img:id,file_name')
                ->select(
                    'id',
                    'part_no',
                    'thumbnail_img',
                    'photos',
                    'billing_name',
                    'name',
                    'slug',
                    'mrp',
                    'current_stock',
                    'is_warranty',
                    'warranty_duration',
                    'piece_by_carton',
                    'c_instock_m_coin'
                )
                ->whereIn('id', $genericProductIds)
                ->where('is_reward_product', '0')
                ->orderBy('id', 'DESC');

            if (!$useAliasProductLogic) {
                $genericProductsQuery->where('current_stock', '>', 0);
            }

            $genericProducts = $genericProductsQuery->get();

            if ($useAliasProductLogic) {
                $genericProducts = $genericProducts
                    ->map(function ($genericProduct) use ($userId) {
                        return $this->applyAliasProductPriceForCart($genericProduct, (int) $userId);
                    })
                    ->filter(function ($genericProduct) {
                        return (int) ($genericProduct->current_stock ?? 0) === 1;
                    })
                    ->values();
            }

            if ($genericProducts->isEmpty()) {
                return [
                    'res' => false,
                    'msg' => 'Generic products not found.',
                    'generic_masters' => [],
                ];
            }

            $firstPhotoIds = $genericProducts
                ->map(function ($genericProduct) {
                    $photoIds = array_filter(explode(',', (string) $genericProduct->photos));
                    return reset($photoIds) ?: null;
                })
                ->filter()
                ->unique()
                ->values();

            $uploadsById = Upload::whereIn('id', $firstPhotoIds)
                ->select('id', 'file_name')
                ->get()
                ->map(function ($image) use ($makePublicUrl) {
                    $image->file_name = $makePublicUrl($image->file_name);
                    return $image;
                })
                ->keyBy('id');

            $inhousePartNos = ProductsApi::whereIn('part_no', $genericProducts->pluck('part_no')->filter()->unique()->values())
                ->where('closing_stock', '>', '0')
                ->distinct()
                ->pluck('part_no')
                ->flip();

            $preparedGenericProducts = $genericProducts->mapWithKeys(function ($genericProduct) use ($makePublicUrl, $uploadsById, $inhousePartNos, $userData, $applyDiscount, $request, $useAliasProductLogic, $userId) {
                if ($genericProduct->thumb_img && $genericProduct->thumb_img->file_name) {
                    $genericProduct->thumb_img->file_name = $makePublicUrl($genericProduct->thumb_img->file_name);
                }

                if ($userData) {
                    $genericProduct = $applyDiscount($genericProduct);
                }

                if (!empty($userId)) {
                    if ($useAliasProductLogic) {
                        product_min_qty_alias_price($genericProduct, $userId);
                    } else {
                        product_min_qty($genericProduct, $userId);
                    }
                }

                $inhouse = $inhousePartNos->has($genericProduct->part_no) ? 1 : 0;
                if ($useAliasProductLogic && (int) ($genericProduct->current_stock ?? 0) === 1) {
                    $inhouse = 1;
                }
                $photoIds = array_filter(explode(',', (string) $genericProduct->photos));
                $firstPhotoId = reset($photoIds) ?: null;

                return [$genericProduct->id => [
                    'id'                  => $genericProduct->id,
                    'part_no'             => $genericProduct->part_no,
                    'thumbnail_img'       => $genericProduct->thumbnail_img,
                    'thumb_img'           => $genericProduct->thumb_img,
                    'images'              => $firstPhotoId && $uploadsById->has($firstPhotoId) ? [$uploadsById->get($firstPhotoId)] : [],
                    'billing_name'        => $genericProduct->billing_name,
                    'name'                => $genericProduct->name,
                    'slug'                => $genericProduct->slug,
                    'mrp'                 => $genericProduct->mrp,
                    'discount_price'      => $genericProduct->discount_price ?? null,
                    'bulk_discount_price' => $genericProduct->bulk_discount_price ?? null,
                    'product_price'       => $genericProduct->product_price ?? null,
                    'piece_by_carton'     => $genericProduct->piece_by_carton ?? null,
                    'min_qty'             => $genericProduct->min_qty ?? null,
                    'alias_price_part_no' => $genericProduct->alias_price_part_no ?? null,
                    'c_instock_m_coin'    => $genericProduct->c_instock_m_coin ?? 0,
                    'current_stock'       => $genericProduct->current_stock,
                    'is_warranty'         => $genericProduct->is_warranty,
                    'warranty_duration'   => $genericProduct->warranty_duration,
                    'inhouse_product'     => $inhouse,
                    'fast_delivery_tag'   => $inhouse,
                ]];
            });

            $productsByLinkId = $linkProductRows
                ->groupBy('generic_master_link_id')
                ->map(function ($rows) use ($preparedGenericProducts) {
                    return $rows->pluck('product_id')
                        ->unique()
                        ->map(function ($productId) use ($preparedGenericProducts) {
                            return $preparedGenericProducts->get($productId);
                        })
                        ->filter()
                        ->values();
                });

            $linksWithProducts = $genericLinks->map(function ($genericLink) use ($productsByLinkId) {
                $products = $productsByLinkId->get($genericLink->id, collect())->values();

                return [
                    'id'                => $genericLink->id,
                    'generic_master_id' => $genericLink->generic_master_id,
                    'name'              => $genericLink->name,
                    'product_count'     => $products->count(),
                    'products'          => $products,
                ];
            })->filter(function ($link) {
                return $link['product_count'] > 0;
            })->values();

            if ($linksWithProducts->isEmpty()) {
                return [
                    'res' => false,
                    'msg' => 'Generic products not found.',
                    'generic_masters' => [],
                ];
            }

            $linksByMasterId = $linksWithProducts->groupBy('generic_master_id');

            $genericMasters = $genericMasters->map(function ($genericMaster) use ($linksByMasterId) {
                return [
                    'id'            => $genericMaster->id,
                    'name'          => $genericMaster->name,
                    'generic_links' => $linksByMasterId->get($genericMaster->id, collect())->values(),
                ];
            })->filter(function ($genericMaster) {
                return $genericMaster['generic_links']->isNotEmpty();
            })->values();

            if ($genericMasters->isEmpty()) {
                return [
                    'res' => false,
                    'msg' => 'Generic products not found.',
                    'generic_masters' => [],
                ];
            }

            return [
                'res' => true,
                'msg' => '',
                'generic_masters' => $genericMasters,
            ];
        } catch (\Exception $e) {
            \Log::error('An error occurred in genericProducts: ' . $e->getMessage(), [
                'trace' => $e->getTraceAsString(),
            ]);

            return [
                'res' => false,
                'msg' => 'An unexpected error occurred. ' . $e->getMessage(),
                'generic_masters' => [],
            ];
        }
    }

    public function downloadGenericProducts($request)
    {
        try {
            $productId = (int) ($request['product_id'] ?? 0);
            $genericMasterId = (int) ($request['generic_masters_id'] ?? $request['generic_master_id'] ?? 0);
            $genericLinkId = (int) ($request['generic_links_id'] ?? $request['generic_link_id'] ?? 0);
            $userId = $request['user_id'] ?? null;
            $downloadType = strtolower(trim((string) ($request['download_type'] ?? 'generic')));
            $downloadMasterProducts = $downloadType === 'master';
            $useAliasProductLogic = true;

            if (
                $productId <= 0 ||
                $genericMasterId <= 0 ||
                (!$downloadMasterProducts && $genericLinkId <= 0)
            ) {
                return [
                    'res' => false,
                    'msg' => $downloadMasterProducts
                        ? 'product_id and generic_masters_id are required.'
                        : 'product_id, generic_masters_id and generic_links_id are required.',
                    'data' => null,
                ];
            }

            $makePublicUrl = function ($path) {
                if (!$path) {
                    return $path;
                }

                if (preg_match('/^https?:\/\//i', $path)) {
                    return $path;
                }

                return 'https://mazingbusiness.com/public/' . ltrim($path, '/');
            };

            $attachProductImages = function ($product) use ($makePublicUrl) {
                if (!$product) {
                    return $product;
                }

                if ($product->thumb_img && $product->thumb_img->file_name) {
                    $product->thumb_img->file_name = $makePublicUrl($product->thumb_img->file_name);
                }

                $photoIds = array_filter(explode(',', (string) $product->photos));

                $product->images = Upload::whereIn('id', $photoIds)
                    ->select('id', 'file_name')
                    ->get()
                    ->map(function ($image) use ($makePublicUrl) {
                        $image->file_name = $makePublicUrl($image->file_name);
                        return $image;
                    });

                return $product;
            };

            $masterProduct = Product::with([
                    'categoryGroup:id,name',
                    'category:id,name',
                    'thumb_img:id,file_name',
                    'reviews:id,product_id,user_id,rating,comment',
                ])
                ->where('id', $productId)
                ->where('is_reward_product', '0')
                ->first();

            if (!$masterProduct) {
                return [
                    'res' => false,
                    'msg' => 'Master product not found.',
                    'data' => null,
                ];
            }

            if ($useAliasProductLogic) {
                $masterProduct = $this->applyAliasProductPriceForCart($masterProduct, (int) $userId);
            }

            $masterProduct = $attachProductImages($masterProduct);

            $genericMaster = GenericMaster::select('id', 'name', 'priority', 'status')
                ->where('id', $genericMasterId)
                ->where('status', 1)
                ->first();

            if (!$genericMaster) {
                return [
                    'res' => false,
                    'msg' => 'Generic master not found.',
                    'data' => null,
                ];
            }

            $genericLink = null;

            if (!$downloadMasterProducts) {
                $genericLink = GenericMasterLink::select('id', 'generic_master_id', 'name', 'priority', 'status')
                    ->where('id', $genericLinkId)
                    ->where('generic_master_id', $genericMasterId)
                    ->where('status', 1)
                    ->first();

                if (!$genericLink) {
                    return [
                        'res' => false,
                        'msg' => 'Generic link not found.',
                        'data' => null,
                    ];
                }
            }

            if (!$downloadMasterProducts) {
                $masterIsLinked = DB::table('generic_master_products')
                    ->where('product_id', $productId)
                    ->where('generic_master_id', $genericMasterId)
                    ->exists();

                if (!$masterIsLinked) {
                    return [
                        'res' => false,
                        'msg' => 'This product is not linked with the selected generic master.',
                        'data' => null,
                    ];
                }
            }

            $listProductIds = $downloadMasterProducts
                ? DB::table('generic_master_products')
                    ->where('generic_master_id', $genericMasterId)
                    ->pluck('product_id')
                    ->unique()
                    ->values()
                : DB::table('generic_master_link_products')
                    ->where('generic_master_id', $genericMasterId)
                    ->where('generic_master_link_id', $genericLinkId)
                    ->pluck('product_id')
                    ->unique()
                    ->values();

            if ($listProductIds->isEmpty()) {
                return [
                    'res' => false,
                    'msg' => $downloadMasterProducts
                        ? 'Master products not found.'
                        : 'Generic link products not found.',
                    'data' => null,
                ];
            }

            $products = Product::with([
                    'categoryGroup:id,name',
                    'category:id,name',
                    'thumb_img:id,file_name',
                    'reviews:id,product_id,rating,comment',
                ])
                ->whereIn('id', $listProductIds)
                ->where('is_reward_product', '0')
                ->get();

            if ($useAliasProductLogic) {
                $products = $products
                    ->map(function ($product) use ($userId) {
                        return $this->applyAliasProductPriceForCart($product, (int) $userId);
                    })
                    ->filter(function ($product) {
                        return (int) ($product->current_stock ?? 0) === 1;
                    })
                    ->values();
            }

            if ($products->isEmpty()) {
                return [
                    'res' => false,
                    'msg' => $downloadMasterProducts
                        ? 'Master products not found.'
                        : 'Generic link products not found.',
                    'data' => null,
                ];
            }

            $inhousePartNos = ProductsApi::whereIn('part_no', $products->pluck('part_no')->filter()->unique()->values())
                ->where('closing_stock', '>', '0')
                ->distinct()
                ->pluck('part_no')
                ->flip();

            $preparedProducts = $products->mapWithKeys(function ($product) use ($attachProductImages, $inhousePartNos, $useAliasProductLogic, $userId) {
                $product = $attachProductImages($product);

                if (!empty($userId)) {
                    if ($useAliasProductLogic) {
                        product_min_qty_alias_price($product, $userId);
                    } else {
                        product_min_qty($product, $userId);
                    }
                }

                $inhouse = $inhousePartNos->has($product->part_no) ? 1 : 0;
                if ($useAliasProductLogic && (int) ($product->current_stock ?? 0) === 1) {
                    $inhouse = 1;
                }

                $product->inhouse_product = $inhouse;
                $product->fast_delivery_tag = $inhouse;

                return [$product->id => $product];
            });

            $products = $listProductIds
                ->map(function ($productId) use ($preparedProducts) {
                    return $preparedProducts->get($productId);
                })
                ->filter()
                ->values();

            if ($downloadMasterProducts) {
                $genericLink = (object) [
                    'id' => null,
                    'generic_master_id' => $genericMasterId,
                    'name' => 'Master Products',
                    'priority' => 0,
                    'status' => 1,
                ];
            }

            $genericLink->product_count = $products->count();
            $genericLink->products = $products;
            $genericMaster->generic_link = $genericLink;

            $pdfPath = $this->createGenericProductPdf([
                'master_product' => $masterProduct,
                'generic_master' => $genericMaster,
                'generic_link' => $genericLink,
                'products' => $products,
            ]);

            return [
                'res' => true,
                'msg' => '',
                'pdf_link' => $pdfPath,
            ];
        } catch (\Exception $e) {
            \Log::error('An error occurred in downloadGenericProducts: ' . $e->getMessage(), [
                'trace' => $e->getTraceAsString(),
            ]);

            return [
                'res' => false,
                'msg' => 'An unexpected error occurred. ' . $e->getMessage(),
                'data' => null,
            ];
        }
    }


    public function createGenericProductPdf($data)
    {
        $masterProduct = $data['master_product'];
        $genericMaster = $data['generic_master'];
        $genericLink = $data['generic_link'];
        $products = collect($data['products'] ?? []);
        $opelLogoPath = public_path('assets/img/opelLogo.jpg');
        $opelLogo = file_exists($opelLogoPath)
            ? $opelLogoPath
            : 'https://mazingbusiness.com/mazing_business_react/public/assets/img/opelLogo.jpg';
        $watermarkLogo = $opelLogo;

        if (file_exists($opelLogoPath) && function_exists('imagecreatefromjpeg') && function_exists('imagerotate')) {
            $watermarkDirectory = public_path('pdfs/');
            if (!file_exists($watermarkDirectory)) {
                mkdir($watermarkDirectory, 0755, true);
            }

            $watermarkLogoPath = $watermarkDirectory . 'opel_watermark_diagonal.png';
            $sourceImage = imagecreatefromjpeg($opelLogoPath);

            if ($sourceImage) {
                $transparent = imagecolorallocatealpha($sourceImage, 255, 255, 255, 127);
                $rotatedImage = imagerotate($sourceImage, 35, $transparent);
                imagesavealpha($rotatedImage, true);
                imagepng($rotatedImage, $watermarkLogoPath);
                imagedestroy($sourceImage);
                imagedestroy($rotatedImage);
                $watermarkLogo = $watermarkLogoPath;
            }
        }
        $logo = function ($width = '44mm', $className = 'brand-logo-img') use ($opelLogo) {
            return '<img src="' . $opelLogo . '" class="' . $className . '" style="width:' . $width . '; height:auto;" />';
        };

        $mazingLogoPath = public_path('assets/img/mazingLogo.jpg');
        $mazingLogo = file_exists($mazingLogoPath)
            ? $mazingLogoPath
            : 'https://mazingbusiness.com/mazing_business_react/public/assets/img/mazingLogo.jpg';

        $mLogo = function ($width = '44mm', $className = 'brand-logo-img') use ($mazingLogo) {
            return '<img src="' . $mazingLogo . '" class="' . $className . '" style="width:' . $width . '; height:auto;" />';
        };

        $safeText = function ($value) {
            return htmlspecialchars((string) ($value ?? ''), ENT_QUOTES, 'UTF-8');
        };

        $badgeBase = trim((string) ($genericMaster->name ?? $genericLink->name ?? $masterProduct->part_no ?? ''));
        $badgeText = stripos($badgeBase, 'spare parts') !== false
            ? $badgeBase
            : trim($badgeBase . ' SPARE PARTS');

        $imageUrl = function ($product) {
            if (isset($product->images[0]->file_name) && !empty($product->images[0]->file_name)) {
                return $product->images[0]->file_name;
            }

            if (isset($product->thumb_img->file_name) && !empty($product->thumb_img->file_name)) {
                return $product->thumb_img->file_name;
            }

            return null;
        };

        $formatPrice = function ($product) {
            $price = $product->discount_price
                ?? $product->product_price
                ?? $product->mrp
                ?? 0;

            $price = (float) preg_replace('/[^\d.]/', '', (string) $price);

            return $this->price_two_decimel($price);
        };

        $imageHtml = function ($product, $className = 'part-img') use ($imageUrl) {
            $url = $imageUrl($product);

            if (!empty($url)) {
                return '<img src="' . $url . '" class="' . $className . '" />';
            }

            return '<div class="image-placeholder"></div>';
        };

        $masterImage = $imageUrl($masterProduct);
        $masterImageHtml = !empty($masterImage)
            ? '<img src="' . $masterImage . '" class="master-image" />'
            : '<div class="master-image image-placeholder master-placeholder">NO IMAGE</div>';
        $fileName = 'generic_products_' . ($masterProduct->part_no ?: $masterProduct->id) . '_' . date('YmdHis') . '.pdf';
        $fileName = preg_replace('/[^A-Za-z0-9_\-.]/', '_', $fileName);

        $header = '
            <table class="topbar" cellpadding="0" cellspacing="0">
                <tr>
                    <td class="topbar-left badge"><span class="badge">&nbsp;&nbsp;&nbsp;' . $safeText($badgeText ?: 'SPARE PARTS') . '</span></td>
                    <td class="topbar-right">' . $logo() . '</td>
                </tr>
            </table>';

        $footer = '
            <div width="100%" border="0" cellpadding="0" cellspacing="0" style="margin-top:10px;">
                <img src="https://mazingbusiness.com/mazing_business_react/public/assets/img/PDF_Footer.jpg" style="width:100%;" />
            </div>';

        $productCount = $products->count();
        $smallLogo = function () use ($logo) {
                    return $logo('18mm', 'small-logo-img');
                };
        $smallMLogo = function () use ($mLogo) {
                    return $mLogo('18mm', 'small-logo-img');
                };
        $renderProductCell = function ($product) use ($safeText, $imageHtml, $smallLogo, $smallMLogo) {
            if (!$product) {
                return '<td></td>';
            }

            $productLogo = ((string) ($product->brand_id ?? '') === '187')
                ? $smallLogo()
                : $smallMLogo();

            return '<td>
                        <p>&nbsp;</p>
                        <div class="card-head">
                            <span class="small-logo" style="margin-right: 120px !important;">' . $productLogo . '</span>
                            <span class="card-code">' . $safeText($product->part_no) . '</span>
                        </div>
                        <div class="divider"><hr/></div>
                        <div class="part-name">' . $safeText($product->name) . '</div>
                        <div class="img-area" style="text-align: center; vertical-align: middle;" >' . $imageHtml($product) . '</div>
                    </td>';
        };
        

        $html = '
            <style>
                body { font-family: Arial, Helvetica, sans-serif; color: #111; }
                .pdf-body { padding-left: 8mm; padding-right: 8mm; }
                .catalog-title { color: #174e84; font-size: 25px; font-weight: bold; text-align: center; margin: 8px 0 5px; letter-spacing: 0; }
                .catalog-subtitle { color: #444; font-size: 12px; text-align: center; margin-bottom: 12px; }
                .master-photo-wrap { padding: 0 12px; text-align: center; margin-top: -22mm; margin-bottom: -18mm; }
                .master-image { width: 330px; max-height: 245px; object-fit: contain; }
                .master-placeholder { width: 330px; height: 170px; line-height: 170px; margin: 0 auto; }
                .master-name { color: #111; font-size: 17px; font-weight: bold; text-align: center; margin-top: 8px; }
                .master-part { color: #174e84; font-size: 14px; font-weight: bold; text-align: center; margin-top: 4px; }
                .summary-table { border-collapse: collapse; width: 100%; margin: 8px 0 14px; }
                .summary-table td { border: 1px solid #174e84; font-size: 12px; padding: 7px 8px; vertical-align: top; }
                .summary-label { background: #eaf2fb; color: #174e84; font-weight: bold; width: 18%; }
                .section-title { background: #174e84; color: #fff; font-size: 15px; font-weight: bold; padding: 8px 10px; text-align: center; }
                .product-grid { border-collapse: separate; border-spacing: 8px; width: 100%; margin-top: 0; }
                .product-grid td { width: 33.33%; vertical-align: top; }
                .product-card { min-height: 158px; padding: 7px; text-align: center; }
                .product-part { color: #174e84; font-size: 10.5px; font-weight: bold; min-height: 18px; }
                .product-img { width: 104px; max-height: 82px; object-fit: contain; margin: 5px 0; }
                .item-name { font-weight: bold; font-size: 10.5px; line-height: 1.25; color: #111; min-height: 34px; }
                .tag { display: inline-block; margin-top: 4px; padding: 2px 5px; background: #dc3545; color: #fff; font-size: 9px; border-radius: 3px; }
                .brand-logo-img { width: 44mm; height: auto; float: left;}
                .small-logo-img { width: 14mm; height: auto; }
                .topbar { width: 100%; height: 13mm; border-collapse: collapse; table-layout: fixed; }
                .topbar-left { width: 55%; text-align: left; vertical-align: top; }
                .topbar-right { width: 45%; text-align: right; vertical-align: top; white-space: nowrap; }
                .badge { display: inline-block; width: auto; height: 15mm; line-height: 15mm; background: #00B5C8; color: #ffffff; font-size: 5.2mm; font-weight: 400; border-radius: 2.4mm; letter-spacing: 0; white-space: nowrap; text-transform: uppercase; text-align: center; overflow: hidden; }
                .header-logo { text-align: right; }
                .brand-logo-img { width: 44mm; height: auto; }
                .small-logo-img { width: 14mm; height: auto; }
                .card-head { width: 100%; height: 7mm; }
                .card-code { float: right; font-size: 4mm; font-weight: 400; color: #000000; text-align: right; white-space: nowrap; letter-spacing: 0; line-height: 7mm; }
                .divider { height: 2px; color: #000000; clear: both; }
                .part-name { height: 4.8mm; font-size: 3mm; font-weight: 400; color: #000000; text-transform: uppercase; letter-spacing: 0; line-height: 1.15; overflow: hidden; margin-right:50px; }
                .img-area { height: 15.8mm; text-align: center; vertical-align: middle; margin-top: .2mm; line-height: 15.8mm; }
                .part-img { display: inline-block; max-width: 52mm; max-height: 31mm; height: auto; width: auto; vertical-align: middle; }
                .image-placeholder { display: inline-block; width: 34mm; height: 18mm; line-height: 18mm; text-align: center; vertical-align: middle; background: #f0f0f0; border: 1px solid #d0d0d0; color: #777777; font-size: 3mm; font-weight: 700; }
            </style>
            <div class="pdf-body">
                <div class="master-photo-wrap">
                    ' . $masterImageHtml . '
                </div>
                <table class="product-grid" cellpadding="0" cellspacing="0">';
                    $items = $products->values();
                    $columnsPerRow = 4;
                    $rowCount = (int) ceil($items->count() / $columnsPerRow);

                    for ($row = 0; $row < $rowCount; $row++) {
                        $html .= '<tr>';
                        for ($col = 0; $col < $columnsPerRow; $col++) {
                            $html .= $renderProductCell(
                                $items->get(($row * $columnsPerRow) + $col)
                            );
                        }
                        $html .= '</tr>';
                    }

                $html .= '
                </table>
            </div>';

        $mpdf = new \Mpdf\Mpdf([
            'format' => 'A4',
            'margin_left' => 0,
            'margin_right' => 0,
            'margin_top' => 16,
            'margin_bottom' => 45,
            'margin_header' => 0,
            'margin_footer' => 0,
        ]);
        $mpdf->setHTMLHeader($header);
        $mpdf->setHTMLFooter($footer);
        $mpdf->SetWatermarkImage($watermarkLogo, 0.08, [170, 170], 'P');
        $mpdf->showWatermarkImage = true;
        $mpdf->WriteHTML($html);

        $pdfDirectory = public_path('pdfs/');
        if (!file_exists($pdfDirectory)) {
            mkdir($pdfDirectory, 0755, true);
        }

        $mpdf->Output($pdfDirectory . '/' . $fileName, 'F');

        return env('DOWNLOAD_FILE_PATH')
            ? env('DOWNLOAD_FILE_PATH') . 'pdfs/' . $fileName
            : url('pdfs/' . $fileName);
    }
    
    // demo design OK
    public function createGenericProductPdf1($data)
    {
        $masterProduct = $data['master_product'];
        $genericMaster = $data['generic_master'];
        $genericLink = $data['generic_link'];
        $products = collect($data['products'] ?? []);

        $safeText = function ($value) {
            return htmlspecialchars((string) ($value ?? ''), ENT_QUOTES, 'UTF-8');
        };

        $imageUrl = function ($product) {
            if (isset($product->images[0]->file_name) && !empty($product->images[0]->file_name)) {
                return $product->images[0]->file_name;
            }

            if (isset($product->thumb_img->file_name) && !empty($product->thumb_img->file_name)) {
                return $product->thumb_img->file_name;
            }

            return 'https://mazingbusiness.com/public//assets/img/placeholder.jpg';
        };

        $masterImage = $imageUrl($masterProduct);
        $fileName = 'generic_products_' . ($masterProduct->part_no ?: $masterProduct->id) . '_' . date('YmdHis') . '.pdf';
        $fileName = preg_replace('/[^A-Za-z0-9_\-.]/', '_', $fileName);
        // public_html/mazing_business_react/public/assets/img/opelLogo.jpg
        $opelLogoPath = public_path('assets/img/opelLogo.jpg');
        $opelLogo = file_exists($opelLogoPath)
            ? $opelLogoPath
            : 'https://mazingbusiness.com/mazing_business_react/public/assets/img/opelLogo.jpg';
        $qr = "https://mazingbusiness.com/mazing_business_react/public/assets/img/PDF_Footer.jpg";
        

        $logo = function ($width = '44mm', $className = 'brand-logo-img') use ($opelLogo) {
            return '<img src="' . $opelLogo . '" class="' . $className . '" style="width:' . $width . '; height:auto;" />';
        };

        $smallLogo = function () use ($logo) {
            return $logo('18mm', 'small-logo-img');
        };

        $chevrons = '<svg class="chevrons" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" viewBox="0 0 100 100"><polygon points="22,2 46,2 58,10 46,18 22,18 34,10" fill="#00B5C8" opacity="0.13"/><polygon points="40,2 64,2 76,10 64,18 40,18 52,10" fill="#00B5C8" opacity="0.09"/><polygon points="58,2 82,2 94,10 82,18 58,18 70,10" fill="#00B5C8" opacity="0.06"/><polygon points="22,22 46,22 58,30 46,38 22,38 34,30" fill="#00B5C8" opacity="0.13"/><polygon points="40,22 64,22 76,30 64,38 40,38 52,30" fill="#00B5C8" opacity="0.09"/><polygon points="58,22 82,22 94,30 82,38 58,38 70,30" fill="#00B5C8" opacity="0.06"/><polygon points="22,42 46,42 58,50 46,58 22,58 34,50" fill="#00B5C8" opacity="0.13"/><polygon points="40,42 64,42 76,50 64,58 40,58 52,50" fill="#00B5C8" opacity="0.09"/><polygon points="58,42 82,42 94,50 82,58 58,58 70,50" fill="#00B5C8" opacity="0.06"/><polygon points="22,62 46,62 58,70 46,78 22,78 34,70" fill="#00B5C8" opacity="0.13"/><polygon points="40,62 64,62 76,70 64,78 40,78 52,70" fill="#00B5C8" opacity="0.09"/><polygon points="58,62 82,62 94,70 82,78 58,78 70,70" fill="#00B5C8" opacity="0.06"/><polygon points="22,82 46,82 58,90 46,98 22,98 34,90" fill="#00B5C8" opacity="0.13"/><polygon points="40,82 64,82 76,90 64,98 40,98 52,90" fill="#00B5C8" opacity="0.09"/><polygon points="58,82 82,82 94,90 82,98 58,98 70,90" fill="#00B5C8" opacity="0.06"/></svg>';

        $renderProductCell = function ($product) use ($safeText, $imageUrl, $smallLogo) {
            if (!$product) {
                return '<td></td>';
            }

            return '<td style="margin-buttom: 1000px !important;">
                        <p>&nbsp;</p>
                        <div class="card-head">
                            <span class="small-logo" style="margin-right: 120px !important;">' . $smallLogo() . '</span>
                            <span class="card-code">' . $safeText($product->part_no) . '</span>
                        </div>
                        <div class="divider"><hr/></div>
                        <div class="part-name">' . $safeText($product->name) . '</div>
                        <div class="img-area" style="text-align: center; vertical-align: middle;" ><img src="' . $imageUrl($product) . '" class="part-img" /></div>
                        <p>&nbsp;</p>
                    </td>';
        };

        $renderPage = function ($pageProducts, $isLastPage = false) use ($safeText, $masterProduct, $genericMaster, $genericLink, $masterImage, $logo, $chevrons, $qr, $renderProductCell) {
            $badgeBase = trim((string) ($genericMaster->name ?? $genericLink->name ?? $masterProduct->part_no ?? ''));
            $badgeText = stripos($badgeBase, 'spare parts') !== false
                ? $badgeBase
                : trim($badgeBase . ' SPARE PARTS');
            $html = '<div class="page">
                <div class="header">
                    <table class="topbar" cellpadding="0" cellspacing="0">
                        <tr>
                            <td class="topbar-left badge"><span class="badge">&nbsp;&nbsp;&nbsp;' . $safeText($badgeText ?: 'SPARE PARTS') . '</span></td>
                            <td class="topbar-right">' . $logo() . '</td>
                        </tr>
                    </table>
                    <div class="hero">
                        <img src="' . $masterImage . '" class="hero-img" />
                        <div class="master-caption">' . $safeText($masterProduct->name) . '</div>
                    </div>
                </div>
                <div class="grid-wrap">
                    <table class="parts-grid" cellpadding="0" cellspacing="0">';
                        $items = $pageProducts->values();
                        for ($row = 0; $row < 5; $row++) {
                            $html .= '<tr>';
                            for ($col = 0; $col < 4; $col++) {
                                $html .= $renderProductCell($items->get(($row * 3) + $col));
                            }
                            $html .= '</tr>';
                        }

                    $html .= '</table>
                    <p>&nbsp;</p>
                </div>
                <div><img src="' . $qr . '" /></div>
                <div class="footer">
                    <div class="footer-content" style="width:100%">
                        <div style="width:30%">
                            <div class="qr"><img src="' . $qr . '" /></div>
                        </div>
                        <div style="width:70%">
                            <div class="footer-bg">SPARE PARTS</div>
                        <div>
                    </div>                  
                </div>
            </div>';
            return $html . ($isLastPage ? '' : '<pagebreak />');
        };

        $html = '<style>
            @page { size: A4 portrait; margin: 0; }
            body { margin: 0; padding: 0; background: #ffffff; font-family: DejaVu Sans, Arial, sans-serif; color: #2C2C2C; }
            .page { width: 210mm; height: 297mm; position: relative; overflow: hidden; background: #ffffff; }
            .header { height: 103mm; padding: 5.5mm 7mm 0 7mm; position: relative; }
            .topbar { width: 100%; height: 13mm; border-collapse: collapse; table-layout: fixed; }
            .topbar-left { width: 55%; text-align: left; vertical-align: top; }
            .topbar-right { width: 45%; text-align: right; vertical-align: top; white-space: nowrap; }
            .badge { display: inline-block; width: auto; height: 15mm; line-height: 15mm; background: #00B5C8; color: #ffffff; font-size: 5.2mm; font-weight: 400; border-radius: 2.4mm; letter-spacing: 0; white-space: nowrap; text-transform: uppercase; text-align: center; overflow: hidden; }
            .header-logo { text-align: right; }
            .brand-logo-img { width: 44mm; height: auto; }
            .small-logo-img { width: 14mm; height: auto; }
            .hero { height: 84mm; position: relative; text-align: center; clear: both; }
            .hero-img { position: relative; z-index: 2; max-width: 160mm; max-height: 72mm; margin-top: 3mm; }
            .master-caption { position: relative; z-index: 2; color: #555555; font-size: 3.2mm; font-weight: 700; text-transform: uppercase; margin-top: 2mm; }
            .grid-wrap { height: 152mm; position: relative; overflow: hidden; }
            .chevrons { position: absolute; left: 0; top: 0; width: 210mm; height: 152mm; z-index: 0; }
            table.parts-grid { width: 200mm; height: 152mm; margin-left: 5mm; border-collapse: collapse; table-layout: fixed; position: relative; z-index: 2; border: 0; }
            table.parts-grid td { width: 66.66mm; height: 30.4mm; border: 0; padding: 2.2mm 2.8mm 2mm 2.8mm; vertical-align: top; background: rgba(255,255,255,.90); }
            .card-head { width: 100%; height: 7mm; }
            .small-logo { float: left; }
            .card-code { float: right; font-size: 4mm; font-weight: 400; color: #000000; text-align: right; white-space: nowrap; letter-spacing: 0; line-height: 7mm; }
            .divider { height: 2px; color: #000000; clear: both; }
            .part-name { height: 4.8mm; font-size: 3mm; font-weight: 400; color: #000000; text-transform: uppercase; letter-spacing: 0; line-height: 1.15; overflow: hidden; margin-right:50px; }
            .img-area { height: 15.8mm; text-align: center; vertical-align: middle; margin-top: .2mm; line-height: 15.8mm; }
            .part-img { display: inline-block; max-width: 52mm; max-height: 31mm; height: auto; width: auto; vertical-align: middle; }
            .footer { height: 42mm; background: #ffffff; position: relative; overflow: hidden; margin-top: 10px;}
            .footer-bg { position: absolute; left: 8mm; top: 4mm; font-family: Arial Narrow, Arial, sans-serif; font-size: 12mm; font-weight: 900; line-height: 1; letter-spacing: -1px; color: rgba(255,255,255,.22); white-space: nowrap; z-index: 0; }
            .footer-content { position: relative; z-index: 2; padding: 8mm 10mm 2mm 6mm;  }
            .qr { float: left; width: 24mm; height: 24mm; margin-right: 3.5mm; border: .5mm solid rgba(255,255,255,.6); border-radius: 1mm; background: #ffffff; }
            .qr img { width: 100%; height: 100%; }
            .phone-icon { float: left; width: 8mm; height: 10mm; margin: 1mm 2mm 0 0; }
            .cta { float: left; margin: 1mm 2mm 0 0; }
            .cta-title { margin: 0; font-size: 3mm; font-weight: 700; color: #fff; text-transform: uppercase; letter-spacing: .3px; line-height: 1.2; }
            .cta-sub { margin: 1mm 0 1mm 0; font-size: 2mm; font-weight: 400; color: rgba(255,255,255,.85); line-height: 1.3; }
            .play-badge { width: 28mm; height: auto; }
            .website { position: absolute; bottom: 2mm; left: 6mm; font-size: 2.5mm; font-weight: 500; color: #ffffff; z-index: 2; letter-spacing: .2px; }
        </style>';

        $chunks = $products->chunk(15)->values();
        if ($chunks->isEmpty()) {
            $chunks = collect([collect()]);
        }

        foreach ($chunks as $index => $chunk) {
            $html .= $renderPage($chunk, $index === ($chunks->count() - 1));
        }

        $mpdf = new \Mpdf\Mpdf([
            'format' => 'A4',
            'margin_left' => 0,
            'margin_right' => 0,
            'margin_top' => 0,
            'margin_bottom' => 0,
        ]);
        $mpdf->AddPageByArray([
            'size' => 'A4',
            'margin_left' => 0,
            'margin_right' => 0,
            'margin_top' => 0,
            'margin_bottom' => 0,
            'margin_header' => 0,
            'margin_footer' => 0,
        ]);
        $mpdf->WriteHTML($html);

        $pdfDirectory = public_path('pdfs/');
        if (!file_exists($pdfDirectory)) {
            mkdir($pdfDirectory, 0755, true);
        }

        $mpdf->Output($pdfDirectory . '/' . $fileName, 'F');

        return env('DOWNLOAD_FILE_PATH')
            ? env('DOWNLOAD_FILE_PATH') . 'pdfs/' . $fileName
            : url('pdfs/' . $fileName);
    }

    
    
    public function masterProduct($request)
    {
        try {
            $productId = (int) ($request['product_id'] ?? 0);

            if ($productId <= 0) {
                return [
                    'res' => false,
                    'msg' => 'Product id is required.',
                    'generic_masters' => [],
                ];
            }

            $makePublicUrl = function ($path) {
                if (!$path) return $path;
                if (preg_match('/^https?:\/\//i', $path)) return $path;
                return 'https://mazingbusiness.com/public/' . ltrim($path, '/');
            };

            $userData = null;
            $discount = 20;
            $userId = $request['user_id'] ?? null;
            $useAliasProductLogic = true;

            if (!empty($userId)) {
                $userData = User::where('id', $userId)->first();

                if ($userData && is_numeric($userData->discount) && (float) $userData->discount > 0) {
                    $discount = (float) $userData->discount;
                }
            }

            $applyDiscount = function ($product) use ($discount, $useAliasProductLogic) {
                $rawMrp = (float) preg_replace('/[^\d.]/', '', (string) $product->mrp);
                $discountPrice = $rawMrp * ((100 - $discount) / 100);
                $bulkDiscountPrice = $discountPrice - (($discountPrice * 2) / 100);

                $product->discount = $discount;
                $product->original_mrp = $rawMrp;
                $product->discount_price = $this->price_two_decimel($discountPrice);
                $product->bulk_discount_price = $this->price_two_decimel($bulkDiscountPrice);

                if (!$useAliasProductLogic) {
                    $product->product_price = $this->price_two_decimel($discountPrice * 131.6 / 100);
                    $product->mrp = price_less_than_50(convert_price($rawMrp), false);
                }

                return $product;
            };

            // A product may be linked to a master via two tables:
            // - generic_master_products (direct mapping)
            // - generic_master_link_products (link -> products mapping)
            // Collect master ids from both sources so calling with a generic product id works.
            $masterIdsFromProducts = DB::table('generic_master_products')
                ->where('product_id', $productId)
                ->pluck('generic_master_id');

            $masterIdsFromLinks = DB::table('generic_master_link_products')
                ->where('product_id', $productId)
                ->pluck('generic_master_id');

            $genericMasterIds = $masterIdsFromProducts->merge($masterIdsFromLinks)->unique()->values();

            if ($genericMasterIds->isEmpty()) {
                return [
                    'res' => false,
                    'msg' => 'Master product not found.',
                    'generic_masters' => [],
                ];
            }

            $genericMasters = GenericMaster::select(
                    'id',
                    'name',
                    'slug',
                    'description',
                    'matching_keywords',
                    'priority'
                )
                ->whereIn('id', $genericMasterIds)
                ->where('status', 1)
                ->orderBy('priority', 'ASC')
                ->orderBy('id', 'ASC')
                ->get();

            if ($genericMasters->isEmpty()) {
                return [
                    'res' => false,
                    'msg' => 'Master product not found.',
                    'generic_masters' => [],
                ];
            }

            $genericMasterIds = $genericMasters->pluck('id')->values();

            $genericLinks = GenericMasterLink::select(
                    'id',
                    'generic_master_id',
                    'name',
                    'matching_keywords',
                    'direction',
                    'priority'
                )
                ->whereIn('generic_master_id', $genericMasterIds)
                ->where('status', 1)
                ->orderBy('priority', 'ASC')
                ->orderBy('id', 'ASC')
                ->get()
                ->groupBy('generic_master_id');

            $masterProductRows = DB::table('generic_master_products')
                ->select('generic_master_id', 'product_id')
                ->whereIn('generic_master_id', $genericMasterIds)
                ->get()
                ->groupBy('generic_master_id');

            $masterProductIds = $masterProductRows
                ->flatMap(function ($rows) {
                    return $rows->pluck('product_id');
                })
                ->unique()
                ->values();

            $masterProductsQuery = Product::with('thumb_img:id,file_name')
                ->select(
                    'id',
                    'part_no',
                    'alias_primary_part_no',
                    'thumbnail_img',
                    'photos',
                    'billing_name',
                    'name',
                    'slug',
                    'mrp',
                    'current_stock',
                    'seller_stock',
                    'is_reward_product',
                    'is_warranty',
                    'warranty_duration',
                    'piece_by_carton',
                    'c_instock_m_coin'
                )
                ->whereIn('id', $masterProductIds)
                ->where('is_reward_product', '0')
                ->orderBy('id', 'DESC');

            if (!$useAliasProductLogic) {
                $masterProductsQuery->where('current_stock', '>', 0);
            }

            $masterProducts = $masterProductsQuery->get();

            if ($useAliasProductLogic) {
                $masterProducts = $masterProducts
                    ->map(function ($masterProduct) use ($userId) {
                        return $this->applyAliasProductPriceForCart($masterProduct, (int) $userId);
                    })
                    ->filter(function ($masterProduct) {
                        return (int) ($masterProduct->current_stock ?? 0) === 1;
                    })
                    ->values();
            }

            $masterProducts = $masterProducts
                ->map(function ($masterProduct) use ($makePublicUrl, $userData, $applyDiscount, $userId, $useAliasProductLogic) {
                    if ($masterProduct->thumb_img && $masterProduct->thumb_img->file_name) {
                        $masterProduct->thumb_img->file_name = $makePublicUrl($masterProduct->thumb_img->file_name);
                    }

                    if ($userData) {
                        $masterProduct = $applyDiscount($masterProduct);
                    }

                    if (!empty($userId)) {
                        if ($useAliasProductLogic) {
                            product_min_qty_alias_price($masterProduct, $userId);
                        } else {
                            product_min_qty($masterProduct, $userId);
                        }
                    }

                    return $masterProduct;
                })
                ->keyBy('id');

            $genericMasters = $genericMasters->map(function ($genericMaster) use ($genericLinks, $masterProductRows, $masterProducts) {
                $masterProductsForGroup = $masterProductRows->get($genericMaster->id, collect())
                    ->pluck('product_id')
                    ->unique()
                    ->map(function ($productId) use ($masterProducts) {
                        return $masterProducts->get($productId);
                    })
                    ->filter()
                    ->values();

                return [
                    'id' => $genericMaster->id,
                    'name' => $genericMaster->name,
                    'slug' => $genericMaster->slug,
                    'description' => $genericMaster->description,
                    'matching_keywords' => $genericMaster->matching_keywords,
                    'priority' => $genericMaster->priority,
                    'generic_links' => $genericLinks->get($genericMaster->id, collect())->values()->map(function ($link) {
                        return [
                            'id' => $link->id,
                            'generic_master_id' => $link->generic_master_id,
                            'name' => $link->name,
                            'matching_keywords' => $link->matching_keywords,
                            'direction' => $link->direction,
                            'priority' => $link->priority,
                        ];
                    }),
                    'master_products' => $masterProductsForGroup,
                ];
            })->values();

            if ($genericMasters->isEmpty()) {
                return [
                    'res' => false,
                    'msg' => 'Master product not found.',
                    'generic_masters' => [],
                ];
            }

            return [
                'res' => true,
                'msg' => '',
                'generic_masters' => $genericMasters,
            ];
        } catch (\Exception $e) {
            \Log::error('An error occurred in masterProduct: ' . $e->getMessage(), [
                'trace' => $e->getTraceAsString(),
            ]);

            return [
                'res' => false,
                'msg' => 'An unexpected error occurred. ' . $e->getMessage(),
                'generic_masters' => [],
            ];
        }
    }


