    /**
     * Get Gallery Images
     *
     * @param $request
     * @return array
     */
    public function galleryImages($request)
    {
        try {
            $perPage = $request->per_page ?? 20;

            $makePublicUrl = function ($path) {
                if (!$path) return $path;

                if (preg_match('/^https?:\/\//i', $path)) {
                    return $path;
                }

                return 'https://mazingbusiness.com/public/' . ltrim($path, '/');
            };

            $galleryImages = Upload::select('id', 'file_name')
                ->orderBy('id', 'DESC')
                ->paginate($perPage);

            $galleryImages->getCollection()->transform(function ($image) use ($makePublicUrl) {
                $image->file_name = $makePublicUrl($image->file_name);
                return $image;
            });

            $response = [
                'res' => true,
                'images' => $galleryImages->items(),
                'pagination' => [
                    'current_page' => $galleryImages->currentPage(),
                    'last_page'    => $galleryImages->lastPage(),
                    'per_page'     => $galleryImages->perPage(),
                    'total'        => $galleryImages->total(),
                    'next_page_url'=> $galleryImages->nextPageUrl(),
                    'prev_page_url'=> $galleryImages->previousPageUrl(),
                ],
            ];
        } catch (Exception $e) {
            $response = [
                'res' => false,
                'msg' => $e->getMessage(),
                'data' => $e->getCode()
            ];
        }

        return $response;
    }


    public function uploadProductImageFromCamera(Request $request): array
    {
        try {
            $validator = Validator::make($request->all(), [
                'product_id' => 'required|exists:products,id',
                'image_file' => 'required|file|image|mimes:jpg,jpeg,png,webp|max:5120',
            ]);

            if ($validator->fails()) {
                return [
                    'res'  => false,
                    'msg'  => $validator->errors()->first(),
                    'data' => null,
                ];
            }

            $product = Product::find($request->product_id);

            if (!$product) {
                return [
                    'res'  => false,
                    'msg'  => 'Product not found.',
                    'data' => null,
                ];
            }

            $file = $request->file('image_file');

            $extension = strtolower($file->getClientOriginalExtension());

            $safePartNo = Str::slug($product->part_no ?? 'product', '-');

            $fileName = $safePartNo . '_' . time() . '_' . uniqid() . '.' . $extension;

            // Project is inside mazing_business_react,
            // but upload should go to root public/uploads/all
            $uploadPath = base_path('../public/uploads/all');

            if (!file_exists($uploadPath)) {
                mkdir($uploadPath, 0755, true);
            }

            $file->move($uploadPath, $fileName);

            $relativePath = 'uploads/all/' . $fileName;

            $upload = Upload::create([
                'file_original_name' => $product->part_no,
                'file_name'          => $relativePath,
                'user_id'            => Auth::id(),
                'file_size'          => filesize($uploadPath . '/' . $fileName),
                'extension'          => $extension,
                'type'               => 'image',
                'site_name'          => 'MAZING',
            ]);

            return [
                'res' => true,
                'msg' => 'Image uploaded successfully.',
                'data' => [
                    'upload_id' => $upload->id,
                    // 'file_name' => $relativePath,
                    // 'url'       => 'https://mazingbusiness.com/public/' . $relativePath,
                ],
            ];
        } catch (\Exception $e) {
            return [
                'res'  => false,
                'msg'  => $e->getMessage(),
                'data' => null,
            ];
        }
    }

    public function editProductDetails(Request $request): array
    {
        try {
            $validator = Validator::make($request->all(), [
                'product_id' => 'required|exists:products,id',
            ]);

            if ($validator->fails()) {
                return [
                    'res'  => false,
                    'msg'  => $validator->errors()->first(),
                    'data' => null,
                ];
            }

            $product = Product::find($request->product_id);

            if (!$product) {
                return [
                    'res'  => false,
                    'msg'  => 'Product not found.',
                    'data' => null,
                ];
            }

            $fields = [
                'name',
                'thumbnail_img',
                'part_no',
                'hsncode',
                'description',
                'group_id',
                'category_id',
                'brand_id',
                'seller_id',
                'seller_stock',
                'cash_and_carry_item',
            ];

            $insertedOrUpdatedCount = 0;

            foreach ($fields as $field) {
                // insert only submitted and non-empty field
                if (!$request->filled($field)) {
                    continue;
                }

                $currentValue = $product->{$field} ?? null;
                $updatedValue = $request->input($field);

                if ((string) $currentValue !== (string) $updatedValue) {
                    ProductUpdate::updateOrCreate(
                        [
                            'part_no'    => $product->part_no,
                            'field_name' => $field,
                            'status'     => 'pending',
                        ],
                        [
                            'current_value' => $currentValue,
                            'updated_value' => $updatedValue,
                            'user_id'       => Auth::id(),
                        ]
                    );

                    $insertedOrUpdatedCount++;
                }
            }

            return [
                'res' => true,
                'msg' => $insertedOrUpdatedCount > 0
                    ? 'Product update request submitted successfully.'
                    : 'No changes found.',
                'data' => [
                    'inserted_or_updated_count' => $insertedOrUpdatedCount,
                ],
            ];
        } catch (\Exception $e) {
            return [
                'res'  => false,
                'msg'  => $e->getMessage(),
                'data' => null,
            ];
        }
    }


    /**
     * View Products
     *
     * @param $request
     * @return array
     */
    public function viewOffer($request){
        try {
            $currentDate = now();
            $productId = $request->product_id;
            $offers = Offer::with('offerProducts')
                    ->where('status', 1)
                    ->whereDate('offer_validity_start', '<=', $currentDate)
                    ->whereDate('offer_validity_end', '>=', $currentDate)
                    ->whereHas('offerProducts', function ($query) use ($productId) {
                        $query->where('product_id', $productId);
                    })->get();
            $offers = $this->processProducts($offers);
            $response = ['res' => true, 'offers' => $offers];
        } catch (Exception $e) {
            $errorCode = $e->getCode();            
            $errorMessage = $e->getMessage();
            $response = ['res' => false, 'msg' => $errorMessage, 'data' => $errorCode];
        }
        return $response;
    }

    
    /**
     * View Products
     *
     * @param $request
     * @return array
     */
    public function validOffers($request){
        try {
            $currentDate = now();

            // User + state (null-safe)
            $user = User::with(['get_addresses:id,user_id,state_id'])->findOrFail(Auth::id());
            $state_id = optional($user->get_addresses->first())->state_id;

            // Cart grouped by product
            $cartRows = Cart::where(function ($q) {
                    $id = Auth::id();
                    $q->where('user_id', $id)->orWhere('customer_id', $id);
                })
                ->get(['product_id', 'quantity', 'price'])
                ->groupBy('product_id');

            $cartProductIds = $cartRows->keys()->all();
            $cartQuantities = $cartRows->mapWithKeys(fn ($items, $pid) => [$pid => $items->sum('quantity')])->all();
            $cartItemPrice  = $cartRows->mapWithKeys(fn ($items, $pid) => [$pid => $items->first()->price * $items->sum('quantity')])->all();

            $achiveOfferArray = [];

            $BASE = 'https://mazingbusiness.com/public/';

            $offers = Offer::with([
                'offerProducts' => function ($q) {
                    $q->with([
                        'productDetails' => function ($p) {
                            $p->select('id','photos','mrp','category_id'); // add more if needed
                        }
                    ])->select('id','offer_id','product_id','name','min_qty','offer_price','mrp','offer_discount_percent');
                }
            ])
            // ⬇️ keep all columns from offers + computed text column
            ->select('offers.*')
            ->selectRaw("
                CASE CAST(offer_type AS UNSIGNED)
                    WHEN 1 THEN 'Item Wise'
                    WHEN 2 THEN 'Total'
                    WHEN 3 THEN 'Complementary'
                    ELSE 'Unknown'
                END AS offer_type_in_text
            ")
            ->where('status', 1)
            ->where(function ($q) use ($user) {
                $q->where('manager_id', $user->manager_id)->orWhereNull('manager_id');
            })
            ->when($state_id, function ($q) use ($state_id) {
                $q->where(function ($q2) use ($state_id) {
                    $q2->where('state_id', $state_id)->orWhereNull('state_id');
                });
            })
            ->whereDate('offer_validity_start', '<=', $currentDate)
            ->whereDate('offer_validity_end', '>=', $currentDate)
            ->get()
            ->map(function ($offer) use ($cartProductIds, $cartQuantities, $cartItemPrice, &$achiveOfferArray, $BASE) {

                $bannerId = trim((string) ($offer->offer_banner ?? ''));
                if ($bannerId !== '' && ctype_digit($bannerId)) {
                    // try to fetch the upload by id
                    $upload = Upload::select('file_name')->find((int) $bannerId);
                    if ($upload) {
                        // convert to absolute URL like product images
                        $offer->offer_banner = $BASE . $upload->file_name;
                    }
                }

                $perProductAchieve = [];

                // --- existing usage/offer logic (unchanged) ---
                $userUsed  = Order::where('user_id', Auth::id())->where('applied_offer_id', $offer->id)->count();
                $offerUsed = Order::where('applied_offer_id', $offer->id)->count();
                $validOfferFlag = ($userUsed < ($offer->per_user ?? PHP_INT_MAX))
                            && ($offerUsed < ($offer->max_uses ?? PHP_INT_MAX));

                $offerProductNames = $offer->offerProducts->pluck('name', 'product_id')->toArray();
                $minQtyByProduct   = $offer->offerProducts->pluck('min_qty', 'product_id')->toArray();

                if ($validOfferFlag) {
                    if ((int) $offer->offer_type === 1) {
                        foreach ($minQtyByProduct as $productId => $minQty) {
                            if (in_array($productId, $cartProductIds, true)) {
                                $needQty = max(0, (int) $minQty - (int) ($cartQuantities[$productId] ?? 0));
                                if ($needQty > 0) {
                                    $name = $offerProductNames[$productId] ?? 'Product';
                                    $msg  = "Add <b>{$needQty}</b> more of {$name} to get OFFER <b>{$offer->offer_name}</b>";
                                    $achiveOfferArray[] = $msg;
                                    $perProductAchieve[$productId] = $msg;
                                }
                            }
                        }
                    } elseif ((int) $offer->offer_type === 2) {
                        $offerValue = (float) ($offer->offer_value ?? 0);
                        if (!empty($minQtyByProduct)) {
                            $offerSubTotal = 0.0;
                            foreach (array_keys($minQtyByProduct) as $productId) {
                                $offerSubTotal += (float) ($cartItemPrice[$productId] ?? 0);
                            }
                            if ($offerSubTotal < $offerValue) {
                                $diff = $offerValue - $offerSubTotal;
                                $msg  = "Add more <b>₹" . number_format($diff, 2, '.', '') . "</b> on "
                                    . implode(', OR ', array_values($offerProductNames))
                                    . " to get OFFER <b>{$offer->offer_name}</b>";
                                $achiveOfferArray[] = $msg;
                                foreach (array_keys($minQtyByProduct) as $pid) {
                                    $perProductAchieve[$pid] = $msg;
                                }
                            }
                        } else {
                            $cartTotal = array_sum($cartItemPrice);
                            if ($cartTotal < $offerValue) {
                                $diff = $offerValue - $cartTotal;
                                $msg  = "Add more <b>₹" . number_format($diff, 2, '.', '') . "</b> to get OFFER <b>{$offer->offer_name}</b>";
                                $achiveOfferArray[] = $msg;
                            }
                        }
                    } elseif ((int) $offer->offer_type === 3) {
                        foreach ($minQtyByProduct as $productId => $minQty) {
                            $have = (int) ($cartQuantities[$productId] ?? 0);
                            $need = max(0, (int) $minQty - $have);
                            if ($need > 0) {
                                $name = $offerProductNames[$productId] ?? 'Product';
                                $msg  = "Add <b>{$need}</b> more of {$name} to get OFFER <b>{$offer->offer_name}</b>";
                                $achiveOfferArray[] = $msg;
                                $perProductAchieve[$productId] = $msg;
                            }
                        }
                    }
                }
                // attach achive_offer + IMAGES per product
                $offer->setRelation('offerProducts', $offer->offerProducts->map(function ($prod) use ($perProductAchieve, $BASE) {
                    $prod->achive_offer = $perProductAchieve[$prod->product_id] ?? null;

                    // ✅ CLONE productDetails so each offer gets its own instance
                    $orig = $prod->productDetails ?? null;
                    $p = $orig ? (clone $orig) : null;

                    if ($p) {
                        // images
                        $ids = collect(explode(',', (string) $p->photos))->filter()->map('intval')->values();
                        $p->images = $ids->isEmpty()
                            ? collect()
                            : Upload::whereIn('id', $ids)
                                ->select('id','file_name')
                                ->get()
                                ->map(function ($img) use ($BASE) {
                                    $img->file_name = $BASE . $img->file_name;
                                    return $img;
                                })->values();

                        // --- pricing (per-offer) ---
                        $userData = User::find(Auth::id());
                        $discount = 20;
                        if ($userData && isset($userData->discount) && $userData->discount != 0) {
                            $discount = $userData->discount;
                        }

                        // base discounted price from product MRP
                        $base = (float) $p->mrp * ((100 - (float) $discount) / 100);
                        $p->base_discount_price = $this->price_two_decimel($base);

                        // read per-offer values from THIS offer product row
                        $offerPctRaw  = data_get($prod, 'offer_discount_percent', 0);
                        $offerPct     = is_numeric($offerPctRaw) ? max(0.0, min(100.0, (float) $offerPctRaw)) : 0.0;
                        $flatOfferRaw = data_get($prod, 'offer_price', 0);
                        $flatOffer    = is_numeric($flatOfferRaw) ? (float) $flatOfferRaw : 0.0;

                        // compute final price (percent stacks on base; flat price overrides if >0)
                        $final = $base;
                        if ($offerPct > 0) {
                            $final = $base * (1 - $offerPct / 100);
                            // $p->offer_discount_price  = $this->price_two_decimel($final);
                            // $p->offer_discount_percent = $offerPct;
                            // $p->offer_discount_amount  = $this->price_two_decimel(max(0, $base - $final));
                        } else {
                            // no extra %: keep fields consistent
                            // $p->offer_discount_percent = 0;
                            // $p->offer_discount_amount  = $this->price_two_decimel(0);
                        }

                        if ($flatOffer > 0) {
                            // Flat price offer (e.g., 3150 each) — override final
                            $final = $flatOffer;
                            // Optional: record how much lower than base it is
                            // $p->flat_offer_price      = $this->price_two_decimel($flatOffer);
                            // $p->offer_discount_amount = $this->price_two_decimel(max(0, $base - $flatOffer));
                        }

                        // set final fields derived from the final price
                        $p->discount_price      = $this->price_two_decimel($final);
                        $p->bulk_discount_price = $this->price_two_decimel($final - (($final * 2) / 100));
                        $p->product_price       = $this->price_two_decimel($final * 131.6 / 100);

                        // ✅ keep the correct offer context inside this cloned product details
                        $p->offer_id = $prod->offer_id;

                        // replace relation with the cloned, per-offer-mutated model
                        $prod->setRelation('productDetails', $p);
                    }

                    return $prod;
                }));
                // print_r($offer->offerProducts);
                // ---- NEW: fill complementary_items for Complementary offers (type = 3) ----
                if ((int)$offer->offer_type === 3) {
                    // we already eager-loaded combinations + product; just shape it
                    $offer->complementary_items = $offer->combinations
                        ->map(function ($c) {
                            $prod = $c->product; // may be null if part_no mismatch
                            return $prod ? [
                                'id'      => (int) $c->id,
                                'part_no' => (string) $prod->part_no,
                                'name'    => (string) $prod->name,
                                'mrp'     => (string) $prod->mrp,
                                'min_qty' => (int) $c->free_product_qty, // alias to match your old select
                            ] : null;
                        })
                        ->filter()  // drop nulls
                        ->values();
                }

                $existingCategoryIds = json_decode((string) ($offer->category_id ?? '[]'), true);
                $existingCategoryIds = is_array($existingCategoryIds)
                    ? collect($existingCategoryIds)->filter()->values()
                    : collect();

                if ($existingCategoryIds->isEmpty()) {
                    $offerCategoryIds = $offer->offerProducts
                        ->map(function ($offerProduct) {
                            return optional($offerProduct->productDetails)->category_id;
                        })
                        ->filter()
                        ->unique()
                        ->values()
                        ->map(function ($categoryId) {
                            return (string) $categoryId;
                        })
                        ->all();

                    $offer->category_id = json_encode($offerCategoryIds);
                }

                return $offer;
            });
            // die;
            return [
                'res'                      => true,
                'offers'                   => $offers,
                'achive_offer_messages'    => $achiveOfferArray,
            ];

        } catch (\Throwable $e) {
            \Log::error('validOffers error: ' . $e->getMessage(), ['trace' => $e->getTraceAsString()]);
            return ['res' => false, 'msg' => $e->getMessage(), 'data' => $e->getCode()];
        }
    }

    public function allMcoinRate($request){
        try{
            $query = Product::select('c_instock_m_coin')->where('current_stock', '>', '0')->where('is_reward_product', '0')
                    ->orderBy('c_instock_m_coin', 'ASC')->groupBy('c_instock_m_coin')->get();
            return [
                'res'                      => true,
                'data'                   => $query,
            ];
        } catch (\Throwable $e) {
            \Log::error('allMcoin error: ' . $e->getMessage(), ['trace' => $e->getTraceAsString()]);
            return ['res' => false, 'msg' => $e->getMessage(), 'data' => $e->getCode()];
        }

    }
    
    private function processProducts($offers) {
        $user_warehouse_id="";
        $user_id="";
        foreach ($offers as $offer) {
            $offerProducts = $offer->offerProducts;
            foreach($offerProducts as $offerProduct){
                if($offerProduct->offer_price == '' OR $offerProduct->offer_price == '0'){
                    $price = $markup = $wmarkup = 0;
                    $user = auth()->user();
                    $discount = 0;
                    if ($user) {
                        $discount = $user->discount;
                    } else {
                        // echo "<script>console.log('User not logged in');</script>";
                    }
                    if(!is_numeric($discount) || $discount == 0) {
                        $discount = 20;
                    }
                    $product_mrp = Product::where('id', $offerProduct->product_id)->select('mrp')->first();
                    
                    $price = $product_mrp->mrp;
                    
                    if (!is_numeric($price)) {
                        $price = 0;
                    }

                    $price = $price * ((100 - $discount) / 100);
                    $offerProduct->offer_price = number_format($price,2,'.','');
                    
                    // $price = $price * 131.6 / 100;
                    // $product->home_base_price = $price;
                }
            }            
        }
        // die;
        return $offers;
    }

}


