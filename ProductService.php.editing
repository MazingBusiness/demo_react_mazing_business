    public function getvariarionProductId(Request $request)
    {
        try {
            $selectedValues = array_filter(explode(',', (string) $request->selected_values), function ($value) {
                return trim((string) $value) !== '';
            });
            $variationParentPartNo = $request->variation_parent_part_no;

            // Convert selected values to integers and sort them
            $selectedIds = array_map('intval', array_values($selectedValues));
            sort($selectedIds);

            $userId = $request['user_id'] ?? null;
            $hasUserId = !empty($userId);

            $makePublicUrl = function ($path) {
                if (!$path) {
                    return $path;
                }

                if (preg_match('/^https?:\/\//i', $path)) {
                    return $path;
                }

                return 'https://mazingbusiness.com/public/' . ltrim($path, '/');
            };

            $userData = null;
            $discount = 20;
            $useAliasProductLogic = true;

            if ($hasUserId) {
                $userData = User::where('id', $userId)->first();

                if ($userData && is_numeric($userData->discount) && (float) $userData->discount > 0) {
                    $discount = (float) $userData->discount;
                }
            }

            $applyDiscount = function ($product) use ($discount, $useAliasProductLogic) {
                $rawMrp = (float) preg_replace('/[^\d.]/', '', (string) $product->mrp);
                $price = $rawMrp * ((100 - $discount) / 100);

                $product->discount = $discount;
                $product->original_mrp = $rawMrp;
                $product->discount_price = $this->price_two_decimel($price);
                $product->bulk_discount_price = $this->price_two_decimel($price - (($price * 2) / 100));

                if (!$useAliasProductLogic) {
                    $finalPrice = $price * 131.6 / 100;
                    $product->product_price = $this->price_two_decimel($finalPrice);
                    $product->mrp = price_less_than_50(convert_price($finalPrice), false);
                }

                return $product;
            };

            // Find all products that match the selected attributes
            $productQuery = Product::query()
                ->whereRaw('JSON_LENGTH(variations) = ?', [count($selectedIds)])
                ->whereRaw('JSON_CONTAINS(variations, ?)', [json_encode($selectedIds)])
                ->where('variation_parent_part_no', $variationParentPartNo)
                ->where('is_reward_product', '0')
                ->where('current_stock', '1');

            if ($hasUserId) {
                $productQuery->with([
                    'categoryGroup:id,name',
                    'category:id,name',
                    'thumb_img:id,file_name',
                    'reviews:id,product_id,rating,comment'
                ]);
            }

            $products = $productQuery->get();

            if ($products->isEmpty()) {
                return [
                    'res' => false,
                    'msg' => 'No matching product found!',
                    'success' => false,
                    'message' => 'No matching product found!',
                    'product_id' => null,
                    'product_ids' => [],
                    'product_details' => [],
                    'data' => null
                ];
            }

            $productIds = $products->pluck('id')->values()->toArray();

            if (!$hasUserId) {
                return [
                    'res' => true,
                    'msg' => '',
                    'success' => true,
                    'message' => 'Successfully get data.',
                    'data' => $products->values(),
                    'product_id' => $products->first()->id,
                    'product_ids' => $productIds,
                    'product_data' => $products->values()
                ];
            }

            $photoIds = $products
                ->flatMap(function ($product) {
                    return array_filter(explode(',', (string) $product->photos));
                })
                ->unique()
                ->values()
                ->toArray();

            $uploads = Upload::whereIn('id', $photoIds)
                ->select('id', 'file_name')
                ->get()
                ->map(function ($image) use ($makePublicUrl) {
                    $image->file_name = $makePublicUrl($image->file_name);
                    return $image;
                })
                ->keyBy('id');

            $stocksByProductId = ProductWarehouse::with('warehouse:id,name')
                ->whereIn('product_id', $productIds)
                ->where('is_manager_41', '0')
                ->select('product_id', 'warehouse_id', 'qty')
                ->get()
                ->groupBy('product_id');

            $fastDeliveryPartNos = ProductsApi::whereIn('part_no', $products->pluck('part_no')->filter()->unique()->values())
                ->where('closing_stock', '>', '0')
                ->pluck('part_no')
                ->flip();

            $wishlistProductIds = collect();
            if (!empty($userId)) {
                $wishlistProductIds = Wishlist::where('user_id', $userId)
                    ->whereIn('product_id', $productIds)
                    ->pluck('product_id')
                    ->flip();
            }

            $productDetails = $products->map(function ($product) use (
                $makePublicUrl,
                $uploads,
                $stocksByProductId,
                $fastDeliveryPartNos,
                $wishlistProductIds,
                $userData,
                $userId,
                $useAliasProductLogic,
                $applyDiscount
            ) {
                if ($useAliasProductLogic) {
                    $product = $this->applyAliasProductPriceForCart($product, (int) $userId);
                }

                if ($product->thumb_img && $product->thumb_img->file_name) {
                    $product->thumb_img->file_name = $makePublicUrl($product->thumb_img->file_name);
                }

                $productPhotoIds = array_filter(explode(',', (string) $product->photos));
                $product->images = collect($productPhotoIds)
                    ->map(function ($photoId) use ($uploads) {
                        return $uploads->get((int) $photoId);
                    })
                    ->filter()
                    ->values();

                $product->stocks = $stocksByProductId
                    ->get($product->id, collect())
                    ->map(function ($stock) {
                        return [
                            'warehouse_id'   => $stock->warehouse_id,
                            'warehouse_name' => optional($stock->warehouse)->name,
                            'qty'            => $stock->qty,
                        ];
                    })
                    ->values();

                if ($userData) {
                    $product = $applyDiscount($product);
                }

                if (!empty($userId)) {
                    if ($useAliasProductLogic) {
                        product_min_qty_alias_price($product, $userId);
                    } else {
                        product_min_qty($product, $userId);
                    }

                    $product->wish_list_flag = $wishlistProductIds->has($product->id) ? 1 : 0;
                }

                $inhouse = $fastDeliveryPartNos->has($product->part_no) ? 1 : 0;
                $product->inhouse_product = $inhouse;
                $product->fast_delivery_tag = $inhouse;

                if ($useAliasProductLogic && (int) ($product->current_stock ?? 0) === 1) {
                    $product->inhouse_product = 1;
                    $product->fast_delivery_tag = 1;
                }

                return $product;
            });

            if (!empty($userId)) {
                $productDetails = $this->addOfferTag($productDetails, $userId);
            }

            return [
                'res' => true,
                'msg' => '',
                'success' => true,
                'message' => 'Successfully get data.',
                'data' => $productDetails->values(),
                'product_id' => $productDetails->first()->id,
                'product_ids' => $productDetails->pluck('id')->values()->toArray(),
                'product_details' => $productDetails->values()
            ];
        }catch (\Exception $e) {
            // Log any other exceptions
            \Log::error('An error occurred: ' . $e->getMessage());
            return ['res' => false,'msg' => 'An unexpected error occurred.' . $e->getMessage()];
        }
    }

    /**
     * Get Category Products.
     *
     * @param $request
     * @return array
     */
    public function categoryProducts($request)
    {
        try {
            $category_id = $request['category_id'];
            // $brand_id = $request['brand_id'];
            $categoryData = Category::with('categoryGroup')->where('id', $category_id)->first();

            // $getData = Product::with(['thumb_img:id,file_name', 'reviews:id,product_id,rating,comment', 'brand:id,name'])
            //     ->where('category_id', $category_id)
            //     ->where('current_stock', '>', '0')
            //     ->select('id', 'part_no', 'thumbnail_img', 'photos', 'billing_name', 'name', 'slug', 'mrp', 'cash_and_carry_item', 'brand_id');
            // $getData = $getData->orderByRaw("FIELD(group_id, 8, 1) DESC, group_id ASC")
            //     ->orderByRaw("category_id ASC") // Sort by category_id after group_id
            //     ->orderByRaw("CASE WHEN name LIKE '%opel%' THEN 0 ELSE 1 END")
            //     ->orderByRaw("CASE  WHEN products.name LIKE '%opel%' THEN 0 WHEN products.part_no COLLATE utf8mb3_general_ci IN (SELECT part_no COLLATE utf8mb3_general_ci FROM products_api ) THEN 1 ELSE 2 END")
            //     ->orderByRaw("CAST(products.mrp AS UNSIGNED) ASC");
            // $getData = $getData->paginate(16);

            // Step 1: Base query
            $baseQuery = Product::with(['thumb_img:id,file_name', 'reviews:id,product_id,rating,comment', 'brand:id,name'])
                ->where('category_id', $category_id)
                ->where('is_reward_product', '0')
                ->select('id', 'part_no', 'thumbnail_img', 'photos', 'billing_name', 'name', 'slug', 'mrp', 'cash_and_carry_item', 'brand_id', 'rating', 'c_m_coin', 'c_instock_m_coin', 'm_m_coin', 'm_instock_m_coin');

            // Step 2: Clone before pagination for full brand list
            $allProducts = (clone $baseQuery)
                ->orderByRaw("FIELD(group_id, 8, 1) DESC, group_id ASC")
                ->orderByRaw("category_id ASC")
                ->orderByRaw("CASE WHEN name LIKE '%opel%' THEN 0 ELSE 1 END")
                ->orderByRaw("CASE WHEN products.name LIKE '%opel%' THEN 0 WHEN products.part_no COLLATE utf8mb3_general_ci IN (SELECT part_no COLLATE utf8mb3_general_ci FROM products_api ) THEN 1 ELSE 2 END")
                ->orderByRaw("CAST(products.mrp AS UNSIGNED) ASC")
                ->get();

            // Step 3: Extract unique brands
            $brands = $allProducts
                ->pluck('brand')  // pluck brand relation
                ->filter()        // remove nulls
                ->unique('id')    // only distinct brands
                ->sortBy('name')
                ->values();       // reset index

            // Step 4: Now paginate original query
            $brandArray = array();
            if($request['brands'] AND $request['brands'] != ""){
                $brandArray = explode(',',$request['brands']);
            }

            // clone again for product list
            $productQuery = (clone $baseQuery);

            if (!empty($brandArray)) {
                $productQuery->whereIn('brand_id', $brandArray);
            }
            $getData = $productQuery
                ->orderByRaw("FIELD(group_id, 8, 1) DESC, group_id ASC")
                ->orderByRaw("category_id ASC")
                ->orderByRaw("CASE WHEN name LIKE '%opel%' THEN 0 ELSE 1 END")
                ->orderByRaw("CASE WHEN products.name LIKE '%opel%' THEN 0 WHEN products.part_no COLLATE utf8mb3_general_ci IN (SELECT part_no COLLATE utf8mb3_general_ci FROM products_api ) THEN 1 ELSE 2 END")
                ->orderByRaw("CAST(products.mrp AS UNSIGNED) ASC")
                ->paginate(16);
            $getData->getCollection()->transform(function ($product) use ($request) {
                // Process thumb_img
                if ($product->thumb_img && $product->thumb_img->file_name) {
                    $product->thumb_img->file_name = 'https://mazingbusiness.com/public/' . $product->thumb_img->file_name;
                }

                // Process images
                $photoIds = explode(',', $product->photos);
                $product->images = Upload::whereIn('id', $photoIds)
                    ->select('id', 'file_name')
                    ->get()
                    ->map(function ($image) {
                        $image->file_name = 'https://mazingbusiness.com/public/' . $image->file_name;
                        return $image;
                    });

                // Process stocks with warehouse data
                $product->stocks = ProductWarehouse::with('warehouse:id,name') // Load only id and name for warehouse
                    ->where('product_id', $product->id) // Use the current product's id
                    ->where('is_manager_41', '0')
                    ->select('warehouse_id', 'qty') // Select only necessary fields
                    ->get()
                    ->map(function ($stock) {
                        return [
                            'warehouse_id' => $stock->warehouse_id,
                            'warehouse_name' => $stock->warehouse ? $stock->warehouse->name : null,
                            'qty' => $stock->qty,
                        ];
                    });

                // Apply discount if user_id is provided
                if (isset($request['user_id']) && $request['user_id'] != "") {
                    $userData = User::find($request['user_id']);
                    $discount = 20;

                    if ($userData && isset($userData->discount) && $userData->discount != 0) {
                        $discount = $userData->discount;                        
                    }

                    $price = $product->mrp * ((100 - $discount) / 100);
                    $product->discount_price = $this->price_two_decimel($price);
                    $product->bulk_discount_price = $this->price_two_decimel($product->discount_price - (($product->discount_price * 2) / 100));
                    $price = $price * 131.6 / 100;
                    $product->product_price = $this->price_two_decimel($price);
                    $product->user_id = $userData->id;
                    $product->discount = $discount;

                    $getWishlist = Wishlist::where('user_id', $request['user_id'])->where('product_id', $product->id)->first();
                    if($getWishlist != NULL){
                        $product->wish_list_flag = 1;
                    }else{
                        $product->wish_list_flag = 0;
                    }
                }

                return $product;
            });
            return ['res' => true, 'msg' => "",'data' => $getData, 'categoryData' => $categoryData, 'allBrands' => $brands];
        }catch (\Exception $e) {
            // Log any other exceptions
            \Log::error('An error occurred: ' . $e->getMessage());
            return response()->json([
                'res' => false,
                'msg' => 'An unexpected error occurred.' . $e->getMessage(),
            ], 500);
        }
    }

    /**
     * Get Category Products.
     *
     * @param $request
     * @return array
     */
    public function brandProducts($request)
    {
        try {
            $brand_id = $request['brand_id'];
            $getData = Product::with(['thumb_img:id,file_name', 'reviews:id,product_id,rating,comment'])
                ->where('brand_id', $brand_id)
                ->where('current_stock', '>', '0')
                ->where('is_reward_product', '0')
                ->select('id', 'part_no', 'thumbnail_img', 'photos', 'billing_name', 'name', 'slug', 'mrp', 'cash_and_carry_item');
            $getData = $getData->orderByRaw("FIELD(group_id, 8, 1) DESC, group_id ASC")
                ->orderByRaw("category_id ASC") // Sort by category_id after group_id
                ->orderByRaw("CASE WHEN name LIKE '%opel%' THEN 0 ELSE 1 END")
                ->orderByRaw("CASE  WHEN products.name LIKE '%opel%' THEN 0 WHEN products.part_no COLLATE utf8mb3_general_ci IN (SELECT part_no COLLATE utf8mb3_general_ci FROM products_api ) THEN 1 ELSE 2 END")
                ->orderByRaw("CAST(products.mrp AS UNSIGNED) ASC");
            $getData = $getData->paginate(15);
            $getData->getCollection()->transform(function ($product) use ($request) {
                // Process thumb_img
                if ($product->thumb_img && $product->thumb_img->file_name) {
                    $product->thumb_img->file_name = 'https://mazingbusiness.com/public/' . $product->thumb_img->file_name;
                }

                // Process images
                $photoIds = explode(',', $product->photos);
                $product->images = Upload::whereIn('id', $photoIds)
                    ->select('id', 'file_name')
                    ->get()
                    ->map(function ($image) {
                        $image->file_name = 'https://mazingbusiness.com/public/' . $image->file_name;
                        return $image;
                    });

                // Process stocks with warehouse data
                $product->stocks = ProductWarehouse::with('warehouse:id,name') // Load only id and name for warehouse
                    ->where('product_id', $product->id) // Use the current product's id
                    ->where('is_manager_41', '0')
                    ->select('warehouse_id', 'qty') // Select only necessary fields
                    ->get()
                    ->map(function ($stock) {
                        return [
                            'warehouse_id' => $stock->warehouse_id,
                            'warehouse_name' => $stock->warehouse ? $stock->warehouse->name : null,
                            'qty' => $stock->qty,
                        ];
                    });

                // Apply discount if user_id is provided
                if (isset($request['user_id']) && $request['user_id'] != "") {
                    $userData = User::find($request['user_id']);
                    $discount = 20;

                    if ($userData && isset($userData->discount) && $userData->discount != 0) {
                        $discount = $userData->discount;
                    }

                    $price = $product->mrp * ((100 - $discount) / 100);
                    $product->discount_price = $this->price_two_decimel($price);
                    $product->bulk_discount_price = $this->price_two_decimel($product->discount_price - (($product->discount_price * 2) / 100));
                    $price = $price * 131.6 / 100;
                    $product->product_price = $this->price_two_decimel($price);

                    $getWishlist = Wishlist::where('user_id', $request['user_id'])->where('product_id', $product->id)->first();
                    if($getWishlist != NULL){
                        $product->wish_list_flag = 1;
                    }else{
                        $product->wish_list_flag = 0;
                    }
                }

                return $product;
            });

            return ['res' => true, 'msg' => "",'data' => $getData];
        }catch (\Exception $e) {
            // Log any other exceptions
            \Log::error('An error occurred: ' . $e->getMessage());
            return response()->json([
                'res' => false,
                'msg' => 'An unexpected error occurred.' . $e->getMessage(),
            ], 500);
        }
    }

    public function quickOrder($request)
    {
        try {
            $userId = $request['user_id'] ?? null;
            $userData = null;
            $discount = 20;
            $useDiscountPrice = false;
            $useAliasProductLogic = true;

            if (!empty($userId)) {
                $userData = User::find($userId);
                $useDiscountPrice = true;

                if ($userData && isset($userData->discount) && (float) $userData->discount != 0) {
                    $discount = (float) $userData->discount;
                }
            }

            $mrpExpression = "
                CAST(
                    NULLIF(
                        REPLACE(REPLACE(REPLACE(REPLACE(TRIM(products.mrp), '₹', ''), 'â‚¹', ''), ',', ''), ' ', ''),
                        ''
                    ) AS DECIMAL(10,2)
                )
            ";

            $effectivePriceExpression = $useDiscountPrice
                ? "({$mrpExpression} * ((100 - {$discount}) / 100))"
                : "({$mrpExpression})";

            /*
            |--------------------------------------------------------------------------
            | Optimized Alias Summary
            |--------------------------------------------------------------------------
            | This calculates alias minimum price once for all alias groups.
            | No per-product query inside transform.
            |--------------------------------------------------------------------------
            */
            $aliasPriceExpression = "
                CAST(
                    NULLIF(
                        REPLACE(REPLACE(REPLACE(REPLACE(TRIM(ap.mrp), '₹', ''), 'â‚¹', ''), ',', ''), ' ', ''),
                        ''
                    ) AS DECIMAL(10,2)
                )
            ";

            $aliasSummarySubQuery = DB::query()
                ->fromSub(function ($query) use ($aliasPriceExpression) {
                    $query->from('products as ap')
                        ->leftJoinSub(
                            DB::table('products_api')
                                ->select('part_no')
                                ->where('closing_stock', '>', 0)
                                ->groupBy('part_no'),
                            'pa',
                            function ($join) {
                                $join->on('pa.part_no', '=', 'ap.part_no');
                            }
                        )
                        ->selectRaw("
                            COALESCE(NULLIF(TRIM(ap.alias_primary_part_no), ''), ap.part_no) as alias_master_part_no
                        ")
                        ->selectRaw("
                            CASE
                                WHEN pa.part_no IS NOT NULL
                                THEN {$aliasPriceExpression}
                                ELSE NULL
                            END as api_mrp
                        ")
                        ->selectRaw("
                            CASE
                                WHEN ap.seller_stock = 1
                                THEN {$aliasPriceExpression}
                                ELSE NULL
                            END as seller_mrp
                        ")
                        ->selectRaw("
                            CASE WHEN pa.part_no IS NOT NULL THEN 1 ELSE 0 END as has_api_stock
                        ")
                        ->selectRaw("
                            CASE WHEN ap.seller_stock = 1 THEN 1 ELSE 0 END as has_seller_stock
                        ")
                        ->where('ap.is_reward_product', '0')
                        ->whereRaw("TRIM(ap.mrp) REGEXP '[0-9]'");
                }, 'alias_rows')
                ->selectRaw("alias_master_part_no")
                ->selectRaw("MIN(api_mrp) as api_min_mrp")
                ->selectRaw("MIN(seller_mrp) as seller_min_mrp")
                ->selectRaw("
                    CASE
                        WHEN SUM(has_api_stock) > 0 THEN 1
                        WHEN SUM(has_seller_stock) > 0 THEN 1
                        ELSE 0
                    END as alias_current_stock
                ")
                ->groupBy('alias_master_part_no');

            $joinAliasProductSummary = function ($query) use ($aliasSummarySubQuery, $useAliasProductLogic) {
                if ($useAliasProductLogic) {
                    $query->leftJoinSub($aliasSummarySubQuery, 'alias_summary', function ($join) {
                        $join->on('alias_summary.alias_master_part_no', '=', 'products.part_no');
                    });
                }

                return $query;
            };

            $aliasListingPriceExpression = "
                COALESCE(
                    alias_summary.api_min_mrp,
                    alias_summary.seller_min_mrp,
                    {$mrpExpression}
                )
            ";

            $aliasCurrentStockExpression = "
                COALESCE(alias_summary.alias_current_stock, 0)
            ";

            $listingPriceExpression = $useAliasProductLogic
                ? $aliasListingPriceExpression
                : $effectivePriceExpression;

            $applyAliasProductFilters = function ($query) use ($useAliasProductLogic, $aliasCurrentStockExpression) {
                if (!$useAliasProductLogic) {
                    $query->where('products.current_stock', '>', 0);
                    return $query;
                }

                return $query
                    ->where(function ($q) {
                        $q->whereNull('products.alias_primary_part_no')
                            ->orWhereRaw("TRIM(COALESCE(products.alias_primary_part_no, '')) = ''");
                    })
                    ->where(function ($q) use ($aliasCurrentStockExpression) {
                        $q->where('products.current_stock', 1)
                            ->orWhereRaw("({$aliasCurrentStockExpression}) = 1");
                    });
            };

            $applyCommonFilters = function ($query) use ($request, $useAliasProductLogic) {
                if (!empty($request['cat_groups'])) {
                    $selected_cat_groups = array_filter(explode(',', $request['cat_groups']));
                    if (!empty($selected_cat_groups)) {
                        $query->whereIn('products.group_id', $selected_cat_groups);
                    }
                }

                if (!empty($request['categories'])) {
                    $selected_categories = array_filter(explode(',', $request['categories']));
                    if (!empty($selected_categories)) {
                        $query->whereIn('products.category_id', $selected_categories);
                    }
                }

                if (!empty($request['brands'])) {
                    $selected_brands = array_filter(explode(',', $request['brands']));
                    if (!empty($selected_brands)) {
                        $query->whereIn('products.brand_id', $selected_brands);
                    }
                }

                if (!empty($request['m_coin_rates'])) {
                    $selected_m_coins = array_filter(explode(',', $request['m_coin_rates']));
                    if (!empty($selected_m_coins)) {
                        $query->whereIn('products.c_instock_m_coin', $selected_m_coins);
                    }
                }

                if (!empty($request['location_id'])) {
                    $query->whereHas('productWarehouses', function ($subQuery) use ($request) {
                        $subQuery->where('warehouse_id', $request['location_id'])
                            ->where('qty', '>', 0);
                    });
                }

                if (isset($request['inhouse_product']) && $request['inhouse_product'] !== '' && $request['inhouse_product'] !== null) {
                    if ((string) $request['inhouse_product'] === '1') {
                        $query->whereHas('productsApi');
                    } elseif ((string) $request['inhouse_product'] === '0') {
                        $query->doesntHave('productsApi');
                    }
                }

                if (!empty($request['search_text'])) {
                    $searchText = trim($request['search_text']);

                    $query->where(function ($q) use ($searchText, $useAliasProductLogic) {
                        $q->where('products.name', 'like', "%{$searchText}%")
                            ->orWhere('products.part_no', 'like', "%{$searchText}%");

                        if ($useAliasProductLogic) {
                            $q->orWhereExists(function ($aliasQuery) use ($searchText) {
                                $aliasQuery->select(DB::raw(1))
                                    ->from('products as search_alias_products')
                                    ->whereColumn('search_alias_products.alias_primary_part_no', 'products.part_no')
                                    ->where(function ($aliasSearchQuery) use ($searchText) {
                                        $aliasSearchQuery->where('search_alias_products.name', 'like', "%{$searchText}%")
                                            ->orWhere('search_alias_products.part_no', 'like', "%{$searchText}%")
                                            ->orWhere('search_alias_products.billing_name', 'like', "%{$searchText}%");
                                    });
                            });
                        }
                    });
                }

                return $query;
            };

            $minQuery = Product::query()
                ->from('products')
                ->where('products.is_reward_product', '0')
                ->whereRaw("TRIM(products.mrp) REGEXP '^[₹0-9, .]+$'");

            $joinAliasProductSummary($minQuery);
            $applyAliasProductFilters($minQuery);
            $applyCommonFilters($minQuery);

            $minQuery->selectRaw("{$listingPriceExpression} as listing_price");

            $priceRange = DB::query()
                ->fromSub($minQuery, 'listing_price_rows')
                ->selectRaw('MIN(listing_price) as min_mrp, MAX(listing_price) as max_mrp')
                ->first();

            $min_mrp = $priceRange->min_mrp ?? null;
            $max_mrp = $priceRange->max_mrp ?? null;

            /*
            $maxQuery = Product::query()
                ->from('products')
                ->where('products.is_reward_product', '0')
                ->whereRaw("TRIM(products.mrp) REGEXP '^[₹0-9, .]+$'");

            $joinAliasProductSummary($maxQuery);
            $applyAliasProductFilters($maxQuery);
            $applyCommonFilters($maxQuery);

            $maxQuery->selectRaw("{$listingPriceExpression} as listing_price");

            $max_mrp = DB::query()
                ->fromSub($maxQuery, 'listing_price_rows')
                ->max('listing_price');
            */

            $sort = strtolower(trim((string) $request->get('price_sort', 'popularity')));

            $fastDeliveryExistsExpression = "
                EXISTS (
                    SELECT 1
                    FROM products_api as fast_delivery_products
                    WHERE fast_delivery_products.closing_stock > 0
                    AND fast_delivery_products.part_no COLLATE utf8mb3_general_ci = products.part_no COLLATE utf8mb3_general_ci
                    LIMIT 1
                )
            ";

            $getData = Product::with([
                    'categoryGroup:id,name',
                    'category:id,name',
                    'thumb_img:id,file_name',
                    'reviews:id,product_id,rating,comment',
                ])
                ->from('products')
                ->select(
                    'products.id',
                    'products.part_no',
                    'products.alias_primary_part_no',
                    'products.thumbnail_img',
                    'products.photos',
                    'products.billing_name',
                    'products.name',
                    'products.slug',
                    'products.mrp',
                    'products.seller_stock',
                    'products.cash_and_carry_item',
                    'products.variant_product',
                    'products.variation_parent_part_no',
                    'products.group_id',
                    'products.category_id',
                    'products.brand_id',
                    'products.is_warranty',
                    'products.warranty_duration',
                    'products.current_stock',
                    'products.is_reward_product',
                    'products.c_m_coin',
                    'products.c_instock_m_coin',
                    'products.m_m_coin',
                    'products.m_instock_m_coin'
                )
                ->selectRaw("
                    CASE
                        WHEN {$fastDeliveryExistsExpression} THEN 1
                        ELSE 0
                    END as fast_delivery_flag
                ")
                ->where('products.is_reward_product', '0')
                ->whereRaw("TRIM(products.mrp) REGEXP '^[₹0-9, .]+$'");

            $joinAliasProductSummary($getData);

            if ($useAliasProductLogic) {
                $getData->addSelect(DB::raw("{$aliasListingPriceExpression} as alias_min_mrp"));
                $getData->addSelect(DB::raw("{$aliasCurrentStockExpression} as alias_current_stock"));
            }

            $applyAliasProductFilters($getData);
            $applyCommonFilters($getData);

            if (
                isset($request['min_price'], $request['max_price']) &&
                $request['min_price'] !== '' &&
                $request['max_price'] !== ''
            ) {
                $minPrice = (float) $request['min_price'];
                $maxPrice = (float) $request['max_price'];

                $getData->whereRaw("{$listingPriceExpression} BETWEEN ? AND ?", [
                    $minPrice,
                    $maxPrice,
                ]);
            }

            $getData->orderByRaw("
                CASE
                    WHEN products.group_id = 1 THEN 0
                    WHEN products.group_id = 8 THEN 1
                    ELSE 2
                END ASC
            ")
                ->orderBy(CategoryGroup::select('name')
                    ->whereColumn('category_groups.id', 'products.group_id')
                    ->limit(1), 'ASC')
                ->orderBy(Category::select('name')
                    ->whereColumn('categories.id', 'products.category_id')
                    ->limit(1), 'ASC')
                ->orderByRaw("
                    CASE
                        WHEN LOWER(products.name) LIKE '%opel%' THEN 0
                        WHEN fast_delivery_flag = 1 THEN 1
                        ELSE 2
                    END ASC
                ")
                ->orderByRaw("
                    CASE WHEN fast_delivery_flag = 1 THEN 0 ELSE 1 END ASC
                ");

            if ($sort === 'high_to_low') {
                $getData->orderByRaw("{$listingPriceExpression} DESC");
            } elseif ($sort === 'low_to_high') {
                $getData->orderByRaw("{$listingPriceExpression} ASC");
            } else {
                $getData->orderByRaw("{$listingPriceExpression} ASC");
            }

            $getData->orderBy('products.id', 'DESC');

            $pagination = !empty($request['pagination']) ? (int) $request['pagination'] : 15;

            $getData = $getData->paginate($pagination);

            $productsCollection = $getData->getCollection();
            $productIds = $productsCollection->pluck('id')->filter()->values();

            $allPhotoIds = $productsCollection
                ->flatMap(function ($product) {
                    return array_filter(explode(',', (string) $product->photos));
                })
                ->unique()
                ->values();

            $uploads = $allPhotoIds->isEmpty()
                ? collect()
                : Upload::whereIn('id', $allPhotoIds)
                    ->select('id', 'file_name')
                    ->get()
                    ->map(function ($image) {
                        $image->file_name = 'https://mazingbusiness.com/public/' . $image->file_name;
                        return $image;
                    })
                    ->keyBy('id');

            $stocksByProductId = $productIds->isEmpty()
                ? collect()
                : ProductWarehouse::with('warehouse:id,name')
                    ->whereIn('product_id', $productIds)
                    ->where('is_manager_41', '0')
                    ->select('product_id', 'warehouse_id', 'qty')
                    ->get()
                    ->groupBy('product_id');

            $wishlistProductIds = collect();
            if (!empty($request['user_id']) && !$productIds->isEmpty()) {
                $wishlistProductIds = Wishlist::where('user_id', $request['user_id'])
                    ->whereIn('product_id', $productIds)
                    ->pluck('product_id')
                    ->flip();
            }

            $getData->setCollection($productsCollection->transform(function ($product) use ($request, $useDiscountPrice, $userData, $useAliasProductLogic, $uploads, $stocksByProductId, $wishlistProductIds) {
                if ($useAliasProductLogic && isset($product->alias_min_mrp) && $product->alias_min_mrp !== null) {
                    $product->mrp = $product->alias_min_mrp;
                    $product->current_stock = (int) $product->alias_current_stock;
                }

                if ($product->thumb_img && $product->thumb_img->file_name) {
                    $product->thumb_img->file_name = 'https://mazingbusiness.com/public/' . $product->thumb_img->file_name;
                }

                $photoIds = !empty($product->photos) ? explode(',', $product->photos) : [];
                $photoIds = array_filter($photoIds);

                $product->images = collect($photoIds)
                    ->map(function ($photoId) use ($uploads) {
                        return $uploads->get((int) $photoId);
                    })
                    ->filter()
                    ->values();

                $product->stocks = $stocksByProductId
                    ->get($product->id, collect())
                    ->map(function ($stock) {
                        return [
                            'warehouse_id'   => $stock->warehouse_id,
                            'warehouse_name' => $stock->warehouse ? $stock->warehouse->name : null,
                            'qty'            => $stock->qty,
                        ];
                    });

                $product->inhouse_product = (int) ($product->fast_delivery_flag ?? 0);
                $product->fast_delivery_tag = (int) ($product->fast_delivery_flag ?? 0);
                $product->varient_product = (
                    (int) ($product->variant_product ?? 0) === 1 &&
                    !empty($product->variation_parent_part_no)
                ) ? 1 : 0;

                $rawMrp = (float) preg_replace('/[^\d.]/', '', (string) $product->mrp);
                $product->original_mrp = $rawMrp;

                if ($useDiscountPrice && !$useAliasProductLogic) {
                    $appliedDiscount = 20;

                    if ($userData && isset($userData->discount) && (float) $userData->discount != 0) {
                        $appliedDiscount = (float) $userData->discount;
                    }

                    $discountPrice = $rawMrp * ((100 - $appliedDiscount) / 100);

                    $product->discount = $appliedDiscount;
                    $product->discount_price = $this->price_two_decimel($discountPrice);
                    $product->bulk_discount_price = $this->price_two_decimel($discountPrice - (($discountPrice * 2) / 100));

                    $price = $discountPrice * 131.6 / 100;
                    $product->product_price = $this->price_two_decimel($price);
                    $product->mrp = price_less_than_50(convert_price($price), false);

                    $product->wish_list_flag = $wishlistProductIds->has($product->id) ? 1 : 0;
                }

                if ($useAliasProductLogic && !empty($request['user_id'])) {
                    $appliedDiscount = 20;

                    if ($userData && isset($userData->discount) && (float) $userData->discount != 0) {
                        $appliedDiscount = (float) $userData->discount;
                    }

                    $discountPrice = $rawMrp * ((100 - $appliedDiscount) / 100);

                    $product->discount = $appliedDiscount;
                    $product->discount_price = $this->price_two_decimel($discountPrice);
                    $product->bulk_discount_price = $this->price_two_decimel($discountPrice - (($discountPrice * 2) / 100));

                    $product->wish_list_flag = $wishlistProductIds->has($product->id) ? 1 : 0;
                }

                return $product;
            }));

            if ($useDiscountPrice) {
                $getData = $this->addOfferTag($getData, $request['user_id']);
            }

            $categorySuggestion = collect();
            $brandSuggestion = collect();

            if (!empty($request['search_text'])) {
                $searchText = trim($request['search_text']);

                $categorySuggestion = Category::select('id', 'name', 'category_group_id')
                    ->where('name', 'like', "%{$searchText}%")
                    ->orderBy('name', 'ASC')
                    ->limit(10)
                    ->get();

                $brandSuggestion = Brand::select('id', 'name')
                    ->where('name', 'like', "%{$searchText}%")
                    ->orderBy('name', 'ASC')
                    ->limit(10)
                    ->get();
            }

            return [
                'res'     => true,
                'msg'     => "",
                'data'    => $getData,
                'min_mrp' => $min_mrp ? (float) $this->price_two_decimel($min_mrp) : 0,
                'max_mrp' => $max_mrp ? (float) $this->price_two_decimel($max_mrp) : 0,
                'catehory_suggestion' => $categorySuggestion,
                'brand_suggestion' => $brandSuggestion,
            ];
        } catch (\Exception $e) {
            \Log::error('An error occurred in quickOrder: ' . $e->getMessage(), [
                'trace' => $e->getTraceAsString(),
            ]);

            return response()->json([
                'res' => false,
                'msg' => 'An unexpected error occurred. ' . $e->getMessage(),
            ], 500);
        }
    }

