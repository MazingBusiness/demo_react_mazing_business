    /**
     * Get All Brand.
     *
     * @param $request
     * @return array
     */
    public function getAllBrands($request){
        try{
            $category_group_id = explode(',',$request->category_group_id);
            $category_id = explode(',',$request->category_id);
            if(isset($request->category_group_id) AND $category_group_id != 0 AND $category_id){        
                $brands = Brand::with(['banner_image' => function ($query) {
                        $query->select('id', 'file_name');
                    }])
                    ->whereHas('products', function ($query) use ($category_group_id, $category_id) {
                        $query->when(count($category_group_id), function ($q) use ($category_group_id) {
                            $q->whereIn('group_id', $category_group_id);
                        })
                        ->when(count($category_id), function ($q) use ($category_id) {
                            $q->whereIn('category_id', $category_id);
                        })
                        ->where('published', true)
                        ->where('current_stock', 1)
                        ->where('approved', true);
                    })
                    ->orderBy('name','ASC')
                    ->distinct()                    
                    ->get()
                    ->map(function ($brand) {
                        if ($brand->banner_image) {
                            $brand->banner_image->file_name = 'https://mazingbusiness.com/public/' . $brand->banner_image->file_name;
                        }
                        return $brand;
                    }); 
            }else{
               $brands = Brand::with(['banner_image' => function ($query) {
                    $query->select('id', 'file_name');
                    }])
                    ->whereHas('products', function ($query) use ($category_group_id, $category_id) {
                        $query->where('published', true)
                        ->where('current_stock', 1)
                        ->where('approved', true);
                    })
                    ->orderBy('name','ASC')
                    ->distinct()
                    ->get()
                    ->map(function ($brand) {
                        if ($brand->banner_image) {
                            $brand->banner_image->file_name = 'https://mazingbusiness.com/public/' . $brand->banner_image->file_name;
                        }
                        return $brand;
                    }); 
            }
            return ['res' => true, 'msg' => "",'data' => $brands];
        }catch (\Exception $e) {
            // Log any other exceptions
            \Log::error('An error occurred: ' . $e->getMessage());
            return response()->json([
                'res' => false,
                'msg' => 'An unexpected error occurred.' . $e->getMessage(),
            ], 500);
        }
    }

    public function rewardProducts($request)
    {
        try {
            $userId = $request['user_id'] ?? null;
            $userData = null;
            $discount = 20;
            $useDiscountPrice = false;

            if (!empty($userId)) {
                $userData = User::find($userId);
                $useDiscountPrice = true;

                if ($userData && isset($userData->discount) && (float) $userData->discount != 0) {
                    $discount = (float) $userData->discount;
                }
            }

            $mrpExpression = "
                CAST(
                    NULLIF(
                        REPLACE(REPLACE(REPLACE(TRIM(products.redeem_m_coin), '₹', ''), ',', ''), ' ', ''),
                        ''
                    ) AS DECIMAL(10,2)
                )
            ";

            $effectivePriceExpression = $useDiscountPrice
                ? "({$mrpExpression} * ((100 - {$discount}) / 100))"
                : "({$mrpExpression})";

            $sort = strtolower(trim((string) ($request['price_sort'] ?? 'popularity')));

            $getData = Product::with([
                    // 'categoryGroup:id,name',
                    // 'category:id,name',
                    'thumb_img:id,file_name',
                    // 'reviews:id,product_id,rating,comment',
                ])
                ->select(
                    'id',
                    'part_no',
                    'thumbnail_img',
                    'photos',
                    'billing_name',
                    'name',
                    'slug',
                    'mrp',
                    'cash_and_carry_item',
                    'group_id',
                    'category_id',
                    'brand_id',
                    'is_warranty',
                    'warranty_duration',
                    'current_stock',
                    'product_value',
                    'redeem_m_coin',
                    'is_reward_product'
                )
                ->where('is_reward_product', '1');
                // ->whereRaw("TRIM(products.mrp) REGEXP '^[₹0-9, .]+$'");

            if (!empty($request['search_text'])) {
                $searchText = trim($request['search_text']);

                $getData->where(function ($q) use ($searchText) {
                    $q->where('products.name', 'like', "%{$searchText}%")
                    ->orWhere('products.part_no', 'like', "%{$searchText}%")
                    ->orWhere('products.billing_name', 'like', "%{$searchText}%");
                });
            }

            if ($sort === 'high_to_low') {
                $getData->orderByRaw("{$effectivePriceExpression} DESC");
            } elseif ($sort === 'low_to_high') {
                $getData->orderByRaw("{$effectivePriceExpression} ASC");
            } else {
                $getData->orderBy('products.id', 'DESC');
            }

            $pagination = !empty($request['pagination']) ? (int) $request['pagination'] : 15;

            $getData = $getData->paginate($pagination);

            $getData->getCollection()->transform(function ($product) use ($request, $useDiscountPrice, $userData) {
                if ($product->thumb_img && $product->thumb_img->file_name) {
                    $product->thumb_img->file_name = 'https://mazingbusiness.com/public/' . $product->thumb_img->file_name;
                }

                $photoIds = !empty($product->photos) ? explode(',', $product->photos) : [];
                $photoIds = array_filter($photoIds);

                $product->images = Upload::whereIn('id', $photoIds)
                    ->select('id', 'file_name')
                    ->get()
                    ->map(function ($image) {
                        $image->file_name = 'https://mazingbusiness.com/public/' . $image->file_name;
                        return $image;
                    });

                // $product->stocks = ProductWarehouse::with('warehouse:id,name')
                //     ->where('product_id', $product->id)
                //     ->where('is_manager_41', '0')
                //     ->select('warehouse_id', 'qty')
                //     ->get()
                //     ->map(function ($stock) {
                //         return [
                //             'warehouse_id'   => $stock->warehouse_id,
                //             'warehouse_name' => $stock->warehouse ? $stock->warehouse->name : null,
                //             'qty'            => $stock->qty,
                //         ];
                //     });

                // $inhouseExists = ProductsApi::where('part_no', $product->part_no)
                //     ->where('closing_stock', '>', '0')
                //     ->distinct()
                //     ->exists();

                // $product->inhouse_product = $inhouseExists ? 1 : 0;
                // $product->fast_delivery_tag = $inhouseExists ? 1 : 0;

                // $rawMrp = (float) preg_replace('/[^\d.]/', '', (string) $product->mrp);
                // $product->original_mrp = $rawMrp;

                // if ($useDiscountPrice) {
                //     $appliedDiscount = 20;

                //     if ($userData && isset($userData->discount) && (float) $userData->discount != 0) {
                //         $appliedDiscount = (float) $userData->discount;
                //     }

                //     $discountPrice = $rawMrp * ((100 - $appliedDiscount) / 100);

                //     $product->discount = $appliedDiscount;
                //     $product->discount_price = $this->price_two_decimel($discountPrice);
                //     $product->bulk_discount_price = $this->price_two_decimel(
                //         $discountPrice - (($discountPrice * 2) / 100)
                //     );

                //     $price = $discountPrice * 131.6 / 100;
                //     $product->product_price = $this->price_two_decimel($price);
                //     $product->mrp = price_less_than_50(convert_price($price), false);

                //     $getWishlist = Wishlist::where('user_id', $request['user_id'])
                //         ->where('product_id', $product->id)
                //         ->first();

                //     $product->wish_list_flag = $getWishlist ? 1 : 0;
                // }

                return $product;
            });

            if ($useDiscountPrice) {
                $getData = $this->addOfferTag($getData, $request['user_id']);
            }

            return [
                'res'  => true,
                'msg'  => "",
                'data' => $getData,
            ];

        } catch (\Exception $e) {
            \Log::error('An error occurred in rewardProducts: ' . $e->getMessage(), [
                'trace' => $e->getTraceAsString(),
            ]);

            return response()->json([
                'res' => false,
                'msg' => 'An unexpected error occurred. ' . $e->getMessage(),
            ], 500);
        }
    }



    /**
     * Get Category Groups.
     *
     * @param $request
     * @return array
     */
    public function categoryGroups($request) : array
    {
        try {
            $getData = CategoryGroup::with(['image', 'bannerImage', 'childrenCategories']);
            if (isset($request['id']) && $request['id'] != "") {
                $getData = $getData->where('id',$request['id']);
            }            
            $getData = $getData->get()
            ->sortBy(function ($item) {
                // Give items with "power tools" in the name a lower priority (i.e., they appear first)
                $hasPowerTools = stripos($item->name, 'power tools') !== false ? 0 : 1;
                return [$hasPowerTools, strtolower($item->name)];
            });
            $data = $getData->map(function ($categoryGroup) {
                $photo = $categoryGroup->bannerImage ? $categoryGroup->bannerImage->file_name : null;
                return [
                    'id' => $categoryGroup->id,
                    'name' => $categoryGroup->name,
                    'slug' => $categoryGroup->slug,
                    'photo' => $photo ? 'https://mazingbusiness.com/public/' . $photo : null,
                    'child_category' => $categoryGroup->childrenCategories->map(function ($childCategory) {
                        $childPhoto = $childCategory->image ? $childCategory->image->file_name : null;
                        return [
                            'id' => $childCategory->id,
                            'name' => $childCategory->name,
                            'slug' => $childCategory->slug,
                            'photo' => $childPhoto ? 'https://mazingbusiness.com/public/' . $childPhoto : null,
                        ];
                    })->values(),
                ];
            })->values();
            return ['res' => true, 'msg' => "",'data' => $data];
        }catch (\Exception $e) {
            // Log any other exceptions
            \Log::error('An error occurred: ' . $e->getMessage());
            return ['res' => false, 'msg' => 'An unexpected error occurred.' . $e->getMessage()];            
        }
    }

    /**
     * Get Warehose List.
     *
     * @param $request
     * @return array
     */
    public function warehoseList($request) : array
    {
        try {
            $getData = Warehouse::where('active', '1')->orderBy('name', 'ASC')->get();
            return ['res' => true, 'msg' => "",'data' => $getData];
        }catch (\Exception $e) {
            // Log any other exceptions
            \Log::error('An error occurred: ' . $e->getMessage());
            return response()->json([
                'res' => false,
                'msg' => 'An unexpected error occurred.' . $e->getMessage(),
            ], 500);
        }
    }

