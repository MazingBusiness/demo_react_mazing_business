  public function admin_product_edit(Request $request, $id)
  {

      CoreComponentRepository::initializeCache();


      $product = Product::findOrFail($id);

      $loggedInUser = auth()->user();

    $isReviewReadonlyUser = false;

        if ($loggedInUser) {
            $userType  = strtolower(trim((string) ($loggedInUser->user_type ?? '')));
            $userTitle = strtolower(trim((string) ($loggedInUser->user_title ?? '')));
            $isBanned  = (int) ($loggedInUser->banned ?? 0) === 0;

            $isReviewReadonlyUser =
                $userType === 'staff' &&
                in_array($userTitle, ['dispatch', 'manager', 'head_manager'], true) &&
                $isBanned;
        }
   
      $lang = $request->lang;
      $tags = json_decode($product->tags);

      $sellers = Seller::join('users', 'sellers.user_id', '=', 'users.id')
          ->select('sellers.*', 'users.name as user_name')
