  public function ownBrandProductDelete($id) {
    $product = OwnBrandProduct::findOrFail($id);

    if (OwnBrandProduct::destroy($id)) {
      // Cart::where('product_id', $id)->delete();

      flash(translate('Product has been deleted successfully'))->success();

      Artisan::call('view:clear');
      Artisan::call('cache:clear');

      return back();
    } else {
      flash(translate('Something went wrong'))->error();
      return back();
    }
  }


/**
 * Manager-41 closing stock listing (no debit note part).
 */
public function manager41ClosingStock(Request $request)
{
    $search_text = $request->search_text;

    $warehouses = Warehouse::where('active', 1)
        ->orderBy('id', 'ASC')
        ->get();

    // Base list: distinct part_no (+ a stable name)
    $productsQ = Manager41ProductStock::query();

    if (!empty($search_text)) {
        $s = trim($search_text);
        $productsQ->where(function ($q) use ($s) {
            $q->where('part_no', 'like', "%{$s}%")
              ->orWhere('name', 'like', "%{$s}%");
        });
    }

    // Distinct part numbers with a representative name
    $products = $productsQ
        ->select('part_no', DB::raw('MAX(name) as name'))
        ->groupBy('part_no')
        ->orderBy('name', 'ASC')
        ->paginate(15);

    $damagedLostQuantities = $this->damagedLostQuantitiesByPartNumber(
        $products->getCollection()->pluck('part_no')
    );

    // Enrich each row with per-warehouse figures (no debit-note)
    $products->getCollection()->transform(function ($product) use ($warehouses, $damagedLostQuantities) {
        $warehouseData = [];

        // get product_id once for challan linkage (if Product exists)
        $productId = Product::where('part_no', $product->part_no)->value('id');

        foreach ($warehouses as $warehouse) {
            // Branch (mirror) stock for this godown
            $branchStock = Manager41ProductStock::where('part_no', $product->part_no)
                ->where('godown', $warehouse->name) // godown stores warehouse name
                ->value('closing_stock');

            // Opening stock (match either warehouse_id or stored godown name)
            $openingQty = Manager41OpeningStock::where('part_no', $product->part_no)
                ->where(function ($q) use ($warehouse) {
                    $q->where('warehouse_id', $warehouse->id)
                      ->orWhere('godown', $warehouse->name);
                })
                ->sum('closing_stock');

            // Purchases (sum qty) for this warehouse
            $purchaseQty = Manager41PurchaseInvoiceDetail::where('part_no', $product->part_no)
                ->whereHas('purchaseInvoice', function ($q) use ($warehouse) {
                    $q->where('warehouse_id', $warehouse->id);
                })
                ->sum('qty');

            // Sales via challans (sum quantity) for this warehouse
            $saleQty = 0;
            if ($productId) {
                $saleQty = Manager41ChallanDetail::where('product_id', $productId)
                    ->whereHas('challan', function ($q) use ($warehouse) {
                        $q->where('warehouse_id', $warehouse->id);
                    })
                    ->sum('quantity');
            }

            $warehouseData[] = [
                'warehouse_id'   => $warehouse->id,
                'warehouse_name' => $warehouse->name,
                'branch_stock'   => (float) ($branchStock ?? 0),
                'opening_stock'  => (float) $openingQty,
                'purchase_qty'   => (float) $purchaseQty,
                'sale_qty'       => (float) $saleQty,
                'debit_note_qty' => 0,
                'damage_qty'     => $damagedLostQuantities[strtoupper(trim($product->part_no))][$warehouse->id]['damage'] ?? 0,
                'lost_qty'       => $damagedLostQuantities[strtoupper(trim($product->part_no))][$warehouse->id]['lost'] ?? 0,
                // ❌ no debit note in Manager-41 view
            ];
        }

        $product->warehouse = $warehouseData;
        return $product;
    });

    if ($stock !== null && $stock !== '' && $stock != 2) {
        $filtered = $products->getCollection()->filter(function ($product) use ($stock) {
            $totalStock = 0;

            foreach ($product->warehouse as $w) {
                $totalStock += (($w['opening_stock'] ?? 0) + ($w['purchase_qty'] ?? 0))
                    - (($w['debit_note_qty'] ?? 0) + ($w['sale_qty'] ?? 0));
            }

            if ($stock == 1) {
                return $totalStock > 0;
            }

            if ($stock == 0) {
                return $totalStock <= 0;
            }

            return true;
        })->values();

        $products->setCollection($filtered);
    }
    $isManager41 = method_exists($this, 'isActingAs41Manager') && $this->isActingAs41Manager();

    

    return view('backend.product.closingStock.index', compact('products', 'warehouses', 'search_text','isManager41'));
}
    public function closingStock(Request $request)
    {
        if ($this->isActingAs41Manager()) {
            return $this->manager41ClosingStock($request);
        }

        $search_text = $request->search_text;

        $categoryGroupIds = array_values(array_filter((array) $request->category_group_id));
        $categoryIds      = array_values(array_filter((array) $request->category_id));
        $brandIds         = array_values(array_filter((array) $request->brand_id));
        $stock            = $request->stock;
        $mrpSort          = $request->mrp_sort;

        $warehouses = Warehouse::where('active', 1)->orderBy('id', 'ASC')->get();

        /*
        |--------------------------------------------------------------------------
        | Main Product Query
        |--------------------------------------------------------------------------
        */
        $products = ProductApi::query()
            ->with([
                'productDetails.brand',
                'productDetails.category',
                'productDetails.categoryGroup'
            ]);

        /*
        |--------------------------------------------------------------------------
        | Dropdown Query
        | Ye same listing ke basis par dropdown data nikalega
        |--------------------------------------------------------------------------
        */
        $dropdownProducts = ProductApi::query();

        if ($search_text != "") {
            $search = $search_text;

            $products = $products->where(function ($query) use ($search) {
                $query->where('products_api.part_no', 'like', "%$search%")
                    ->orWhere('products_api.name', 'like', "%$search%");
            });

            $dropdownProducts = $dropdownProducts->where(function ($query) use ($search) {
                $query->where('products_api.part_no', 'like', "%$search%")
                    ->orWhere('products_api.name', 'like', "%$search%");
            });
        }

        /*
        |--------------------------------------------------------------------------
        | Dropdown Data Only From Listed Products
        |--------------------------------------------------------------------------
        */
        $dropdownPartNos = (clone $dropdownProducts)
            ->whereNotNull('products_api.part_no')
            ->pluck('products_api.part_no')
            ->toArray();

        $productIdsForDropdown = Product::whereIn('part_no', $dropdownPartNos)
            ->pluck('id');

        $category_group = CategoryGroup::whereIn('id', function ($q) use ($productIdsForDropdown) {
                $q->select('group_id')
                ->from('products')
                ->whereIn('id', $productIdsForDropdown)
                ->whereNotNull('group_id');
            })
            ->orderBy('name', 'ASC')
            ->get();

        $categories = Category::whereIn('id', function ($q) use ($productIdsForDropdown) {
                $q->select('category_id')
                ->from('products')
                ->whereIn('id', $productIdsForDropdown)
                ->whereNotNull('category_id');
            })
            ->when(!empty($categoryGroupIds), function ($q) use ($categoryGroupIds) {
                $q->whereIn('parent_id', $categoryGroupIds);
            })
            ->orderBy('name', 'ASC')
            ->get();

        $brands = Brand::whereIn('id', function ($q) use ($productIdsForDropdown) {
                $q->select('brand_id')
                ->from('products')
                ->whereIn('id', $productIdsForDropdown)
                ->whereNotNull('brand_id');
            })
            ->orderBy('name', 'ASC')
            ->get();

        /*
        |--------------------------------------------------------------------------
        | Apply Filters On Main Listing
        |--------------------------------------------------------------------------
        */
        if (!empty($categoryGroupIds)) {
            $products = $products->whereHas('productDetails', function ($q) use ($categoryGroupIds) {
                $q->whereIn('group_id', $categoryGroupIds);
            });
        }

        if (!empty($categoryIds)) {
            $products = $products->whereHas('productDetails', function ($q) use ($categoryIds) {
                $q->whereIn('category_id', $categoryIds);
            });
        }

        if (!empty($brandIds)) {
            $products = $products->whereHas('productDetails', function ($q) use ($brandIds) {
                $q->whereIn('brand_id', $brandIds);
            });
        }

        if ($stock !== null && $stock !== '' && $stock != 2) {
            if ($stock == 1) {
                $products = $products->where('products_api.closing_stock', '>', 0);
            } elseif ($stock == 0) {
                $products = $products->where(function ($q) {
                    $q->whereNull('products_api.closing_stock')
                        ->orWhere('products_api.closing_stock', '<=', 0);
                });
            }
        }

        $products = $products
            ->leftJoin('products as p', 'p.part_no', '=', 'products_api.part_no')
            ->select(
                'products_api.part_no',
                'products_api.name'
            )
            ->selectRaw('SUM(COALESCE(products_api.closing_stock, 0)) as total_stock_for_sort')
            ->selectRaw('(MAX(COALESCE(p.mrp, 0)) * SUM(COALESCE(products_api.closing_stock, 0))) as mrp_stock_value')
            ->groupBy('products_api.part_no', 'products_api.name');

        if ($mrpSort == 'high_to_low') {
            $products = $products->orderByDesc('mrp_stock_value');
        } elseif ($mrpSort == 'low_to_high') {
            $products = $products->orderBy('mrp_stock_value', 'ASC');
        } else {
            $products = $products->orderBy('products_api.name', 'ASC');
        }

        $products = $products->paginate(15);

        $damagedLostQuantities = $this->damagedLostQuantitiesByPartNumber(
            $products->getCollection()->pluck('part_no')
        );

        $products->getCollection()->transform(function ($product) use ($warehouses, $damagedLostQuantities) {
            $warehouseData = [];

            foreach ($warehouses as $warehouse) {
                $stockData = ProductApi::with([
                        'openingProductStock',
                        'purchaseQty',
                        'saleQty.challan'
                    ])
                    ->where('part_no', $product->part_no)
                    ->where('godown', $warehouse->name)
                    ->first();

                $saleQty = $stockData
                    ? $stockData->saleQtyForWarehouse($warehouse->id)->get()
                    : collect();

                $purchaseQty = $stockData
                    ? $stockData->purchaseQtyForWarehouse($warehouse->id)->get()
                    : collect();

                $openingQty = $stockData
                    ? $stockData->openingProductStockQtyForWarehouse($warehouse->id)->get()
                    : collect();

                $debitNoteQty = $stockData
                    ? $stockData->debitNoteQtyForWarehouse($warehouse->id)->get()
                    : collect();

                $warehouseData[] = [
                    'warehouse_id'    => $warehouse->id,
                    'warehouse_name'  => $warehouse->name,
                    'branch_stock'    => $stockData ? $stockData->closing_stock : 0,
                    'opening_stock'   => $openingQty->sum('closing_stock'),
                    'purchase_qty'    => $purchaseQty->sum('qty'),
                    'sale_qty'        => $saleQty->sum('quantity'),
                    'debit_note_qty'  => $debitNoteQty->sum('qty'),
                    'damage_qty'      => $damagedLostQuantities[strtoupper(trim($product->part_no))][$warehouse->id]['damage'] ?? 0,
                    'lost_qty'        => $damagedLostQuantities[strtoupper(trim($product->part_no))][$warehouse->id]['lost'] ?? 0,
                ];
            }

            $product->warehouse = $warehouseData;

            return $product;
        });

        $abmStockUrl = 'https://abm.spurspaces.com/manager41/stocks/available';
        $m41ApiStockMap = [];

        try {
            $res = Http::timeout(12)->acceptJson()->get($abmStockUrl);

            if ($res->ok()) {
                $json = $res->json();

                if (!empty($json['success']) && !empty($json['data']) && is_array($json['data'])) {
                    foreach ($json['data'] as $row) {
                        $pno = strtoupper(trim((string)($row['part_no'] ?? '')));
                        $wh  = trim((string)($row['warehouse_name'] ?? ''));
                        $qty = (int)($row['closing_stock'] ?? 0);

                        if ($pno !== '' && $wh !== '') {
                            $m41ApiStockMap[$pno][$wh] = $qty;
                        }
                    }
                }
            }
        } catch (\Throwable $e) {
            $m41ApiStockMap = [];
        }

        $isManager41 = method_exists($this, 'isActingAs41Manager')
            && $this->isActingAs41Manager();

        return view('backend.product.closingStock.index', compact(
            'products',
            'warehouses',
            'search_text',
            'isManager41',
            'm41ApiStockMap',
            'category_group',
            'categories',
            'brands',
            'stock',
            'mrpSort'
        ));
    }

    private function damagedLostQuantitiesByPartNumber($partNumbers)
    {
        $partNumbers = collect($partNumbers)
            ->filter()
            ->map(function ($partNumber) {
                return trim((string) $partNumber);
            })
            ->unique()
            ->values();

        if ($partNumbers->isEmpty()) {
            return [];
        }

        $rows = DamagedLostGoods::query()
            ->select('part_number', 'warehouse_id')
            ->selectRaw("SUM(CASE WHEN LOWER(type) = 'damage' THEN COALESCE(quantity, 0) ELSE 0 END) as damage_qty")
            ->selectRaw("SUM(CASE WHEN LOWER(type) = 'lost' THEN COALESCE(quantity, 0) ELSE 0 END) as lost_qty")
            ->whereIn('part_number', $partNumbers)
            ->groupBy('part_number', 'warehouse_id')
            ->get();

        $quantities = [];
        foreach ($rows as $row) {
            $partNumber = strtoupper(trim((string) $row->part_number));
            $quantities[$partNumber][(int) $row->warehouse_id] = [
                'damage' => (float) $row->damage_qty,
                'lost'   => (float) $row->lost_qty,
            ];
        }

        return $quantities;
    }

    public function damagedLostGoods(Request $request)
    {
        $search_text      = trim((string) $request->search_text);
        $categoryGroupIds = array_values(array_filter((array) $request->category_group_id));
        $categoryIds      = array_values(array_filter((array) $request->category_id));
        $brandIds         = array_values(array_filter((array) $request->brand_id));
        $warehouseIds     = array_values(array_filter((array) $request->warehouse_id));
        $types            = array_values(array_filter((array) $request->type));

        // Every filter option must belong to at least one damage/lost-goods row.
        $damagedProductIds = DamagedLostGoods::query()
            ->whereNotNull('product_id')
            ->distinct()
            ->pluck('product_id');

        $category_group = CategoryGroup::query()
            ->whereIn('id', DamagedLostGoods::query()
                ->select('category_group_id')
                ->whereNotNull('category_group_id')
                ->distinct())
            ->orderBy('name')
            ->get();

        $categories = Category::query()
            ->whereIn('id', DamagedLostGoods::query()
                ->select('category_id')
                ->whereNotNull('category_id')
                ->distinct())
            ->when($categoryGroupIds, function ($query) use ($categoryGroupIds) {
                $query->whereIn('parent_id', $categoryGroupIds);
            })
            ->orderBy('name')
            ->get();

        $brands = Brand::query()
            ->whereIn('id', Product::query()
                ->select('brand_id')
                ->whereIn('id', $damagedProductIds)
                ->whereNotNull('brand_id')
                ->distinct())
            ->orderBy('name')
            ->get();

        $warehouses = Warehouse::query()
            ->whereIn('id', DamagedLostGoods::query()
                ->select('warehouse_id')
                ->whereNotNull('warehouse_id')
                ->distinct())
            ->orderBy('id')
            ->get();

        $availableTypes = DamagedLostGoods::query()
            ->whereNotNull('type')
            ->where('type', '<>', '')
            ->distinct()
            ->orderBy('type')
            ->pluck('type');

        $allProducts = Product::withoutGlobalScopes()
            ->select('id', 'name', 'part_no')
            ->orderBy('name')
            ->get();

        $formWarehouses = Warehouse::query()
            ->where('active', 1)
            ->orderBy('name')
            ->get();

        $products = DamagedLostGoods::query()
            ->select('product_id', 'type')
            ->selectRaw('MAX(part_number) as part_number')
            ->selectRaw('SUM(COALESCE(quantity, 0)) as total_quantity')
            ->with(['product.brand', 'product.category', 'product.categoryGroup'])
            ->when($categoryGroupIds, function ($query) use ($categoryGroupIds) {
                $query->whereIn('category_group_id', $categoryGroupIds);
            })
            ->when($categoryIds, function ($query) use ($categoryIds) {
                $query->whereIn('category_id', $categoryIds);
            })
            ->when($brandIds, function ($query) use ($brandIds) {
                $query->whereHas('product', function ($productQuery) use ($brandIds) {
                    $productQuery->whereIn('brand_id', $brandIds);
                });
            })
            ->when($warehouseIds, function ($query) use ($warehouseIds) {
                $query->whereIn('warehouse_id', $warehouseIds);
            })
            ->when($types, function ($query) use ($types) {
                $query->whereIn('type', $types);
            })
            ->when($search_text !== '', function ($query) use ($search_text) {
                $query->where(function ($searchQuery) use ($search_text) {
                    $searchQuery->where('part_number', 'like', '%' . $search_text . '%')
                        ->orWhereHas('product', function ($productQuery) use ($search_text) {
                            $productQuery->where('name', 'like', '%' . $search_text . '%')
                                ->orWhere('part_no', 'like', '%' . $search_text . '%');
                        });
                });
            })
            ->groupBy('product_id', 'type')
            ->orderBy('part_number')
            ->paginate(15);

        // Keep the main row grouped, but expose each warehouse's summed quantity.
        $pageProductIds = $products->getCollection()->pluck('product_id')->unique()->values();
        $pageTypes      = $products->getCollection()->pluck('type')->unique()->values();

        $warehouseQuantities = DamagedLostGoods::query()
            ->select('product_id', 'type', 'warehouse_id')
            ->selectRaw('SUM(COALESCE(quantity, 0)) as quantity')
            ->whereIn('product_id', $pageProductIds)
            ->whereIn('type', $pageTypes)
            ->groupBy('product_id', 'type', 'warehouse_id')
            ->get()
            ->groupBy(function ($row) {
                return $row->product_id . '|' . $row->type;
            });

        $products->getCollection()->transform(function ($row) use ($warehouseQuantities) {
            $key = $row->product_id . '|' . $row->type;
            $row->warehouse_quantities = $warehouseQuantities->get($key, collect())
                ->pluck('quantity', 'warehouse_id');
            $row->total_quantity = $row->warehouse_quantities->sum();
            return $row;
        });

        return view('backend.product.damagedLostGoods.index', compact(
            'products',
            'warehouses',
            'search_text',
            'category_group',
            'categories',
            'brands',
            'availableTypes',
            'allProducts',
            'formWarehouses'
        ));
    }

    public function submitDamagedLostGoods(Request $request)
    {
        $validated = $request->validate([
            'product_id'   => 'required|integer|exists:products,id',
            'type'         => 'required|in:damage,lost',
            'warehouse_id' => 'required|integer|exists:warehouses,id',
            'quantity'     => 'required|numeric|gt:0',
        ]);

        $product = Product::withoutGlobalScopes()->findOrFail($validated['product_id']);
        $availableStock = $this->productStockForWarehouse($product, $validated['warehouse_id']);

        if ((float) $validated['quantity'] > $availableStock) {
            return redirect()->back()->withInput()->withErrors([
                'quantity' => translate('Quantity cannot be greater than the available warehouse stock') . ' (' . $availableStock . ').',
            ]);
        }

        $damagedLostGoods = new DamagedLostGoods();
        $damagedLostGoods->product_id       = $product->id;
        $damagedLostGoods->category_group_id = $product->group_id;
        $damagedLostGoods->category_id      = $product->category_id;
        $damagedLostGoods->brand_id         = $product->brand_id;
        $damagedLostGoods->type             = $validated['type'];
        $damagedLostGoods->warehouse_id     = $validated['warehouse_id'];
        $damagedLostGoods->part_number      = $product->part_no;
        $damagedLostGoods->quantity         = $validated['quantity'];
        $damagedLostGoods->save();

        // ✅ Call inventory update logic
        $requestSubmit = new \Illuminate\Http\Request();
        $requestSubmit->merge([
            'product_id' => $product->id
        ]);
        $this->inventoryProductEntry($requestSubmit);

        return redirect()->back()->with('success', translate('Damaged / lost product added successfully'));
    }

    public function getProductStockByWarehouse(Request $request)
    {
        $validated = $request->validate([
            'product_id'   => 'required|integer|exists:products,id',
            'warehouse_id' => 'required|integer|exists:warehouses,id',
        ]);

        $product = Product::withoutGlobalScopes()->findOrFail($validated['product_id']);
        $warehouse = Warehouse::findOrFail($validated['warehouse_id']);
        $productApi = ProductApi::query()
            ->where('part_no', $product->part_no)
            ->where('godown', $warehouse->name)
            ->first();

        return response()->json([
            'success'        => true,
            'product_id'     => $product->id,
            'part_no'        => $product->part_no,
            'warehouse_id'   => $warehouse->id,
            'godown'         => $warehouse->name,
            'stock_quantity' => max(0, (float) optional($productApi)->closing_stock),
            'data'           => $productApi,
        ]);
    }

    private function productStockForWarehouse(Product $product, $warehouseId)
    {
        $warehouse = Warehouse::findOrFail($warehouseId);

        return max(0, (float) ProductApi::query()
            ->where('part_no', $product->part_no)
            ->where('godown', $warehouse->name)
            ->value('closing_stock'));
    }

    public function editDamagedLostGoods(Request $request)
    {
        $validated = $request->validate([
            'original_product_id'   => 'required|integer|exists:products,id',
            'original_type'         => 'required|in:damage,lost',
            'original_warehouse_id' => 'required|integer|exists:warehouses,id',
            'product_id'            => 'required_unless:action,delete|nullable|integer|exists:products,id',
            'type'                  => 'required_unless:action,delete|nullable|in:damage,lost',
            'warehouse_id'          => 'required_unless:action,delete|nullable|integer|exists:warehouses,id',
            'quantity'              => 'required_unless:action,delete|nullable|numeric|min:0',
            'action'                => 'nullable|in:update,delete',
        ]);

        $isDelete = ($validated['action'] ?? 'update') === 'delete'
            || (float) ($validated['quantity'] ?? 0) === 0.0;
        $originalProductId = (int) $validated['original_product_id'];
        $productId = $isDelete ? $originalProductId : (int) $validated['product_id'];
        $product = Product::withoutGlobalScopes()->findOrFail($productId);

        if (!$isDelete) {
            $availableStock = $this->productStockForWarehouse($product, $validated['warehouse_id']);
            if ((float) $validated['quantity'] > $availableStock) {
                return redirect()->back()->withInput()->withErrors([
                    'quantity' => translate('Quantity cannot be greater than the available warehouse stock') . ' (' . $availableStock . ').',
                ]);
            }
        }

        DB::transaction(function () use ($validated, $isDelete, $product) {
            DamagedLostGoods::query()
                ->where('product_id', $validated['original_product_id'])
                ->where('type', $validated['original_type'])
                ->where('warehouse_id', $validated['original_warehouse_id'])
                ->delete();

            if (!$isDelete) {
                $row = new DamagedLostGoods();
                $row->product_id = $product->id;
                $row->category_group_id = $product->group_id;
                $row->category_id = $product->category_id;
                $row->brand_id = $product->brand_id;
                $row->type = $validated['type'];
                $row->warehouse_id = $validated['warehouse_id'];
                $row->part_number = $product->part_no;
                $row->quantity = $validated['quantity'];
                $row->save();
            }
        });

        foreach (array_unique([$originalProductId, $product->id]) as $inventoryProductId) {
            $requestSubmit = new \Illuminate\Http\Request();
            $requestSubmit->merge(['product_id' => $inventoryProductId]);
            $this->inventoryProductEntry($requestSubmit);
        }

        return redirect()->back()->with('success', $isDelete
            ? translate('Damaged / lost product deleted successfully')
            : translate('Damaged / lost product updated successfully'));
    }

    public function exportDamagedLostGoods(Request $request)
    {
        $searchText      = trim((string) $request->search_text);
        $categoryGroups  = array_values(array_filter((array) $request->category_group_id));
        $categories      = array_values(array_filter((array) $request->category_id));
        $brands          = array_values(array_filter((array) $request->brand_id));
        $warehouseIds    = array_values(array_filter((array) $request->warehouse_id));
        $types           = array_values(array_filter((array) $request->type));

        $warehouses = Warehouse::query()
            ->whereIn('id', DamagedLostGoods::query()->select('warehouse_id')->distinct())
            ->orderBy('id')
            ->get();

        $rows = DamagedLostGoods::query()
            ->select('product_id', 'type')
            ->selectRaw('MAX(part_number) as part_number')
            ->with(['product.brand', 'product.category', 'product.categoryGroup'])
            ->when($categoryGroups, function ($query) use ($categoryGroups) {
                $query->whereIn('category_group_id', $categoryGroups);
            })
            ->when($categories, function ($query) use ($categories) {
                $query->whereIn('category_id', $categories);
            })
            ->when($brands, function ($query) use ($brands) {
                $query->whereHas('product', function ($productQuery) use ($brands) {
                    $productQuery->whereIn('brand_id', $brands);
                });
            })
            ->when($warehouseIds, function ($query) use ($warehouseIds) {
                $query->whereIn('warehouse_id', $warehouseIds);
            })
            ->when($types, function ($query) use ($types) {
                $query->whereIn('type', $types);
            })
            ->when($searchText !== '', function ($query) use ($searchText) {
                $query->where(function ($searchQuery) use ($searchText) {
                    $searchQuery->where('part_number', 'like', '%' . $searchText . '%')
                        ->orWhereHas('product', function ($productQuery) use ($searchText) {
                            $productQuery->where('name', 'like', '%' . $searchText . '%')
                                ->orWhere('part_no', 'like', '%' . $searchText . '%');
                        });
                });
            })
            ->groupBy('product_id', 'type')
            ->orderBy('part_number')
            ->get();

        $quantities = DamagedLostGoods::query()
            ->select('product_id', 'type', 'warehouse_id')
            ->selectRaw('SUM(COALESCE(quantity, 0)) as quantity')
            ->whereIn('product_id', $rows->pluck('product_id')->unique())
            ->whereIn('type', $rows->pluck('type')->unique())
            ->groupBy('product_id', 'type', 'warehouse_id')
            ->get()
            ->groupBy(function ($row) {
                return $row->product_id . '|' . $row->type;
            });

        $fileName = 'damageProdctList_' . date('d-m-Y_H-i-s') . '.csv';

        return response()->streamDownload(function () use ($rows, $warehouses, $quantities) {
            $output = fopen('php://output', 'w');
            fwrite($output, "\xEF\xBB\xBF");

            $header = ['Part No', 'Item Name', 'Type', 'Category Group', 'Category', 'Brand'];
            foreach ($warehouses as $warehouse) {
                $header[] = $warehouse->name;
            }
            $header[] = 'Total Quantity';
            fputcsv($output, $header);

            foreach ($rows as $row) {
                $warehouseQuantities = $quantities
                    ->get($row->product_id . '|' . $row->type, collect())
                    ->pluck('quantity', 'warehouse_id');

                $csvRow = [
                    $row->part_number ?: optional($row->product)->part_no,
                    optional($row->product)->name,
                    ucfirst(str_replace('_', ' ', $row->type)),
                    optional(optional($row->product)->categoryGroup)->name,
                    optional(optional($row->product)->category)->name,
                    optional(optional($row->product)->brand)->name,
                ];

                foreach ($warehouses as $warehouse) {
                    $csvRow[] = $warehouseQuantities->get($warehouse->id, 0);
                }
                $csvRow[] = $warehouseQuantities->sum();
                fputcsv($output, $csvRow);
            }

            fclose($output);
        }, $fileName, ['Content-Type' => 'text/csv; charset=UTF-8']);
    }

    private function manager41GetStockTransaction(Request $request)
    {
        $warehouseId   = (int) $request->warehouseId;
        $part_no       = trim($request->part_no ?? '');
        $warehouseName = $request->warehouseName; // godown = warehouse name in 41 stock
        $combinedData  = [];

        if ($part_no === '' || !$warehouseId) {
            return response()->json($combinedData);
        }

        // Load 41 stock row for this part/warehouse-name (godown)
        $stockData = Manager41ProductStock::with([
                'openingProductStock',                 // Manager41OpeningStock
                'purchaseQty.purchaseInvoice.address',// Manager41PurchaseInvoice(+address)
            ])
            ->where('part_no', $part_no)
            ->where('godown', $warehouseName)
            ->first();

        if (!$stockData) {
            return response()->json($combinedData);
        }

        /* ========== Opening Stock (41) ========== */
        // hasOne -> use get() for parity with your old code; sum() still works
        $openingRows = $stockData->openingProductStockQtyForWarehouse($warehouseId)->get();
        if ($openingRows->isNotEmpty()) {
            $combinedData[] = [
                'type'           => 'Opening Stock',
                'quantity'       => (float) $openingRows->sum('closing_stock'),
                'created_at'     => date('Y') . '-04-01', // FY start
                'details'        => $stockData->openingProductStock,
                'voucher_number' => '',
                'party_name'     => '',
            ];
        }

        /* ========== Purchases & Credit Notes (41) ========== */
        $purchaseDetails = $stockData->purchaseQtyForWarehouse($warehouseId)->get();
        foreach ($purchaseDetails as $pd) {
            $pi = $pd->purchaseInvoice; // may be null if data inconsistent
            if (!$pi) {
                continue;
            }

            // Type
            $type = ($pi->purchase_invoice_type === 'seller') ? 'Purchase' : 'Credit Note';

            // Voucher number
            $voucher = '';
            if ($pi->purchase_invoice_type === 'seller') {
                $voucher = $pd->purchase_invoice_no ?: $pi->purchase_no;
            } else {
                $voucher = $pi->credit_note_number ?: $pi->purchase_no;
            }

            // Party name
            $party = '';
            if ($pi->purchase_invoice_type === 'seller') {
                $si = $pi->seller_info; // cast to array in Model; keep defensive
                if (is_string($si)) {
                    $decoded = json_decode($si, true);
                    $party   = $decoded['seller_name'] ?? '';
                } elseif (is_array($si)) {
                    $party = $si['seller_name'] ?? '';
                }
            } else {
                $party = optional($pi->address)->company_name ?? '';
            }

            $combinedData[] = [
                'type'           => $type,
                'quantity'       => (float) ($pd->qty ?? 0),
                'created_at'     => optional($pd->created_at)->format('Y-m-d'),
                'details'        => $pd,
                'voucher_number' => $voucher ?: '',
                'party_name'     => $party,
            ];
        }

        /* ========== Sales from Challans ONLY (41) ========== */
        $saleRows = $stockData->saleQtyForWarehouse($warehouseId)
            ->with(['challan.address'])
            ->get();

        foreach ($saleRows as $row) {
            $challan = $row->challan;

            // Party from challan address, else decode shipping_address (array/json)
            $party = '';
            if ($challan && $challan->address) {
                $party = $challan->address->company_name ?? '';
            } else {
                $sa = $challan->shipping_address ?? null;
                if (is_string($sa)) {
                    $decoded = json_decode($sa, true);
                    $party   = $decoded['company_name'] ?? '';
                } elseif (is_array($sa)) {
                    $party = $sa['company_name'] ?? '';
                }
            }

            if ($party !== '') {
                $combinedData[] = [
                    'type'           => 'Challan', // strictly challan-based sales
                    'quantity'       => (float) ($row->quantity ?? 0),
                    'created_at'     => ($challan && $challan->challan_date)
                        ? date('Y-m-d', strtotime($challan->challan_date))
                        : optional($row->created_at)->format('Y-m-d'),
                    'details'        => $challan ?? $row,
                    'voucher_number' => $challan->challan_no ?? '-',
                    'party_name'     => $party,
                    'challan_id_'    => $row->challan_id,
                ];
            }
        }

        /* ========== Sort & Return ========== */
        usort($combinedData, function ($a, $b) {
            return strtotime($a['created_at']) <=> strtotime($b['created_at']);
        });

        return response()->json($combinedData);
    }

  public function getStockTransaction(Request $request)
  {

    // Manager-41 login/impersonation पर सीधे Manager-41 वाला flow
    if ($this->isActingAs41Manager()) {
        return $this->manager41GetStockTransaction($request);
    }
      $warehouseId = $request->warehouseId;
      $part_no = $request->part_no;
      $warehouseName = $request->warehouseName;
      $combinedData = [];

      $stockData = ProductApi::with('openingProductStock', 'purchaseQty', 'saleQty.challan')
          ->where('part_no', $part_no)
          ->where('godown', $warehouseName)
          ->first();

      if (!$stockData) {
          return response()->json($combinedData);
      }      
      $openingQty = $stockData ? $stockData->openingProductStockQtyForWarehouse($warehouseId)->get() : collect();
      $today = now(); // or Carbon::now()
      //$fyStartYear = $today->month >= 4 ? $today->year : ($today->year - 1);
      $fyStartDate = sprintf('2025-04-01');
      if ($openingQty) {
          $combinedData[] = [
              'type' => 'Opening Stock',
              'quantity' => $openingQty->sum('closing_stock') ?? 0,
            //   'created_at' => date('Y') . '-04-01',
              'created_at' => $fyStartDate,
              'details' => $stockData->openingProductStock,
              'voucher_number' => '',
              'party_name' => ''
          ];
      }

      // Purchase Quantity
      $purchaseQty = $stockData ? $stockData->purchaseQtyForWarehouse($warehouseId)->get() : collect();
      foreach ($purchaseQty as $purchase) {
          $number = $purchase->purchaseInvoice->purchase_invoice_type == 'seller' ? $purchase->purchase_invoice_no : $purchase->purchaseInvoice->credit_note_number;
          $party_name = '';
          
          if ($purchase->purchaseInvoice->purchase_invoice_type == 'seller') {
            $sellerInfo = $purchase->purchaseInvoice->seller_info;
              if (is_string($sellerInfo)) {
                  $decoded = json_decode($sellerInfo, true);
                  $party_name = $decoded['seller_name'] ?? '';
              } elseif (is_array($sellerInfo)) {
                  $party_name = $sellerInfo['seller_name'] ?? '';
              }
          }else{
              $sellerInfo = $purchase->purchaseInvoice->address;
              $party_name = $sellerInfo->company_name ?? '';
          }

          $combinedData[] = [
              'type' => $purchase->purchaseInvoice->purchase_invoice_type == 'seller'?'Purchase':'Credit Note',
              'quantity' => $purchase->qty ?? 0,
              'created_at' => $purchase->created_at,
              'details' => $purchase,
              'voucher_number' => $number,
              'party_name' => $party_name
          ];
      }

      // Debit Note Quantity
      $debitNoteQty = $stockData ? $stockData->debitNoteQtyForWarehouse($warehouseId)->get() : collect();
      foreach ($debitNoteQty as $debitNote) {
          $number = $debitNote->debitNoteInvoice->debit_note_no;
          
          if ($debitNote->debitNoteInvoice->debit_note_type == 'seller') {
            $sellerInfo = $debitNote->debitNoteInvoice->seller_info;
              if (is_string($sellerInfo)) {
                  $decoded = json_decode($sellerInfo, true);
                  $party_name = $decoded['seller_name'] ?? '';
              } elseif (is_array($sellerInfo)) {
                  $party_name = $sellerInfo['seller_name'] ?? '';
              }
          }else{
              $sellerInfo = $debitNote->debitNoteInvoice->address;
              $party_name = $sellerInfo->company_name ?? '';
          }

          $combinedData[] = [
              'type' => $debitNote->debitNoteInvoice->debit_note_type == 'seller'?'Debit Note':'Debit Note',
              'quantity' => $debitNote->qty ?? 0,
              'created_at' => $debitNote->created_at,
              'details' => $debitNote,
              'voucher_number' => $debitNote->debitNoteInvoice->debit_note_number,
              'party_name' => $party_name
          ];
      }


      // Sale Quantity
      $saleQty = $stockData ? $stockData->saleQtyForWarehouse($warehouseId)->get() : collect();
      
      foreach ($saleQty as $sale) {
        //   $party_name = "-";
          $details = null;
          // echo "<br>".$sale->challan->id.;
          if ($sale->challan->invoice_status == 1) {
              $details = InvoiceOrderDetail::where('part_no', $part_no)
                  ->where('challan_id', $sale->challan_id)
                  ->whereHas('invoiceOrder', function ($q) {
                      $q->where('invoice_cancel_status', 0);
                  })
                  ->first();
              $number = $details->invoiceOrder->invoice_no ?? '-';
              $sellerInfo = $details->invoiceOrder->party_info ?? '-';
              if (is_string($sellerInfo)) {
                  $decoded = json_decode($sellerInfo, true);
                  $party_name = $decoded['company_name'] ?? '';
              } elseif (is_array($sellerInfo)) {
                  $party_name = $sellerInfo['company_name'] ?? '';
              }
          } else {
              $details = $sale->challan;
              $number = $sale->challan->challan_no ?? '-';
              $sellerInfo = $details->shipping_address;
              if (is_string($sellerInfo)) {
                  $decoded = json_decode($sellerInfo, true);
                  $party_name = $decoded['company_name'] ?? '';
              } elseif (is_array($sellerInfo)) {
                  $party_name = $sellerInfo['company_name'] ?? '';
              }              
          }
          // echo "<br>".$sale->challan->id.'----'.$sale->challan->invoice_status.'......'.$party_name;
          if($party_name != ""){
            $combinedData[] = [
                'type' => $sale->challan->invoice_status == 1 ? 'Invoice' : 'Challan',
                'quantity' => $sale->quantity,
                'created_at' => date('Y-m-d', strtotime(
                    $details->invoiceOrder->created_at ?? $details->created_at
                )),
                'details' => $details,
                'voucher_number' => $number,
                'party_name' => $party_name,
                'challan_id_' => $sale->challan->id
            ];
          }          
      }
      // echo "<pre>"; print_r($combinedData);
      // die;

      usort($combinedData, function ($a, $b) {
          return strtotime($a['created_at']) <=> strtotime($b['created_at']);
      });

      return response()->json($combinedData);
  }
  

  public function manager41closingStockExport(Request $request)
{
    $search = trim($request->search_text ?? '');

    // Active warehouses
    $warehouses = Warehouse::where('active', 1)->orderBy('id', 'ASC')->get();

    // Base: Manager-41 product stocks
    $productsQ = Manager41ProductStock::with([
        // Pull related product to access category/categoryGroup names
        'productDetails.categoryGroup',
        'productDetails.category',
    ]);

    if ($search !== '') {
        $productsQ->where(function ($q) use ($search) {
            $q->where('part_no', 'like', "%{$search}%")
              ->orWhere('name', 'like', "%{$search}%");
        });
    }

    // Distinct part_no + name (safe for pagination/export)
    $products = $productsQ
        ->select('part_no', 'name')
        ->distinct()
        ->orderBy('name', 'ASC')
        ->get();

    // For each product, compute per-warehouse stats
    $products->transform(function ($product) use ($warehouses) {
        $warehouseData = [];

        foreach ($warehouses as $warehouse) {
            // manager_41_product_stocks.godown stores the WAREHOUSE NAME
            $stockData = Manager41ProductStock::with([
                    'openingProductStock',
                ])
                ->where('part_no', $product->part_no)
                ->where('godown', $warehouse->name)
                ->first();

            // Purchases & sales are drawn via Manager-41 relations
            $purchaseQty = $stockData
                ? $stockData->purchaseQtyForWarehouse($warehouse->id)->get()
                : collect();

            $saleQty = $stockData
                ? $stockData->saleQtyForWarehouse($warehouse->id)->get()
                : collect();

            $warehouseData[] = [
                'warehouse_id'    => $warehouse->id,
                'warehouse_name'  => $warehouse->name,
                'branch_stock'    => $stockData ? (float)$stockData->closing_stock : 0.0,
                'opening_stock'   => $stockData && $stockData->openingProductStock
                                        ? (float)$stockData->openingProductStock->closing_stock
                                        : 0.0,
                'purchase_qty'    => (float)$purchaseQty->sum('qty'),
                'sale_qty'        => (float)$saleQty->sum('quantity'),
            ];
        }

        $product->warehouse = $warehouseData;
        return $product;
    });

    // Shape rows for export
    $processedData = [];
    foreach ($products as $product) {
        $totalStock = 0;
        $kolkata = 0; $delhi = 0; $mumbai = 0;

        foreach ($product->warehouse as $w) {
            $totalStock += $w['branch_stock'];
            if ($w['warehouse_id'] == 1) {
                $kolkata = $w['branch_stock'];
            } elseif ($w['warehouse_id'] == 2) {
                $delhi = $w['branch_stock'];
            } elseif ($w['warehouse_id'] == 6) {
                $mumbai = $w['branch_stock'];
            }
        }

        $processedData[] = [
            'Part No'        => $product->part_no,
            'Item Name'      => $product->name,
            'MRP' => (is_numeric(optional($product->productDetails)->mrp_41_price) ? (float) optional($product->productDetails)->mrp_41_price : 0.0),

            'Category Group' => optional(optional($product->productDetails)->categoryGroup)->name ?? '',
            'Category'       => optional(optional($product->productDetails)->category)->name ?? '',
            'Kolkata'        => $kolkata,
            'Delhi'          => $delhi,
            'Mumbai'         => $mumbai,
            'Total Stock'    => $totalStock,
        ];
    }

    // Filename: differentiate if you like
       $filename = 'closingStock41_'
        . now('Asia/Kolkata')->format('Y-m-d_H-i-s_u') // microsecond precision
        . '_' . Str::random(6)
        . '.xlsx';

    return Excel::download(
        new ClosingStockExport($processedData),
        $filename,
        ExcelWriter::XLSX,
        [
            'Cache-Control' => 'no-store, no-cache, must-revalidate, max-age=0',
            'Pragma'        => 'no-cache',
            'Expires'       => '0',
        ]
    );

}

public function closingStockExportCombined(Request $request)
{
    $search_text = $request->search_text;

    $categoryGroupIds = array_values(array_filter((array) $request->category_group_id));
    $categoryIds      = array_values(array_filter((array) $request->category_id));
    $brandIds         = array_values(array_filter((array) $request->brand_id));
    $stock            = $request->stock;
    $mrpSort          = $request->mrp_sort;

    $warehouses = Warehouse::where('active', 1)->orderBy('id', 'ASC')->get();

    $productsQ = ProductApi::with([
        'productDetails.brand',
        'productDetails.categoryGroup',
        'productDetails.category',
    ]);

    if (!empty($search_text)) {
        $productsQ->where(function ($q) use ($search_text) {
            $q->where('part_no', 'like', "%$search_text%")
              ->orWhere('name', 'like', "%$search_text%");
        });
    }

    if (!empty($categoryGroupIds)) {
        $productsQ->whereHas('productDetails', function ($q) use ($categoryGroupIds) {
            $q->whereIn('group_id', $categoryGroupIds);
        });
    }

    if (!empty($categoryIds)) {
        $productsQ->whereHas('productDetails', function ($q) use ($categoryIds) {
            $q->whereIn('category_id', $categoryIds);
        });
    }

    if (!empty($brandIds)) {
        $productsQ->whereHas('productDetails', function ($q) use ($brandIds) {
            $q->whereIn('brand_id', $brandIds);
        });
    }

    $products = $productsQ
        ->select('part_no', 'name')
        ->distinct()
        ->orderBy('name', 'ASC')
        ->get();

    $abmStockUrl = 'https://abm.spurspaces.com/manager41/stocks/available';
    $m41ApiStockMap = [];

    try {
        $res = Http::timeout(12)->acceptJson()->get($abmStockUrl);

        if ($res->ok()) {
            $json = $res->json();

            if (!empty($json['success']) && !empty($json['data']) && is_array($json['data'])) {
                foreach ($json['data'] as $row) {
                    $pno = strtoupper(trim((string)($row['part_no'] ?? '')));
                    $wh  = trim((string)($row['warehouse_name'] ?? ''));
                    $qty = (int)($row['closing_stock'] ?? 0);

                    if ($pno !== '' && $wh !== '') {
                        $m41ApiStockMap[$pno][$wh] = $qty;
                    }
                }
            }
        }
    } catch (\Throwable $e) {
        $m41ApiStockMap = [];
    }

    $processedData = [];

    foreach ($products as $product) {
        $totalStock = 0;
        $kolkata = 0;
        $delhi   = 0;
        $mumbai  = 0;

        foreach ($warehouses as $warehouse) {
            $stockData = ProductApi::with([
                    'openingProductStock',
                    'purchaseQty',
                    'saleQty.challan'
                ])
                ->where('part_no', $product->part_no)
                ->where('godown', $warehouse->name)
                ->first();

            $saleQty = $stockData
                ? $stockData->saleQtyForWarehouse($warehouse->id)->get()
                : collect();

            $purchaseQty = $stockData
                ? $stockData->purchaseQtyForWarehouse($warehouse->id)->get()
                : collect();

            $openingQty = $stockData
                ? $stockData->openingProductStockQtyForWarehouse($warehouse->id)->get()
                : collect();

            $debitNoteQty = $stockData
                ? $stockData->debitNoteQtyForWarehouse($warehouse->id)->get()
                : collect();

            $localQty = ($openingQty->sum('closing_stock') + $purchaseQty->sum('qty'))
                        - ($debitNoteQty->sum('qty') + $saleQty->sum('quantity'));

            $localQty = max(0, $localQty);

            $pnoApi = strtoupper(trim((string) $product->part_no));
            $whName = (string) $warehouse->name;
            $apiQty = (int) ($m41ApiStockMap[$pnoApi][$whName] ?? 0);

            $qty = $localQty + $apiQty;
            $qty = max(0, $qty);

            $totalStock += $qty;

            if ((int) $warehouse->id === 1) {
                $kolkata = $qty;
            } elseif ((int) $warehouse->id === 2) {
                $delhi = $qty;
            } elseif ((int) $warehouse->id === 6) {
                $mumbai = $qty;
            }
        }

        if ($stock !== null && $stock !== '' && $stock != 2) {
            if ($stock == 1 && $totalStock <= 0) {
                continue;
            }

            if ($stock == 0 && $totalStock > 0) {
                continue;
            }
        }

        $mrp = optional($product->productDetails)->mrp ?? 0;
        $value = $mrp * $totalStock;

        $processedData[] = [
            'Part No'        => $product->part_no,
            'Item Name'      => $product->name,
            'Brand'          => optional(optional($product->productDetails)->brand)->name ?? '',
            'Mrp'            => $mrp,
            'Category Group' => optional(optional($product->productDetails)->categoryGroup)->name ?? '',
            'Category'       => optional(optional($product->productDetails)->category)->name ?? '',
            'Kolkata'        => $kolkata,
            'Delhi'          => $delhi,
            'Mumbai'         => $mumbai,
            'Total Stock'    => $totalStock,
            'Value'          => $value,
        ];
    }

    if ($mrpSort == 'high_to_low') {
        usort($processedData, function ($a, $b) {
            return $b['Value'] <=> $a['Value'];
        });
    } elseif ($mrpSort == 'low_to_high') {
        usort($processedData, function ($a, $b) {
            return $a['Value'] <=> $b['Value'];
        });
    }

    return Excel::download(
        new ClosingStockExport($processedData),
        'closingStock_combined_' . date('d-m-Y') . '.xlsx'
    );
}
public function closingStockExport(Request $request)
{
    if (method_exists($this, 'isActingAs41Manager') && $this->isActingAs41Manager()) {
        return $this->manager41closingStockExport($request);
    }

    if ($request->get('export_type') === 'combined') {
        return $this->closingStockExportCombined($request);
    }

    $search_text = $request->search_text;

    $categoryGroupIds = array_values(array_filter((array) $request->category_group_id));
    $categoryIds      = array_values(array_filter((array) $request->category_id));
    $brandIds         = array_values(array_filter((array) $request->brand_id));
    $stock            = $request->stock;
    $mrpSort          = $request->mrp_sort;

    $warehouses = Warehouse::where('active', 1)->orderBy('id', 'ASC')->get();

    $productsQ = ProductApi::with([
        'productDetails.brand',
        'productDetails.categoryGroup',
        'productDetails.category',
    ]);

    if (!empty($search_text)) {
        $productsQ->where(function ($q) use ($search_text) {
            $q->where('part_no', 'like', "%$search_text%")
              ->orWhere('name', 'like', "%$search_text%");
        });
    }

    if (!empty($categoryGroupIds)) {
        $productsQ->whereHas('productDetails', function ($q) use ($categoryGroupIds) {
            $q->whereIn('group_id', $categoryGroupIds);
        });
    }

    if (!empty($categoryIds)) {
        $productsQ->whereHas('productDetails', function ($q) use ($categoryIds) {
            $q->whereIn('category_id', $categoryIds);
        });
    }

    if (!empty($brandIds)) {
        $productsQ->whereHas('productDetails', function ($q) use ($brandIds) {
            $q->whereIn('brand_id', $brandIds);
        });
    }

    $products = $productsQ
        ->select('part_no', 'name')
        ->distinct()
        ->orderBy('name', 'ASC')
        ->get();

    $processedData = [];

    foreach ($products as $product) {
        $totalStock = 0;
        $kolkata = 0;
        $delhi   = 0;
        $mumbai  = 0;

        foreach ($warehouses as $warehouse) {
            $stockData = ProductApi::with([
                    'openingProductStock',
                    'purchaseQty',
                    'saleQty.challan'
                ])
                ->where('part_no', $product->part_no)
                ->where('godown', $warehouse->name)
                ->first();

            $saleQty = $stockData
                ? $stockData->saleQtyForWarehouse($warehouse->id)->get()
                : collect();

            $purchaseQty = $stockData
                ? $stockData->purchaseQtyForWarehouse($warehouse->id)->get()
                : collect();

            $openingQty = $stockData
                ? $stockData->openingProductStockQtyForWarehouse($warehouse->id)->get()
                : collect();

            $debitNoteQty = $stockData
                ? $stockData->debitNoteQtyForWarehouse($warehouse->id)->get()
                : collect();

            $qty = ($openingQty->sum('closing_stock') + $purchaseQty->sum('qty'))
                   - ($debitNoteQty->sum('qty') + $saleQty->sum('quantity'));

            $qty = max(0, $qty);

            $totalStock += $qty;

            if ((int) $warehouse->id === 1) {
                $kolkata = $qty;
            } elseif ((int) $warehouse->id === 2) {
                $delhi = $qty;
            } elseif ((int) $warehouse->id === 6) {
                $mumbai = $qty;
            }
        }

        if ($stock !== null && $stock !== '' && $stock != 2) {
            if ($stock == 1 && $totalStock <= 0) {
                continue;
            }

            if ($stock == 0 && $totalStock > 0) {
                continue;
            }
        }

        $mrp = optional($product->productDetails)->mrp ?? 0;
        $value = $mrp * $totalStock;

        $processedData[] = [
            'Part No'        => $product->part_no,
            'Item Name'      => $product->name,
            'Brand'          => optional(optional($product->productDetails)->brand)->name ?? '',
            'Mrp'            => $mrp,
            'Category Group' => optional(optional($product->productDetails)->categoryGroup)->name ?? '',
            'Category'       => optional(optional($product->productDetails)->category)->name ?? '',
            'Kolkata'        => $kolkata,
            'Delhi'          => $delhi,
            'Mumbai'         => $mumbai,
            'Total Stock'    => $totalStock,
            'Value'          => $value,
        ];
    }

    if ($mrpSort == 'high_to_low') {
        usort($processedData, function ($a, $b) {
            return $b['Value'] <=> $a['Value'];
        });
    } elseif ($mrpSort == 'low_to_high') {
        usort($processedData, function ($a, $b) {
            return $a['Value'] <=> $b['Value'];
        });
    }

    return Excel::download(
        new ClosingStockExport($processedData),
        'closingStock_' . date('d-m-Y') . '.xlsx'
    );
}


    public function manager41ClosingStockExportDetails(Request $request)
    {
        $warehouseId   = (int)$request->warehouseId;
        $part_no       = trim($request->part_no ?? '');
        $warehouseName = $request->warehouseName;

        $processedData = [];
        $combinedData  = [];

        // Load from Manager-41 stock
        $stockData = Manager41ProductStock::with([
                'openingProductStock',
                'purchaseQty.purchaseInvoice.address',
                'saleQty.challan.address',
            ])
            ->where('part_no', $part_no)
            ->where('godown', $warehouseName) // 41: godown holds warehouse NAME
            ->first();

        // Opening Stock
        $openingQty = $stockData ? $stockData->openingProductStockQtyForWarehouse($warehouseId)->get() : collect();
        $runningBalance = 0;
        if ($openingQty->isNotEmpty()) {
            $sumOpen = (float)$openingQty->sum('closing_stock');
            $drQty = 0.0; $crQty = 0.0;

            if ($sumOpen <= 0) {
                $drQty = $sumOpen;
                $runningBalance -= $drQty;
            } else {
                $crQty = $sumOpen;
                $runningBalance += $crQty;
            }

            $processedData[] = [
                'Date'          => date('Y') . '-04-01',
                'Voucher Type'  => 'Opening Stock',
                'Voucher Number'=> '',
                'Party Name'    => '',
                'DrQty'         => $drQty,
                'CrQty'         => $crQty,
                // 'Running Qty' => $runningBalance
            ];
        }

        // Purchases & Credit Notes (41)
        $purchaseQty = $stockData ? $stockData->purchaseQtyForWarehouse($warehouseId)->get() : collect();
        foreach ($purchaseQty as $purchase) {
            $pi = $purchase->purchaseInvoice;
            if (!$pi) continue;

            $number = ($pi->purchase_invoice_type === 'seller')
                ? ($purchase->purchase_invoice_no ?: $pi->purchase_no)
                : ($pi->credit_note_number ?: $pi->purchase_no);

            // party name
            $party_name = '';
            if ($pi->purchase_invoice_type === 'seller') {
                $sellerInfo = $pi->seller_info;
                if (is_string($sellerInfo)) {
                    $decoded    = json_decode($sellerInfo, true);
                    $party_name = $decoded['seller_name'] ?? '';
                } elseif (is_array($sellerInfo)) {
                    $party_name = $sellerInfo['seller_name'] ?? '';
                }
            } else {
                $party_name = optional($pi->address)->company_name ?? '';
            }

            $drQty = 0.0; $crQty = 0.0;
            $type  = ($pi->purchase_invoice_type === 'seller') ? 'Purchase' : 'Credit Note';

            if ((float)$purchase->qty <= 0) {
                $drQty = (float)$purchase->qty;
                $runningBalance -= $drQty;
            } else {
                $crQty = (float)$purchase->qty;
                $runningBalance += $crQty;
            }

            $combinedData[] = [
                'Date'           => optional($purchase->created_at)->format('Y-m-d'),
                'Voucher Type'   => $type,
                'Voucher Number' => $number,
                'Party Name'     => $party_name,
                'DrQty'          => $drQty,
                'CrQty'          => $crQty,
                // 'Running Qty'  => $runningBalance
            ];
        }

        // Sales from Challans ONLY (no invoice lookups)
        $saleQty = $stockData ? $stockData->saleQtyForWarehouse($warehouseId)->with('challan.address')->get() : collect();
        foreach ($saleQty as $sale) {
            $challan = $sale->challan;

            $number = $challan->challan_no ?? '-';

            // party from challan address or shipping_address (json/array)
            $party_name = '';
            if ($challan && $challan->address) {
                $party_name = $challan->address->company_name ?? '';
            } else {
                $sellerInfo = $challan->shipping_address ?? null;
                if (is_string($sellerInfo)) {
                    $decoded    = json_decode($sellerInfo, true);
                    $party_name = $decoded['company_name'] ?? '';
                } elseif (is_array($sellerInfo)) {
                    $party_name = $sellerInfo['company_name'] ?? '';
                }
            }

            $drQty = 0.0; $crQty = 0.0;
            $type  = 'Challan';

            // sale reduces stock => treat as Dr (subtract)
            if ((float)$sale->quantity >= 0) {
                $drQty = (float)$sale->quantity;
                $runningBalance -= $drQty;
            } else {
                $crQty = (float)$sale->quantity;
                $runningBalance += $crQty;
            }

            $combinedData[] = [
                'Date'           => ($challan && $challan->challan_date)
                                    ? date('Y-m-d', strtotime($challan->challan_date))
                                    : optional($sale->created_at)->format('Y-m-d'),
                'Voucher Type'   => $type,
                'Voucher Number' => $number,
                'Party Name'     => $party_name,
                'DrQty'          => $drQty,
                'CrQty'          => $crQty,
                // 'Running Qty'  => $runningBalance
            ];
        }

        // Sort by date
        usort($combinedData, function ($a, $b) {
            return strtotime($a['Date']) <=> strtotime($b['Date']);
        });

        // Merge and compute running qty column
        $merged = array_merge($processedData, $combinedData);
        $runningBalance = 0.0;
        foreach ($merged as &$row) {
            $runningBalance += (float)$row['CrQty'];
            $runningBalance -= (float)$row['DrQty'];
            $row['Running Qty'] = $runningBalance; // unified key
        }
        unset($row);

        // Closing Stock line
        $drQtyClose = 0.0; $crQtyClose = 0.0;
        if ($runningBalance >= 0) {
            $drQtyClose = $runningBalance;
        } else {
            $crQtyClose = $runningBalance; // keep your original sign logic
        }
        $merged[] = [
            'Date'           => date('Y-m-d'),
            'Voucher Type'   => 'Closing Stock',
            'Voucher Number' => '',
            'Party Name'     => '',
            'DrQty'          => $drQtyClose,
            'CrQty'          => $crQtyClose,
            'Running Qty'    => '',
        ];

        $partNumber = $part_no;
        $itemName   = $stockData->name ?? '';

        return Excel::download(
            new ClosingStockDetailsExport($merged, $partNumber, $itemName),
            $part_no.'-closingStockDetails_'.date('Y-m-d').'.xlsx'
        );
    }
  
  public function closingStockExportDetails(Request $request){


     if (method_exists($this, 'isActingAs41Manager') && $this->isActingAs41Manager()) {
            return $this->manager41ClosingStockExportDetails($request);
     }


    $warehouseId = $request->warehouseId;
    $part_no = $request->part_no;
    $warehouseName = $request->warehouseName;
    $processedData = [];
    $combinedData = [];
    
    $stockData = ProductApi::with('openingProductStock', 'purchaseQty', 'saleQty.challan')
      ->where('part_no', $part_no)
      ->where('godown', $warehouseName)
      ->first();
          
    $openingQty = $stockData ? $stockData->openingProductStockQtyForWarehouse($warehouseId)->get() : collect();
    $runningBalance = 0;
    if ($openingQty) {
        $drQty = 0;
        $crQty = 0;
        if($openingQty->sum('closing_stock') <= 0){
           $drQty = $openingQty->sum('closing_stock');
           $runningBalance -= $drQty;
        }else{
            $crQty = $openingQty->sum('closing_stock');
            $runningBalance += $crQty;
        }
        $today = now(); // or Carbon::now()
        $fyStartYear = $today->month >= 4 ? $today->year : ($today->year - 1);
        $fyStartDate = sprintf('%d-04-01', $fyStartYear);
        $processedData[] = [
            // 'Date' => date('Y') . '-04-01',
            'Date' => $fyStartDate,
            'Voucher Type' => 'Opening Stock',
            'Voucher Number' => '',
            'Party Name' => '',
            'DrQty' => $drQty,
            'CrQty' => $crQty,
            //'Running Qty' => $runningBalance
        ];
    }
    
    // Purchase Quantity
    $purchaseQty = $stockData ? $stockData->purchaseQtyForWarehouse($warehouseId)->get() : collect();
    foreach ($purchaseQty as $purchase) {
      $number = $purchase->purchaseInvoice->purchase_invoice_type == 'seller' ? $purchase->purchase_invoice_no : $purchase->purchaseInvoice->credit_note_number;
      $party_name = '';
      
      if ($purchase->purchaseInvoice->purchase_invoice_type == 'seller') {
        $sellerInfo = $purchase->purchaseInvoice->seller_info;
          if (is_string($sellerInfo)) {
              $decoded = json_decode($sellerInfo, true);
              $party_name = $decoded['seller_name'] ?? '';
          } elseif (is_array($sellerInfo)) {
              $party_name = $sellerInfo['seller_name'] ?? '';
          }
      }else{
          $sellerInfo = $purchase->purchaseInvoice->address;
          $party_name = $sellerInfo->company_name ?? '';
      }
    
      //   $combinedData[] = [
      //       'type' => $purchase->purchaseInvoice->purchase_invoice_type == 'seller'?'Purchase':'Credit Note',
      //       'quantity' => $purchase->qty ?? 0,
      //       'created_at' => $purchase->created_at,
      //       'details' => $purchase,
      //       'voucher_number' => $number,
      //       'party_name' => $party_name
      //   ];
      
        $drQty = 0;
        $crQty = 0;
        $type = $purchase->purchaseInvoice->purchase_invoice_type == 'seller'?'Purchase':'Credit Note';
        if($purchase->qty <= 0){
           $drQty = $purchase->qty;
           $runningBalance -= $drQty;
        }else{
            $crQty = $purchase->qty;
            $runningBalance += $crQty;
        }
        $combinedData[] = [
          'Date' => date('Y-m-d', strToTime($purchase->created_at)),
          'Voucher Type' => $type,
          'Voucher Number' => $number,
          'Party Name' => $party_name,
          'DrQty' => $drQty,
          'CrQty' => $crQty,
          //'Running Qty' => $runningBalance
        ];
    }
        
    // Sale Quantity
    $saleQty = $stockData ? $stockData->saleQtyForWarehouse($warehouseId)->get() : collect();
    foreach ($saleQty as $sale) {
      $party_name = "";
      $details = null;
      if ($sale->challan->invoice_status == 1) {
          $details = InvoiceOrderDetail::where('part_no', $part_no)
            ->where('challan_id', $sale->challan_id)
            ->whereHas('invoiceOrder', function ($q) {
                $q->where('invoice_cancel_status', 0);
            })
            ->first();
          $number = $details->invoiceOrder->invoice_no ?? '-';
          $sellerInfo = $details->invoiceOrder->party_info ?? '-';
          if (is_string($sellerInfo)) {
              $decoded = json_decode($sellerInfo, true);
              $party_name = $decoded['company_name'] ?? '';
          } elseif (is_array($sellerInfo)) {
              $party_name = $sellerInfo['company_name'] ?? '';
          }
      } else {
          $details = $sale->challan;
          $number = $sale->challan->challan_no ?? '-';
          $sellerInfo = $details->shipping_address;
          if (is_string($sellerInfo)) {
              $decoded = json_decode($sellerInfo, true);
              $party_name = $decoded['company_name'] ?? '';
          } elseif (is_array($sellerInfo)) {
              $party_name = $sellerInfo['company_name'] ?? '';
          }              
      }
      
        $drQty = 0;
        $crQty = 0;
        $type = $sale->challan->invoice_status == 1 ? 'Invoice' : 'Challan';
        if($sale->quantity >= 0){
           $drQty = $sale->quantity;
           $runningBalance -= $drQty;
        }else{
            $crQty = $sale->quantity;
            $runningBalance += $crQty;
        }
        $combinedData[] = [
          'Date' => date('Y-m-d', strToTime($sale->created_at)),
          'Voucher Type' => $type,
          'Voucher Number' => $number,
          'Party Name' => $party_name,
          'DrQty' => $drQty,
          'CrQty' => $crQty,
          //'Running Qty' => $runningBalance
        ];
    }
    
    usort($combinedData, function ($a, $b) {
      return strtotime($a['Date']) <=> strtotime($b['Date']);
    });
    $merged = array_merge($processedData, $combinedData);
    $runningBalance = 0;
    foreach ($merged as &$mValue) {
        $runningBalance += $mValue['CrQty'];
        $runningBalance -= $mValue['DrQty'];
        $mValue['RunningQty'] = $runningBalance;
    }
    
    $drQty = 0;
    $crQty = 0;
    if($runningBalance >= 0){
       $drQty = $runningBalance;
    }else{
        $crQty = $runningBalance;
    }
    $merged[]=[
            'Date' => date('Y-m-d'),
            'Voucher Type' => 'Closing Stock',
            'Voucher Number' => '',
            'Party Name' => '',
            'DrQty' => $drQty,
            'CrQty' => $crQty,
            'Running Qty' => ''
        ];
    // echo "<pre>"; print_r($merged);die;
    
    $partNumber = $part_no;
    $itemName = $stockData->name;
    return Excel::download(new ClosingStockDetailsExport($merged, $partNumber, $itemName), $part_no.'closingStockDetails_'.date('d-m-Y').'.xlsx');
    
  }

  public function sendPproductApi($last_product_id, $user_id, $last_upload_id){

    $products = Product::without('product_translations', 'taxes')->where('id', '>', $last_product_id)->orderBy('id', 'asc')->get();

    $productIds = $products->pluck('id')->filter()->values()->all();
    $partNos    = $products->pluck('part_no')->filter()->values()->all();
    $photos = $products->pluck('photos')->filter()
                ->flatMap(function ($p) {
                    return collect(explode(',', $p))
                        ->map(fn($x) => trim($x))
                        ->filter();
                })->unique()->values()->all();
    
    $thumbnailImg = $products->pluck('thumbnail_img')->filter()
                ->flatMap(function ($p) {
                    return collect(explode(',', $p))
                        ->map(fn($x) => trim($x))
                        ->filter();
                })->unique()->values()->all();

    $allImageIds = collect($products->pluck('photos'))
        ->merge($products->pluck('thumbnail_img'))
        ->filter()
        ->flatMap(function ($p) {
            return collect(explode(',', $p))
                ->map(fn($x) => trim($x))
                ->filter();
        })
        ->unique()
        ->values()
        ->all();

    $productWarehouses = ProductWarehouse::whereIn('product_id', $productIds)->get();
    $productsApi = ProductApi::whereIn('part_no', $partNos)->get();
    $productTranslation = ProductTranslation::whereIn('product_id', $productIds)->get();
    $allImagesData = Upload::whereIn('id', $allImageIds)->get();
    $allImagesData = Upload::where('id', '>', $last_upload_id)->orderBy('id', 'asc')->get();
    $allImages = $allImagesData->map(function ($u) {
        $path = ltrim($u->file_name, '/');
        // agar file_name "public/..." se start hota hai to public hata do
        $path = 'public/'. $path;

        return [
            'id' => $u->id,
            'file_name' => $u->file_name,
            'url' => asset($path), // full public URL
            'data' => $u
        ];
    })->values();

    $userData = User::where('id', '>', $user_id)
        ->orderBy('id', 'asc')
        ->get();

    $userIds = $userData->pluck('id')->filter()->values()->all();
    $userAddressData = Address::whereIn('user_id', $userIds)->get();

    // print_r($productIds);print_r($partNos);die;

    return response()->json(['res' => 'true', 'products' => $products, 'productWarehouses' => $productWarehouses, 'productsApi' => $productsApi, 'productTranslation' => $productTranslation, 'allImages'=>$allImages, 'userData'=>$userData, 'userAddressData'=>$userAddressData]);
  }
  
}
