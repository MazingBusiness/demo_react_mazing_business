      $proPhotosArray = explode(',',$product->photos);
      $photos = Upload::whereIn('id', $proPhotosArray)->get();
    }
    // print_r($photos);die;
    
    return view('backend.product.products.own_brand_product_edit', compact('product', 'categoryGroups', 'categories', 'photos', 'lang'));
  }

