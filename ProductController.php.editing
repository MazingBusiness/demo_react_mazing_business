  /**
   * Store a newly created resource in storage.
   *
   * @param  \Illuminate\Http\Request  $request
   * @return \Illuminate\Http\Response
   */
  public function store(ProductRequest $request) {
    $product = $this->productService->store($request->except([
      '_token', 'warehouse_id', 'seller_sku', 'choice', 'tax_id', 'tax', 'tax_type', 'flash_deal_id', 'flash_discount', 'flash_discount_type',
    ]));
    $request->merge(['product_id' => $product->id]);

    //VAT & Tax
    if ($request->tax_id) {
      $this->productTaxService->store($request->only([
        'tax_id', 'tax', 'tax_type', 'product_id',
      ]));
    }

    //Flash Deal
    $this->productFlashDealService->store($request->only([
      'flash_deal_id', 'flash_discount', 'flash_discount_type',
    ]), $product);

    //Product Stock
    $this->productStockService->store($request->only([
      'warehouse_id', 'seller_id', 'colors_active', 'colors', 'choice_no', 'unit_price', 'carton_price', 'piece_per_carton', 'seller_sku', 'current_stock', 'seller_stock', 'product_id', 'part_no', 'model_no', 'cbm', 'carton_cbm', 'length', 'breadth', 'height', 'weight',
    ]), $product);

    // Product Translations
    $request->merge(['lang' => env('DEFAULT_LANGUAGE')]);
    ProductTranslation::create($request->only([
      'lang', 'name', 'unit', 'description', 'product_id',
    ]));

    flash(translate('Product has been inserted successfully'))->success();

    Artisan::call('view:clear');
    Artisan::call('cache:clear');

    return redirect()->route('products.admin');
  }


public function store_reward_product (Request $request)
{
    $request->validate([
        'name'           => 'required|string|max:255',
        'photos'         => 'nullable|string',
        'unit_price'     => 'required|numeric|min:0',
        'product_value'  => 'required|numeric|min:0',
        'redeem_m_coin'  => 'required|integer|min:0',
    ]);

    DB::beginTransaction();

    try {
        // Get last MZ part number safely
        $lastProduct = Product::where('part_no', 'LIKE', 'MZ%')
            ->whereRaw("LENGTH(part_no) = 7")
            ->orderByRaw("CAST(SUBSTRING(part_no, 3) AS UNSIGNED) DESC")
            ->lockForUpdate()
            ->first();

        if ($lastProduct && preg_match('/^MZ(\d{5})$/', $lastProduct->part_no, $match)) {
            $nextNumber = (int) $match[1] + 1;
        } else {
            $nextNumber = 1;
        }

        if ($nextNumber > 99999) {
            return back()->withInput()->withErrors([
                'part_no' => 'Part number series limit reached. Maximum is MZ99999.',
            ]);
        }

        $partNo = 'MZ' . str_pad($nextNumber, 5, '0', STR_PAD_LEFT);

        Product::create([
            'name'              => $request->name,
            'part_no'           => $partNo,
            'slug'              => Str::slug($request->name . '-' . $partNo),
            'photos'            => $request->photos,
            'thumbnail_img'     => $request->photos ? explode(',', $request->photos)[0] : null,

            'unit_price'        => $request->unit_price,
            'purchase_price'    => $request->unit_price,
            'product_value'     => $request->product_value,
            'redeem_m_coin'     => $request->redeem_m_coin,
            'is_reward_product' => '1',

            'published'         => $request->button === 'publish' ? 1 : 0,
            'approved'          => 1,
            'added_by'          => 'admin',

            'choice_options'    => '[]',
            'colors'            => '[]',
            'attributes'        => '[]',
            'variations'        => '[]',

            'current_stock'     => 0,
            'seller_stock'      => 0,
            'min_qty'           => 1,
            'unit'              => 'Pc',

        ]);

        DB::commit();

        flash(translate('Reward product has been created successfully. Part No: ' . $partNo))->success();
        return redirect()->route('products.all_reward_products');

        // return redirect()->back();

    } catch (\Throwable $e) {
        DB::rollBack();

        return back()->withInput()->withErrors([
            'error' => $e->getMessage(),
        ]);
    }
}

