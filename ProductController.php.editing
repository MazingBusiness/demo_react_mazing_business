  public function __construct(
    ProductService $productService,
    ProductTaxService $productTaxService,
    ProductFlashDealService $productFlashDealService,
    ProductStockService $productStockService,
    GoogleSheetsService $sheetsService
    ) {
        $this->productService          = $productService;
        $this->productTaxService       = $productTaxService;
        $this->productFlashDealService = $productFlashDealService;
        $this->productStockService     = $productStockService;
        $this->sheetsService           = $sheetsService;

        /*
        |--------------------------------------------------------------------------
        | Helper: bypass for selected staff ids / titles
        |--------------------------------------------------------------------------
        */
        $roleBypassMiddleware = function (string $permissionName) {
            return function ($request, $next) use ($permissionName) {

                $allowedStaff = [180, 169, 25606, 27746];

                $staffId = (int) $request->session()->get('staff_id', 0);
                $authId  = (int) (auth()->id() ?? 0);

                $user = auth()->user();

                if (!$user) {
                    abort(403);
                }

                $userType  = strtolower(trim((string) ($user->user_type ?? '')));
                $userTitle = strtolower(trim((string) ($user->user_title ?? '')));

                $allowedTitles = ['dispatch', 'manager', 'head_manager'];

                $bypass = in_array($staffId, $allowedStaff, true)
                    || in_array($authId, $allowedStaff, true)
                    || ($userType === 'staff' && in_array($userTitle, $allowedTitles, true));

                if ($bypass) {
                    return $next($request);
                }

                if (!$user->can($permissionName)) {
                    abort(403);
                }

                return $next($request);
            };
        };

        // Staff Permission Check
        $this->middleware(['permission:add_new_product'])->only('create');

        // IMPORTANT:
        // direct permission middleware hata diya, custom bypass middleware niche use ho raha hai
        // $this->middleware(['permission:show_all_products'])->only('all_products', 'no_images');

        $this->middleware(['permission:show_in_house_products'])->only('admin_products');
        $this->middleware(['permission:show_seller_products'])->only('seller_products');

        // show_all_products with bypass
        $this->middleware(
            $roleBypassMiddleware('show_all_products')
        )->only('all_products', 'no_images');

        // product_edit with bypass
        $this->middleware(
            $roleBypassMiddleware('product_edit')
        )->only('admin_product_edit', 'seller_product_edit');

        $this->middleware(['permission:product_duplicate'])->only('duplicate');
        $this->middleware(['permission:product_delete'])->only('destroy');
    }
  /**
   * Display a listing of the resource.
   *
   * @return \Illuminate\Http\Response
   */


    public function submitForReview(Request $request, $id)
    {
        $product = Product::findOrFail($id);
    
        $lang = $request->lang ?? env('DEFAULT_LANGUAGE');
    
        /*
        |--------------------------------------------------------------------------
        | Check if pricing fields are submitted
        |--------------------------------------------------------------------------
        */
        $hasListPrice = $request->filled('list_price');
        $hasDiscount  = $request->filled('discount');
        $hasMarkup    = $request->filled('markup');
        $hasTax       = $request->filled('tax');
        $hasPurchaseTax = $request->filled('purchase_tax');
    
       // $shouldCalculatePricing = $hasListPrice || $hasDiscount || $hasMarkup || $hasTax || $hasPurchaseTax;

        $listPriceInput = (float) str_replace([',', '₹', '%', ' '], '', (string) $request->input('list_price', $product->list_price ?? 0));

        $shouldCalculatePricing = $listPriceInput > 0 && (
            $hasListPrice || $hasDiscount || $hasMarkup || $hasTax || $hasPurchaseTax
        );
    
        $dynamicRequestValues = [];
    
        if ($shouldCalculatePricing) {
            $listPrice = (float) str_replace([',', '₹', '%', ' '], '', (string) $request->input('list_price', $product->list_price ?? 0));
            $discount  = (float) str_replace([',', '₹', '%', ' '], '', (string) $request->input('discount', $product->discount ?? 0));
            $markup    = (float) str_replace([',', '₹', '%', ' '], '', (string) $request->input('markup', $product->markup ?? 0));
            $submittedTax = (float) str_replace([',', '₹', '%', ' '], '', (string) $request->input('tax', $product->tax ?? 0));
            $purchaseTax = strtoupper(trim((string) $request->input('purchase_tax', $product->purchase_tax ?? 'N')));
    
            $taxUsedForCalculation = $purchaseTax === 'Y' ? 0 : $submittedTax;
    
            $discountAmount = $listPrice * ($discount / 100);
            $baseAfterDiscount = $listPrice - $discountAmount;
    
            $gstAmount = $baseAfterDiscount * ($taxUsedForCalculation / 100);
            $calculatedPurchasePrice = round($baseAfterDiscount + $gstAmount, 2);
    
            $markupAmount = $calculatedPurchasePrice * ($markup / 100);
            $calculatedNetPrice = round($calculatedPurchasePrice + $markupAmount, 2);
    
            $calculatedMrp = round($calculatedNetPrice + ($calculatedNetPrice * 31.579 / 100), 2);
    
            $dynamicRequestValues = [
                'purchase_price' => $calculatedPurchasePrice,
                'net_price'      => $calculatedNetPrice,
                'mrp'            => $calculatedMrp,
            ];
        }
    
        $fieldsToTrack = [
            'name',
            'billing_name',
            'part_no',
            'hsncode',
            'alias_name',
            'group_id',
            'category_id',
            'brand_id',
            'seller_id',
            'warehouse_id',
            'unit',
            'generic_name',
            'refundable',
            'photos',
            'thumbnail_img',
            'import_photos',
            'import_thumbnail_img',
    
            'list_price',
            'discount',
            'purchase_tax',
            'tax',
            'purchase_price',
            'markup',
            'net_price',
            'mrp',
            'mrp_41_price',
            'weight',
    
            'description',
            'meta_title',
            'meta_description',
            'meta_keywords',
            'slug',
            'cash_on_delivery',
            'published',
            'approved',
            'current_stock',
            'seller_stock',
            'variant_parent_part_no',
        ];
    
        $checkboxFields = [
            'refundable',
            'cash_on_delivery',
            'published',
            'approved',
            'current_stock',
            'seller_stock',
        ];
    
        $translationFields = [
            'name',
            'billing_name',
            'unit',
            'description',
        ];
    
        $changesCount = 0;
    
        foreach ($fieldsToTrack as $field) {
    
            if (in_array($field, ['purchase_price', 'net_price', 'mrp']) && !$shouldCalculatePricing) {
                continue;
            }
    
            if (in_array($field, $translationFields)) {
                $currentValue = (string) ($product->getTranslation($field, $lang) ?? '');
                $submittedValue = (string) ($request->input($field, ''));
            } elseif (in_array($field, $checkboxFields)) {
                $currentValue = (string) ((int) ($product->$field ?? 0));
                //$submittedValue = $request->has($field) ? '1' : '0';
                $submittedValue = (string) ((int) $request->input($field, 0));
            } elseif (array_key_exists($field, $dynamicRequestValues)) {
                $currentValue = (string) ($product->$field ?? '');
                $submittedValue = (string) $dynamicRequestValues[$field];
            } else {
                if (!$request->has($field)) {
                    continue;
                }
    
                $currentValue = (string) ($product->$field ?? '');
                $submittedValue = (string) ($request->input($field, ''));
            }
    
            $currentValue = trim($currentValue);
            $submittedValue = trim($submittedValue);
    
            if ($currentValue === $submittedValue) {
                continue;
            }
    
            $existingPending = ProductUpdate::where('part_no', $product->part_no)
                ->where('field_name', $field)
                ->where('status', 'pending')
                ->first();
    
            if ($existingPending) {
                $existingPending->update([
                    'current_value' => $currentValue,
                    'updated_value' => $submittedValue,
                    'user_id'       => Auth::id(),
                ]);
            } else {
                ProductUpdate::create([
                    'part_no'       => $product->part_no,
                    'field_name'    => $field,
                    'current_value' => $currentValue,
                    'updated_value' => $submittedValue,
                    'status'        => 'pending',
                    'user_id'       => Auth::id(),
                ]);
            }
    
            $changesCount++;
        }
    
        if ($changesCount === 0) {
            return redirect()->back()->with('warning', 'No new changes detected.');
        }
    
        return redirect()->back()->with('success', 'Product changes submitted for review successfully.');
    }

    public function reviewProductsFromExcel(Request $request)
    {
        $request->validate([
            'excel_file' => 'required|file|mimes:xlsx,xls,csv',
        ]);

        $totalReviewed   = 0;
        $totalSkipped    = 0;
        $totalProcessed  = 0;
        $totalRows       = 0;
        $notFoundParts   = [];
        $blankPartRows   = [];

        try {
            $file = $request->file('excel_file');

            $spreadsheet = \PhpOffice\PhpSpreadsheet\IOFactory::load($file->getRealPath());
            $sheet = $spreadsheet->getActiveSheet();
            $rows = $sheet->toArray(null, true, true, false);

            if (empty($rows) || count($rows) < 2) {
                return redirect()->back()->with('error', 'Excel file is empty or does not contain data rows.');
            }

            /*
            |--------------------------------------------------------------------------
            | Normalize headers
            |--------------------------------------------------------------------------
            */
            $rawHeaders = $rows[0] ?? [];

            $normalizeHeader = function ($value) {
                $value = trim((string) $value);
                $value = preg_replace('/\s+/', ' ', $value);
                $value = strtolower($value);
                $value = str_replace(['-', '/', '%'], ['_', '_', 'percent'], $value);
                $value = str_replace(' ', '_', $value);
                $value = preg_replace('/[^a-z0-9_]/', '', $value);
                return trim($value, '_');
            };

            $headers = [];
            foreach ($rawHeaders as $index => $header) {
                $normalized = $normalizeHeader($header);

                if (in_array($normalized, ['gst_percent', 'gst'])) {
                    $normalized = 'tax';
                }

                if (in_array($normalized, ['purchase_tax', 'purchase_tax_', 'purchasetax', 'purchase_tax_y_n'])) {
                    $normalized = 'purchase_tax';
                }

                if ($normalized === 'brand') {
                    $normalized = 'brand_name';
                }

                if ($normalized === 'warehouse') {
                    $normalized = 'warehouse_name';
                }

                if ($normalized === 'seller') {
                    $normalized = 'seller_name';
                }

                if ($normalized === 'sz_group') {
                    $normalized = 'category_group_name';
                }

                if ($normalized === 'sz_category') {
                    $normalized = 'category_name';
                }

                $headers[$index] = $normalized;
            }

            // remove header row
            array_shift($rows);

            /*
            |--------------------------------------------------------------------------
            | Helpers
            |--------------------------------------------------------------------------
            */
            $getValue = function (array $rowData, array $possibleKeys, $default = '') {
                foreach ($possibleKeys as $key) {
                    if (!array_key_exists($key, $rowData)) {
                        continue;
                    }

                    $value = $rowData[$key];

                    if (is_string($value)) {
                        $value = trim($value);
                    }

                    if ($value !== null && $value !== '') {
                        return $value;
                    }
                }

                return $default;
            };

            $toNumber = function ($value, $default = null) {
                if ($value === null || $value === '') {
                    return $default;
                }

                if (is_string($value)) {
                    $value = trim($value);
                    $value = str_replace([',', '₹', '%', ' '], '', $value);
                }

                return is_numeric($value) ? (float) $value : $default;
            };

            $syncProductUpdate = function ($product, $fieldName, $updatedValue) use (&$totalReviewed) {
                if (is_array($updatedValue)) {
                    $updatedValue = json_encode($updatedValue);
                }

                $currentValue = $product->$fieldName ?? '';

                if (is_array($currentValue)) {
                    $currentValue = json_encode($currentValue);
                }

                $currentValue = trim((string) $currentValue);
                $updatedValue = trim((string) $updatedValue);

                if ($updatedValue === '') {
                    return;
                }

                if ($currentValue === $updatedValue) {
                    return;
                }

                $existingPending = ProductUpdate::where('part_no', $product->part_no)
                    ->where('field_name', $fieldName)
                    ->where('status', 'pending')
                    ->first();

                if ($existingPending) {
                    $existingPending->update([
                        'current_value' => $currentValue,
                        'updated_value' => $updatedValue,
                        'user_id'       => Auth::id(),
                    ]);
                } else {
                    ProductUpdate::create([
                        'part_no'       => $product->part_no,
                        'field_name'    => $fieldName,
                        'current_value' => $currentValue,
                        'updated_value' => $updatedValue,
                        'status'        => 'pending',
                        'user_id'       => Auth::id(),
                    ]);
                }

                $totalReviewed++;
            };

            /*
            |--------------------------------------------------------------------------
            | Process rows
            |--------------------------------------------------------------------------
            */
            foreach ($rows as $rowIndex => $row) {
                $excelRowNumber = $rowIndex + 2; // header row is row 1
                $totalRows++;

                $rowData = [];
                foreach ($headers as $colIndex => $header) {
                    if ($header === '') {
                        continue;
                    }

                    $value = $row[$colIndex] ?? null;

                    if (is_string($value)) {
                        $value = trim($value);
                    }

                    $rowData[$header] = $value;
                }

                // skip fully blank row
                $nonEmptyValues = array_filter($rowData, function ($v) {
                    return $v !== null && $v !== '';
                });

                if (empty($nonEmptyValues)) {
                    $totalSkipped++;
                    continue;
                }

                /*
                |--------------------------------------------------------------------------
                | Part No
                |--------------------------------------------------------------------------
                */
                $partNoRaw = $getValue($rowData, ['part_no'], '');
                $part_no = trim((string) $partNoRaw);

                if ($part_no === '') {
                    $blankPartRows[] = $excelRowNumber;
                    $totalSkipped++;
                    continue;
                }

                $product = Product::where('part_no', $part_no)->first();

                if (!$product) {
                    $notFoundParts[] = $part_no;
                    $totalSkipped++;
                    continue;
                }

                $totalProcessed++;

                $fieldsFromExcel = [];

                /*
                |--------------------------------------------------------------------------
                | Direct product fields from excel
                |--------------------------------------------------------------------------
                */
                $directFieldMap = [
                    'name'                => ['name', 'product_name'],
                    'alias_name'          => ['alias_name'],
                    'billing_name'        => ['billing_name'],
                    'seller_stock'        => ['seller_stock'],
                    'hsncode'             => ['hsncode', 'hsn_code'],
                    'generic_name'        => ['generic_name'],
                    'weight'              => ['weight'],
                    'cash_and_carry_item' => ['cash_and_carry_item'],
                    'list_price'          => ['list_price'],
                    'discount'            => ['discount'],
                    'markup'              => ['markup'],
                    'meta_title'          => ['meta_title'],
                    'slug'                => ['slug'],
                ];

                foreach ($directFieldMap as $dbField => $possibleHeaders) {
                    $value = $getValue($rowData, $possibleHeaders, '');

                    if ($value === '') {
                        continue;
                    }

                    if (is_string($value)) {
                        $value = trim($value);
                    }

                    $fieldsFromExcel[$dbField] = $value;
                }

                /*
                |--------------------------------------------------------------------------
                | Lookup mappings
                |--------------------------------------------------------------------------
                */
                $brandName = trim((string) $getValue($rowData, ['brand_name'], ''));
                if ($brandName !== '') {
                    $brand = Brand::where('name', $brandName)->first();
                    if ($brand) {
                        $fieldsFromExcel['brand_id'] = $brand->id;
                    }
                }

                $groupName = trim((string) $getValue($rowData, ['category_group_name'], ''));
                if ($groupName !== '') {
                    $catGroup = CategoryGroup::where('name', $groupName)->first();
                    if ($catGroup) {
                        $fieldsFromExcel['group_id'] = $catGroup->id;
                    }
                }

                $categoryName = trim((string) $getValue($rowData, ['category_name'], ''));
                if ($categoryName !== '') {
                    $category = Category::where('name', $categoryName)->first();
                    if ($category) {
                        $fieldsFromExcel['category_id'] = $category->id;
                    }
                }

                $warehouseName = trim((string) $getValue($rowData, ['warehouse_name'], ''));
                if ($warehouseName !== '') {
                    $warehouse = Warehouse::where('name', $warehouseName)->first();
                    if ($warehouse) {
                        $fieldsFromExcel['warehouse_id'] = $warehouse->id;
                    }
                }

                $sellerName = trim((string) $getValue($rowData, ['seller_name'], ''));
                if ($sellerName !== '') {
                    $shop = \App\Models\Shop::where('name', $sellerName)->first();

                    if ($shop && !empty($shop->seller_id)) {
                        $fieldsFromExcel['seller_id'] = $shop->seller_id;
                    } else {
                        $sellerUser = User::where('name', $sellerName)->first();
                        if ($sellerUser) {
                            $seller = Seller::where('user_id', $sellerUser->id)->first();
                            if ($seller) {
                                $fieldsFromExcel['seller_id'] = $seller->id;
                            }
                        }
                    }
                }

                /*
                |--------------------------------------------------------------------------
                | Numeric values
                |--------------------------------------------------------------------------
                */
                $listPrice = $toNumber(
                    $getValue($rowData, ['list_price'], $fieldsFromExcel['list_price'] ?? $product->list_price),
                    $toNumber($product->list_price, 0)
                );

                $discountPercent = $toNumber(
                    $getValue($rowData, ['discount'], $fieldsFromExcel['discount'] ?? $product->discount),
                    $toNumber($product->discount, 0)
                );

                $markupPercent = $toNumber(
                    $getValue($rowData, ['markup'], $fieldsFromExcel['markup'] ?? $product->markup),
                    $toNumber($product->markup, 0)
                );

                /*
                |--------------------------------------------------------------------------
                | Excel GST/TAX value
                |--------------------------------------------------------------------------
                | Yaha se GST column ka value uthaya ja raha hai.
                | Ye value hamesha tax field me hi save hoga.
                |--------------------------------------------------------------------------
                */
                $excelTaxPercent = $toNumber(
                    $getValue($rowData, ['tax'], $product->tax),
                    $toNumber($product->tax, 0)
                );

                /*
                |--------------------------------------------------------------------------
                | Purchase Tax flag
                |--------------------------------------------------------------------------
                */
                $purchaseTaxRaw = strtoupper(trim((string) $getValue($rowData, ['purchase_tax'], '')));
                if ($purchaseTaxRaw !== '') {
                    $fieldsFromExcel['purchase_tax'] = $purchaseTaxRaw;
                }

                /*
                |--------------------------------------------------------------------------
                | IMPORTANT RULE
                |--------------------------------------------------------------------------
                | Agar purchase_tax = Y hai tab bhi tax field me excel GST hi save hoga.
                | Matlab:
                |   tax field = excelTaxPercent
                |--------------------------------------------------------------------------
                */
                $fieldsFromExcel['tax'] = round($excelTaxPercent, 2);

                /*
                |--------------------------------------------------------------------------
                | Purchase price calculation logic
                |--------------------------------------------------------------------------
                | Yaha do possible business rule ho sakte hain:
                |
                | 1. Agar purchase_tax = Y, matlab purchase tax included hai
                |    to purchase price me GST dubara add nahi karenge
                |
                | 2. Agar purchase_tax = N, to GST add karenge
                |--------------------------------------------------------------------------
                */
                $discountAmount = $listPrice * ($discountPercent / 100);
                $baseAfterDiscount = $listPrice - $discountAmount;

                if ($purchaseTaxRaw === 'Y') {
                    $purchasePrice = $baseAfterDiscount;
                } else {
                    $gstAmount = $baseAfterDiscount * ($excelTaxPercent / 100);
                    $purchasePrice = $baseAfterDiscount + $gstAmount;
                }

                $markupAmount = $purchasePrice * ($markupPercent / 100);
                $netPrice = $purchasePrice + $markupAmount;

                $mrp = $netPrice + ($netPrice * 31.579 / 100);

                $fieldsFromExcel['purchase_price'] = round($purchasePrice, 2);
                $fieldsFromExcel['net_price'] = round($netPrice, 2);
                $fieldsFromExcel['mrp'] = round($mrp, 2);

                /*
                |--------------------------------------------------------------------------
                | Save ProductUpdate rows
                |--------------------------------------------------------------------------
                */
                foreach ($fieldsFromExcel as $fieldName => $updatedValue) {
                    $syncProductUpdate($product, $fieldName, $updatedValue);
                }

                \Log::info('reviewProductsFromExcel row calculation', [
                    'excel_row'         => $excelRowNumber,
                    'part_no'           => $part_no,
                    'list_price'        => $listPrice,
                    'discount_percent'  => $discountPercent,
                    'markup_percent'    => $markupPercent,
                    'purchase_tax'      => $purchaseTaxRaw,
                    'excel_tax_percent' => $excelTaxPercent,
                    'saved_tax'         => round($excelTaxPercent, 2),
                    'purchase_price'    => round($purchasePrice, 2),
                    'net_price'         => round($netPrice, 2),
                    'mrp'               => round($mrp, 2),
                ]);
            }

            $message = "Excel review completed. "
                . "Processed rows: {$totalProcessed}, "
                . "Field changes reviewed: {$totalReviewed}, "
                . "Skipped rows: {$totalSkipped}.";

            if (!empty($blankPartRows)) {
                $message .= " Blank part_no rows at Excel row: " . implode(', ', array_slice($blankPartRows, 0, 20)) . ".";
            }

            if (!empty($notFoundParts)) {
                $message .= " Product not found for part_no: " . implode(', ', array_slice(array_unique($notFoundParts), 0, 20)) . ".";
            }

            return redirect()->back()->with('success', $message);
        } catch (\Throwable $e) {
            \Log::error('reviewProductsFromExcel failed', [
                'message' => $e->getMessage(),
                'line'    => $e->getLine(),
                'file'    => $e->getFile(),
                'trace'   => $e->getTraceAsString(),
            ]);

            return redirect()->back()->with('error', 'Excel processing failed: ' . $e->getMessage());
        }
    }
    


    public function reviewProductsFromGoogleSheet(Request $request)
    {
        $range = config('sheets.get_data_range');
        $rows = $this->sheetsService->getData($range);

        $totalReviewed = 0;
        $totalSkipped = 0;

        foreach ($rows as $row) {
            $part_no = trim((string)($row[0] ?? ''));

            // blank part no => skip
            if ($part_no === '') {
                $totalSkipped++;
                continue;
            }

            $product = Product::where('part_no', $part_no)->first();

            // product not found => skip
            if (!$product) {
                $totalSkipped++;
                continue;
            }

            $brand_name = trim((string)($row[1] ?? ''));
            $product_name = trim((string)($row[2] ?? ''));
            $alias_name = trim((string)($row[3] ?? ''));
            $billing_name = trim((string)($row[4] ?? ''));
            $category_group_name = trim((string)($row[5] ?? ''));
            $category_name = trim((string)($row[6] ?? ''));
            $mrp = (string)($row[7] ?? '');
            $warehouse_name = trim((string)($row[8] ?? ''));
            $seller_name = trim((string)($row[9] ?? ''));
            $seller_stock = (string)($row[10] ?? '');
            $hsncode = trim((string)($row[11] ?? ''));
            $tax = (string)($row[12] ?? '');
            $generic_name = trim((string)($row[13] ?? ''));
            $weight = (string)($row[14] ?? '');
            $purchase_price = (string)($row[15] ?? '');
            $cash_and_carry_item = (string)($row[16] ?? '0');

            // additional added to exel start
            $list_price = (string)($row[17] ?? '');
            $discount = (string)($row[18] ?? '');
            $markup = (string)($row[19] ?? '');
            $net_price = (string)($row[20] ?? '');
            // additional added to exel end

            $brand_id = null;
            if ($brand_name !== '') {
                $brand = Brand::where('name', $brand_name)->first();
                $brand_id = $brand ? $brand->id : null;
            }

            $category_group_id = null;
            if ($category_group_name !== '') {
                $catGroup = CategoryGroup::where('name', $category_group_name)->first();
                $category_group_id = $catGroup ? $catGroup->id : null;
            }

            $category_id = null;
            if ($category_name !== '') {
                $category = Category::where('name', $category_name)->first();
                $category_id = $category ? $category->id : null;
            }

            $seller_id = null;
            if ($seller_name !== '') {
                $sellerUser = User::where('name', $seller_name)->first();
                if ($sellerUser) {
                    $seller = Seller::where('user_id', $sellerUser->id)->first();
                    $seller_id = $seller ? $seller->id : null;
                }
            }

            $warehouse_id = null;
            if ($warehouse_name !== '') {
                $warehouse = Warehouse::where('name', $warehouse_name)->first();
                $warehouse_id = $warehouse ? $warehouse->id : null;
            }

            if (($row[7] ?? 0) == 0) {
                $piece_by_carton = 0;
            } else {
                $piece_by_carton = round(50000 / ($row[7] - (($row[7] * 24) / 100)));
            }

            $slugValue = strtolower(str_replace([' ', '"', "'", '(', ')', '/', '\\', '.'], '-', $product_name ?: $product->name));

            $fieldsFromSheet = [
                'brand_id'            => $brand_id,
                'group_id'            => $category_group_id,
                'category_id'         => $category_id,
                'seller_id'           => $seller_id,
                'meta_title'          => $product_name ?: '',
                'slug'                => $slugValue,
                'name'                => $product_name ?: $product->name,
                'alias_name'          => $alias_name ?: $product->alias_name,
                'billing_name'        => $billing_name ?: $product->billing_name,
                'mrp'                 => $mrp !== '' ? $mrp : $product->mrp,
                'warehouse_id'        => $warehouse_id,
                'seller_stock'        => $seller_stock !== '' ? $seller_stock : $product->seller_stock,
                'hsncode'             => $hsncode !== '' ? $hsncode : $product->hsncode,
                'tax'                 => $tax !== '' ? $tax : $product->tax,
                'generic_name'        => $generic_name !== '' ? $generic_name : $product->generic_name,
                'weight'              => $weight !== '' ? $weight : $product->weight,
                'piece_by_carton'     => $piece_by_carton,
                'purchase_price'      => $purchase_price !== '' ? $purchase_price : $product->purchase_price,
                'cash_and_carry_item' => $cash_and_carry_item !== '' ? $cash_and_carry_item : $product->cash_and_carry_item,

                'list_price'          => $list_price !== '' ? $list_price : $product->list_price,
                'discount'            => $discount !== '' ? $discount : $product->discount,
                'markup'              => $markup !== '' ? $markup : $product->markup,
                'net_price'           => $net_price !== '' ? $net_price : $product->net_price,
            ];

            foreach ($fieldsFromSheet as $fieldName => $updatedValue) {
                $currentValue = (string)($product->$fieldName ?? '');
                $updatedValue = (string)($updatedValue ?? '');

                $currentValue = trim($currentValue);
                $updatedValue = trim($updatedValue);

                $existingPending = ProductUpdate::where('part_no', $product->part_no)
                    ->where('field_name', $fieldName)
                    ->where('status', 'pending')
                    ->first();

                // same value hai to kuch mat karo
                // purana pending delete nahi karna
                if ($currentValue === $updatedValue) {
                    continue;
                }

                // same part_no + same field_name + pending => update same row
                if ($existingPending) {
                    $existingPending->update([
                        'current_value' => $currentValue,
                        'updated_value' => $updatedValue,
                        'user_id'       => Auth::id(),
                    ]);
                } else {
                    ProductUpdate::create([
                        'part_no'       => $product->part_no,
                        'field_name'    => $fieldName,
                        'current_value' => $currentValue,
                        'updated_value' => $updatedValue,
                        'status'        => 'pending',
                        'user_id'       => Auth::id(),
                    ]);
                }

                $totalReviewed++;
            }
        }

        return response()->json([
            'status' => 'success',
            'message' => "Pull for review completed. Total field changes reviewed: {$totalReviewed}, skipped rows: {$totalSkipped}.",
        ]);
    }

    public function productUnderReview(Request $request)
    {
        $search = trim((string) $request->get('search', ''));
        $sellerId = trim((string) $request->get('seller_id', ''));
        $updatesOnly = $request->has('updates_only')
            ? ((string) $request->get('updates_only') === '1')
            : true;

        /*
        |--------------------------------------------------------------------------
        | Base seller ids from products table (only sellers having products)
        |--------------------------------------------------------------------------
        */
        $baseSellerIdsQuery = Product::query()
            ->select('seller_id')
            ->whereNotNull('seller_id')
            ->where('seller_id', '!=', '');

        if ($sellerId !== '') {
            $baseSellerIdsQuery->where('seller_id', $sellerId);
        }

        $baseSellerIds = $baseSellerIdsQuery
            ->groupBy('seller_id')
            ->havingRaw('COUNT(*) > 0')
            ->pluck('seller_id')
            ->filter()
            ->values();

        /*
        |--------------------------------------------------------------------------
        | Shop details from shop table only
        |--------------------------------------------------------------------------
        */
        $shopMeta = \App\Models\Shop::query()
            ->whereIn('seller_id', $baseSellerIds)
            ->select('seller_id', 'name')
            ->get()
            ->keyBy('seller_id');

        /*
        |--------------------------------------------------------------------------
        | Total products count by seller
        |--------------------------------------------------------------------------
        */
        $totalProductsBySeller = Product::query()
            ->selectRaw('seller_id, COUNT(*) as total_products_count')
            ->whereIn('seller_id', $baseSellerIds)
            ->groupBy('seller_id')
            ->pluck('total_products_count', 'seller_id');

        /*
        |--------------------------------------------------------------------------
        | First product part no by seller
        |--------------------------------------------------------------------------
        */
        $firstProductPartNoBySeller = Product::query()
            ->select('seller_id', 'part_no', 'id')
            ->whereIn('seller_id', $baseSellerIds)
            ->whereNotNull('part_no')
            ->where('part_no', '!=', '')
            ->orderBy('id', 'asc')
            ->get()
            ->groupBy('seller_id')
            ->map(function ($rows) {
                return optional($rows->first())->part_no;
            });

        /*
        |--------------------------------------------------------------------------
        | Pending updates query
        |--------------------------------------------------------------------------
        */
        $pendingUpdatesQuery = ProductUpdate::query()
            ->where('status', 'pending');

        if ($search !== '') {
            $pendingUpdatesQuery->where(function ($q) use ($search) {
                $q->where('part_no', 'like', '%' . $search . '%')
                    ->orWhere('field_name', 'like', '%' . $search . '%')
                    ->orWhere('current_value', 'like', '%' . $search . '%')
                    ->orWhere('updated_value', 'like', '%' . $search . '%');
            });
        }

        $pendingUpdates = $pendingUpdatesQuery
            ->orderBy('updated_at', 'desc')
            ->get();

        /*
        |--------------------------------------------------------------------------
        | Pending products map
        |--------------------------------------------------------------------------
        */
        $pendingPartNos = $pendingUpdates->pluck('part_no')->filter()->unique()->values();

        $pendingProducts = Product::query()
            ->whereIn('part_no', $pendingPartNos)
            ->get()
            ->keyBy('part_no');

        /*
        |--------------------------------------------------------------------------
        | Build pending seller stats
        |--------------------------------------------------------------------------
        */
        $pendingProductsBySeller = [];
        $firstPendingPartNoBySeller = [];

        foreach ($pendingUpdates as $update) {
            $product = $pendingProducts->get($update->part_no);

            if (!$product || empty($product->seller_id)) {
                continue;
            }

            $sid = (string) $product->seller_id;

            if (!in_array($product->seller_id, $baseSellerIds->all())) {
                continue;
            }

            if (!isset($pendingProductsBySeller[$sid])) {
                $pendingProductsBySeller[$sid] = [];
            }

            $pendingProductsBySeller[$sid][$update->part_no] = true;

            if (!isset($firstPendingPartNoBySeller[$sid]) && !empty($update->part_no)) {
                $firstPendingPartNoBySeller[$sid] = $update->part_no;
            }
        }

        /*
        |--------------------------------------------------------------------------
        | Build seller cards
        |--------------------------------------------------------------------------
        */
        $sellerCards = collect($baseSellerIds)->map(function ($sid) use (
            $shopMeta,
            $totalProductsBySeller,
            $pendingProductsBySeller,
            $firstPendingPartNoBySeller,
            $firstProductPartNoBySeller
        ) {
            $sidString = (string) $sid;
            $pendingCount = isset($pendingProductsBySeller[$sidString]) ? count($pendingProductsBySeller[$sidString]) : 0;
            $productCount = (int) ($totalProductsBySeller[$sid] ?? 0);

            return [
                'seller_id'              => $sid,
                'seller_name'            => optional($shopMeta->get($sid))->name ?? 'Unknown Seller',
                'product_count'          => $productCount,
                'total_products_count'   => $productCount,
                'pending_count'          => $pendingCount,
                'pending_products_count' => $pendingCount,
                'has_pending'            => $pendingCount > 0,
                'first_part_no'          => $firstPendingPartNoBySeller[$sidString] ?? null,
                'first_product_part_no'  => $firstProductPartNoBySeller[$sid] ?? null,
            ];
        })
        ->filter(function ($seller) {
            return (int) ($seller['product_count'] ?? 0) > 0;
        })
        ->values();

        /*
        |--------------------------------------------------------------------------
        | Search seller name also
        |--------------------------------------------------------------------------
        */
        if ($search !== '') {
            $keyword = strtolower($search);

            $sellerCards = $sellerCards->filter(function ($seller) use ($keyword) {
                return str_contains(strtolower((string) $seller['seller_name']), $keyword)
                    || str_contains(strtolower((string) ($seller['first_part_no'] ?? '')), $keyword)
                    || str_contains(strtolower((string) ($seller['first_product_part_no'] ?? '')), $keyword);
            })->values();
        }

        /*
        |--------------------------------------------------------------------------
        | updates_only => only sellers with pending
        |--------------------------------------------------------------------------
        */
        if ($updatesOnly) {
            $sellerCards = $sellerCards->filter(function ($seller) {
                return !empty($seller['has_pending']);
            })->values();
        }

        /*
        |--------------------------------------------------------------------------
        | Sort pending first
        |--------------------------------------------------------------------------
        */
        $sellerCards = $sellerCards->sort(function ($a, $b) {
            if ((int) $a['has_pending'] !== (int) $b['has_pending']) {
                return (int) $b['has_pending'] <=> (int) $a['has_pending'];
            }

            if ((int) $a['pending_count'] !== (int) $b['pending_count']) {
                return (int) $b['pending_count'] <=> (int) $a['pending_count'];
            }

            return strcasecmp((string) $a['seller_name'], (string) $b['seller_name']);
        })->values();

        /*
        |--------------------------------------------------------------------------
        | Seller dropdown only for sellers having at least 1 product
        |--------------------------------------------------------------------------
        */
        $dropdownSellerIds = Product::query()
            ->select('seller_id')
            ->whereNotNull('seller_id')
            ->where('seller_id', '!=', '')
            ->groupBy('seller_id')
            ->havingRaw('COUNT(*) > 0')
            ->pluck('seller_id')
            ->filter()
            ->values();

        $sellers = \App\Models\Shop::query()
            ->whereIn('seller_id', $dropdownSellerIds)
            ->select('seller_id as id', 'name')
            ->orderBy('name', 'asc')
            ->get();

        return view('backend.product.products.under_review', [
            'sellerCards' => $sellerCards,
            'sellers'     => $sellers,
            'search'      => $search,
            'sellerId'    => $sellerId,
            'updatesOnly' => $updatesOnly,
        ]);
    }

    public function productUnderReviewView(Request $request, $part_no)
    {
        $baseProduct = Product::with([
            'thumb_img:id,file_name',
        ])->where('part_no', $part_no)->firstOrFail();

        $sellerId = $baseProduct->seller_id;

        $selectedFieldName = trim((string) $request->get('field_name', ''));
        $viewType          = trim((string) $request->get('view_type', 'updates'));
        $showAllProducts   = $viewType === 'all';

        $searchValue       = trim((string) $request->get('search', ''));
        $showUpdatesOnly   = $viewType === 'updates';

        $brandFilters      = array_filter((array) $request->get('brand', []));
        $categoryFilters   = array_filter((array) $request->get('category', []));
        $subCategoryFilter = array_filter((array) $request->get('sub_category', []));
        $discountFilters   = array_filter((array) $request->get('discount', []), function ($v) {
            return $v !== null && $v !== '';
        });
        $markupFilters     = array_filter((array) $request->get('markup', []), function ($v) {
            return $v !== null && $v !== '';
        });

        $sellerName = 'Unknown Seller';

        if (!empty($sellerId)) {
            $shopData = \App\Models\Shop::query()
                ->where('seller_id', $sellerId)
                ->select('seller_id', 'name')
                ->first();

            if ($shopData) {
                $sellerName = $shopData->name;
            }
        }

        $sellerProductPartNos = Product::query()
            ->where('seller_id', $sellerId)
            ->pluck('part_no')
            ->filter()
            ->unique()
            ->values();

        $filteredPartNos = ProductUpdate::query()
            ->whereIn('part_no', $sellerProductPartNos)
            ->whereIn('status', ['pending', 'confirmed'])
            ->when($selectedFieldName !== '', function ($query) use ($selectedFieldName) {
                $query->where('field_name', $selectedFieldName);
            })
            ->pluck('part_no')
            ->filter()
            ->unique()
            ->values();

        // $pendingUpdates = ProductUpdate::query()
        //     ->whereIn('part_no', $filteredPartNos)
        //     ->whereIn('status', ['pending', 'confirmed'])
        //     ->when($selectedFieldName !== '', function ($query) use ($selectedFieldName) {
        //         $query->where('field_name', $selectedFieldName);
        //     })
        //     ->orderBy('updated_at', 'desc')
        //     ->get();

            $pendingUpdates = ProductUpdate::query()
        ->whereIn('part_no', $filteredPartNos)
        ->whereIn('status', ['pending', 'confirmed'])
        ->orderBy('updated_at', 'desc')
        ->get();

        $updatedPartNos = $pendingUpdates->pluck('part_no')->filter()->unique()->values();

        $productsQuery = Product::query()->with([
            'thumb_img:id,file_name',
        ]);

        if ($showAllProducts) {
            $productsQuery->where('seller_id', $sellerId);
        } else {
            $productsQuery->whereIn('part_no', $updatedPartNos);
        }

        if ($searchValue !== '') {
            $productsQuery->where(function ($query) use ($searchValue) {
                $query->where('part_no', 'like', '%' . $searchValue . '%')
                    ->orWhere('name', 'like', '%' . $searchValue . '%');
            });
        }

        if (!empty($brandFilters)) {
            $productsQuery->whereIn('brand_id', $brandFilters);
        }

        if (!empty($categoryFilters)) {
            $productsQuery->whereIn('category_id', $categoryFilters);
        }

        if (!empty($subCategoryFilter)) {
            $productsQuery->whereIn('group_id', $subCategoryFilter);
        }

        if (!empty($discountFilters)) {
            $productsQuery->whereIn(\DB::raw('ROUND(COALESCE(discount,0),2)'), array_map('floatval', $discountFilters));
        }

        if (!empty($markupFilters)) {
            $productsQuery->whereIn(\DB::raw('ROUND(COALESCE(markup,0),2)'), array_map('floatval', $markupFilters));
        }

        $productsPaginator = $productsQuery
            ->orderBy('name', 'asc')
            ->paginate(250)
            ->appends($request->query());

        $pageProducts = $productsPaginator->getCollection();

        $groupIds = $pageProducts->pluck('group_id')->filter()->unique()->values();
        $categoryIds = $pageProducts->pluck('category_id')->filter()->unique()->values();
        $sellerIds = $pageProducts->pluck('seller_id')->filter()->unique()->values();

        $groupNames = \App\Models\CategoryGroup::query()
            ->whereIn('id', $groupIds)
            ->pluck('name', 'id');

        $categoryNames = \App\Models\Category::query()
            ->whereIn('id', $categoryIds)
            ->pluck('name', 'id');

        $sellerNames = \App\Models\Shop::query()
            ->whereIn('seller_id', $sellerIds)
            ->pluck('name', 'seller_id');

        $products = [];

        foreach ($pageProducts as $product) {
            $productKey = $product->part_no;

            $products[$productKey] = [
                'id' => $product->id,
                'name' => $product->name,
                'part_no' => $product->part_no,
                'thumbnail_img' => $product->thumbnail_img,
                'brand_id' => $product->brand_id,
                'group_id' => $product->group_id,
                'category_id' => $product->category_id,
                'warehouse_id' => $product->warehouse_id,
                'seller_id' => $product->seller_id,

                'group_name' => $groupNames[$product->group_id] ?? null,
                'category_name' => $categoryNames[$product->category_id] ?? null,
                'seller_name' => $sellerNames[$product->seller_id] ?? null,

                'hsncode' => $product->hsncode,
                'alias_name' => $product->alias_name,

                'seller_stock' => $product->seller_stock ?? 0,
                'no_credit' => $product->cash_and_carry_item ?? 0,

                'list_price'     => $product->list_price,
                'discount'       => $product->discount,
                'tax'            => $product->tax,
                'purchase_price' => $product->purchase_price,
                'markup'         => $product->markup,
                'net_price'      => $product->net_price,
                'mrp'            => $product->mrp,
                'purchase_tax'   => $product->purchase_tax,

                'changes' => [],
            ];
        }

        foreach ($pendingUpdates as $update) {
            $productKey = $update->part_no;

            if (!isset($products[$productKey])) {
                continue;
            }

            $products[$productKey]['changes'][] = [
                'field_name'    => $update->field_name,
                'current_value' => $update->current_value,
                'updated_value' => $update->updated_value,
                'status'        => $update->status,
                'user_id'       => $update->user_id,
                'updated_at'    => $update->updated_at,
            ];
        }

        $products = collect($products)->values();

        if ($showUpdatesOnly) {
            $products = $products->filter(function ($product) {
                return !empty($product['changes']) && count($product['changes']) > 0;
            })->values();
        }

        $productsPaginator->setCollection($products);

        $availableFieldNames = ProductUpdate::query()
            ->whereIn('part_no', $sellerProductPartNos)
            ->whereIn('status', ['pending', 'confirmed'])
            ->select('field_name')
            ->whereNotNull('field_name')
            ->distinct()
            ->orderBy('field_name')
            ->pluck('field_name');

        $baseUiProductQuery = Product::query()
            ->where('seller_id', $sellerId)
            ->when(!$showAllProducts, function ($query) use ($updatedPartNos) {
                $query->whereIn('part_no', $updatedPartNos);
            });

        $uiBrandIds = (clone $baseUiProductQuery)
            ->pluck('brand_id')
            ->filter()
            ->unique()
            ->values();

        $uiCategoryIds = (clone $baseUiProductQuery)
            ->pluck('category_id')
            ->filter()
            ->unique()
            ->values();

        $uiSubCategoryIds = (clone $baseUiProductQuery)
            ->pluck('group_id')
            ->filter()
            ->unique()
            ->values();

        $uiBrands = \App\Models\Brand::query()
            ->whereIn('id', $uiBrandIds)
            ->orderBy('name')
            ->get(['id', 'name']);

        $uiCategories = \App\Models\Category::query()
            ->whereIn('id', $uiCategoryIds)
            ->orderBy('name')
            ->get(['id', 'name']);

        $uiSubCategories = \App\Models\CategoryGroup::query()
            ->whereIn('id', $uiSubCategoryIds)
            ->orderBy('name')
            ->get(['id', 'name']);

        $uiDiscounts = (clone $baseUiProductQuery)
            ->pluck('discount')
            ->filter(function ($value) {
                return $value !== null && $value !== '';
            })
            ->map(function ($value) {
                return round((float) $value, 2);
            })
            ->unique()
            ->sort()
            ->values();

        $uiMarkups = (clone $baseUiProductQuery)
            ->pluck('markup')
            ->filter(function ($value) {
                return $value !== null && $value !== '';
            })
            ->map(function ($value) {
                return round((float) $value, 2);
            })
            ->unique()
            ->sort()
            ->values();

        $totalChanges = $pendingUpdates->count();

        return view('backend.product.products.under_review_view', compact(
            'sellerName',
            'products',
            'productsPaginator',
            'totalChanges',
            'availableFieldNames',
            'selectedFieldName',
            'viewType',
            'searchValue',
            'showUpdatesOnly',
            'uiBrands',
            'uiCategories',
            'uiSubCategories',
            'uiDiscounts',
            'uiMarkups',
            'brandFilters',
            'categoryFilters',
            'subCategoryFilter',
            'discountFilters',
            'markupFilters'
        ));
    }

    public function reviewInlineUpdate(Request $request)
    {
        $request->validate([
            'part_no'    => 'required|string',
            'field_name' => 'required|string',
            'value'      => 'nullable',
        ]);

        try {
            $partNo = trim((string) $request->part_no);
            $fieldName = trim((string) $request->field_name);
            $value = $request->value;

            /*
            |--------------------------------------------------------------------------
            | Field mapping
            |--------------------------------------------------------------------------
            */
            if ($fieldName === 'no_credit') {
                $fieldName = 'cash_and_carry_item';
            }

            $allowedFields = [
                'name',
                'hsncode',
                'category_id',
                'group_id',
                'alias_name',
                'seller_id',
                'list_price',
                'markup',
                'discount',
                'purchase_tax',
                'seller_stock',
                'cash_and_carry_item',
                'purchase_tax'
            ];

            if (!in_array($fieldName, $allowedFields, true)) {
                return response()->json([
                    'success' => false,
                    'message' => 'This field is not allowed for inline update.',
                ], 422);
            }

            $product = \App\Models\Product::where('part_no', $partNo)->first();

            if (!$product) {
                return response()->json([
                    'success' => false,
                    'message' => 'Product not found.',
                ], 404);
            }

            /*
            |--------------------------------------------------------------------------
            | Normalize incoming value
            |--------------------------------------------------------------------------
            */
            if (in_array($fieldName, ['seller_stock', 'cash_and_carry_item'], true)) {
                $value = (int) ((string) $value === '1' || $value === 1 || $value === true);
            }

            if ($fieldName === 'purchase_tax') {
                $value = strtoupper(trim((string) $value)) === 'Y' ? 'Y' : 'N';
            }

            $currentValue = $product->$fieldName ?? '';

            if (is_array($currentValue)) {
                $currentValue = json_encode($currentValue);
            }

            if (is_array($value)) {
                $value = json_encode($value);
            }

            $currentValue = trim((string) $currentValue);
            $updatedValue = trim((string) $value);

            /*
            |--------------------------------------------------------------------------
            | Main field update in product_updates
            |--------------------------------------------------------------------------
            */
            $productUpdate = \App\Models\ProductUpdate::where('part_no', $partNo)
                ->where('field_name', $fieldName)
                ->whereIn('status', ['pending', 'confirmed'])
                ->latest('id')
                ->first();

            if ($productUpdate) {
                $productUpdate->current_value = $currentValue;
                $productUpdate->updated_value = $updatedValue;
                $productUpdate->status = 'confirmed';
                $productUpdate->user_id = \Auth::id();
                $productUpdate->updated_at = now();
                $productUpdate->save();
            } else {
                $productUpdate = \App\Models\ProductUpdate::create([
                    'part_no'       => $partNo,
                    'field_name'    => $fieldName,
                    'current_value' => $currentValue,
                    'updated_value' => $updatedValue,
                    'status'        => 'confirmed',
                    'user_id'       => \Auth::id(),
                ]);
            }

            /*
            |--------------------------------------------------------------------------
            | Derived calculations
            |--------------------------------------------------------------------------
            | purchase price = list price - discount%
            | if purchase_tax = N => add tax%
            | if purchase_tax = Y => do not add tax%
            | net price = purchase price + markup%
            | mrp = net price + 31.579%
            |--------------------------------------------------------------------------
            */
            $purchasePrice = null;
            $netPrice = null;
            $mrp = null;

            if (in_array($fieldName, ['list_price', 'discount', 'markup', 'purchase_tax'], true)) {

                $getLatestValue = function ($field, $default = null) use ($partNo, $product) {
                    $latestUpdate = \App\Models\ProductUpdate::where('part_no', $partNo)
                        ->where('field_name', $field)
                        ->whereIn('status', ['pending', 'confirmed'])
                        ->latest('id')
                        ->first();

                    if ($latestUpdate && $latestUpdate->updated_value !== null && $latestUpdate->updated_value !== '') {
                        return $latestUpdate->updated_value;
                    }

                    return $product->$field ?? $default;
                };

                $listPrice   = (float) $getLatestValue('list_price', 0);
                $discount    = (float) $getLatestValue('discount', 0);
                $markup      = (float) $getLatestValue('markup', 0);
                $tax         = (float) $getLatestValue('tax', 0);
                $purchaseTax = strtoupper(trim((string) $getLatestValue('purchase_tax', 'N')));

                $discountedBase = $listPrice - ($listPrice * $discount / 100);

                if ($purchaseTax === 'N') {
                    $purchasePrice = $discountedBase + ($discountedBase * $tax / 100);
                } else {
                    $purchasePrice = $discountedBase;
                }

                $netPrice = $purchasePrice + ($purchasePrice * $markup / 100);
                $mrp      = $netPrice + ($netPrice * 31.579 / 100);

                $purchasePrice = round($purchasePrice, 2);
                $netPrice      = round($netPrice, 2);
                $mrp           = round($mrp, 2);

                $derivedUpdates = [
                    'purchase_price' => $purchasePrice,
                    'net_price'      => $netPrice,
                    'mrp'            => $mrp,
                ];

                foreach ($derivedUpdates as $derivedField => $derivedValue) {
                    $existingDerived = \App\Models\ProductUpdate::where('part_no', $partNo)
                        ->where('field_name', $derivedField)
                        ->whereIn('status', ['pending', 'confirmed'])
                        ->latest('id')
                        ->first();

                    $currentDerivedValue = $product->$derivedField ?? '';

                    if (is_array($currentDerivedValue)) {
                        $currentDerivedValue = json_encode($currentDerivedValue);
                    }

                    $currentDerivedValue = trim((string) $currentDerivedValue);
                    $derivedValueString = trim((string) $derivedValue);

                    if ($existingDerived) {
                        $existingDerived->current_value = $currentDerivedValue;
                        $existingDerived->updated_value = $derivedValueString;
                        $existingDerived->status = 'confirmed';
                        $existingDerived->user_id = \Auth::id();
                        $existingDerived->updated_at = now();
                        $existingDerived->save();
                    } else {
                        \App\Models\ProductUpdate::create([
                            'part_no'       => $partNo,
                            'field_name'    => $derivedField,
                            'current_value' => $currentDerivedValue,
                            'updated_value' => $derivedValueString,
                            'status'        => 'confirmed',
                            'user_id'       => \Auth::id(),
                        ]);
                    }
                }
            }

            return response()->json([
                'success' => true,
                'message' => 'Inline update saved successfully.',
                'data' => [
                    'part_no'       => $productUpdate->part_no,
                    'field_name'    => $productUpdate->field_name,
                    'current_value' => $productUpdate->current_value,
                    'updated_value' => $productUpdate->updated_value,
                    'status'        => $productUpdate->status,
                ],
                'derived' => [
                    'purchase_price' => $purchasePrice,
                    'net_price'      => $netPrice,
                    'mrp'            => $mrp,
                ],
            ]);
        } catch (\Throwable $e) {
            \Log::error('reviewInlineUpdate failed', [
                'message' => $e->getMessage(),
                'line'    => $e->getLine(),
                'file'    => $e->getFile(),
                'trace'   => $e->getTraceAsString(),
            ]);

            return response()->json([
                'success' => false,
                'message' => 'Something went wrong while saving inline update.',
            ], 500);
        }
    }
    public function reviewUpdate(Request $request)
    {
        $partNo = $request->main_part_no;
        $publishToProduct = (int) $request->publish_to_product === 1;

        $updatedValues = $request->updated_value ?? [];
        $fieldNames = $request->field_name ?? [];

        $product = \App\Models\Product::where('part_no', $partNo)->first();

        $translationFields = [
            'name',
            'billing_name',
            'unit',
            'description',
        ];

        $allowedProductFields = [
            'name',
            'billing_name',
            'part_no',
            'hsncode',
            'alias_name',
            'group_id',
            'category_id',
            'brand_id',
            'seller_id',
            'warehouse_id',
            'unit',
            'generic_name',
            'photos',
            'thumbnail_img',
            'import_photos',
            'import_thumbnail_img',
            'purchase_price',
            'mrp',
            'mrp_41_price',
            'weight',
            'description',
            'meta_title',
            'meta_description',
            'meta_keywords',
            'list_price',
            'discount',
            'markup',
            'net_price',
            'tax',
            'purchase_tax',
            'seller_stock',
        ];

        /*
        |--------------------------------------------------------------------------
        | Determine final Purchase Price and MRP before publishing
        |--------------------------------------------------------------------------
        */

        $effectivePurchasePrice = (float) optional($product)->purchase_price;
        $effectiveMrp = (float) optional($product)->mrp;

        foreach ($updatedValues as $productKey => $values) {
            foreach ($values as $index => $value) {
                $field = $fieldNames[$productKey][$index] ?? null;

                if ($field === 'purchase_price') {
                    $effectivePurchasePrice = (float) $value;
                }

                if ($field === 'mrp') {
                    $effectiveMrp = (float) $value;
                }
            }
        }

        /*
        |--------------------------------------------------------------------------
        | Keep updates pending when Purchase Price or MRP is zero
        |--------------------------------------------------------------------------
        */

        if (
            $publishToProduct &&
            ($effectivePurchasePrice <= 0 || $effectiveMrp <= 0)
        ) {
            \App\Models\ProductUpdate::where('part_no', $partNo)
                ->whereIn('status', ['pending', 'confirmed'])
                ->update([
                    'status' => 'pending',
                    'updated_at' => now(),
                ]);

            return back()->with(
                'warning',
                'Product cannot be published because Purchase Price and MRP must both be greater than zero. Updates have been kept pending.'
            );
        }

        foreach ($updatedValues as $productKey => $values) {
            foreach ($values as $index => $value) {
                $field = $fieldNames[$productKey][$index] ?? null;

                if (!$field) {
                    continue;
                }

                $productUpdate = \App\Models\ProductUpdate::where('part_no', $partNo)
                    ->where('field_name', $field)
                    ->whereIn('status', ['pending', 'confirmed'])
                    ->latest('id')
                    ->first();

                if (!$productUpdate) {
                    continue;
                }

                /*
                |--------------------------------------------------------------------------
                | Pending to Confirmed
                |--------------------------------------------------------------------------
                */

                if ($productUpdate->status === 'pending') {
                    $productUpdate->updated_value = $value;
                    $productUpdate->status = 'confirmed';
                    $productUpdate->updated_at = now();
                    $productUpdate->save();
                }

                /*
                |--------------------------------------------------------------------------
                | Confirmed to Published
                |--------------------------------------------------------------------------
                */

                if ($publishToProduct) {
                    $productUpdate->status = 'published';
                    $productUpdate->updated_at = now();
                    $productUpdate->save();

                    if (
                        $product &&
                        in_array($field, $allowedProductFields, true)
                    ) {
                        if (
                            in_array($field, $translationFields, true) &&
                            method_exists($product, 'setTranslation')
                        ) {
                            $product->setTranslation(
                                $field,
                                env('DEFAULT_LANGUAGE', 'en'),
                                $value
                            );
                        } else {
                            $product->{$field} = $value;
                        }

                        $product->modified_at = now();
                    }
                }
            }
        }

        if ($publishToProduct) {
            if ($product) {
                $product->save();

                return back()->with(
                    'success',
                    'Product confirmed & published successfully!'
                );
            }

            return back()->with(
                'warning',
                'Published in product_updates but product not found.'
            );
        }

        return back()->with('success', 'Product confirmed successfully!');
    }


    public function bulkPublishReviewUpdates(Request $request)
    {
        $selectedPartNos = json_decode($request->selected_part_nos, true);

        if (empty($selectedPartNos) || !is_array($selectedPartNos)) {
            return response()->json([
                'status' => false,
                'message' => 'Please select at least one product.'
            ], 422);
        }

        $selectedPartNos = collect($selectedPartNos)
            ->filter()
            ->unique()
            ->values()
            ->toArray();

        \App\Jobs\BulkPublishReviewUpdatesJob::dispatch($selectedPartNos, auth()->id());

        return response()->json([
            'status' => true,
            'message' => 'Bulk publish job started successfully.',
            'count' => count($selectedPartNos),
        ]);
    }

